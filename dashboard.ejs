<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<%- include('../partials/header', { title: 'HealthOrbit — Executive Summary' }) %>
<link rel="icon" href="/images/Logo.png">

<style>
/* ==================================================================
   HEALTHORBIT DASHBOARD v2 — scoped with 'ho-' / 'd-' prefixes.
   Designed to sit next to the new sidebar (desktop rail) and the
   mobile top bar + bottom tab bar (both handled in sidebar.ejs).
================================================================== */
:root {
  --d-bg: #eef6f3;
  --d-ink: #0c2a26;
  --d-ink-2: #4a6861;
  --d-ink-3: #8aa39c;
  --d-teal-950: #06302b;
  --d-teal-900: #0b5e55;
  --d-teal-700: #0d7a6e;
  --d-teal-500: #17a795;
  --d-mint: #5fe0c4;
  --d-coral: #e5806c;
  --d-coral-soft: #fdeae5;
  --d-blue: #4285f4;
  --d-amber: #e09a2b;
  --d-red: #e5484d;
  --d-card: rgba(255, 255, 255, 0.72);
  --d-card-solid: #ffffff;
  --d-edge: rgba(255, 255, 255, 0.95);
  --d-line: rgba(11, 94, 85, 0.11);
  --d-shadow: 0 18px 40px -22px rgba(6, 48, 43, 0.28);
  --d-r-xl: 28px;
  --d-r-lg: 20px;
  --d-r-md: 14px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  min-height: 100vh; display: flex;
  font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
  color: var(--d-ink); -webkit-font-smoothing: antialiased; overflow-x: hidden;
  background-color: var(--d-bg);
  background-image:
    radial-gradient(700px 500px at 5% 0%, rgba(23, 167, 149, 0.20), transparent 60%),
    radial-gradient(600px 500px at 100% 10%, rgba(229, 128, 108, 0.16), transparent 60%),
    radial-gradient(700px 600px at 60% 100%, rgba(95, 224, 196, 0.16), transparent 60%);
  background-attachment: fixed;
}

@keyframes dRise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
@keyframes dPulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.45; transform: scale(1.5); } }
@keyframes dDraw { from { stroke-dashoffset: 339; } }
@keyframes dBar { from { transform: scaleY(0.15); } to { transform: scaleY(1); } }

/* ---------- Layout shell ---------- */
.ho-app-layout { display: flex; width: 100vw; height: 100vh; position: relative; z-index: 10; }
.ho-main-content {
  flex: 1; min-width: 0; height: 100vh; overflow-y: auto; scrollbar-width: none;
  display: flex; flex-direction: column; margin-left: 0 !important; padding-left: 0 !important;
}
.ho-main-content::-webkit-scrollbar { display: none; }
.d-wrap { width: 100%; max-width: 1480px; margin: 0 auto; padding: 1.6rem 2.4rem 2.5rem; flex: 1; }

/* ---------- Page header ---------- */
.d-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.6rem; flex-wrap: wrap; }
.d-eyebrow { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; font-weight: 800; color: var(--d-teal-700); text-transform: uppercase; letter-spacing: 0.09em; margin-bottom: 0.5rem; }
.d-live { width: 8px; height: 8px; border-radius: 50%; background: var(--d-mint); box-shadow: 0 0 10px var(--d-mint); animation: dPulse 2s infinite; }
.d-head h1 { font-family: 'Fraunces', serif; font-weight: 700; font-size: 2.35rem; color: var(--d-teal-950); letter-spacing: -0.03em; line-height: 1.1; }
.d-head h1 em { font-style: normal; color: var(--d-coral); }
.d-head p { color: var(--d-ink-2); font-weight: 600; font-size: 0.95rem; margin-top: 0.4rem; }
.d-btn {
  display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.85rem 1.5rem; border-radius: 999px;
  background: var(--d-teal-950); color: #fff; font-weight: 750; font-size: 0.9rem; text-decoration: none;
  box-shadow: 0 10px 24px -10px rgba(6, 48, 43, 0.6); transition: transform 0.2s ease, background 0.2s ease;
}
.d-btn:hover { background: var(--d-teal-900); transform: translateY(-2px); }
.d-btn:active { transform: scale(0.96); }
.d-btn svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

/* ---------- Grid + cards ---------- */
.d-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 1.3rem; }
.d-card {
  background: var(--d-card); backdrop-filter: blur(30px) saturate(180%); -webkit-backdrop-filter: blur(30px) saturate(180%);
  border: 1px solid var(--d-edge); border-radius: var(--d-r-xl); padding: 1.6rem;
  box-shadow: var(--d-shadow), inset 0 1px 0 rgba(255,255,255,0.9);
  animation: dRise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; position: relative; min-width: 0;
}
.d-card:nth-child(1) { animation-delay: 0.04s; } .d-card:nth-child(2) { animation-delay: 0.08s; }
.d-card:nth-child(3) { animation-delay: 0.12s; } .d-card:nth-child(4) { animation-delay: 0.16s; }
.d-card:nth-child(5) { animation-delay: 0.2s; }  .d-card:nth-child(6) { animation-delay: 0.24s; }
.d-card:nth-child(n+7) { animation-delay: 0.28s; }

.d-card-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.1rem; }
.d-card-head h3 { font-family: 'Fraunces', serif; font-weight: 700; font-size: 1.1rem; color: var(--d-teal-950); display: flex; align-items: center; gap: 0.55rem; }
.d-card-head h3 svg { width: 18px; height: 18px; fill: none; stroke: var(--d-teal-700); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
.d-link { font-size: 0.8rem; font-weight: 750; color: var(--d-teal-700); text-decoration: none; white-space: nowrap; }
.d-link:hover { text-decoration: underline; }
.d-chip { font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; padding: 5px 11px; border-radius: 999px; background: rgba(13,122,110,0.1); color: var(--d-teal-700); white-space: nowrap; }

/* ---------- Hero ---------- */
.d-hero {
  grid-column: span 8; color: #fff; border: none; overflow: hidden;
  display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 2.4rem 2.6rem;
  background:
    radial-gradient(420px 260px at 90% 0%, rgba(95, 224, 196, 0.28), transparent 70%),
    linear-gradient(135deg, var(--d-teal-950), var(--d-teal-900) 60%, var(--d-teal-700));
  cursor: pointer; transition: transform 0.3s ease;
}
.d-hero:hover { transform: translateY(-3px); }
.d-hero-text { position: relative; z-index: 2; flex: 1; min-width: 0; }
.d-hero-label { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--d-mint); margin-bottom: 0.8rem; }
.d-hero h2 { font-family: 'Fraunces', serif; font-weight: 600; font-size: 2rem; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 0.8rem; }
.d-hero p { color: rgba(255,255,255,0.82); font-size: 0.95rem; line-height: 1.6; max-width: 54ch; margin-bottom: 1.4rem; }
.d-hero-tags { display: flex; gap: 0.6rem; flex-wrap: wrap; }
.d-tag { font-size: 0.75rem; font-weight: 750; padding: 6px 14px; border-radius: 999px; background: rgba(255,255,255,0.13); border: 1px solid rgba(255,255,255,0.22); }
.d-tag.good { color: var(--d-mint); background: rgba(95,224,196,0.14); border-color: rgba(95,224,196,0.4); }

.d-score { width: 150px; height: 150px; position: relative; flex-shrink: 0; z-index: 2; }
.d-score svg { width: 100%; height: 100%; transform: rotate(-90deg); filter: drop-shadow(0 6px 18px rgba(0,0,0,0.25)); }
.d-score .track { fill: none; stroke: rgba(255,255,255,0.14); stroke-width: 9; }
.d-score .fill { fill: none; stroke: var(--d-mint); stroke-width: 9; stroke-linecap: round; stroke-dasharray: 339; stroke-dashoffset: 41; animation: dDraw 1.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both; }
.d-score-num { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.d-score-num strong { font-family: 'JetBrains Mono', monospace; font-size: 2.2rem; line-height: 1; }
.d-score-num span { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #a9d6cd; margin-top: 5px; }

/* ---------- Sync card ---------- */
.d-sync { grid-column: span 4; display: flex; flex-direction: column; }
.d-sync-box { display: flex; align-items: center; gap: 1rem; background: var(--d-card-solid); border: 1px solid var(--d-line); border-radius: var(--d-r-md); padding: 1rem 1.1rem; }
.d-sync-ic { width: 46px; height: 46px; border-radius: 13px; background: rgba(66,133,244,0.1); color: var(--d-blue); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.d-sync-ic svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.1; stroke-linecap: round; stroke-linejoin: round; }
.d-sync-box strong { display: block; font-size: 0.93rem; color: var(--d-teal-950); font-weight: 800; }
.d-sync-box span { font-family: 'JetBrains Mono', monospace; font-size: 0.74rem; color: var(--d-ink-2); font-weight: 600; }
.d-sync-note { margin-top: auto; padding-top: 1rem; font-size: 0.8rem; color: var(--d-ink-2); font-weight: 600; line-height: 1.5; }

/* ---------- Live telemetry (dynamic) ---------- */
.d-telemetry { grid-column: span 12; }
.d-tele-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.9rem; }
.d-tele-item { background: var(--d-card-solid); border: 1px solid var(--d-line); border-radius: var(--d-r-md); padding: 1.1rem 1.2rem; }
.d-tele-item .lbl { font-size: 0.7rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; color: var(--d-ink-3); }
.d-tele-item .val { font-family: 'JetBrains Mono', monospace; font-size: 1.65rem; font-weight: 800; color: var(--d-teal-950); margin-top: 0.35rem; }
.d-tele-item .val small { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.8rem; font-weight: 650; color: var(--d-ink-2); margin-left: 3px; }
.d-tele-item .ts { font-size: 0.7rem; font-weight: 700; color: var(--d-teal-700); margin-top: 0.4rem; }

/* ---------- Vitals ---------- */
.d-vital { grid-column: span 3; display: flex; flex-direction: column; gap: 0.3rem; padding: 1.35rem 1.4rem; cursor: pointer; text-decoration: none; color: inherit; transition: transform 0.3s ease, border-color 0.3s ease; }
.d-vital:hover { transform: translateY(-4px); border-color: var(--d-teal-500); }
.d-vital-top { display: flex; align-items: center; justify-content: space-between; }
.d-vital-lbl { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; color: var(--d-ink-2); }
.d-vital-ic { width: 32px; height: 32px; border-radius: 10px; display: flex; align-items: center; justify-content: center; }
.d-vital-ic svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
.d-vital-val { font-family: 'JetBrains Mono', monospace; font-size: 2rem; font-weight: 800; color: var(--d-teal-950); margin-top: 0.5rem; line-height: 1; }
.d-vital-val small { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.82rem; font-weight: 650; color: var(--d-ink-2); margin-left: 3px; }
.d-vital-note { font-size: 0.74rem; font-weight: 750; margin-top: 0.15rem; }
.d-bars { display: flex; align-items: flex-end; gap: 4px; height: 30px; margin-top: 0.7rem; }
.d-bars i { flex: 1; border-radius: 3px; background: currentColor; opacity: 0.22; transform-origin: bottom; animation: dBar 0.9s cubic-bezier(0.16, 1, 0.3, 1) both; }
.d-bars i:last-child { opacity: 0.85; }
.tone-red { color: var(--d-red); } .tone-red .d-vital-ic { background: rgba(229,72,77,0.1); }
.tone-blue { color: var(--d-blue); } .tone-blue .d-vital-ic { background: rgba(66,133,244,0.1); }
.tone-purple { color: #8b5cf6; } .tone-purple .d-vital-ic { background: rgba(139,92,246,0.1); }
.tone-teal { color: var(--d-teal-500); } .tone-teal .d-vital-ic { background: rgba(23,167,149,0.1); }
.d-vital-note { color: var(--d-teal-700); }

/* ---------- Quick actions ---------- */
.d-actions { grid-column: span 12; }
.d-action-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.9rem; }
.d-action {
  display: flex; align-items: center; gap: 0.9rem; padding: 1rem 1.15rem; border-radius: var(--d-r-lg);
  background: var(--d-card-solid); border: 1px solid var(--d-line); text-decoration: none; color: inherit;
  transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease; min-width: 0;
}
.d-action:hover { transform: translateY(-3px); border-color: var(--d-teal-500); box-shadow: 0 14px 30px -14px rgba(13,122,110,0.35); }
.d-action:active { transform: scale(0.97); }
.d-action-ic { width: 42px; height: 42px; border-radius: 12px; background: var(--d-bg); color: var(--d-teal-700); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.d-action-ic svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.1; stroke-linecap: round; stroke-linejoin: round; }
.d-action strong { display: block; font-size: 0.88rem; font-weight: 800; color: var(--d-teal-950); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.d-action span { display: block; font-size: 0.72rem; font-weight: 650; color: var(--d-ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.d-action.primary { background: linear-gradient(135deg, var(--d-teal-700), var(--d-teal-950)); border-color: transparent; }
.d-action.primary .d-action-ic { background: rgba(255,255,255,0.18); color: #fff; }
.d-action.primary strong { color: #fff; }
.d-action.primary span { color: var(--d-mint); }

/* ---------- Activity ---------- */
.d-activity { grid-column: span 7; }
.d-act-list { display: flex; flex-direction: column; gap: 0.7rem; }
.d-act { display: flex; align-items: center; gap: 0.95rem; padding: 0.9rem 1.05rem; border-radius: var(--d-r-md); background: var(--d-card-solid); border: 1px solid var(--d-line); text-decoration: none; color: inherit; transition: transform 0.2s ease, border-color 0.2s ease; }
.d-act:hover { transform: translateX(5px); border-color: var(--d-teal-500); }
.d-act-ic { width: 38px; height: 38px; border-radius: 11px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.d-act-ic svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.1; stroke-linecap: round; stroke-linejoin: round; }
.d-act-body { flex: 1; min-width: 0; }
.d-act-body strong { display: block; font-size: 0.9rem; font-weight: 750; color: var(--d-teal-950); }
.d-act-body span { display: block; font-size: 0.76rem; font-weight: 600; color: var(--d-ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.d-act-time { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; font-weight: 700; color: var(--d-ink-3); white-space: nowrap; }

/* ---------- Medication ---------- */
.d-med { grid-column: span 5; background: linear-gradient(145deg, rgba(255,255,255,0.8), rgba(253,234,229,0.7)); border-color: rgba(229,128,108,0.3); display: flex; flex-direction: column; }
.d-med-sub { font-size: 0.85rem; font-weight: 600; color: var(--d-ink-2); margin-bottom: 1rem; }
.d-med-box { background: var(--d-card-solid); border: 1px solid var(--d-line); border-radius: var(--d-r-lg); padding: 1.15rem; display: flex; align-items: center; gap: 1rem; transition: border-color 0.3s ease, background 0.3s ease; }
.d-med-ic { width: 46px; height: 46px; border-radius: 13px; background: var(--d-coral-soft); color: var(--d-coral); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.d-med-ic svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.1; stroke-linecap: round; stroke-linejoin: round; }
.d-med-info { flex: 1; min-width: 0; }
.d-med-info strong { display: block; font-size: 1rem; font-weight: 800; color: var(--d-teal-950); }
.d-med-info span { font-family: 'JetBrains Mono', monospace; font-size: 0.74rem; font-weight: 600; color: var(--d-ink-2); }
.d-med-btn { border: none; cursor: pointer; padding: 0.7rem 1.15rem; border-radius: 12px; background: var(--d-teal-950); color: #fff; font-family: inherit; font-weight: 750; font-size: 0.82rem; white-space: nowrap; transition: transform 0.2s ease, background 0.2s ease; }
.d-med-btn:hover { background: var(--d-teal-900); transform: scale(1.05); }
.d-med-btn:active { transform: scale(0.95); }
.d-med-box.done { border-color: var(--d-teal-500); background: #f2fbf8; }
.d-med-box.done .d-med-btn { background: var(--d-teal-500); pointer-events: none; }

/* ---------- Responsive ---------- */
@media (max-width: 1400px) {
  .d-vital { grid-column: span 6; }
  .d-action-grid { grid-template-columns: repeat(3, 1fr); }
  .d-activity, .d-med { grid-column: span 6; }
}
@media (max-width: 1100px) {
  .d-hero, .d-sync { grid-column: span 12; }
  .d-vital { grid-column: span 6; }
  .d-activity, .d-med { grid-column: span 12; }
}

/* Phones & tablets: sidebar.ejs adds the top bar + bottom tab bar and sets
   .ho-main-content padding, so this only handles inner spacing. */
@media (max-width: 1024px) {
  body { display: block; }
  .ho-app-layout { height: auto !important; }
  .d-wrap { padding: 1.1rem 1rem 1.5rem; }
}
@media (max-width: 768px) {
  .d-head { margin-bottom: 1.1rem; }
  .d-head h1 { font-size: 1.7rem; }
  .d-head p { font-size: 0.86rem; }
  .d-head .d-btn { display: none; }
  .d-grid { gap: 1rem; }
  .d-card { padding: 1.2rem; border-radius: 22px; }
  .d-hero { flex-direction: column; align-items: flex-start; padding: 1.5rem 1.3rem; gap: 1.2rem; }
  .d-hero h2 { font-size: 1.5rem; }
  .d-score { width: 116px; height: 116px; align-self: center; order: 2; }
  .d-score-num strong { font-size: 1.7rem; }
  .d-vital { grid-column: span 6; padding: 1.05rem; }
  .d-vital-val { font-size: 1.5rem; }
  .d-vital-note { font-size: 0.68rem; }
  .d-action-grid { grid-template-columns: repeat(2, 1fr); gap: 0.7rem; }
  .d-action { flex-direction: column; align-items: flex-start; gap: 0.6rem; padding: 0.95rem; }
  .d-action.primary { grid-column: span 2; flex-direction: row; align-items: center; }
  .d-act-time { display: none; }
  .d-med-box { flex-wrap: wrap; }
  .d-med-btn { width: 100%; padding: 0.85rem; }
}

/* ---------- PWA splash ---------- */
.ho-pwa-splash-container { position: fixed; inset: 0; z-index: 999999; background: var(--d-bg); display: flex; flex-direction: column; align-items: center; justify-content: center; transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.6s; }
.ho-pwa-splash-hidden { opacity: 0; visibility: hidden; pointer-events: none; }
.ho-pwa-logo-stage { position: relative; width: 90px; height: 90px; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: center; }
.ho-pwa-core { width: 24px; height: 24px; border-radius: 50%; background: var(--d-teal-900); box-shadow: 0 0 15px rgba(11, 94, 85, 0.25); z-index: 5; }
.ho-pwa-ring { position: absolute; top: 50%; left: 50%; border-radius: 50%; border: 1px dashed var(--d-teal-500); opacity: 0.6; }
.ho-pwa-ring-outer { width: 90px; height: 90px; animation: hoPwaSpin 4s linear infinite; }
.ho-pwa-ring-inner { width: 56px; height: 56px; animation: hoPwaSpinReverse 3s linear infinite; }
.ho-pwa-planet { position: absolute; top: -4px; left: 50%; transform: translateX(-50%); border-radius: 50%; }
.ho-pwa-planet-coral { width: 8px; height: 8px; background: var(--d-coral); box-shadow: 0 0 6px var(--d-coral); }
.ho-pwa-planet-mint { width: 6px; height: 6px; background: var(--d-mint); box-shadow: 0 0 6px var(--d-mint); }
.ho-pwa-brand { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.8rem; font-weight: 800; color: var(--d-teal-900); letter-spacing: -0.5px; }
.ho-pwa-brand span { color: var(--d-coral); }
@keyframes hoPwaSpin { from { transform: translate(-50%, -50%) rotate(0deg); } to { transform: translate(-50%, -50%) rotate(360deg); } }
@keyframes hoPwaSpinReverse { from { transform: translate(-50%, -50%) rotate(360deg); } to { transform: translate(-50%, -50%) rotate(0deg); } }
@media (prefers-reduced-motion: reduce) {
  .ho-pwa-ring-outer, .ho-pwa-ring-inner, .d-card, .d-bars i, .d-live { animation: none; }
}
</style>
</head>
<body>

<!-- PWA splash -->
<div id="ho-pwa-splash" class="ho-pwa-splash-container" role="alert" aria-busy="true" aria-label="Loading HealthOrbit">
  <div class="ho-pwa-logo-stage">
    <div class="ho-pwa-ring ho-pwa-ring-outer"><div class="ho-pwa-planet ho-pwa-planet-coral"></div></div>
    <div class="ho-pwa-ring ho-pwa-ring-inner"><div class="ho-pwa-planet ho-pwa-planet-mint"></div></div>
    <div class="ho-pwa-core"></div>
  </div>
  <div class="ho-pwa-brand">Health<span>Orbit</span></div>
</div>

<%
  // Unified live telemetry list from whichever data source the route provides
  let telemetry = [];
  if (typeof wearableRecords !== 'undefined' && wearableRecords && wearableRecords.length > 0) {
    telemetry = wearableRecords.slice(0, 4).map(i => ({
      label: i.metricName, value: i.value, unit: i.unit,
      time: new Date(i.recordedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    }));
  } else if (typeof latestWearables !== 'undefined' && latestWearables && Object.keys(latestWearables).length > 0) {
    const g = k => latestWearables[k] ? (latestWearables[k].numericValue || latestWearables[k].value) : null;
    const steps = g('steps'), hr = g('heart_rate'), sys = g('blood_pressure_systolic'), dia = g('blood_pressure_diastolic'), cal = g('calories');
    telemetry = [
      { label: 'Physical Steps', value: steps !== null ? Number(steps).toLocaleString() : '--', unit: 'steps' },
      { label: 'Heart Rate', value: hr !== null ? Math.round(hr) : '--', unit: 'bpm' },
      { label: 'Blood Pressure', value: (sys !== null && dia !== null) ? Math.round(sys) + '/' + Math.round(dia) : '--', unit: 'mmHg' },
      { label: 'Active Calories', value: cal !== null ? Math.round(cal) : '--', unit: 'kcal' }
    ];
  }
  const firstName = (locals.userName && String(locals.userName).trim()) ? String(locals.userName).trim().split(' ')[0] : '';
%>

<div class="ho-app-layout">

  <%- include('../partials/sidebar') %>

  <main class="ho-main-content">
    <div class="d-wrap">

      <!-- ===== Header ===== -->
      <header class="d-head">
        <div>
          <div class="d-eyebrow"><span class="d-live"></span> All modules synced · Telemetry live</div>
          <h1><span id="dGreeting">Welcome</span><% if (firstName) { %>, <em><%= firstName %></em><% } %></h1>
          <p>Here is your unified health picture for today.</p>
        </div>
        <a href="/ai-assistant" class="d-btn">
          <svg viewBox="0 0 24 24"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path></svg>
          Ask AI Assistant
        </a>
      </header>

      <div class="d-grid">

        <!-- ===== Hero ===== -->
        <section class="d-card d-hero" onclick="window.location.href='/profile'">
          <div class="d-hero-text">
            <span class="d-hero-label"><span class="d-live"></span> Status: Optimal baseline</span>
            <h2>What is happening with your health right now?</h2>
            <p>Your unified profile is stable. Restorative sleep and recent vitamin protocols are actively bridging the gap from last week's recorded biometric shift.</p>
            <div class="d-hero-tags">
              <span class="d-tag">Authorized network active</span>
              <span class="d-tag good">All vitals stable</span>
            </div>
          </div>
          <div class="d-score" aria-label="Health score 88 out of 100">
            <svg viewBox="0 0 120 120">
              <circle class="track" cx="60" cy="60" r="54"></circle>
              <circle class="fill" cx="60" cy="60" r="54"></circle>
            </svg>
            <div class="d-score-num"><strong>88</strong><span>Health score</span></div>
          </div>
        </section>

        <!-- ===== Health Connect ===== -->
        <section class="d-card d-sync">
          <div class="d-card-head">
            <h3><svg viewBox="0 0 24 24"><path d="M5 12.55a11 11 0 0 1 14.08 0"></path><path d="M1.42 9a16 16 0 0 1 21.16 0"></path><path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path><line x1="12" y1="20" x2="12.01" y2="20"></line></svg> Health Connect</h3>
            <span class="d-chip" style="background: rgba(66,133,244,0.12); color: var(--d-blue);">Secure bridge</span>
          </div>
          <div class="d-sync-box">
            <div class="d-sync-ic"><svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></div>
            <div>
              <strong>Connected</strong>
              <span>Last sync: 10:42 PM</span>
            </div>
          </div>
          <p class="d-sync-note">Continuous background telemetry is active across your paired wearable devices.</p>
        </section>

        <!-- ===== Live telemetry (only when data exists) ===== -->
        <% if (telemetry.length > 0) { %>
        <section class="d-card d-telemetry">
          <div class="d-card-head">
            <h3><svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg> Wearable telemetry</h3>
            <span class="d-chip">Live sync</span>
          </div>
          <div class="d-tele-grid">
            <% telemetry.forEach(t => { %>
              <div class="d-tele-item">
                <div class="lbl"><%= t.label %></div>
                <div class="val"><%= t.value %><small><%= t.unit %></small></div>
                <% if (t.time) { %><div class="ts">Recorded <%= t.time %></div><% } %>
              </div>
            <% }) %>
          </div>
        </section>
        <% } %>

        <!-- ===== Core vitals ===== -->
        <a href="/wearables" class="d-card d-vital tone-red">
          <div class="d-vital-top"><span class="d-vital-lbl">Heart rate</span><span class="d-vital-ic"><svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg></span></div>
          <div class="d-vital-val">72<small>bpm</small></div>
          <div class="d-vital-note">Normal resting range</div>
          <div class="d-bars" aria-hidden="true"><i style="height:55%;animation-delay:.05s"></i><i style="height:70%;animation-delay:.1s"></i><i style="height:48%;animation-delay:.15s"></i><i style="height:80%;animation-delay:.2s"></i><i style="height:62%;animation-delay:.25s"></i><i style="height:74%;animation-delay:.3s"></i><i style="height:60%;animation-delay:.35s"></i></div>
        </a>

        <a href="/wearables" class="d-card d-vital tone-blue">
          <div class="d-vital-top"><span class="d-vital-lbl">Blood oxygen</span><span class="d-vital-ic"><svg viewBox="0 0 24 24"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg></span></div>
          <div class="d-vital-val">98<small>%</small></div>
          <div class="d-vital-note">Optimal saturation</div>
          <div class="d-bars" aria-hidden="true"><i style="height:90%;animation-delay:.05s"></i><i style="height:94%;animation-delay:.1s"></i><i style="height:92%;animation-delay:.15s"></i><i style="height:96%;animation-delay:.2s"></i><i style="height:93%;animation-delay:.25s"></i><i style="height:97%;animation-delay:.3s"></i><i style="height:98%;animation-delay:.35s"></i></div>
        </a>

        <a href="/wearables" class="d-card d-vital tone-purple">
          <div class="d-vital-top"><span class="d-vital-lbl">Deep sleep</span><span class="d-vital-ic"><svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg></span></div>
          <div class="d-vital-val">2<small>h</small> 15<small>m</small></div>
          <div class="d-vital-note">Restorative phase</div>
          <div class="d-bars" aria-hidden="true"><i style="height:40%;animation-delay:.05s"></i><i style="height:65%;animation-delay:.1s"></i><i style="height:50%;animation-delay:.15s"></i><i style="height:72%;animation-delay:.2s"></i><i style="height:58%;animation-delay:.25s"></i><i style="height:80%;animation-delay:.3s"></i><i style="height:68%;animation-delay:.35s"></i></div>
        </a>

        <a href="/trends" class="d-card d-vital tone-teal">
          <div class="d-vital-top"><span class="d-vital-lbl">Stress index</span><span class="d-vital-ic"><svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg></span></div>
          <div class="d-vital-val">34<small>/100</small></div>
          <div class="d-vital-note">Relaxed state</div>
          <div class="d-bars" aria-hidden="true"><i style="height:70%;animation-delay:.05s"></i><i style="height:55%;animation-delay:.1s"></i><i style="height:60%;animation-delay:.15s"></i><i style="height:42%;animation-delay:.2s"></i><i style="height:48%;animation-delay:.25s"></i><i style="height:36%;animation-delay:.3s"></i><i style="height:34%;animation-delay:.35s"></i></div>
        </a>

        <!-- ===== Quick actions ===== -->
        <section class="d-card d-actions">
          <div class="d-card-head">
            <h3><svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg> Quick actions</h3>
          </div>
          <div class="d-action-grid">
            <a href="/xyz" class="d-action">
              <span class="d-action-ic"><svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg></span>
              <div><strong>Upload report</strong><span>OCR extraction</span></div>
            </a>
            <a href="/wearables" class="d-action">
              <span class="d-action-ic"><svg viewBox="0 0 24 24"><rect x="6" y="4" width="12" height="16" rx="3"></rect><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></span>
              <div><strong>Connect device</strong><span>Health Connect</span></div>
            </a>
            <a href="/medicines" class="d-action">
              <span class="d-action-ic"><svg viewBox="0 0 24 24"><path d="M10.5 20.5l10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path><line x1="8.5" y1="8.5" x2="15.5" y2="15.5"></line></svg></span>
              <div><strong>Add medicine</strong><span>Schedule Rx</span></div>
            </a>
            <a href="/medicines" class="d-action">
              <span class="d-action-ic"><svg viewBox="0 0 24 24"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg></span>
              <div><strong>Log symptom</strong><span>Journal entry</span></div>
            </a>
            <a href="/ai-assistant" class="d-action primary">
              <span class="d-action-ic"><svg viewBox="0 0 24 24"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path></svg></span>
              <div><strong>Ask AI Assistant</strong><span>RAG intelligence</span></div>
            </a>
          </div>
        </section>

        <!-- ===== Recent activity ===== -->
        <section class="d-card d-activity">
          <div class="d-card-head">
            <h3><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> Recent activity</h3>
            <a href="/timeline" class="d-link">View timeline →</a>
          </div>
          <div class="d-act-list">
            <a href="/ocr" class="d-act">
              <span class="d-act-ic" style="background: rgba(66,133,244,0.1); color: var(--d-blue);"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg></span>
              <div class="d-act-body"><strong>CBC report uploaded</strong><span>OCR engine extracted 4 parameters successfully</span></div>
              <span class="d-act-time">2 hours ago</span>
            </a>
            <a href="/wearables" class="d-act">
              <span class="d-act-ic" style="background: rgba(229,72,77,0.1); color: var(--d-red);"><svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg></span>
              <div class="d-act-body"><strong>Heart rate synced</strong><span>Resting average stable at 72 BPM</span></div>
              <span class="d-act-time">10 mins ago</span>
            </a>
            <a href="/medicines" class="d-act">
              <span class="d-act-ic" style="background: rgba(224,154,43,0.12); color: var(--d-amber);"><svg viewBox="0 0 24 24"><path d="M10.5 20.5l10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path><line x1="8.5" y1="8.5" x2="15.5" y2="15.5"></line></svg></span>
              <div class="d-act-body"><strong>Medicine taken: Vitamin D3</strong><span>60,000 IU logged after breakfast protocol</span></div>
              <span class="d-act-time">8:00 PM</span>
            </a>
          </div>
        </section>

        <!-- ===== Next medication ===== -->
        <section class="d-card d-med">
          <div class="d-card-head">
            <h3><svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg> Next due medication</h3>
            <span class="d-chip" style="background: var(--d-coral-soft); color: var(--d-coral);" id="dMedChip">Pending dose</span>
          </div>
          <p class="d-med-sub">Your next scheduled prescription:</p>
          <div class="d-med-box" id="dMedBox">
            <div class="d-med-ic"><svg viewBox="0 0 24 24"><path d="M10.5 20.5l10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path><line x1="8.5" y1="8.5" x2="15.5" y2="15.5"></line></svg></div>
            <div class="d-med-info">
              <strong>Levothyroxine</strong>
              <span>50 mcg · Empty stomach · 08:00 AM</span>
            </div>
            <button type="button" class="d-med-btn" id="dMedBtn">Mark taken</button>
          </div>
        </section>

      </div>
    </div>

    <%- include('../partials/footer') %>
  </main>
</div>

<script>
  // Time-of-day greeting
  (function () {
    var h = new Date().getHours();
    var g = h < 5 ? 'Good night' : h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : h < 21 ? 'Good evening' : 'Good night';
    var el = document.getElementById('dGreeting');
    if (el) el.textContent = g;
  })();

  // Mark medication taken (in-place, no alert popup)
  (function () {
    var btn = document.getElementById('dMedBtn');
    var box = document.getElementById('dMedBox');
    var chip = document.getElementById('dMedChip');
    if (!btn) return;
    btn.addEventListener('click', function () {
      box.classList.add('done');
      btn.textContent = '✓ Taken';
      if (chip) { chip.textContent = 'Completed'; chip.style.background = 'rgba(23,167,149,0.12)'; chip.style.color = 'var(--d-teal-700)'; }
    });
  })();

  // Splash: hide once loaded, with a safety fallback
  (function () {
    var splash = document.getElementById('ho-pwa-splash');
    function hide() {
      if (!splash) return;
      setTimeout(function () {
        splash.classList.add('ho-pwa-splash-hidden');
        setTimeout(function () { if (splash) splash.remove(); }, 600);
      }, 300);
    }
    window.addEventListener('load', hide);
    setTimeout(hide, 5000);
  })();
</script>
</body>
</html>
