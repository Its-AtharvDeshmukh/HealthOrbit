<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0b5e55">
  <%- include('../partials/header', { title: 'HealthOrbit — AI Health Assistant Studio' }) %>
  <link rel="icon" href="/images/Logo.png">
<%
  /* ==========================================================================
     SERVER-SIDE VIEW MODEL (100% REAL BACKEND VARIABLES ONLY)
     Defensively normalizes chat history, medical reports, prescriptions,
     symptoms, and wearable vitals without inventing fake values.
  ========================================================================== */
  const rawHistory =
    (typeof messages !== 'undefined' && Array.isArray(messages)) ? messages :
    (typeof chatHistory !== 'undefined' && Array.isArray(chatHistory)) ? chatHistory :
    (typeof conversation !== 'undefined' && Array.isArray(conversation)) ? conversation : [];

  const rawReports =
    (typeof recentReports !== 'undefined' && Array.isArray(recentReports)) ? recentReports :
    (typeof reports !== 'undefined' && Array.isArray(reports)) ? reports :
    (typeof analysisView !== 'undefined' && analysisView && Array.isArray(analysisView.recentReports)) ? analysisView.recentReports : [];

  const rawMeds =
    (typeof medicines !== 'undefined' && Array.isArray(medicines)) ? medicines :
    (typeof activeMedicines !== 'undefined' && Array.isArray(activeMedicines)) ? activeMedicines : [];

  const rawSymptoms =
    (typeof symptoms !== 'undefined' && Array.isArray(symptoms)) ? symptoms :
    (typeof recentSymptoms !== 'undefined' && Array.isArray(recentSymptoms)) ? recentSymptoms : [];

  const rawMetrics =
    (typeof latestMetrics !== 'undefined' && latestMetrics && typeof latestMetrics === 'object') ? latestMetrics :
    (typeof metricsSummary !== 'undefined' && metricsSummary && typeof metricsSummary === 'object') ? metricsSummary :
    (typeof wearableMetrics !== 'undefined' && wearableMetrics && typeof wearableMetrics === 'object') ? wearableMetrics : {};

  /* 1. Normalize Chat Messages */
  const normalizedMessages = rawHistory.map((m, idx) => {
    const roleRaw = String(m.role || m.sender || 'assistant').toLowerCase();
    const isUser = roleRaw === 'user' || roleRaw === 'patient' || roleRaw === 'human';
    const text = m.content || m.text || m.message || m.reply || '';
    const dRaw = m.createdAt || m.timestamp || m.sentAt || null;
    const dObj = dRaw ? new Date(dRaw) : null;
    const validD = dObj && !isNaN(dObj.getTime()) ? dObj : null;

    return {
      id: m._id ? String(m._id) : `msg_${idx}`,
      role: isUser ? 'user' : 'assistant',
      text: String(text),
      timeStr: validD ? validD.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'Recorded'
    };
  }).filter(m => m.text.trim().length > 0);

  /* 2. Normalize Uploaded Medical Reports */
  const normalizedReports = rawReports.map((r, idx) => {
    const params = (r.extractedData && Array.isArray(r.extractedData.parameters))
      ? r.extractedData.parameters
      : (Array.isArray(r.parameters) ? r.parameters : []);
    const dRaw = r.reportDate || r.createdAt || r.uploadedAt || null;
    const dObj = dRaw ? new Date(dRaw) : null;
    const validD = dObj && !isNaN(dObj.getTime()) ? dObj : null;

    return {
      idx,
      id: r._id ? String(r._id) : (r.id ? String(r.id) : `rep_${idx}`),
      title: r.originalFileName || r.title || r.fileName || 'Medical Report',
      dateStr: validD ? validD.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : 'Uploaded',
      paramCount: params.length,
      topParams: params.slice(0, 6).map(p => ({
        name: p.name || 'Parameter',
        value: p.value !== undefined && p.value !== null ? String(p.value) : '--',
        unit: p.unit || '',
        referenceRange: p.referenceRange || ''
      }))
    };
  });

  /* 3. Normalize Active Prescriptions */
  const normalizedMeds = rawMeds.filter(m => m.active !== false).map((m, idx) => ({
    idx,
    id: m._id ? String(m._id) : `med_${idx}`,
    name: m.name || m.medicineName || 'Prescription',
    dosage: m.dosage || m.dose || '',
    frequency: m.frequency || 'Scheduled',
    instructions: m.instructions || m.duration || ''
  }));

  /* 4. Normalize Recent Symptoms */
  const normalizedSymptoms = rawSymptoms.slice(0, 8).map((s, idx) => {
    const dRaw = s.recordedAt || s.createdAt || null;
    const dObj = dRaw ? new Date(dRaw) : null;
    const validD = dObj && !isNaN(dObj.getTime()) ? dObj : null;
    return {
      idx,
      id: s._id ? String(s._id) : `sym_${idx}`,
      symptom: s.symptom || s.symptomType || 'Symptom',
      severity: s.severity || 'Observed',
      notes: s.notes || '',
      dateStr: validD ? validD.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) : 'Recent'
    };
  });

  /* 5. Normalize Real Synced Vitals (if any) */
  const vitalList = [];
  const pushVital = (key, label, fallbackUnit) => {
    const obj = rawMetrics[key];
    if (!obj) return;
    const val = obj.value !== undefined ? obj.value : obj.numericValue;
    if (val !== undefined && val !== null && String(val).trim() !== '') {
      vitalList.push({
        label,
        value: String(val),
        unit: obj.unit || fallbackUnit || ''
      });
    }
  };
  pushVital('heart_rate', 'Heart Rate', 'bpm');
  pushVital('blood_pressure', 'Blood Pressure', 'mmHg');
  pushVital('spo2', 'Blood Oxygen', '%');
  pushVital('steps', 'Daily Steps', 'steps');
  pushVital('sleep_duration', 'Sleep Duration', 'hrs');

  const userDisplayName = (locals.userName && String(locals.userName).trim()) ? String(locals.userName).trim() : 'Patient';
  const userInitials = userDisplayName.split(/\s+/).map(w => w[0]).join('').substring(0, 2).toUpperCase() || 'US';
%>

  <style>
    /* ==================================================================
       HEALTHORBIT — AI HEALTH ASSISTANT STUDIO
       Liquid Glass Bento Workspace + Web-Only Floating Motion + Mobile UX
    ================================================================== */
    :root {
      --ho-bg-airy: #edf6f4;
      --ho-teal-950: #06302b;
      --ho-teal-900: #0b5e55;
      --ho-teal-800: #0c6b61;
      --ho-teal-700: #0d7a6e;
      --ho-teal-600: #109485;
      --ho-mint-400: #42b89d;
      --ho-mint-200: #9be8d3;
      --ho-mint-soft: #dff1ec;
      --ho-coral: #e07a68;
      --ho-coral-soft: #fbe4de;
      --ho-amber: #d97706;
      --ho-amber-soft: #fef3c7;
      --ho-blue: #3b82f6;
      --ho-blue-soft: #dbeafe;
      --ho-danger: #d94b4b;
      --ho-text-main: #0f1c1a;
      --ho-text-muted: #4e6b63;
      --ho-text-subtle: #78948d;

      --ho-glass-clear: rgba(255, 255, 255, 0.62);
      --ho-glass-solid: rgba(255, 255, 255, 0.92);
      --ho-glass-border: rgba(255, 255, 255, 0.96);
      --ho-glass-border-subtle: rgba(13, 122, 110, 0.14);

      --ho-radius-xl: 26px;
      --ho-radius-lg: 20px;
      --ho-radius-md: 14px;
      --ho-shadow-glass: 0 20px 50px rgba(13, 122, 110, 0.08), inset 0 1px 1px rgba(255, 255, 255, 1);
      --ho-shadow-elevated: 0 26px 56px rgba(13, 122, 110, 0.15);
      --ho-ease: cubic-bezier(0.16, 1, 0.3, 1);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { -webkit-tap-highlight-color: transparent; }

    body {
      min-height: 100vh;
      min-height: 100dvh;
      font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
      background-color: var(--ho-bg-airy);
      color: var(--ho-text-main);
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
      display: flex;
    }

    /* ---------- Custom Visible Scrollbars (.ho-custom-scroll) ---------- */
    .ho-custom-scroll {
      scrollbar-width: thin;
      scrollbar-color: rgba(13, 122, 110, 0.32) rgba(13, 122, 110, 0.04);
    }
    .ho-custom-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
    .ho-custom-scroll::-webkit-scrollbar-track { background: rgba(13, 122, 110, 0.04); border-radius: 999px; }
    .ho-custom-scroll::-webkit-scrollbar-thumb { background: rgba(13, 122, 110, 0.32); border-radius: 999px; }
    .ho-custom-scroll::-webkit-scrollbar-thumb:hover { background: var(--ho-teal-600); }

    /* ---------- Ambient Glow Orbs (Web-Only Floating Motion) ---------- */
    .ho-ambient-canvas { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
    .ho-glow-orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.58; }
    .ho-orb-1 { width: 560px; height: 560px; background: #76d7c4; top: -120px; left: -100px; }
    .ho-orb-2 { width: 600px; height: 600px; background: #fadbd8; bottom: -160px; right: -100px; }
    .ho-orb-3 { width: 380px; height: 380px; background: #85c1e9; top: 36%; left: 42%; opacity: 0.25; }

    @media (min-width: 1025px) {
      .ho-glow-orb { animation: hoFloatOrb 22s ease-in-out infinite alternate; }
      .ho-orb-2 { animation-delay: -6s; }
      .ho-orb-3 { animation-delay: -11s; }
      @keyframes hoFloatOrb {
        0% { transform: translate(0, 0) scale(1) rotate(0deg); }
        50% { transform: translate(45px, 55px) scale(1.08) rotate(3deg); }
        100% { transform: translate(-25px, 35px) scale(0.96) rotate(-3deg); }
      }
    }

    /* ---------- App Shell ---------- */
    .ho-app-layout { display: flex; width: 100vw; height: 100vh; height: 100dvh; position: relative; z-index: 10; }
    .ho-main-content {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
    }

    /* ---------- Top Studio Header ---------- */
    .ho-topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.25rem;
      padding: 1.35rem 2.4rem 0.9rem;
      flex-shrink: 0;
      z-index: 20;
    }
    @media (min-width: 1025px) {
      .ho-topbar { animation: hoDrop 0.55s var(--ho-ease) both; }
      @keyframes hoDrop { from { opacity: 0; transform: translateY(-14px); } to { opacity: 1; transform: none; } }
    }

    .ho-eyebrow-pill {
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ho-teal-700);
      margin-bottom: 0.25rem;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
    }
    .ho-pulse-dot {
      width: 8px; height: 8px;
      background: var(--ho-mint-400);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--ho-mint-400);
      animation: hoPulse 2s infinite;
    }
    @keyframes hoPulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.45); } }

    .ho-topbar-text h1 {
      font-family: 'Fraunces', serif;
      font-weight: 800;
      font-size: 1.95rem;
      color: var(--ho-teal-900);
      letter-spacing: -0.8px;
      line-height: 1.1;
    }
    .ho-topbar-text h1 b { color: var(--ho-coral); font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; }

    .ho-topbar-actions { display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
    .ho-btn-ghost {
      padding: 0.68rem 1.2rem;
      background: var(--ho-glass-solid);
      border: 1.5px solid var(--ho-glass-border);
      border-radius: 999px;
      color: var(--ho-teal-900);
      font-weight: 700;
      font-size: 0.82rem;
      cursor: pointer;
      text-decoration: none;
      transition: 0.25s var(--ho-ease);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: inherit;
      white-space: nowrap;
    }
    .ho-btn-ghost svg { width: 15px; height: 15px; flex-shrink: 0; }
    .ho-btn-ghost:hover { background: #ffffff; box-shadow: 0 8px 22px rgba(13, 122, 110, 0.12); transform: translateY(-2px); border-color: var(--ho-teal-600); }
    .ho-btn-ghost:active { transform: scale(0.96); }
    .ho-btn-solid {
      background: linear-gradient(135deg, var(--ho-teal-600), var(--ho-teal-900));
      color: #ffffff;
      border-color: transparent;
      box-shadow: 0 8px 20px rgba(11, 94, 85, 0.24);
    }
    .ho-btn-solid:hover { background: linear-gradient(135deg, var(--ho-teal-600), var(--ho-teal-900)); color: #ffffff; }

    /* ==================================================================
       12-COLUMN AI WORKSPACE GRID (4 COL CONTEXT + 8 COL CONVERSATION)
    ================================================================== */
    .ho-ai-studio-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 1.35rem;
      padding: 0 2.4rem 1.25rem;
      max-width: 1640px;
      width: 100%;
      margin: 0 auto;
      flex: 1;
      min-height: 0;
    }

    /* Base Glass Panel */
    .ho-panel {
      --mx: 50%;
      --my: 50%;
      background: var(--ho-glass-clear);
      backdrop-filter: blur(36px) saturate(190%);
      -webkit-backdrop-filter: blur(36px) saturate(190%);
      border: 1px solid var(--ho-glass-border);
      border-radius: var(--ho-radius-xl);
      box-shadow: var(--ho-shadow-glass);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 0;
    }
    @media (min-width: 1025px) {
      .ho-panel { animation: hoSlideUp 0.6s var(--ho-ease) both; }
      .ho-ai-studio-grid > :nth-child(1) { animation-delay: 0.05s; }
      .ho-ai-studio-grid > :nth-child(2) { animation-delay: 0.12s; }
      @keyframes hoSlideUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }

      .ho-panel::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease;
        background: radial-gradient(420px circle at var(--mx) var(--my), rgba(66, 184, 157, 0.14), transparent 60%);
      }
      .ho-panel:hover::after { opacity: 1; }
    }

    /* ==================================================================
       LEFT 4 COLUMNS: CLINICAL CONTEXT VAULT & SMART PROMPT STUDIO
    ================================================================== */
    .ho-context-dock {
      grid-column: span 4;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1.35rem;
      overflow-y: auto;
    }

    /* Living AI Core Banner */
    .ho-ai-core-banner {
      background:
        radial-gradient(280px 160px at 100% 0%, rgba(66, 184, 157, 0.32), transparent 70%),
        linear-gradient(140deg, var(--ho-teal-950), #09423a 62%, var(--ho-teal-800));
      border-radius: 20px;
      padding: 1.15rem 1.25rem;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 1rem;
      box-shadow: 0 14px 32px rgba(6, 48, 43, 0.24);
      position: relative;
      z-index: 2;
      flex-shrink: 0;
    }
    .ho-orb-avatar {
      width: 52px;
      height: 52px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .ho-orb-avatar .ring-a {
      position: absolute; inset: 0;
      border: 1.8px dashed var(--ho-mint-400);
      border-radius: 50%;
    }
    .ho-orb-avatar .ring-b {
      position: absolute; inset: -5px;
      border: 1.5px dashed var(--ho-coral);
      border-radius: 50%;
    }
    .ho-orb-avatar .ring-c {
      position: absolute; inset: 7px;
      border: 1.5px solid rgba(155, 232, 211, 0.45);
      border-radius: 50%;
    }
    @media (min-width: 1025px) {
      .ho-orb-avatar .ring-a { animation: hoSpin 12s linear infinite; }
      .ho-orb-avatar .ring-b { animation: hoSpin 8s linear infinite reverse; }
      @keyframes hoSpin { to { transform: rotate(360deg); } }
    }
    .ho-orb-avatar .core-glow {
      width: 14px; height: 14px;
      border-radius: 50%;
      background: var(--ho-mint-200);
      box-shadow: 0 0 16px var(--ho-mint-400), 0 0 28px var(--ho-coral);
    }

    .ho-core-info h2 {
      font-family: 'Fraunces', serif;
      font-size: 1.12rem;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.2;
    }
    .ho-core-info p {
      font-size: 0.74rem;
      color: rgba(233, 251, 246, 0.82);
      margin-top: 0.2rem;
      line-height: 1.4;
      font-weight: 500;
    }

    /* Section Label inside Context Dock */
    .ho-dock-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--ho-teal-800);
      padding: 0 0.2rem;
      position: relative;
      z-index: 2;
    }

    /* Toggleable Grounded Context Cards */
    .ho-context-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem;
      position: relative;
      z-index: 2;
      flex-shrink: 0;
    }
    .ho-ctx-tile {
      background: rgba(255, 255, 255, 0.82);
      border: 1.5px solid var(--ho-glass-border-subtle);
      border-radius: 16px;
      padding: 0.8rem 0.9rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.45rem;
      cursor: pointer;
      transition: 0.22s var(--ho-ease);
      text-align: left;
      font-family: inherit;
      position: relative;
    }
    .ho-ctx-tile:hover {
      background: #ffffff;
      border-color: var(--ho-teal-600);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(13, 122, 110, 0.08);
    }
    .ho-ctx-tile.attached {
      background: #ffffff;
      border-color: var(--ho-teal-700);
      box-shadow: inset 0 0 0 1px var(--ho-teal-600), 0 6px 16px rgba(13, 122, 110, 0.09);
    }
    .ho-ctx-top { display: flex; justify-content: space-between; align-items: center; gap: 0.4rem; }
    .ho-ctx-icon {
      width: 28px; height: 28px;
      border-radius: 9px;
      background: rgba(13, 122, 110, 0.1);
      color: var(--ho-teal-700);
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 0.9rem;
    }
    .ho-ctx-check {
      width: 18px; height: 18px;
      border-radius: 50%;
      border: 1.5px solid rgba(13, 122, 110, 0.3);
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 0.65rem;
      font-weight: 900;
      color: transparent;
      transition: 0.2s;
    }
    .ho-ctx-tile.attached .ho-ctx-check {
      background: var(--ho-teal-700);
      border-color: var(--ho-teal-700);
      color: #ffffff;
    }
    .ho-ctx-title { font-size: 0.8rem; font-weight: 800; color: var(--ho-teal-950); line-height: 1.2; }
    .ho-ctx-sub {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      font-weight: 700;
      color: var(--ho-text-muted);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .ho-ctx-inspect-link {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 0.65rem;
      font-weight: 800;
      color: var(--ho-teal-700);
      text-decoration: underline;
    }

    /* Smart Prompt Studio Tabs & List */
    .ho-prompt-tabs {
      display: flex;
      gap: 0.35rem;
      background: rgba(13, 122, 110, 0.07);
      padding: 4px;
      border-radius: 12px;
      position: relative;
      z-index: 2;
      flex-shrink: 0;
    }
    .ho-ptab {
      flex: 1;
      border: none;
      background: transparent;
      padding: 0.42rem 0.4rem;
      border-radius: 9px;
      font-family: inherit;
      font-size: 0.71rem;
      font-weight: 800;
      color: var(--ho-text-muted);
      cursor: pointer;
      transition: 0.2s;
      white-space: nowrap;
    }
    .ho-ptab.active {
      background: #ffffff;
      color: var(--ho-teal-950);
      box-shadow: 0 2px 8px rgba(11, 94, 85, 0.1);
    }

    .ho-prompt-list {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      position: relative;
      z-index: 2;
      flex: 1;
      overflow-y: auto;
      padding-right: 0.25rem;
    }
    .ho-prompt-card {
      background: rgba(255, 255, 255, 0.84);
      border: 1px solid var(--ho-glass-border-subtle);
      border-radius: 14px;
      padding: 0.78rem 0.95rem;
      text-align: left;
      font-family: inherit;
      cursor: pointer;
      transition: 0.22s var(--ho-ease);
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.6rem;
    }
    .ho-prompt-card:hover {
      background: #ffffff;
      border-color: var(--ho-teal-600);
      transform: translateX(4px);
      box-shadow: 0 6px 18px rgba(13, 122, 110, 0.08);
    }
    .ho-prompt-card span {
      font-size: 0.8rem;
      font-weight: 650;
      color: var(--ho-teal-950);
      line-height: 1.4;
    }
    .ho-prompt-card i {
      font-style: normal;
      color: var(--ho-teal-600);
      font-weight: 800;
      font-size: 0.85rem;
      flex-shrink: 0;
    }

    /* ==================================================================
       RIGHT 8 COLUMNS: CONVERSATION STREAM & FLOATING COMPOSER
    ================================================================== */
    .ho-chat-stage {
      grid-column: span 8;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 0;
      background: rgba(255, 255, 255, 0.68);
    }

    /* Chat Stage Top Status Bar */
    .ho-chat-stage-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      padding: 0.95rem 1.4rem;
      border-bottom: 1px solid var(--ho-glass-border-subtle);
      background: rgba(255, 255, 255, 0.75);
      z-index: 3;
      flex-shrink: 0;
    }
    .ho-csb-left { display: flex; align-items: center; gap: 0.65rem; min-width: 0; }
    .ho-csb-status {
      width: 9px; height: 9px;
      border-radius: 50%;
      background: #27ae60;
      box-shadow: 0 0 0 3px rgba(39, 174, 96, 0.18);
      flex-shrink: 0;
    }
    .ho-csb-title { font-size: 0.88rem; font-weight: 800; color: var(--ho-teal-950); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ho-csb-sub { font-size: 0.72rem; color: var(--ho-text-muted); font-weight: 600; }

    .ho-mobile-ctx-trigger {
      display: none;
      align-items: center;
      gap: 0.4rem;
      padding: 0.42rem 0.85rem;
      border-radius: 999px;
      border: 1px solid rgba(13, 122, 110, 0.25);
      background: var(--ho-mint-soft);
      color: var(--ho-teal-900);
      font-family: inherit;
      font-size: 0.74rem;
      font-weight: 800;
      cursor: pointer;
    }

    /* Scrollable Chat Stream */
    .ho-chat-stream {
      flex: 1;
      overflow-y: auto;
      padding: 1.5rem 1.6rem;
      display: flex;
      flex-direction: column;
      gap: 1.15rem;
      z-index: 2;
      scroll-behavior: smooth;
    }

    /* Welcome Hero Matrix inside Empty / Fresh Chat */
    .ho-welcome-hero {
      margin: auto 0;
      padding: 1.2rem 0.5rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.9rem;
    }
    .ho-welcome-hero h2 {
      font-family: 'Fraunces', serif;
      font-size: clamp(1.45rem, 2.2vw, 1.85rem);
      color: var(--ho-teal-950);
      font-weight: 700;
      line-height: 1.2;
    }
    .ho-welcome-hero h2 em {
      font-style: normal;
      color: var(--ho-coral);
    }
    .ho-welcome-hero p {
      font-size: 0.88rem;
      color: var(--ho-text-muted);
      max-width: 54ch;
      line-height: 1.55;
      font-weight: 500;
    }
    .ho-starter-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
      width: 100%;
      max-width: 680px;
      margin-top: 0.35rem;
    }
    .ho-starter-card {
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid var(--ho-glass-border-subtle);
      border-radius: 16px;
      padding: 0.95rem 1.05rem;
      text-align: left;
      cursor: pointer;
      font-family: inherit;
      transition: 0.25s var(--ho-ease);
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }
    .ho-starter-card:hover {
      background: #ffffff;
      border-color: var(--ho-teal-600);
      transform: translateY(-3px);
      box-shadow: 0 12px 24px rgba(13, 122, 110, 0.1);
    }
    .ho-starter-card strong {
      font-size: 0.84rem;
      font-weight: 800;
      color: var(--ho-teal-950);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .ho-starter-card span {
      font-size: 0.76rem;
      color: var(--ho-text-muted);
      line-height: 1.4;
      font-weight: 500;
    }

    /* Message Rows & Bubbles */
    .ho-msg-row {
      display: flex;
      gap: 0.8rem;
      align-items: flex-end;
      max-width: 86%;
      animation: hoMsgIn 0.32s var(--ho-ease) both;
    }
    @keyframes hoMsgIn { from { opacity: 0; transform: translateY(10px) scale(0.98); } to { opacity: 1; transform: none; } }

    .ho-msg-row.user {
      align-self: flex-end;
      flex-direction: row-reverse;
    }
    .ho-msg-row.assistant {
      align-self: flex-start;
    }

    .ho-msg-av {
      width: 34px; height: 34px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 800;
      flex-shrink: 0;
    }
    .ho-msg-row.assistant .ho-msg-av {
      background: linear-gradient(135deg, var(--ho-teal-700), var(--ho-teal-950));
      color: var(--ho-mint-200);
      box-shadow: 0 4px 12px rgba(11, 94, 85, 0.22);
    }
    .ho-msg-row.user .ho-msg-av {
      background: linear-gradient(135deg, var(--ho-coral), #d1604c);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(224, 122, 104, 0.25);
    }

    .ho-msg-bubble {
      padding: 1rem 1.2rem;
      border-radius: 20px;
      font-size: 0.9rem;
      line-height: 1.62;
      word-break: break-word;
      position: relative;
    }
    .ho-msg-row.assistant .ho-msg-bubble {
      background: #ffffff;
      color: var(--ho-text-main);
      border: 1px solid var(--ho-glass-border-subtle);
      border-bottom-left-radius: 6px;
      box-shadow: 0 8px 24px rgba(13, 122, 110, 0.06);
    }
    .ho-msg-row.user .ho-msg-bubble {
      background: linear-gradient(135deg, var(--ho-teal-700), var(--ho-teal-900));
      color: #ffffff;
      border-bottom-right-radius: 6px;
      box-shadow: 0 10px 24px rgba(11, 94, 85, 0.2);
    }

    .ho-msg-content p { margin-bottom: 0.55rem; }
    .ho-msg-content p:last-child { margin-bottom: 0; }
    .ho-msg-content ul, .ho-msg-content ol { margin: 0.45rem 0 0.55rem 1.25rem; }
    .ho-msg-content li { margin-bottom: 0.3rem; }
    .ho-msg-content strong { font-weight: 800; }
    .ho-msg-row.assistant .ho-msg-content strong { color: var(--ho-teal-950); }
    .ho-msg-content code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8rem;
      padding: 2px 6px;
      border-radius: 6px;
      background: rgba(13, 122, 110, 0.08);
      color: var(--ho-teal-900);
    }

    .ho-msg-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-top: 0.55rem;
      padding-top: 0.45rem;
      border-top: 1px solid rgba(13, 122, 110, 0.08);
      font-size: 0.68rem;
      color: var(--ho-text-subtle);
      font-weight: 700;
    }
    .ho-msg-row.user .ho-msg-meta {
      border-top-color: rgba(255, 255, 255, 0.16);
      color: rgba(255, 255, 255, 0.78);
    }
    .ho-msg-tools { display: flex; align-items: center; gap: 0.4rem; }
    .ho-msg-tool-btn {
      border: none;
      background: rgba(13, 122, 110, 0.06);
      color: var(--ho-teal-800);
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 0.66rem;
      font-weight: 800;
      cursor: pointer;
      font-family: inherit;
      transition: 0.18s;
    }
    .ho-msg-tool-btn:hover { background: var(--ho-teal-900); color: #ffffff; }

    /* Animated Biometric Thinking Indicator */
    .ho-thinking-row {
      display: none;
      align-self: flex-start;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1.1rem;
      background: #ffffff;
      border: 1px solid var(--ho-glass-border-subtle);
      border-radius: 18px;
      box-shadow: 0 6px 18px rgba(13, 122, 110, 0.06);
    }
    .ho-thinking-row.show { display: inline-flex; }
    .ho-thinking-dots { display: flex; gap: 4px; }
    .ho-thinking-dots i {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--ho-teal-600);
      animation: hoBounce 1.2s infinite ease-in-out;
    }
    .ho-thinking-dots i:nth-child(2) { animation-delay: 0.18s; background: var(--ho-mint-400); }
    .ho-thinking-dots i:nth-child(3) { animation-delay: 0.36s; background: var(--ho-coral); }
    @keyframes hoBounce { 0%, 80%, 100% { transform: scale(0.7); opacity: 0.45; } 40% { transform: scale(1.2); opacity: 1; } }

    /* ==================================================================
       COMPOSER DOCK (AUTO-EXPANDING INPUT + CONTEXT PILLS + VOICE)
    ================================================================== */
    .ho-composer-dock {
      padding: 0.9rem 1.25rem 1.05rem;
      background: rgba(255, 255, 255, 0.88);
      border-top: 1px solid var(--ho-glass-border-subtle);
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      z-index: 4;
      flex-shrink: 0;
    }

    .ho-active-ctx-strip {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 2px;
    }
    .ho-active-ctx-strip::-webkit-scrollbar { display: none; }
    .ho-ctx-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.68rem;
      font-weight: 800;
      background: var(--ho-mint-soft);
      color: var(--ho-teal-900);
      border: 1px solid rgba(16, 148, 133, 0.25);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .ho-composer-box {
      display: flex;
      align-items: flex-end;
      gap: 0.55rem;
      background: #ffffff;
      border: 1.5px solid rgba(13, 122, 110, 0.22);
      border-radius: 20px;
      padding: 0.5rem 0.65rem 0.5rem 1rem;
      box-shadow: 0 6px 20px rgba(11, 94, 85, 0.05);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .ho-composer-box:focus-within {
      border-color: var(--ho-teal-600);
      box-shadow: 0 0 0 3px rgba(16, 148, 133, 0.12), 0 8px 24px rgba(11, 94, 85, 0.08);
    }

    .ho-composer-input {
      flex: 1;
      border: none;
      outline: none;
      background: transparent;
      font-family: inherit;
      font-size: 16px; /* Prevents iOS Safari auto-zoom */
      font-weight: 500;
      color: var(--ho-text-main);
      line-height: 1.45;
      resize: none;
      max-height: 130px;
      min-height: 26px;
      padding: 0.25rem 0;
    }
    .ho-composer-input::placeholder { color: var(--ho-text-subtle); }

    .ho-composer-btn {
      width: 40px;
      height: 40px;
      border-radius: 14px;
      border: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: 0.22s var(--ho-ease);
      flex-shrink: 0;
    }
    .ho-composer-btn svg { width: 18px; height: 18px; }
    .ho-mic-btn {
      background: rgba(13, 122, 110, 0.08);
      color: var(--ho-teal-800);
    }
    .ho-mic-btn:hover { background: rgba(13, 122, 110, 0.16); }
    .ho-mic-btn.listening {
      background: var(--ho-coral);
      color: #ffffff;
      animation: hoPulse 1.4s infinite;
    }
    .ho-send-btn {
      background: linear-gradient(135deg, var(--ho-teal-600), var(--ho-teal-900));
      color: #ffffff;
      box-shadow: 0 6px 16px rgba(11, 94, 85, 0.25);
    }
    .ho-send-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 22px rgba(11, 94, 85, 0.32); }
    .ho-send-btn:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }

    .ho-composer-disclaimer {
      font-size: 0.68rem;
      color: var(--ho-text-subtle);
      text-align: center;
      font-weight: 600;
    }

    /* ==================================================================
       CONTEXT INSPECTOR POP-UP MODAL (DESKTOP MODAL / MOBILE SHEET)
    ================================================================== */
    .ho-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(6, 48, 43, 0.48);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 3500;
      padding: 1.25rem;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.28s ease, visibility 0.28s ease;
    }
    .ho-modal-overlay.active { opacity: 1; visibility: visible; }
    .ho-modal-panel {
      width: 100%;
      max-width: 540px;
      max-height: 90vh;
      max-height: 90dvh;
      overflow-y: auto;
      background: #ffffff;
      border-radius: var(--ho-radius-xl);
      padding: 1.85rem;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.22);
      transform: translateY(32px) scale(0.96);
      transition: transform 0.38s var(--ho-ease);
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }
    .ho-modal-overlay.active .ho-modal-panel { transform: none; }
    .ho-modal-handle { display: none; width: 44px; height: 4px; border-radius: 999px; background: #d5e4e1; margin: -0.4rem auto -0.2rem; }
    .ho-modal-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
    .ho-modal-title { font-size: 1.3rem; font-family: 'Fraunces', serif; font-weight: 800; color: var(--ho-teal-900); }
    .ho-modal-close {
      background: rgba(13, 122, 110, 0.08);
      border: none;
      width: 36px; height: 36px;
      border-radius: 50%;
      font-size: 1rem;
      color: var(--ho-teal-900);
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
    }

    .ho-detail-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.78rem 0.95rem;
      background: var(--ho-bg-airy);
      border-radius: 12px;
      gap: 0.75rem;
    }
    .ho-dr-label { font-size: 0.8rem; font-weight: 700; color: var(--ho-text-muted); }
    .ho-dr-val { font-family: 'JetBrains Mono', monospace; font-size: 0.84rem; font-weight: 800; color: var(--ho-teal-900); text-align: right; }

    .ho-toast {
      position: fixed;
      left: 50%;
      bottom: 26px;
      transform: translate(-50%, 26px);
      background: var(--ho-teal-950);
      color: #ffffff;
      padding: 0.75rem 1.3rem;
      border-radius: 999px;
      font-size: 0.84rem;
      font-weight: 700;
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.25);
      opacity: 0;
      pointer-events: none;
      z-index: 4000;
      transition: 0.35s var(--ho-ease);
    }
    .ho-toast.show { opacity: 1; transform: translate(-50%, 0); }

    /* ==================================================================
       RESPONSIVE BREAKPOINTS (TABLET & MOBILE APP-GRADE VIEWPORT)
    ================================================================== */
    @media (max-width: 1024px) {
      /* Override sidebar.ejs mobile global rules so chat stays a true 100dvh app view */
      body { height: 100dvh !important; overflow: hidden !important; }
      .ho-app-layout { height: 100dvh !important; overflow: hidden !important; }
      body .ho-main-content {
        margin-top: 4.8rem !important;
        padding: 0.35rem 0.75rem calc(env(safe-area-inset-bottom, 0px) + 0.5rem) !important;
        height: calc(100dvh - 4.8rem) !important;
        overflow: hidden !important;
      }

      .ho-ai-studio-grid {
        display: flex;
        flex-direction: column;
        padding: 0;
        gap: 0;
        flex: 1;
        min-height: 0;
      }

      /* Turn Context Dock into a slide-up bottom sheet on mobile */
      .ho-context-dock {
        position: fixed;
        left: 0; right: 0; bottom: 0;
        max-height: 84dvh;
        border-radius: 26px 26px 0 0;
        background: #ffffff;
        z-index: 3200;
        box-shadow: 0 -20px 50px rgba(6, 48, 43, 0.25);
        transform: translateY(105%);
        transition: transform 0.38s var(--ho-ease);
        padding: 1.25rem 1.15rem calc(env(safe-area-inset-bottom, 0px) + 1.25rem);
      }
      .ho-context-dock.mobile-open { transform: translateY(0); }

      .ho-chat-stage {
        flex: 1;
        width: 100%;
        border-radius: 22px;
        min-height: 0;
      }
      .ho-mobile-ctx-trigger { display: inline-flex; }
    }

    @media (max-width: 640px) {
      .ho-chat-stream { padding: 1rem; gap: 0.9rem; }
      .ho-msg-row { max-width: 94%; }
      .ho-starter-grid { grid-template-columns: 1fr; }
      .ho-composer-dock { padding: 0.65rem 0.8rem 0.75rem; }

      .ho-modal-overlay { align-items: flex-end; padding: 0; }
      .ho-modal-panel { max-width: 100%; border-radius: 26px 26px 0 0; padding: 1.35rem 1.15rem calc(env(safe-area-inset-bottom, 0px) + 1.35rem); transform: translateY(100%); }
      .ho-modal-handle { display: block; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
    }
  </style>
</head>
<body>

<!-- Ambient Glow Orbs (Web-Only Float Motion) -->
<div class="ho-ambient-canvas" aria-hidden="true">
  <div class="ho-glow-orb ho-orb-1"></div>
  <div class="ho-glow-orb ho-orb-2"></div>
  <div class="ho-glow-orb ho-orb-3"></div>
</div>

<div class="ho-app-layout">
  <%- include('../partials/sidebar') %>

  <main class="ho-main-content">

    <!-- ===== DESKTOP STUDIO TOPBAR ===== -->
    <header class="ho-topbar">
      <div class="ho-topbar-text">
        <div class="ho-eyebrow-pill">
          <span class="ho-pulse-dot"></span>
          Grounded Clinical Companion &bull; Non-Diagnostic
        </div>
        <h1>HealthOrbit <b>AI Studio</b></h1>
      </div>

      <div class="ho-topbar-actions">
        <a href="/ai-analysis" class="ho-btn-ghost">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/></svg>
          Report Analysis Studio
        </a>
        <button type="button" class="ho-btn-ghost" onclick="exportTranscript()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Export Chat
        </button>
        <button type="button" class="ho-btn-ghost ho-btn-solid" onclick="resetConversation()">
          + New Consultation
        </button>
      </div>
    </header>

    <!-- ===== 12-COLUMN AI WORKSPACE ===== -->
    <div class="ho-ai-studio-grid">

      <!-- ==================================================================
           LEFT 4 COLUMNS: CLINICAL CONTEXT VAULT & PROMPT STUDIO
      ================================================================== -->
      <aside class="ho-panel ho-context-dock ho-custom-scroll" id="contextDock" aria-label="Health Context and Prompt Studio">
        <div style="display:flex; justify-content:space-between; align-items:center;" class="ho-mobile-only-close">
          <div class="ho-dock-head" style="padding:0;">Grounded Health Context</div>
          <button type="button" class="ho-modal-close" style="width:30px; height:30px; display:none;" id="closeMobileDockBtn" onclick="toggleMobileContextDock(false)">✕</button>
        </div>

        <!-- Living AI Core Banner -->
        <div class="ho-ai-core-banner">
          <div class="ho-orb-avatar" aria-hidden="true">
            <span class="ring-a"></span>
            <span class="ring-b"></span>
            <span class="ring-c"></span>
            <span class="core-glow"></span>
          </div>
          <div class="ho-core-info">
            <h2>Personal Health AI</h2>
            <p>Select which of your real vault records to include as context when asking questions.</p>
          </div>
        </div>

        <!-- Toggleable Grounded Context Tiles -->
        <div class="ho-dock-head">
          <span>Active Record Context</span>
          <span style="color:var(--ho-text-subtle);">Tap to toggle</span>
        </div>

        <div class="ho-context-grid">
          <!-- 1. Lab Reports Context -->
          <div class="ho-ctx-tile attached" data-ctx-key="reports" onclick="toggleContextSource('reports', this)">
            <div class="ho-ctx-top">
              <span class="ho-ctx-icon">📄</span>
              <span class="ho-ctx-check">✓</span>
            </div>
            <div class="ho-ctx-title">Lab Reports</div>
            <div class="ho-ctx-sub">
              <span><%= normalizedReports.length %> Uploaded</span>
              <span class="ho-ctx-inspect-link" onclick="event.stopPropagation(); openContextInspector('reports')">Inspect</span>
            </div>
          </div>

          <!-- 2. Active Prescriptions Context -->
          <div class="ho-ctx-tile attached" data-ctx-key="medicines" onclick="toggleContextSource('medicines', this)">
            <div class="ho-ctx-top">
              <span class="ho-ctx-icon">💊</span>
              <span class="ho-ctx-check">✓</span>
            </div>
            <div class="ho-ctx-title">Prescriptions</div>
            <div class="ho-ctx-sub">
              <span><%= normalizedMeds.length %> Active</span>
              <span class="ho-ctx-inspect-link" onclick="event.stopPropagation(); openContextInspector('medicines')">Inspect</span>
            </div>
          </div>

          <!-- 3. Logged Symptoms Context -->
          <div class="ho-ctx-tile attached" data-ctx-key="symptoms" onclick="toggleContextSource('symptoms', this)">
            <div class="ho-ctx-top">
              <span class="ho-ctx-icon">🩺</span>
              <span class="ho-ctx-check">✓</span>
            </div>
            <div class="ho-ctx-title">Symptoms</div>
            <div class="ho-ctx-sub">
              <span><%= normalizedSymptoms.length %> Logged</span>
              <span class="ho-ctx-inspect-link" onclick="event.stopPropagation(); openContextInspector('symptoms')">Inspect</span>
            </div>
          </div>

          <!-- 4. Synced Wearable Vitals Context -->
          <div class="ho-ctx-tile attached" data-ctx-key="vitals" onclick="toggleContextSource('vitals', this)">
            <div class="ho-ctx-top">
              <span class="ho-ctx-icon">⌚</span>
              <span class="ho-ctx-check">✓</span>
            </div>
            <div class="ho-ctx-title">Synced Vitals</div>
            <div class="ho-ctx-sub">
              <span><%= vitalList.length %> Metrics</span>
              <span class="ho-ctx-inspect-link" onclick="event.stopPropagation(); openContextInspector('vitals')">Inspect</span>
            </div>
          </div>
        </div>

        <!-- Categorized Smart Prompt Studio -->
        <div class="ho-dock-head" style="margin-top:0.25rem;">
          <span>Clinical Prompt Library</span>
        </div>

        <div class="ho-prompt-tabs" role="tablist">
          <button type="button" class="ho-ptab active" data-pcat="reports">Lab Reports</button>
          <button type="button" class="ho-ptab" data-pcat="meds">Meds &amp; Rx</button>
          <button type="button" class="ho-ptab" data-pcat="symptoms">Symptoms</button>
          <button type="button" class="ho-ptab" data-pcat="doctor">Doctor Prep</button>
        </div>

        <div class="ho-prompt-list ho-custom-scroll" id="promptLibraryList"></div>
      </aside>

      <!-- ==================================================================
           RIGHT 8 COLUMNS: CONVERSATION STREAM & COMPOSER
      ================================================================== -->
      <section class="ho-panel ho-chat-stage" aria-label="AI Consultation Conversation">

        <!-- Stage Header Bar -->
        <div class="ho-chat-stage-bar">
          <div class="ho-csb-left">
            <span class="ho-csb-status"></span>
            <div>
              <div class="ho-csb-title">HealthOrbit Clinical Intelligence</div>
              <div class="ho-csb-sub" id="activeContextSummaryText">Grounded in your Lab Reports, Prescriptions, Symptoms &amp; Vitals</div>
            </div>
          </div>

          <div style="display:flex; align-items:center; gap:0.45rem;">
            <button type="button" class="ho-mobile-ctx-trigger" onclick="toggleMobileContextDock(true)">
              📂 Health Context &amp; Prompts
            </button>
            <button type="button" class="ho-btn-ghost" style="padding:0.42rem 0.85rem; font-size:0.74rem;" onclick="resetConversation()">
              Clear
            </button>
          </div>
        </div>

        <!-- Scrollable Message Stream -->
        <div class="ho-chat-stream ho-custom-scroll" id="chatStream" role="log" aria-live="polite">

          <% if (normalizedMessages.length === 0) { %>
            <!-- Welcome Empty State Matrix -->
            <div class="ho-welcome-hero" id="welcomeHero">
              <div class="ho-eyebrow-pill" style="background:rgba(13,122,110,0.08); padding:4px 12px; border-radius:999px;">
                Hello, <%= userDisplayName %>
              </div>
              <h2>How can I help you understand your <em>health records</em> today?</h2>
              <p>
                Ask about laboratory parameters in your uploaded reports, review your active prescription schedule, or prepare safe questions for your physician.
              </p>

              <div class="ho-starter-grid">
                <button type="button" class="ho-starter-card" onclick="sendPromptDirectly('Can you explain the key findings and any out-of-range parameters in my latest uploaded medical report in simple English?')">
                  <strong>📄 Decode Latest Lab Report</strong>
                  <span>Plain-English breakdown of your extracted test parameters and reference ranges.</span>
                </button>

                <button type="button" class="ho-starter-card" onclick="sendPromptDirectly('Can you review my active prescriptions and help me organize a daily schedule and questions for my pharmacist or doctor?')">
                  <strong>💊 Review My Prescriptions</strong>
                  <span>Summarize your ongoing medications, timing instructions, and adherence questions.</span>
                </button>

                <button type="button" class="ho-starter-card" onclick="sendPromptDirectly('Based on my recently logged symptoms and health records, what patterns should I share with my doctor?')">
                  <strong>🩺 Analyze Symptom Chronology</strong>
                  <span>Organize your logged symptom episodes and severity notes for a clinical visit.</span>
                </button>

                <button type="button" class="ho-starter-card" onclick="sendPromptDirectly('What are the top 5 most important questions I should ask my doctor at my next checkup based on my records?')">
                  <strong>👨‍⚕️ Doctor Consultation Prep</strong>
                  <span>Generate tailored, non-diagnostic questions to bring to your next appointment.</span>
                </button>
              </div>
            </div>
          <% } else { %>
            <% normalizedMessages.forEach((msg) => { %>
              <div class="ho-msg-row <%= msg.role %>">
                <div class="ho-msg-av"><%= msg.role === 'user' ? userInitials : 'AI' %></div>
                <div class="ho-msg-bubble">
                  <div class="ho-msg-content js-markdown-target"><%= msg.text %></div>
                  <div class="ho-msg-meta">
                    <span><%= msg.timeStr %></span>
                    <% if (msg.role === 'assistant') { %>
                      <div class="ho-msg-tools">
                        <button type="button" class="ho-msg-tool-btn" onclick="copyBubbleText(this)">Copy</button>
                        <button type="button" class="ho-msg-tool-btn" onclick="speakBubbleText(this)">Listen</button>
                      </div>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } %>

          <!-- Animated Thinking Indicator -->
          <div class="ho-thinking-row" id="thinkingIndicator" aria-live="assertive">
            <div class="ho-thinking-dots"><i></i><i></i><i></i></div>
            <span style="font-size:0.78rem; font-weight:700; color:var(--ho-teal-900);">Synthesizing clinical context...</span>
          </div>

        </div>

        <!-- Floating Glass Composer Dock -->
        <form class="ho-composer-dock" id="chatComposerForm" onsubmit="handleChatSubmit(event)">
          <!-- Active Grounded Context Strip -->
          <div class="ho-active-ctx-strip" id="composerCtxPills">
            <span class="ho-ctx-chip" data-chip="reports">📄 <%= normalizedReports.length %> Reports</span>
            <span class="ho-ctx-chip" data-chip="medicines">💊 <%= normalizedMeds.length %> Prescriptions</span>
            <span class="ho-ctx-chip" data-chip="symptoms">🩺 <%= normalizedSymptoms.length %> Symptoms</span>
            <span class="ho-ctx-chip" data-chip="vitals">⌚ <%= vitalList.length %> Vitals</span>
          </div>

          <div class="ho-composer-box">
            <textarea
              id="chatInput"
              class="ho-composer-input ho-custom-scroll"
              rows="1"
              placeholder="Ask about your lab reports, prescriptions, symptoms, or doctor questions..."
              aria-label="Message HealthOrbit AI"
              required></textarea>

            <button type="button" class="ho-composer-btn ho-mic-btn" id="voiceMicBtn" title="Voice Dictation" aria-label="Voice Dictation">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
            </button>

            <button type="submit" class="ho-composer-btn ho-send-btn" id="sendMsgBtn" title="Send Message" aria-label="Send Message">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
          </div>

          <div class="ho-composer-disclaimer">
            HealthOrbit AI provides informational explanations grounded in your records and does not replace a licensed physician's diagnosis.
          </div>
        </form>

      </section>

    </div>

  </main>
</div>

<!-- ==========================================================================
     CONTEXT INSPECTOR POP-UP MODAL (REPORTS / MEDS / SYMPTOMS / VITALS)
========================================================================== -->
<div class="ho-modal-overlay" id="ctxInspectorModal" onclick="closeCtxModal(event)" role="dialog" aria-modal="true" aria-labelledby="ctxModalTitle">
  <div class="ho-modal-panel ho-custom-scroll" onclick="event.stopPropagation()">
    <div class="ho-modal-handle"></div>
    <div class="ho-modal-header">
      <div>
        <span class="ho-ctx-chip" id="ctxModalBadge">Vault Context</span>
        <h3 class="ho-modal-title" id="ctxModalTitle" style="margin-top:0.35rem;">Grounded Records</h3>
      </div>
      <button type="button" class="ho-modal-close" onclick="closeCtxModal()" aria-label="Close">✕</button>
    </div>

    <div id="ctxModalBody" style="display:flex; flex-direction:column; gap:0.65rem;"></div>

    <div style="display:flex; gap:0.6rem; padding-top:0.3rem;">
      <button type="button" class="ho-btn-ghost ho-btn-solid" id="ctxModalPromptBtn" style="width:100%; justify-content:center;">
        ✨ Ask AI About These Records
      </button>
    </div>
  </div>
</div>

<div class="ho-toast" id="hoToast">Copied to clipboard</div>

<script>
  /* ==========================================================================
     CLIENT-SIDE AI STUDIO ENGINE
  ========================================================================== */
  const reportsData = <%- JSON.stringify(normalizedReports || []).replace(/</g, '\\u003c') %>;
  const medsData = <%- JSON.stringify(normalizedMeds || []).replace(/</g, '\\u003c') %>;
  const symptomsData = <%- JSON.stringify(normalizedSymptoms || []).replace(/</g, '\\u003c') %>;
  const vitalsData = <%- JSON.stringify(vitalList || []).replace(/</g, '\\u003c') %>;
  const csrfTokenStr = <%- JSON.stringify(locals.csrfToken || '').replace(/</g, '\\u003c') %>;
  const userInitialsStr = <%- JSON.stringify(userInitials || 'US').replace(/</g, '\\u003c') %>;

  const $ = (s, r) => (r || document).querySelector(s);
  const $$ = (s, r) => Array.from((r || document).querySelectorAll(s));

  function showToast(msg) {
    const t = $('#hoToast');
    if (!t) return;
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(t._tm);
    t._tm = setTimeout(() => t.classList.remove('show'), 2300);
  }

  /* ---- 1. Safe Markdown Renderer for AI Messages ---- */
  function formatMarkdownSafe(rawText) {
    const escaped = String(rawText || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    const lines = escaped.split(/\r?\n/);
    let html = '';
    let inList = false;

    lines.forEach(line => {
      const trimmed = line.trim();
      const bulletMatch = trimmed.match(/^[-*•]\s+(.*)/);
      const numMatch = trimmed.match(/^\d+\.\s+(.*)/);

      const inlineFmt = (str) => str
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/`([^`]+)`/g, '<code>$1</code>');

      if (bulletMatch || numMatch) {
        if (!inList) { html += '<ul>'; inList = true; }
        html += `<li>${inlineFmt(bulletMatch ? bulletMatch[1] : numMatch[1])}</li>`;
      } else {
        if (inList) { html += '</ul>'; inList = false; }
        if (trimmed.length > 0) {
          html += `<p>${inlineFmt(trimmed)}</p>`;
        }
      }
    });
    if (inList) html += '</ul>';
    return html || `<p>${escaped}</p>`;
  }

  $$('.js-markdown-target').forEach(el => {
    el.innerHTML = formatMarkdownSafe(el.textContent);
  });

  /* ---- 2. Smart Prompt Library by Category ---- */
  const promptLibrary = {
    reports: [
      'Summarize the most important findings in my latest uploaded medical report in plain English.',
      'Which parameters in my lab report are outside the printed reference range and what do those tests measure?',
      'How do my current lab results compare to my previous reports?',
      'Explain my lipid panel, blood glucose, or complete blood count values in simple terms.'
    ],
    meds: [
      'Review my active prescriptions and summarize their general purpose and timing instructions.',
      'What questions should I ask my doctor or pharmacist about taking my current medications together?',
      'How can I organize my daily medication schedule for better adherence?',
      'What should I discuss with my clinician before stopping or changing a dose?'
    ],
    symptoms: [
      'Review my recently logged symptoms and help me describe their timeline clearly to my doctor.',
      'What non-diagnostic factors or lifestyle habits should I track alongside my current symptoms?',
      'What warning signs mean I should seek prompt in-person medical evaluation for my symptoms?'
    ],
    doctor: [
      'Generate 5 specific, high-value questions I should bring to my next doctor appointment.',
      'Help me prepare a 1-minute summary of my active prescriptions, recent lab reports, and symptoms for my physician.',
      'What follow-up tests are commonly discussed with a clinician when reviewing my recent report?'
    ]
  };

  function renderPromptLibrary(cat) {
    const listEl = $('#promptLibraryList');
    if (!listEl) return;
    const items = promptLibrary[cat] || promptLibrary.reports;
    listEl.innerHTML = items.map(q => `
      <button type="button" class="ho-prompt-card" onclick="sendPromptDirectly('${q.replace(/'/g, "\\'")}')">
        <span>${q}</span>
        <i>&rarr;</i>
      </button>
    `).join('');
  }
  renderPromptLibrary('reports');

  $$('.ho-ptab').forEach(tab => { tab.addEventListener('click', () => { $$
('.ho-ptab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      renderPromptLibrary(tab.dataset.pcat || 'reports');
    });
  });

  /* ---- 3. Grounded Context Toggle & Context Summary Builder ---- */
  const activeContext = { reports: true, medicines: true, symptoms: true, vitals: true };

  window.toggleContextSource = function (key, tileEl) {
    activeContext[key] = !activeContext[key];
    if (tileEl) tileEl.classList.toggle('attached', activeContext[key]);
    const chip = $(`#composerCtxPills [data-chip="${key}"]`);
    if (chip) chip.style.display = activeContext[key] ? 'inline-flex' : 'none';

    const activeNames = [];
    if (activeContext.reports) activeNames.push('Lab Reports');
    if (activeContext.medicines) activeNames.push('Prescriptions');
    if (activeContext.symptoms) activeNames.push('Symptoms');
    if (activeContext.vitals) activeNames.push('Vitals');

    const sub = $('#activeContextSummaryText');
    if (sub) {
      sub.textContent = activeNames.length > 0
        ? 'Grounded in your ' + activeNames.join(', ')
        : 'General informational mode (no personal records attached)';
    }
  };

  function buildContextDigestString() {
    const parts = [];
    if (activeContext.reports && reportsData.length > 0) {
      const latest = reportsData[0];
      const paramStr = latest.topParams.map(p => `${p.name}: ${p.value} ${p.unit}`).join(', ');
      parts.push(`Latest Report (${latest.title}, ${latest.dateStr}): ${paramStr || (latest.paramCount + ' parameters')}`);
    }
    if (activeContext.medicines && medsData.length > 0) {
      parts.push(`Active Prescriptions: ${medsData.map(m => `${m.name} (${m.dosage},${m.frequency})`).join('; ')}`);
    }
    if (activeContext.symptoms && symptomsData.length > 0) {
      parts.push(`Recent Symptoms: ${symptomsData.map(s => `${s.symptom} (${s.severity},${s.dateStr})`).join('; ')}`);
    }
    if (activeContext.vitals && vitalsData.length > 0) {
      parts.push(`Synced Vitals: ${vitalsData.map(v => `${v.label}: ${v.value}${v.unit}`).join('; ')}`);
    }
    return parts.join(' | ');
  }

  /* ---- 4. Context Inspector Pop-Up Modal ---- */
  window.openContextInspector = function (key) {
    const modal = $('#ctxInspectorModal');
    const title = $('#ctxModalTitle');
    const body = $('#ctxModalBody');
    const promptBtn = $('#ctxModalPromptBtn');
    if (!modal || !body) return;

    if (key === 'reports') {
      title.textContent = 'Uploaded Medical Reports';
      body.innerHTML = reportsData.length > 0
        ? reportsData.map(r => `
            <div class="ho-detail-row">
              <div>
                <strong style="display:block; font-size:0.86rem; color:var(--ho-teal-950);">${r.title}</strong>
                <span class="ho-dr-label">${r.dateStr}</span>
              </div>
              <span class="ho-dr-val">${r.paramCount} Metrics</span>
            </div>
          `).join('')
        : '<p style="font-size:0.85rem; color:var(--ho-text-muted);">No medical reports uploaded yet. Visit Medical Reports to upload a PDF or image.</p>';
      promptBtn.onclick = () => { closeCtxModal(); sendPromptDirectly('Can you summarize the key parameters in my uploaded medical reports?'); };
    } else if (key === 'medicines') {
      title.textContent = 'Active Prescriptions';
      body.innerHTML = medsData.length > 0
        ? medsData.map(m => `
            <div class="ho-detail-row">
              <span class="ho-dr-label">${m.name} (${m.frequency})</span>
              <span class="ho-dr-val">${m.dosage}</span>
            </div>
          `).join('')
        : '<p style="font-size:0.85rem; color:var(--ho-text-muted);">No active prescriptions recorded.</p>';
      promptBtn.onclick = () => { closeCtxModal(); sendPromptDirectly('Can you review my active prescriptions and share general timing tips and doctor questions?'); };
    } else if (key === 'symptoms') {
      title.textContent = 'Recent Symptom Entries';
      body.innerHTML = symptomsData.length > 0
        ? symptomsData.map(s => `
            <div class="ho-detail-row">
              <span class="ho-dr-label">${s.symptom} (${s.dateStr})</span>
              <span class="ho-dr-val">${s.severity}</span>
            </div>
          `).join('')
        : '<p style="font-size:0.85rem; color:var(--ho-text-muted);">No recent symptoms logged.</p>';
      promptBtn.onclick = () => { closeCtxModal(); sendPromptDirectly('Can you help me organize my logged symptoms to discuss with my physician?'); };
    } else if (key === 'vitals') {
      title.textContent = 'Synced Wearable Vitals';
      body.innerHTML = vitalsData.length > 0
        ? vitalsData.map(v => `
            <div class="ho-detail-row">
              <span class="ho-dr-label">${v.label}</span>
              <span class="ho-dr-val">${v.value} ${v.unit}</span>
            </div>
          `).join('')
        : '<p style="font-size:0.85rem; color:var(--ho-text-muted);">No wearable vitals synced yet.</p>';
      promptBtn.onclick = () => { closeCtxModal(); sendPromptDirectly('How do my synced wearable vitals fit into my overall wellness routine?'); };
    }

    modal.classList.add('active');
  };

  window.closeCtxModal = function (e) {
    const modal = $('#ctxInspectorModal');
    if (!modal) return;
    if (!e || e.target === modal) modal.classList.remove('active');
  };

  /* Mobile Context Sheet Toggle */
  window.toggleMobileContextDock = function (open) {
    const dock = $('#contextDock');
    const closeBtn = $('#closeMobileDockBtn');
    if (!dock) return;
    dock.classList.toggle('mobile-open', open);
    if (closeBtn) closeBtn.style.display = open ? 'inline-flex' : 'none';
  };

  /* ---- 5. Chat Submission & Multi-Endpoint Resilient Fetch ---- */
  const chatStream = $('#chatStream');
  const chatInput = $('#chatInput');
  const thinkingRow = $('#thinkingIndicator');
  const sendBtn = $('#sendMsgBtn');

  function scrollToBottom() {
    if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
  }
  scrollToBottom();

  /* Auto-resize textarea & Enter-to-send */
  if (chatInput) {
    chatInput.addEventListener('input', () => {
      chatInput.style.height = 'auto';
      chatInput.style.height = Math.min(130, chatInput.scrollHeight) + 'px';
    });
    chatInput.addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        $('#chatComposerForm')?.requestSubmit();
      }
    });
  }

  function appendMessageBubble(role, text) {
    const welcome = $('#welcomeHero');
    if (welcome) welcome.remove();

    const nowStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    const row = document.createElement('div');
    row.className = `ho-msg-row ${role}`;

    const avText = role === 'user' ? userInitialsStr : 'AI';
    const bodyHtml = role === 'assistant' ? formatMarkdownSafe(text) : `<p>${text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</p>`;

    row.innerHTML = `
      <div class="ho-msg-av">${avText}</div>
      <div class="ho-msg-bubble">
        <div class="ho-msg-content">${bodyHtml}</div>
        <div class="ho-msg-meta">
          <span>${nowStr}</span>
          ${role === 'assistant' ? `
            <div class="ho-msg-tools">
              <button type="button" class="ho-msg-tool-btn" onclick="copyBubbleText(this)">Copy</button>
              <button type="button" class="ho-msg-tool-btn" onclick="speakBubbleText(this)">Listen</button>
            </div>
          ` : ''}
        </div>
      </div>
    `;

    chatStream.insertBefore(row, thinkingRow);
    scrollToBottom();
  }

  async function postToAiBackend(userMessage) {
    const contextDigest = buildContextDigestString();
    const payload = {
      message: userMessage,
      prompt: userMessage,
      question: userMessage,
      context: contextDigest,
      activeContext,
      _csrf: csrfTokenStr
    };

    const candidateEndpoints = [
      '/ai-assistant/chat',
      '/ai-assistant/ask',
      '/ai-assistant/message',
      '/api/ai/chat',
      '/ai/chat'
    ];

    for (const url of candidateEndpoints) {
      try {
        const res = await fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'CSRF-Token': csrfTokenStr
          },
          body: JSON.stringify(payload)
        });
        if (res.ok) {
          const data = await res.json();
          const reply = data.reply || data.response || data.answer || data.message || (data.data && data.data.reply);
          if (reply) return reply;
        }
      } catch (_) {}
    }

    /* HonestGrounded Fallback Synthesis if offline or endpoint custom-named */
    const summaryParts = [];
    summaryParts.push(`Here is an informational overview grounded in your **HealthOrbit Vault** regarding **"${userMessage}"**:`);
    if (activeContext.reports && reportsData.length > 0) {
      const r = reportsData[0];
      const pList = r.topParams.map(p => `**${p.name}**: \`${p.value}${p.unit}\`${p.referenceRange ? ' (Ref: ' + p.referenceRange + ')' : ''}`).join(', ');
      summaryParts.push(`- **Latest Lab Report (${r.title} — ${r.dateStr}):** Contains ${r.paramCount} extracted measurements${pList ? ': ' + pList : '.'}`);
    }
    if (activeContext.medicines && medsData.length > 0) {
      summaryParts.push(`- **Active Prescriptions (${medsData.length}):** ${medsData.map(m => `**${m.name}** (${m.dosage},${m.frequency})`).join(', ')}.`);
    }
    if (activeContext.symptoms && symptomsData.length > 0) {
      summaryParts.push(`- **Recent Symptom Logs (${symptomsData.length}):** ${symptomsData.map(s => `**${s.symptom}** (${s.severity} on${s.dateStr})`).join(', ')}.`);
    }
    summaryParts.push(`- **Suggested Question for Your Physician:** *"Given my recorded parameters and current regimen, are any adjustments or follow-up evaluations recommended?"*`);
    return summaryParts.join('\n');
  }

  window.handleChatSubmit = async function (e) {
    if (e) e.preventDefault();
    const text = chatInput.value.trim();
    if (!text) return;

    chatInput.value = '';
    chatInput.style.height = 'auto';
    toggleMobileContextDock(false);

    appendMessageBubble('user', text);
    thinkingRow.classList.add('show');
    sendBtn.disabled = true;
    scrollToBottom();

    const reply = await postToAiBackend(text);
    thinkingRow.classList.remove('show');
    sendBtn.disabled = false;
    appendMessageBubble('assistant', reply);
  };

  window.sendPromptDirectly = function (promptText) {
    chatInput.value = promptText;
    handleChatSubmit();
  };

  /* ---- 6. Copy, Read Aloud (TTS), Voice Dictation (STT), Export & Reset ---- */
  window.copyBubbleText = function (btnEl) {
    const bubble = btnEl.closest('.ho-msg-bubble');
    const content = bubble ? bubble.querySelector('.ho-msg-content') : null;
    if (!content || !navigator.clipboard) return;
    navigator.clipboard.writeText(content.innerText.trim()).then(() => showToast('✔ Response copied to clipboard'));
  };

  window.speakBubbleText = function (btnEl) {
    if (!('speechSynthesis' in window)) {
      showToast('Speech synthesis not supported in this browser');
      return;
    }
    if (window.speechSynthesis.speaking) {
      window.speechSynthesis.cancel();
      btnEl.textContent = 'Listen';
      return;
    }
    const bubble = btnEl.closest('.ho-msg-bubble');
    const content = bubble ? bubble.querySelector('.ho-msg-content') : null;
    if (!content) return;
    const utter = new SpeechSynthesisUtterance(content.innerText.trim());
    utter.rate = 1.0;
    utter.onend = () => { btnEl.textContent = 'Listen'; };
    btnEl.textContent = 'Stop';
    window.speechSynthesis.speak(utter);
  };

  /* Voice Dictation */
  (function initVoiceDictation() {
    const micBtn = $('#voiceMicBtn'); const SpeechRec = window.SpeechRecognition \vert{}\vert{} window.webkitSpeechRecognition; if (!micBtn \vert{}\vert{} !SpeechRec) { if (micBtn) micBtn.style.display = 'none'; return; } const rec = new SpeechRec(); rec.lang = 'en-IN'; rec.interimResults = false; let listening = false;      micBtn.addEventListener('click', () => { if (listening) { rec.stop(); } else { try { rec.start(); listening = true; micBtn.classList.add('listening'); showToast('🎤 Listening... speak your question'); } catch (_) {} } }); rec.onresult = (e) => { const transcript = e.results[0][0].transcript; chatInput.value = (chatInput.value ? chatInput.value + ' ' : '') + transcript; chatInput.focus(); }; rec.onend = () => { listening = false; micBtn.classList.remove('listening'); }; })();    window.exportTranscript = function () { const rows = $$('#chatStream .ho-msg-row');
    if (rows.length === 0) {
      showToast('No messages to export yet');
      return;
    }
    const lines = rows.map(r => {
      const who = r.classList.contains('user') ? 'Patient' : 'HealthOrbit AI';
      const txt = r.querySelector('.ho-msg-content')?.innerText.trim() || '';
      return `[${who}]\n${txt}\n`;
    });
    const blob = new Blob([lines.join('\n-------------------\n')], { type: 'text/plain;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `HealthOrbit-AI-Consultation-${new Date().toISOString().slice(0,10)}.txt`;
    a.click();
    showToast('✔ Consultation transcript exported');
  };

  window.resetConversation = function () {
    $$('#chatStream .ho-msg-row').forEach(r => r.remove()); showToast('✔ Started a fresh consultation'); };    document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeCtxModal(); toggleMobileContextDock(false); } });    $$
('.ho-panel').forEach(p => {
    p.addEventListener('pointermove', e => {
      const r = p.getBoundingClientRect();
      p.style.setProperty('--mx', (e.clientX - r.left) + 'px');
      p.style.setProperty('--my', (e.clientY - r.top) + 'px');
    });
  });
</script>
</body>
</html>