        </div>
      </div>
    </section>

  </div>

<script src="/js/auth-portal.js"></script>

<!-- Mobile-only interaction enhancements (no effect on desktop) -->
<script>
(function () {
  var isMobile = function () { return window.matchMedia('(max-width: 768px)').matches; };

  // Show / hide password
  document.querySelectorAll('.m-eye').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var input = btn.parentElement.querySelector('input');
      var show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.classList.toggle('on', show);
      btn.textContent = show ? '🙈' : '👁';
      btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    });
  });

  // Ripple on primary buttons + light haptic tap
  document.querySelectorAll('.liquid-submit-btn').forEach(function (btn) {
    btn.addEventListener('pointerdown', function (e) {
      if (!isMobile()) return;
      var r = btn.getBoundingClientRect();
      var size = Math.max(r.width, r.height);
      var dot = document.createElement('span');
      dot.className = 'm-ripple';
      dot.style.width = dot.style.height = size + 'px';
      dot.style.left = (e.clientX - r.left - size / 2) + 'px';
      dot.style.top = (e.clientY - r.top - size / 2) + 'px';
      btn.appendChild(dot);
      setTimeout(function () { dot.remove(); }, 700);
      if (navigator.vibrate) navigator.vibrate(8);
    });
  });

  // Haptic tick when switching tabs
  ['tabLogin', 'tabSignup'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('click', function () {
      if (isMobile() && navigator.vibrate) navigator.vibrate(10);
    });
  });
})();
</script>
</body>
</html>