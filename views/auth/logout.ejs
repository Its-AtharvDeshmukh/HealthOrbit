<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/header', { title: 'HealthOrbit — Securely Signed Out' }) %>

  <style>
    /* 
    ==================================================================
      STRICTLY SCOPED CSS FOR PREMIUM SIGN-OUT UX
    ================================================================== 
    */
    :root {
      --ho-bg-airy: #edf6f4;
      --ho-teal-900: #0b5e55;
      --ho-teal-700: #0d7a6e;
      --ho-mint-400: #42b89d;
      --ho-coral: #e07a68;
      --ho-text-main: #0f1c1a;
      --ho-text-muted: #4e6b63;
      --ho-danger: #d94b4b;
      --ho-glass-clear: rgba(255, 255, 255, 0.65);
      --ho-glass-border: rgba(255, 255, 255, 0.95);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body, html {
      min-height: 100vh;
      width: 100vw;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
      background-color: var(--ho-bg-airy);
      color: var(--ho-text-main);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    .ho-logout-viewport {
      position: relative;
      z-index: 10;
      width: 100%;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    /* --- PREMIUM GLASS CARD --- */
    .ho-logout-card {
      background: var(--ho-glass-clear);
      backdrop-filter: blur(40px) saturate(200%);
      -webkit-backdrop-filter: blur(40px) saturate(200%);
      border: 1px solid var(--ho-glass-border);
      border-radius: 32px;
      padding: 3rem 2.5rem;
      width: 100%;
      max-width: 460px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      box-shadow: 0 25px 60px rgba(13, 122, 110, 0.12), inset 0 1px 0 rgba(255, 255, 255, 1);
      opacity: 0;
      animation: hoCardEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      overflow: hidden;
      position: relative;
    }

    @keyframes hoCardEntrance {
      from { opacity: 0; transform: translateY(40px) scale(0.95); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* --- BRAND DISPLAY & ANIMATED LOGO --- */
    .ho-brand-display {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.8rem;
      margin-bottom: 2.5rem;
    }

    .ho-brand-text {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 800;
      font-size: 1.6rem;
      color: var(--ho-teal-900);
      letter-spacing: -0.5px;
    }
    
    .ho-brand-text span {
      color: var(--ho-coral);
    }

    /* Animated Rings */
    .ho-logo-box {
      width: 28px;
      height: 28px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    
    .ho-ring-1 {
      position: absolute;
      inset: 0;
      border: 1.5px dashed var(--ho-teal-700);
      border-radius: 50%;
      animation: hoSpinSlow 12s linear infinite;
    }
    
    .ho-ring-2 {
      position: absolute;
      inset: -4px;
      border: 1.5px dashed var(--ho-coral);
      border-radius: 50%;
      animation: hoSpinFast 8s linear infinite reverse;
    }
    
    .ho-nucleus {
      width: 6px;
      height: 6px;
      background: #df2e0f;
      border-radius: 50%;
      box-shadow: 0 0 8px var(--ho-coral);
    }

    @keyframes hoSpinSlow { 100% { transform: rotate(360deg); } }
    @keyframes hoSpinFast { 100% { transform: rotate(360deg); } }

    /* --- UNIQUE ANIMATION: ORBIT TO SHIELD --- */
    .ho-security-anim-box {
      position: relative;
      width: 120px;
      height: 120px;
      margin-bottom: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Spinning Orbit Rings */
    .ho-orbit-spinner {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 3px dashed var(--ho-mint-400);
      animation: hoSpinCollapse 1.5s cubic-bezier(0.68, -0.55, 0.27, 1.55) forwards 0.5s;
      opacity: 0;
    }
    
    .ho-orbit-spinner-2 {
      position: absolute;
      inset: -10px;
      border-radius: 50%;
      border: 2px solid rgba(13, 122, 110, 0.2);
      border-top-color: var(--ho-teal-700);
      animation: hoSpinCollapseReverse 1.5s cubic-bezier(0.68, -0.55, 0.27, 1.55) forwards 0.5s;
      opacity: 0;
    }

    @keyframes hoSpinCollapse {
      0% { transform: rotate(0deg) scale(1.5); opacity: 0; }
      20% { opacity: 1; }
      100% { transform: rotate(360deg) scale(0.85); opacity: 0; }
    }
    
    @keyframes hoSpinCollapseReverse {
      0% { transform: rotate(0deg) scale(1.6); opacity: 0; }
      20% { opacity: 1; }
      100% { transform: rotate(-360deg) scale(0.7); opacity: 0; }
    }

    /* Glowing Shield that pops in after orbits collapse */
    .ho-shield-icon {
      width: 65px;
      height: 65px;
      background: linear-gradient(135deg, var(--ho-mint-400), var(--ho-teal-700));
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 30px rgba(66, 184, 157, 0.4);
      transform: scale(0);
      opacity: 0;
      animation: hoShieldPop 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards 1.6s;
      position: relative;
      z-index: 2;
    }
    
    .ho-shield-icon svg {
      width: 32px;
      height: 32px;
      color: #fff;
      stroke-width: 3;
      stroke-dasharray: 50;
      stroke-dashoffset: 50;
      animation: hoDrawCheck 0.6s ease forwards 2.2s;
    }

    @keyframes hoShieldPop {
      0% { transform: scale(0); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    
    @keyframes hoDrawCheck {
      to { stroke-dashoffset: 0; }
    }

    /* --- TYPOGRAPHY --- */
    .ho-logout-text-wrap {
      opacity: 0;
      transform: translateY(10px);
      animation: hoFadeUp 0.6s ease forwards 2s;
    }
    
    .ho-logout-card h2 {
      font-weight: 800;
      font-size: 1.6rem;
      color: var(--ho-teal-900);
      margin-bottom: 0.6rem;
      letter-spacing: -0.5px;
    }

    .ho-logout-card p {
      font-family: 'Inter', sans-serif;
      font-size: 0.95rem;
      color: var(--ho-text-muted);
      line-height: 1.6;
      margin-bottom: 2rem;
      font-weight: 500;
    }

    @keyframes hoFadeUp {
      to { opacity: 1; transform: translateY(0); }
    }

    /* --- LIQUID BUTTON & UX REDIRECT BAR --- */
    .ho-liquid-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 1rem 1.5rem;
      background: var(--ho-glass-solid);
      border: 1.5px solid var(--ho-glass-border);
      color: var(--ho-teal-900);
      border-radius: 16px;
      font-weight: 800;
      font-size: 1rem;
      text-decoration: none;
      box-shadow: 0 8px 20px rgba(0,0,0,0.03);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    .ho-liquid-btn:hover {
      background: #fff;
      transform: translateY(-3px);
      box-shadow: 0 12px 25px rgba(13, 122, 110, 0.1);
      border-color: var(--ho-teal-600);
    }
    
    .ho-liquid-btn:active { transform: scale(0.96); }

    /* Visual countdown progress bar */
    .ho-redirect-zone {
      margin-top: 1.5rem;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      opacity: 0;
      animation: hoFadeUp 0.6s ease forwards 2.5s;
    }

    .ho-redirect-text {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--ho-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .ho-progress-track {
      width: 100%;
      height: 6px;
      background: rgba(13, 122, 110, 0.1);
      border-radius: 999px;
      overflow: hidden;
    }
    
    .ho-progress-fill {
      height: 100%;
      background: var(--ho-coral);
      width: 100%;
      border-radius: 999px;
      animation: hoBarShrink 5s linear forwards 2.5s; 
    }

    @keyframes hoBarShrink {
      from { width: 100%; }
      to { width: 0%; background: var(--ho-danger); }
    }

    /* Mobile overrides */
    @media (max-width: 480px) {
      .ho-logout-viewport { padding: 1rem; }
      .ho-logout-card { padding: 2.5rem 1.5rem; border-radius: 28px; }
      .ho-logout-card h2 { font-size: 1.4rem; }
      .ho-brand-display { font-size: 1.4rem; margin-bottom: 2rem; }
    }
  </style>
</head>
<body>

  <!-- Global 3-Color Ambient Background -->
  <%- include('../partials/ambient') %>

  <div class="ho-logout-viewport">
    <div class="ho-logout-card">
      
      <!-- Properly Written Brand Logo (Consistent with Sidebar) -->
      <div class="ho-brand-display">
        <!-- Animated Orbit Logo -->
        <div class="ho-logo-box">
          <div class="ho-ring-1"></div>
          <div class="ho-ring-2"></div>
          <div class="ho-nucleus"></div>
        </div>

        <!-- Brand Text -->
        <div class="ho-brand-text">
          Health<span>Orbit</span>
        </div>
      </div>

      <!-- Unique "Orbit to Shield" Animation -->
      <div class="ho-security-anim-box">
        <div class="ho-orbit-spinner"></div>
        <div class="ho-orbit-spinner-2"></div>
        
        <div class="ho-shield-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
      </div>

      <!-- Sign Out Messaging -->
      <div class="ho-logout-text-wrap">
        <h2>Session Terminated</h2>
        <p>Your connection to the HealthOrbit network has been securely closed. Your medical telemetry and personal vault are locked.</p>
      </div>
      
      <!-- Redirect Area with Animated Bar -->
      <div class="ho-redirect-zone">
        <a href="/auth" class="ho-liquid-btn">Sign Back In</a>
        <span class="ho-redirect-text">Returning to portal in <span id="hoCountdownText">5</span>s</span>
        <div class="ho-progress-track">
          <div class="ho-progress-fill"></div>
        </div>
      </div>

    </div>
  </div>

  <!-- UX Script: Handles the text countdown and actual redirection -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // The animation takes 2.5 seconds to finish before the countdown starts.
      setTimeout(() => {
        let timeLeft = 5;
        const countdownEl = document.getElementById('hoCountdownText');
        
        const timer = setInterval(() => {
          timeLeft--;
          countdownEl.textContent = timeLeft;
          
          if (timeLeft <= 0) {
            clearInterval(timer);
            window.location.href = '/auth'; // Auto-redirect to Auth page
          }
        }, 1000);
      }, 2500); // 2.5s delay matches the CSS animation delays
    });
  </script>

</body>
</html>