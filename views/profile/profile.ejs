          <div class="ho-qr-text">
            <h4>Emergency Scan Code</h4>
            <p>Generates a secure QR containing only blood group, allergies, and emergency contacts.</p>
            <button class="ho-liquid-btn" style="padding: 0.5rem 1rem;">View Full Card</button>
          </div>
        </div>
      </section>

      <!-- 4. ACCOUNT SETTINGS -->
      <section class="ho-liquid-panel ho-panel-settings">
        <div class="ho-panel-header"><h2>Account Settings</h2></div>
        <div class="ho-settings-grid">
          
          <div class="ho-setting-card">
            <div class="ho-setting-icon">🔐</div>
            <div class="ho-setting-text">
              <strong>Security & 2FA</strong>
              <span>Password, Biometrics</span>
            </div>
          </div>
          
          <div class="ho-setting-card">
            <div class="ho-setting-icon">⌚</div>
            <div class="ho-setting-text">
              <strong>Connected Devices</strong>
              <span>Apple Health, Fitbit</span>
            </div>
          </div>
          
          <div class="ho-setting-card">
            <div class="ho-setting-icon">🔔</div>
            <div class="ho-setting-text">
              <strong>Notifications</strong>
              <span>Med reminders, alerts</span>
            </div>
          </div>
          
          <div class="ho-setting-card">
            <div class="ho-setting-icon">📥</div>
            <div class="ho-setting-text">
              <strong>Data Export</strong>
              <span>Download full timeline</span>
            </div>
          </div>

        </div>
      </section>

    </div>
  </main>
</div>

<!-- ==========================================
     EDIT PROFILE & FAMILY MODAL 
     (Clean, Solid White Interface)
=========================================== -->
<div class="ho-modal-overlay" id="hoEditProfileModal">
  <div class="ho-modal-box">
    
    <div class="ho-modal-head">
      <h3>Edit Profile & Family Network</h3>
      <button class="ho-modal-close" onclick="closeEditModal()">×</button>
    </div>
    
    <div class="ho-modal-body">
      <!-- Form submission hijacked by JS for smooth Toast feedback -->
      <form id="hoProfileForm" action="/profile" method="POST">
        
        <!-- Section 1: Personal Details -->
        <div class="ho-form-section">
          <h4 class="ho-section-title">👤 Basic Information</h4>
          <div class="ho-form-grid">
            <div class="ho-form-group" style="grid-column: span 2;">
              <label>Full Legal Name</label>
              <input type="text" name="fullName" class="ho-input" value="<%= locals.userName || 'Atharv Manoj Deshmukh' %>" required>
            </div>
            
            <div class="ho-form-group">
              <label>Phone Number</label>
              <input type="tel" name="phone" class="ho-input" placeholder="+91 ">
            </div>
            
            <div class="ho-form-group">
              <label>Email Address</label>
              <input type="email" name="email" class="ho-input" value="<%= locals.userEmail || 'atharv@healthorbit.com' %>">
            </div>
          </div>
        </div>

        <!-- Section 2: Medical Profile -->
        <div class="ho-form-section">
          <h4 class="ho-section-title">🏥 Medical Profile</h4>
          <div class="ho-form-grid">
            <div class="ho-form-group">
              <label>Age</label>
              <input type="number" name="age" class="ho-input" value="21" required>
            </div>
            
            <div class="ho-form-group">
              <label>Blood Group</label>
              <select name="bloodGroup" class="ho-input">
                <option value="O+">O+ (Positive)</option>
                <option value="O-">O- (Negative)</option>
                <option value="A+">A+ (Positive)</option>
                <option value="B+">B+ (Positive)</option>
                <option value="AB+">AB+ (Positive)</option>
              </select>
            </div>

            <div class="ho-form-group">
              <label>Height (cm)</label>
              <input type="number" name="height" class="ho-input" placeholder="e.g. 175">
            </div>

            <div class="ho-form-group">
              <label>Weight (kg)</label>
              <input type="number" name="weight" class="ho-input" placeholder="e.g. 70">
            </div>

            <div class="ho-form-group" style="grid-column: span 2;">
              <label>Known Allergies (Comma separated)</label>
              <input type="text" name="allergies" class="ho-input" placeholder="e.g. Penicillin, Peanuts...">
            </div>
          </div>
        </div>

        <!-- Section 3: Family Network & HoF -->
        <div class="ho-form-section" style="margin-bottom: 0;">
          <h4 class="ho-section-title">👨‍👩‍👧‍👦 Family Connections</h4>
          
          <!-- Head of Family Designation -->
          <div class="ho-form-group" style="margin-bottom: 1.5rem;">
            <label style="color: var(--ho-coral-accent);">Head of the Family (HoF)</label>
            <select name="headOfFamily" class="ho-input">
              <option value="self">Self (<%= locals.userName || 'Atharv Deshmukh' %>)</option>
              <option value="father">Father (Manoj Deshmukh)</option>
              <option value="mother">Mother</option>
            </select>
            <span style="font-size: 0.75rem; color: var(--ho-text-muted); margin-top: 0.4rem; line-height: 1.4;">
              The Head of the Family has overarching management rights to view synced reports and emergency data for linked accounts.
            </span>
          </div>

          <!-- Add New Member Box -->
          <div class="ho-add-member-box">
            <h5 style="font-size: 0.95rem; color: var(--ho-teal-900); margin-bottom: 0.8rem;">+ Add New Family Member</h5>
            <div class="ho-form-grid">
              <div class="ho-form-group">
                <label>Member Name</label>
                <input type="text" class="ho-input" placeholder="e.g. Rahul">
              </div>
              <div class="ho-form-group">
                <label>Relation</label>
                <select class="ho-input">
                  <option>Spouse</option>
                  <option>Child</option>
                  <option>Parent</option>
                  <option>Sibling</option>
                </select>
              </div>
            </div>
            <button type="button" class="ho-ghost-btn" style="width: 100%; margin-top: 1rem; padding: 0.75rem; border-style: dashed;">
              Generate & Send Invite Link
            </button>
          </div>
        </div>

      </form>
    </div>
    
    <div class="ho-modal-footer">
      <button class="ho-ghost-btn" onclick="closeEditModal()">Cancel</button>
      <button type="submit" form="hoProfileForm" id="saveProfileBtn" class="ho-liquid-btn">
        <span>Save Profile</span>
        <div class="ho-btn-sheen"></div>
      </button>
    </div>

  </div>
</div>

<!-- BEAUTIFUL TOAST NOTIFICATION -->
<div id="hoToast" class="ho-toast">
  <span style="font-size: 1.2rem;">✅</span> Profile updated successfully.
</div>

<script>
  // Modal Logic
  function openEditModal() {
    document.getElementById('hoEditProfileModal').style.display = 'flex';
  }

  function closeEditModal() {
    document.getElementById('hoEditProfileModal').style.display = 'none';
  }

  // Smooth form submission with Toast Feedback
  document.getElementById('hoProfileForm').addEventListener('submit', function(e) {
    e.preventDefault(); // Prevent instant reload
    
    const btn = document.getElementById('saveProfileBtn');
    const span = btn.querySelector('span');
    span.innerText = 'Saving...';
    btn.style.opacity = '0.8';
    
    // Show Toast
    const toast = document.getElementById('hoToast');
    toast.classList.add('show');
    
    // Close modal and actually submit the form after a slight delay for UX
    setTimeout(() => {
      closeEditModal();
      this.submit(); // Actually send POST to backend
    }, 1200);
  });
</script>

</body>
</html>