<!-- ADD FAMILY MEMBER MODAL -->
<div class="ho-modal" id="addFamilyModal" onclick="closeModal('addFamilyModal', event)">
  <div class="ho-modal-box" onclick="event.stopPropagation()">
    <div class="ho-modal-head">
      <h3>Add Family Member</h3>
      <button type="button" class="ho-modal-close" onclick="closeModal('addFamilyModal')">×</button>
    </div>
    <form method="POST" action="/family/add">
      <div class="ho-form-group">
        <label>Name</label>
        <input type="text" name="name" class="ho-input" placeholder="e.g. Rahul Deshmukh" required>
      </div>
