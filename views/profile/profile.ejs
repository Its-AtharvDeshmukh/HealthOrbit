            <rect x="10" y="60" width="30" height="30" fill="#0b5e55"/>
            <rect x="15" y="65" width="20" height="20" fill="#ffffff"/>
            <rect x="20" y="70" width="10" height="10" fill="#0b5e55"/>
            <rect x="50" y="50" width="10" height="10" fill="#0b5e55"/>
            <rect x="70" y="60" width="20" height="10" fill="#0b5e55"/>
            <rect x="60" y="80" width="30" height="10" fill="#0b5e55"/>
