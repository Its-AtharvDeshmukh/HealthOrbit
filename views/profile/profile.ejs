          <label>Email / Phone</label>
          <input type="text" name="contact" class="ho-input" placeholder="Contact details" required>
        </div>
      </div>

      <p style="font-size: 0.85rem; font-weight: 800; color: var(--ho-teal-900); margin-bottom: 1rem; border-bottom: 1px solid var(--ho-glass-border-subtle); padding-bottom: 0.5rem;">Select information this person can access</p>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; margin-bottom: 1.5rem;">
        <label style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; color: var(--ho-teal-900);"><input type="checkbox" name="permissions" value="emergencyInfo" style="width: 16px; height: 16px; accent-color: var(--ho-teal-600);"> Emergency Information</label>
        <label style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; color: var(--ho-teal-900);"><input type="checkbox" name="permissions" value="medicalReports" style="width: 16px; height: 16px; accent-color: var(--ho-teal-600);"> Medical Reports</label>
        <label style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; color: var(--ho-teal-900);"><input type="checkbox" name="permissions" value="healthSummary" style="width: 16px; height: 16px; accent-color: var(--ho-teal-600);"> Health Summary</label>
        <label style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; color: var(--ho-teal-900);"><input type="checkbox" name="permissions" value="medicines" style="width: 16px; height: 16px; accent-color: var(--ho-teal-600);"> Medicines</label>
        <label style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; color: var(--ho-teal-900);"><input type="checkbox" name="permissions" value="symptoms" style="width: 16px; height: 16px; accent-color: var(--ho-teal-600);"> Symptoms</label>
        <label style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; color: var(--ho-teal-900);"><input type="checkbox" name="permissions" value="insurance" style="width: 16px; height: 16px; accent-color: var(--ho-teal-600);"> Insurance</label>
        <label style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; color: var(--ho-teal-900);"><input type="checkbox" name="permissions" value="wearableData" style="width: 16px; height: 16px; accent-color: var(--ho-teal-600);"> Wearable Data</label>
        <label style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; color: var(--ho-teal-900);"><input type="checkbox" name="permissions" value="healthTimeline" style="width: 16px; height: 16px; accent-color: var(--ho-teal-600);"> Health Timeline</label>
      </div>

      <div style="display: flex; gap: 1rem;">
        <button type="button" class="ho-btn-ghost" style="flex: 1;" onclick="closeModal('addFamilyModal')">Cancel</button>
        <button type="submit" class="ho-btn-primary" style="flex: 1;">Send Authorization</button>
      </div>
    </form>
  </div>
</div>

<!-- MANAGE ACCESS MODAL (populated dynamically) -->
<div class="ho-modal" id="manageAccessModal" onclick="closeModal('manageAccessModal', event)">
  <div class="ho-modal-box" onclick="event.stopPropagation()">
    <div class="ho-modal-head">
      <h3>Manage Access</h3>
      <button type="button" class="ho-modal-close" onclick="closeModal('manageAccessModal')">×</button>
    </div>

    <div style="margin-bottom: 1.5rem; background: var(--ho-bg-airy); padding: 1rem; border-radius: 12px;">
      <strong id="maName" style="display: block; font-size: 1.1rem; color: var(--ho-teal-900);"></strong>
      <span id="maRelationship" style="font-size: 0.85rem; color: var(--ho-text-muted); font-weight: 500;"></span>
    </div>

    <p style="font-size: 0.85rem; font-weight: 800; color: var(--ho-teal-900); margin-bottom: 1rem; border-bottom: 1px solid var(--ho-glass-border-subtle); padding-bottom: 0.5rem;">Access Permissions</p>

    <form id="manageAccessForm" method="POST" action="/family//permissions">
      <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 2rem;">
        <div class="ho-perm-row">
          <div class="ho-perm-info"><strong>Emergency Information</strong><span>Critical contacts, blood group, allergies</span></div>
          <label class="ho-toggle"><input type="checkbox" name="permissions" value="emergencyInfo" id="perm-emergencyInfo"><span class="ho-toggle-slider"></span></label>
        </div>
        <div class="ho-perm-row">
          <div class="ho-perm-info"><strong>Medical Reports</strong><span>OCR extractions and PDF files</span></div>
          <label class="ho-toggle"><input type="checkbox" name="permissions" value="medicalReports" id="perm-medicalReports"><span class="ho-toggle-slider"></span></label>
        </div>
        <div class="ho-perm-row">
          <div class="ho-perm-info"><strong>Medicines</strong><span>Active prescriptions and reminders</span></div>
          <label class="ho-toggle"><input type="checkbox" name="permissions" value="medicines" id="perm-medicines"><span class="ho-toggle-slider"></span></label>
        </div>
        <div class="ho-perm-row">
          <div class="ho-perm-info"><strong>Health Summary</strong><span>Composite scores and general overview</span></div>
          <label class="ho-toggle"><input type="checkbox" name="permissions" value="healthSummary" id="perm-healthSummary"><span class="ho-toggle-slider"></span></label>
        </div>
        <div class="ho-perm-row">
          <div class="ho-perm-info"><strong>Wearable Data</strong><span>Heart rate, sleep, steps, activity</span></div>
          <label class="ho-toggle"><input type="checkbox" name="permissions" value="wearableData" id="perm-wearableData"><span class="ho-toggle-slider"></span></label>
        </div>
        <div class="ho-perm-row">
          <div class="ho-perm-info"><strong>Insurance</strong><span>Policy documents and claims</span></div>
          <label class="ho-toggle"><input type="checkbox" name="permissions" value="insurance" id="perm-insurance"><span class="ho-toggle-slider"></span></label>
        </div>
        <div class="ho-perm-row">
          <div class="ho-perm-info"><strong>Symptoms</strong><span>Logged symptoms and health events</span></div>
          <label class="ho-toggle"><input type="checkbox" name="permissions" value="symptoms" id="perm-symptoms"><span class="ho-toggle-slider"></span></label>
        </div>
        <div class="ho-perm-row">
          <div class="ho-perm-info"><strong>Health Timeline</strong><span>Full longitudinal health history</span></div>
          <label class="ho-toggle"><input type="checkbox" name="permissions" value="healthTimeline" id="perm-healthTimeline"><span class="ho-toggle-slider"></span></label>
        </div>
      </div>

      <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
        <button type="button" class="ho-btn-ghost" style="flex: 1; min-width: 100px;" onclick="closeModal('manageAccessModal')">Cancel</button>
        <button type="submit" class="ho-btn-primary" style="flex: 1; min-width: 140px;">Save Permissions</button>
      </div>
    </form>
  </div>
</div>

<!-- DELETE ACCOUNT CONFIRMATION MODAL -->
<div class="ho-modal" id="deleteAccountModal" onclick="closeModal('deleteAccountModal', event)">
  <div class="ho-modal-box" style="max-width: 450px; text-align: center;" onclick="event.stopPropagation()">
    <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
    <h3 style="font-size: 1.4rem; font-weight: 800; color: var(--ho-teal-900); margin-bottom: 0.5rem;">Delete Account?</h3>
    <p style="font-size: 0.95rem; color: var(--ho-text-muted); line-height: 1.5; margin-bottom: 1rem; font-weight: 500;">Are you sure you want to delete your HealthOrbit account?</p>
    <p style="font-size: 0.85rem; color: var(--ho-danger); font-weight: 700; background: var(--ho-coral-soft); padding: 0.8rem; border-radius: 10px; margin-bottom: 2rem;">Warning: This permanently deletes your reports, measurements, family access records, and account. This cannot be undone.</p>

    <form method="POST" action="/account/delete">
      <div style="display: flex; gap: 1rem;">
        <button type="button" class="ho-btn-ghost" style="flex: 1;" onclick="closeModal('deleteAccountModal')">Cancel</button>
        <button type="submit" class="ho-btn-danger" style="flex: 1;">Delete Account</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openModal(id) {
    const modal = document.getElementById(id);
    modal.style.display = 'flex';
    setTimeout(() => modal.classList.add('active'), 10);
  }
  function closeModal(id, e) {
    if (!e || e.target === document.getElementById(id) || e.target.classList.contains('ho-modal-close') || (e.target.tagName === 'BUTTON' && e.target.type === 'button')) {
      const modal = document.getElementById(id);
      modal.classList.remove('active');
      setTimeout(() => modal.style.display = 'none', 300);
    }
  }

  // Populate + open the "Manage Access" modal for a specific family member
  function openManageAccess(memberId, name, relationship, permissions) {
    document.getElementById('maName').textContent = name;
    document.getElementById('maRelationship').textContent = 'Relationship: ' + relationship;
    document.getElementById('manageAccessForm').action = '/family/' + memberId + '/permissions';

    const keys = ['emergencyInfo','medicalReports','medicines','healthSummary','wearableData','insurance','symptoms','healthTimeline'];
    keys.forEach(function(k) {
      const el = document.getElementById('perm-' + k);
      if (el) el.checked = !!permissions[k];
    });

    openModal('manageAccessModal');
  }

  // Auto-dismiss the success toast, if present
  (function() {
    const toast = document.getElementById('serverToast');
    if (toast) setTimeout(() => toast.classList.remove('show'), 3000);
  })();
</script>

</body>
</html>