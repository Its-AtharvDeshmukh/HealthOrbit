<!-- views/partials/sidebar.ejs -->
<style>
/* ==========================================================
   HEALTHORBIT - DESKTOP SIDEBAR & MOBILE ISLAND
   ========================================================== */
:root {
  --ho-sidebar-bg: rgba(255, 255, 255, 0.65);
  --ho-sidebar-border: rgba(255, 255, 255, 0.9);
  --ho-primary: #0b5e55;
  --ho-primary-hover: rgba(13, 122, 110, 0.08);
  --ho-alert: #d94b4b;
  --ho-alert-hover: rgba(217, 75, 75, 0.1);
  --ho-text: #4e6b63;
}

/* Base Desktop Sidebar */
.ho-sidebar-root {
  width: 78px;
  height: calc(100vh - 2.5rem);
  position: sticky;
  top: 1.25rem; left: 1.25rem; margin-bottom: 1.25rem;
  background: var(--ho-sidebar-bg);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border: 1.5px solid var(--ho-sidebar-border);
  border-radius: 24px;
  display: flex; flex-direction: column; flex-shrink: 0; z-index: 100;
  overflow: hidden;
  transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, background 0.4s ease;
  box-shadow: 0 10px 30px rgba(13, 122, 110, 0.04);
}
.ho-sidebar-root:hover { width: 270px; background: rgba(255, 255, 255, 0.95); box-shadow: 0 20px 50px rgba(13, 122, 110, 0.12); }

/* Header & 3-Circle Logo */
.ho-sb-header { display: flex; align-items: center; height: 80px; padding: 0 22px; border-bottom: 1px solid rgba(13, 122, 110, 0.08); white-space: nowrap; flex-shrink: 0; }
.ho-logo-box { width: 32px; height: 32px; position: relative; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transform: scale(0.9); transform-origin: left center; }

/* 1. ANIMATION FIX: Green Clockwise, Orange Anti-Clockwise */
.ho-ring-1 { position: absolute; inset: 0; border: 1.5px dashed #0d7a6e; border-radius: 50%; animation: hoSpin 12s linear infinite; }
.ho-ring-2 { position: absolute; inset: -4px; border: 1.5px dashed #e07a68; border-radius: 50%; animation: hoSpinAnti 8s linear infinite; } /* Anti-clockwise */
.ho-nucleus { width: 7px; height: 7px; background: #df2e0f; border-radius: 50%; box-shadow: 0 0 8px #e07a68; }

@keyframes hoSpin { 100% { transform: rotate(360deg); } }
@keyframes hoSpinAnti { 100% { transform: rotate(-360deg); } }

.ho-brand-title { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 1.25rem; color: var(--ho-primary); margin-left: 14px; opacity: 0; transform: translateX(-10px); transition: all 0.3s ease; }
.ho-sidebar-root:hover .ho-brand-title { opacity: 1; transform: translateX(0); }
.ho-brand-highlight { color: #e07a68; }

/* Navigation Links */
.ho-nav-links { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 1rem 12px; display: flex; flex-direction: column; gap: 4px; scrollbar-width: none; }
.ho-nav-links::-webkit-scrollbar { display: none; }
.ho-nav-category { font-size: 0.65rem; font-weight: 700; color: var(--ho-text); text-transform: uppercase; margin: 12px 0 4px 12px; opacity: 0; white-space: nowrap; transition: opacity 0.2s ease; }
.ho-sidebar-root:hover .ho-nav-category { opacity: 1; }
.ho-nav-category:first-child { margin-top: 0; }

.ho-nav-links a { display: flex; align-items: center; height: 44px; padding: 0 14px; border-radius: 12px; text-decoration: none; color: var(--ho-text); font-weight: 600; font-size: 0.9rem; transition: all 0.2s ease; white-space: nowrap; }
.ho-nav-links a .icon { display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; flex-shrink: 0; }
.ho-nav-links a .icon svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.2s; }
.ho-nav-links a .link-text { margin-left: 14px; opacity: 0; transition: opacity 0.3s ease; }

.ho-sidebar-root:hover .ho-nav-links a .link-text { opacity: 1; }
.ho-nav-links a:hover:not(.active) { background: rgba(0,0,0,0.03); color: var(--ho-primary); }
.ho-nav-links a:hover .icon svg { transform: scale(1.1); }
.ho-nav-links a.active { background: var(--ho-primary-hover); color: #0d7a6e; }
.ho-nav-links a.active .icon svg { stroke-width: 2.5; }

/* Premium AI Button */
.ho-nav-links a.ho-nav-ai { color: #d97706; }
.ho-nav-links a.ho-nav-ai:hover { background: rgba(245, 158, 11, 0.1); }

/* EMERGENCY RED LINK */
.ho-nav-links a.ho-emergency-link { color: var(--ho-alert); }
.ho-nav-links a.ho-emergency-link:hover { background: var(--ho-alert-hover); }

/* Desktop Footer: Hover to Sign Out */
.ho-sb-footer { padding: 12px; border-top: 1px solid rgba(13, 122, 110, 0.08); }
.ho-user-box { display: flex; align-items: center; gap: 0.75rem; height: 48px; padding: 0 8px; border-radius: 12px; text-decoration: none; color: inherit; transition: background 0.2s ease; position: relative; cursor: pointer; overflow: hidden; }
.ho-user-box:hover { background: var(--ho-alert-hover); }
.ho-user-av { width: 32px; height: 32px; border-radius: 50%; background: var(--ho-primary); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.8rem; flex-shrink: 0; }
.ho-user-meta { display: flex; flex-direction: column; transition: opacity 0.2s ease; white-space: nowrap; opacity: 0; }
.ho-sidebar-root:hover .ho-user-meta { opacity: 1; }
.ho-user-box:hover .ho-user-meta { opacity: 0; }
.ho-user-meta strong { font-size: 0.85rem; color: var(--ho-primary); }
.ho-user-meta span { font-size: 0.68rem; color: var(--ho-text); font-weight: 600; }

.ho-signout-overlay { position: absolute; left: 3.5rem; display: flex; align-items: center; gap: 0.6rem; color: var(--ho-alert); font-weight: 700; font-size: 0.9rem; opacity: 0; transform: translateX(-10px); transition: all 0.2s ease; pointer-events: none; }
.ho-signout-overlay svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
.ho-user-box:hover .ho-signout-overlay { opacity: 1; transform: translateX(0); pointer-events: auto; }

@media (max-width: 1024px) { .ho-sidebar-root { display: none !important; } }

/* ==================== MOBILE FLOATING ISLAND ==================== */
.ho-m-island, .ho-m-backdrop { display: none; }

@media (max-width: 1024px) {
  body { height: auto !important; overflow-y: auto !important; overflow-x: hidden !important; }
  .ho-app-layout { flex-direction: column !important; width: 100% !important; min-height: 100vh !important; overflow: visible !important; }
  .ho-main-content { margin-left: 0 !important; padding: 5.4rem 1.25rem 3rem !important; height: auto !important; overflow: visible !important; }
  .ho-topbar { display: none !important; } 

  .ho-m-island { display: flex; position: fixed; top: 0.85rem; left: 0.85rem; right: 0.85rem; z-index: 2000; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(30px) saturate(200%); -webkit-backdrop-filter: blur(30px) saturate(200%); border: 1px solid rgba(255, 255, 255, 0.95); border-radius: 22px; box-shadow: 0 6px 24px rgba(0, 0, 0, 0.04); flex-direction: column; overflow: hidden; max-height: 52px; transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, background 0.3s ease; }
  .ho-m-island.open { max-height: 85vh; background: rgba(255, 255, 255, 0.98); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15); overflow-y: auto; }
  .ho-m-collapsed-row { display: flex; align-items: center; justify-content: space-between; height: 50px; padding: 0 0.85rem; flex-shrink: 0; }
  .ho-m-brand { display: flex; align-items: center; gap: 0.55rem; text-decoration: none; }
  .ho-m-brand .ho-logo-box { transform: scale(0.8); }
  .ho-m-brand-title { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 1.05rem; color: var(--ho-primary); letter-spacing: -0.3px; }
  .ho-m-brand-title .hl { color: #e07a68; }

  /* MOBILE TOP QUICK ACTIONS */
  .ho-m-right-actions { display: flex; align-items: center; gap: 0.4rem; flex-shrink: 0; }
  .ho-m-quick-btn { display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 10px; text-decoration: none; transition: transform 0.2s; }
  .ho-m-quick-btn:active { transform: scale(0.9); }
  .ho-m-emergency-btn { color: var(--ho-alert); background: rgba(217, 75, 75, 0.1); }
  .ho-m-ai-btn { color: #d97706; background: rgba(245, 158, 11, 0.15); }
  .ho-m-quick-btn svg { width: 18px; height: 18px; stroke-width: 2.5; stroke: currentColor; fill: none; }

  .ho-m-toggle { width: 34px; height: 34px; border-radius: 10px; border: none; background: rgba(13, 122, 110, 0.06); display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--ho-primary); transition: transform 0.3s ease; }
  .ho-m-island.open .ho-m-toggle { transform: rotate(180deg); background: rgba(13, 122, 110, 0.12); }

  .ho-m-full-links { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.4rem 0.8rem 0.8rem; }
  .ho-m-category { font-size: 0.7rem; font-weight: 700; color: var(--ho-text); text-transform: uppercase; margin: 12px 0 4px 8px; }
  .ho-m-category:first-child { margin-top: 4px; }
  .ho-m-full-links a { display: flex; align-items: center; height: 46px; padding: 0 12px; border-radius: 12px; text-decoration: none; color: var(--ho-text); font-weight: 600; font-size: 0.95rem; }
  .ho-m-full-links a .icon { width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; margin-right: 12px; color: var(--ho-text); }
  .ho-m-full-links a .icon svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; }
  
  .ho-m-full-links a.active { background: var(--ho-primary-hover); color: var(--ho-primary); }
  .ho-m-full-links a.active .icon { color: var(--ho-primary); }
  .ho-m-full-links a.ho-nav-ai { color: #d97706; }
  .ho-m-full-links a.ho-nav-ai .icon { color: #d97706; }
  .ho-m-full-links a.ho-emergency-link { color: var(--ho-alert); }
  .ho-m-full-links a.ho-emergency-link .icon { color: var(--ho-alert); }

  .ho-m-full-footer { display: flex; align-items: center; padding: 1rem; border-top: 1px solid rgba(13, 122, 110, 0.08); }
  .ho-m-user-av { width: 36px; height: 36px; border-radius: 50%; background: var(--ho-primary); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem; flex-shrink: 0; }
  .ho-m-user-meta { flex: 1; margin-left: 12px; }
  .ho-m-user-meta strong { display: block; font-size: 0.9rem; color: var(--ho-primary); }
  .ho-m-user-meta span { font-size: 0.7rem; color: var(--ho-text); font-weight: 600; }
  .ho-m-signout { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--ho-alert); background: var(--ho-alert-hover); text-decoration: none; }
  .ho-m-signout svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }

  .ho-m-backdrop { display: block; position: fixed; inset: 0; background: rgba(11, 94, 85, 0.35); backdrop-filter: blur(4px); z-index: 1500; opacity: 0; visibility: hidden; transition: opacity 0.3s ease; }
  .ho-m-backdrop.show { opacity: 1; visibility: visible; }
}
</style>

