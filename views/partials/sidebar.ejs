<!-- views/partials/sidebar.ejs -->
<style>
/* ==========================================================
   HEALTHORBIT — DESKTOP SIDEBAR & MOBILE ISLAND
   Palette matches the rest of the app (chat, drawers, etc.)
   ========================================================== */
:root {
  --ho-sidebar-bg: rgba(255, 255, 255, 0.68);
  --ho-sidebar-bg-hover: rgba(255, 255, 255, 0.97);
  --ho-sidebar-border: rgba(255, 255, 255, 0.9);
  --ho-primary: #0b5e55;
  --ho-primary-dim: #0d7a6e;
  --ho-primary-hover: rgba(13, 122, 110, 0.09);
  --ho-mint: #42b89d;
  --ho-coral: #e07a68;
  --ho-coral-deep: #d1604c;
  --ho-amber: #d97706;
  --ho-alert: #d94b4b;
  --ho-alert-hover: rgba(217, 75, 75, 0.1);
  --ho-text: #4e6b63;
  --ho-text-dim: #8aa39c;
}

/* ==================================================================
   DESKTOP SIDEBAR — floating glass rail, expands on hover
================================================================== */
.ho-sidebar-root {
  width: 76px;
  height: calc(100vh - 2.5rem);
  position: sticky;
  top: 1.25rem; left: 1.25rem; margin-bottom: 1.25rem;
  background: var(--ho-sidebar-bg);
  backdrop-filter: blur(26px) saturate(180%);
  -webkit-backdrop-filter: blur(26px) saturate(180%);
  border: 1.5px solid var(--ho-sidebar-border);
  border-radius: 26px;
  display: flex; flex-direction: column; flex-shrink: 0; z-index: 100;
  overflow: hidden;
  transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, background 0.4s ease;
  box-shadow: 0 10px 32px rgba(11, 94, 85, 0.06);
}
.ho-sidebar-root:hover { width: 264px; background: var(--ho-sidebar-bg-hover); box-shadow: 0 24px 56px rgba(11, 94, 85, 0.14); }

/* Header — animated orbit logo */
.ho-sb-header { display: flex; align-items: center; height: 78px; padding: 0 21px; flex-shrink: 0; }
.ho-logo-box { width: 30px; height: 30px; position: relative; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.ho-ring-1 { position: absolute; inset: 0; border: 1.5px dashed var(--ho-primary-dim); border-radius: 50%; animation: hoSpin 12s linear infinite; }
.ho-ring-2 { position: absolute; inset: -4px; border: 1.5px dashed var(--ho-coral); border-radius: 50%; animation: hoSpinAnti 8s linear infinite; }
.ho-nucleus { width: 7px; height: 7px; background: var(--ho-coral-deep); border-radius: 50%; box-shadow: 0 0 9px var(--ho-coral); }
@keyframes hoSpin { 100% { transform: rotate(360deg); } }
@keyframes hoSpinAnti { 100% { transform: rotate(-360deg); } }

.ho-brand-title { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 1.2rem; color: var(--ho-primary); margin-left: 14px; opacity: 0; transform: translateX(-8px); transition: all 0.3s ease; white-space: nowrap; }
.ho-sidebar-root:hover .ho-brand-title { opacity: 1; transform: translateX(0); }
.ho-brand-highlight { color: var(--ho-coral); }

/* Divider under header — a soft gradient line instead of a hard rule */
.ho-sb-header { border-bottom: 1px solid transparent; background-image: linear-gradient(to right, rgba(13,122,110,0.12), transparent 85%); background-repeat: no-repeat; background-position: bottom; background-size: 100% 1px; }

/* Navigation */
.ho-nav-links { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 0.9rem 11px; display: flex; flex-direction: column; gap: 3px; scrollbar-width: none; }
.ho-nav-links::-webkit-scrollbar { display: none; }
.ho-nav-category { font-size: 0.64rem; font-weight: 800; color: var(--ho-text-dim); text-transform: uppercase; letter-spacing: 0.07em; margin: 14px 0 5px 13px; opacity: 0; white-space: nowrap; transition: opacity 0.2s ease; }
.ho-sidebar-root:hover .ho-nav-category { opacity: 1; }
.ho-nav-category:first-child { margin-top: 2px; }

.ho-nav-links a {
  position: relative; display: flex; align-items: center; height: 44px; padding: 0 13px;
  border-radius: 13px; text-decoration: none; color: var(--ho-text); font-weight: 650; font-size: 0.89rem;
  transition: background 0.2s ease, color 0.2s ease; white-space: nowrap;
}
.ho-nav-links a .icon { display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; flex-shrink: 0; }
.ho-nav-links a .icon svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.2s; }
.ho-nav-links a .link-text { margin-left: 13px; opacity: 0; transition: opacity 0.3s ease; }
.ho-sidebar-root:hover .ho-nav-links a .link-text { opacity: 1; }

.ho-nav-links a:hover:not(.active) { background: rgba(11, 94, 85, 0.045); color: var(--ho-primary); }
.ho-nav-links a:hover .icon svg { transform: scale(1.1); }

/* Active state: soft fill + left accent bar (shows even collapsed) */
.ho-nav-links a.active { background: var(--ho-primary-hover); color: var(--ho-primary-dim); font-weight: 750; }
.ho-nav-links a.active::before {
  content: ''; position: absolute; left: -11px; top: 50%; transform: translateY(-50%);
  width: 4px; height: 20px; border-radius: 0 4px 4px 0; background: var(--ho-primary-dim);
}
.ho-nav-links a.active .icon svg { stroke-width: 2.4; }

/* Premium AI link */
.ho-nav-links a.ho-nav-ai { color: var(--ho-amber); }
.ho-nav-links a.ho-nav-ai:hover, .ho-nav-links a.ho-nav-ai.active { background: rgba(217, 119, 6, 0.1); }
.ho-nav-links a.ho-nav-ai.active::before { background: var(--ho-amber); }

/* Emergency link — always slightly warm, with a live pulse dot */
.ho-nav-links a.ho-emergency-link { color: var(--ho-alert); }
.ho-nav-links a.ho-emergency-link:hover, .ho-nav-links a.ho-emergency-link.active { background: var(--ho-alert-hover); }
.ho-nav-links a.ho-emergency-link.active::before { background: var(--ho-alert); }
.ho-emergency-link .icon { position: relative; }
.ho-emergency-link .icon::after {
  content: ''; position: absolute; top: -1px; right: -1px; width: 7px; height: 7px; border-radius: 50%;
  background: var(--ho-alert); box-shadow: 0 0 0 2px #fff; animation: hoPulseDot 2.2s ease-in-out infinite;
}
@keyframes hoPulseDot { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.55; transform: scale(0.85); } }

/* Footer — avatar, hover-to-sign-out */
.ho-sb-footer { padding: 11px; margin: 4px 0 0; }
.ho-sb-footer { border-top: 1px solid transparent; background-image: linear-gradient(to right, rgba(13,122,110,0.12), transparent 85%); background-repeat: no-repeat; background-position: top; background-size: 100% 1px; }
.ho-user-box { display: flex; align-items: center; gap: 0.75rem; height: 50px; padding: 0 7px; border-radius: 13px; text-decoration: none; color: inherit; transition: background 0.2s ease; position: relative; cursor: pointer; overflow: hidden; }
.ho-user-box:hover { background: var(--ho-alert-hover); }
.ho-user-av { width: 33px; height: 33px; border-radius: 50%; background: linear-gradient(135deg, var(--ho-primary-dim), var(--ho-primary)); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.78rem; flex-shrink: 0; box-shadow: 0 3px 10px rgba(11,94,85,0.22); }
.ho-user-meta { display: flex; flex-direction: column; transition: opacity 0.2s ease; white-space: nowrap; opacity: 0; }
.ho-sidebar-root:hover .ho-user-meta { opacity: 1; }
.ho-user-box:hover .ho-user-meta { opacity: 0; }
.ho-user-meta strong { font-size: 0.84rem; color: var(--ho-primary); }
.ho-user-meta span { font-size: 0.67rem; color: var(--ho-text); font-weight: 600; }

.ho-signout-overlay { position: absolute; left: 3.4rem; display: flex; align-items: center; gap: 0.55rem; color: var(--ho-alert); font-weight: 750; font-size: 0.88rem; opacity: 0; transform: translateX(-8px); transition: all 0.2s ease; pointer-events: none; white-space: nowrap; }
.ho-signout-overlay svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
.ho-user-box:hover .ho-signout-overlay { opacity: 1; transform: translateX(0); pointer-events: auto; }

@media (max-width: 1024px) { .ho-sidebar-root { display: none !important; } }

/* ==================================================================
   MOBILE FLOATING ISLAND
================================================================== */
.ho-m-island, .ho-m-backdrop { display: none; }

@media (max-width: 1024px) {
  body { height: auto !important; overflow-y: auto !important; overflow-x: hidden !important; }
  .ho-app-layout { flex-direction: column !important; width: 100% !important; min-height: 100vh !important; overflow: visible !important; }
  .ho-main-content { margin-left: 0 !important; padding: 5.4rem 1.25rem 3rem !important; height: auto !important; overflow: visible !important; }
  .ho-topbar { display: none !important; }

  .ho-m-island {
    display: flex; position: fixed; top: 0.85rem; left: 0.85rem; right: 0.85rem; z-index: 2000;
    background: rgba(255, 255, 255, 0.86); backdrop-filter: blur(32px) saturate(200%); -webkit-backdrop-filter: blur(32px) saturate(200%);
    border: 1px solid rgba(255, 255, 255, 0.95); border-radius: 24px; box-shadow: 0 6px 24px rgba(11,94,85,0.07);
    flex-direction: column; overflow: hidden; max-height: 54px;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, background 0.3s ease;
  }
  .ho-m-island.open { max-height: 85vh; background: rgba(255, 255, 255, 0.98); box-shadow: 0 20px 54px rgba(11,94,85,0.18); overflow-y: auto; }

  .ho-m-collapsed-row { display: flex; align-items: center; justify-content: space-between; height: 52px; padding: 0 0.85rem; flex-shrink: 0; }
  .ho-m-brand { display: flex; align-items: center; gap: 0.55rem; text-decoration: none; }
  .ho-m-brand .ho-logo-box { transform: scale(0.82); }
  .ho-m-brand-title { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 1.05rem; color: var(--ho-primary); letter-spacing: -0.3px; }
  .ho-m-brand-title .hl { color: var(--ho-coral); }

  .ho-m-right-actions { display: flex; align-items: center; gap: 0.4rem; flex-shrink: 0; }
  .ho-m-quick-btn { display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 11px; text-decoration: none; transition: transform 0.15s ease, filter 0.15s ease; }
  .ho-m-quick-btn:active { transform: scale(0.9); }
  .ho-m-emergency-btn { color: var(--ho-alert); background: var(--ho-alert-hover); }
  .ho-m-ai-btn { color: var(--ho-amber); background: rgba(217, 119, 6, 0.13); }
  .ho-m-quick-btn svg { width: 18px; height: 18px; stroke-width: 2.5; stroke: currentColor; fill: none; }

  .ho-m-toggle { width: 34px; height: 34px; border-radius: 11px; border: none; background: rgba(13, 122, 110, 0.07); display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--ho-primary); transition: transform 0.3s ease, background 0.2s ease; }
  .ho-m-island.open .ho-m-toggle { transform: rotate(180deg); background: rgba(13, 122, 110, 0.14); }

  /* Grouped "card" sections instead of one long flat list — easier to scan */
  .ho-m-full-links { display: flex; flex-direction: column; gap: 0.9rem; padding: 0.5rem 0.85rem 0.9rem; }
  .ho-m-group { background: rgba(13, 122, 110, 0.035); border: 1px solid rgba(13, 122, 110, 0.08); border-radius: 16px; padding: 0.4rem; }
  .ho-m-category { font-size: 0.68rem; font-weight: 800; color: var(--ho-text-dim); text-transform: uppercase; letter-spacing: 0.06em; margin: 0.45rem 0 0.35rem 0.55rem; }

  .ho-m-full-links a { display: flex; align-items: center; height: 46px; padding: 0 10px; border-radius: 12px; text-decoration: none; color: var(--ho-text); font-weight: 650; font-size: 0.93rem; transition: background 0.15s ease; }
  .ho-m-full-links a:active { background: rgba(13, 122, 110, 0.07); }
  .ho-m-full-links a .icon { width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; margin-right: 12px; color: var(--ho-text); flex-shrink: 0; }
  .ho-m-full-links a .icon svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 2; }

  .ho-m-full-links a.active { background: var(--ho-primary-hover); color: var(--ho-primary-dim); font-weight: 750; }
  .ho-m-full-links a.active .icon { color: var(--ho-primary-dim); }
  .ho-m-full-links a.ho-nav-ai { color: var(--ho-amber); }
  .ho-m-full-links a.ho-nav-ai .icon { color: var(--ho-amber); }
  .ho-m-full-links a.ho-emergency-link { color: var(--ho-alert); }
  .ho-m-full-links a.ho-emergency-link .icon { color: var(--ho-alert); position: relative; }
  .ho-m-full-links a.ho-emergency-link .icon::after {
    content: ''; position: absolute; top: -1px; right: -1px; width: 7px; height: 7px; border-radius: 50%;
    background: var(--ho-alert); box-shadow: 0 0 0 2px #fff; animation: hoPulseDot 2.2s ease-in-out infinite;
  }

  .ho-m-full-footer { display: flex; align-items: center; padding: 0.9rem 1rem 1.1rem; }
  .ho-m-user-av { width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--ho-primary-dim), var(--ho-primary)); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem; flex-shrink: 0; box-shadow: 0 3px 10px rgba(11,94,85,0.22); }
  .ho-m-user-meta { flex: 1; margin-left: 12px; }
  .ho-m-user-meta strong { display: block; font-size: 0.9rem; color: var(--ho-primary); }
  .ho-m-user-meta span { font-size: 0.7rem; color: var(--ho-text); font-weight: 600; }
  .ho-m-signout { width: 40px; height: 40px; border-radius: 11px; display: flex; align-items: center; justify-content: center; color: var(--ho-alert); background: var(--ho-alert-hover); text-decoration: none; transition: background 0.15s ease; }
  .ho-m-signout:active { background: rgba(217, 75, 75, 0.2); }
  .ho-m-signout svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }

  .ho-m-backdrop { display: block; position: fixed; inset: 0; background: rgba(11, 94, 85, 0.35); backdrop-filter: blur(4px); z-index: 1500; opacity: 0; visibility: hidden; transition: opacity 0.3s ease; }
  .ho-m-backdrop.show { opacity: 1; visibility: visible; }
}
</style>

<!-- ==================== DESKTOP SIDEBAR ==================== -->
<aside class="ho-sidebar-root" id="sidebar" aria-label="Main Navigation">
  <div class="ho-sb-header">
    <div class="ho-logo-box" aria-hidden="true">
      <div class="ho-ring-1"></div>
      <div class="ho-ring-2"></div>
      <div class="ho-nucleus"></div>
    </div>
    <div class="ho-brand-title">Health<span class="ho-brand-highlight">Orbit</span></div>
  </div>

  <nav class="ho-nav-links" aria-label="Desktop Navigation">
    <div class="ho-nav-category">Main</div>
    <a href="/dashboard" title="Dashboard">
      <div class="icon"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect></svg></div>
      <span class="link-text">Dashboard</span>
    </a>

    <div class="ho-nav-category">My Health</div>
    <a href="/profile" title="Profile & Family">
      <div class="icon"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div>
      <span class="link-text">Profile & Family</span>
    </a>
    <a href="/ocr" title="Medical Reports">
      <div class="icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="16" y2="17"></line></svg></div>
      <span class="link-text">Medical Reports</span>
    </a>
    <a href="/timeline" title="Health Timeline">
      <div class="icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
      <span class="link-text">Health Timeline</span>
    </a>
    <a href="/trends" title="Health Trends">
      <div class="icon"><svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg></div>
      <span class="link-text">Health Trends</span>
    </a>
    <a href="/medicines" title="Medicines & Symptoms">
      <div class="icon"><svg viewBox="0 0 24 24"><path d="M10.5 20.5l10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path><line x1="8.5" y1="8.5" x2="15.5" y2="15.5"></line></svg></div>
      <span class="link-text">Meds & Symptoms</span>
    </a>

    <div class="ho-nav-category">Health Data</div>
    <a href="/wearables" title="Wearable Data">
      <div class="icon"><svg viewBox="0 0 24 24"><rect x="6" y="4" width="12" height="16" rx="3"></rect><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></div>
      <span class="link-text">Wearable Data</span>
    </a>

    <div class="ho-nav-category">AI & Insights</div>
    <a href="/ai-analysis" title="AI Medical Analysis">
      <div class="icon"><svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="10" rx="2"></rect><circle cx="12" cy="5" r="2"></circle><path d="M12 7v4"></path><line x1="8" y1="16" x2="8.01" y2="16"></line><line x1="16" y1="16" x2="16.01" y2="16"></line></svg></div>
      <span class="link-text">AI Medical Analysis</span>
    </a>
    <a href="/ai-assistant" class="ho-nav-ai" title="AI Health Assistant">
      <div class="icon"><svg viewBox="0 0 24 24"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path></svg></div>
      <span class="link-text">AI Health Assistant</span>
    </a>
    <a href="/nutrition" title="Nutrition & Lifestyle">
      <div class="icon"><svg viewBox="0 0 24 24"><path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z"></path><path d="M10 2c1 .5 2 2 2 5"></path></svg></div>
      <span class="link-text">Nutrition & Lifestyle</span>
    </a>

    <div class="ho-nav-category">Important</div>
    <a href="/emergency" title="Emergency" class="ho-emergency-link">
      <div class="icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg></div>
      <span class="link-text">Emergency</span>
    </a>
    <a href="/insurance" title="Insurance">
      <div class="icon"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg></div>
      <span class="link-text">Insurance</span>
    </a>
  </nav>

  <div class="ho-sb-footer">
    <a href="/logout" class="ho-user-box" title="Click to Sign Out">
      <div class="ho-user-av"><%= (locals.userName && locals.userName.length > 0) ? locals.userName.substring(0, 2).toUpperCase() : 'US' %></div>

      <div class="ho-user-meta">
        <strong><%= locals.userName || 'User' %></strong>
        <span>Health ID Active</span>
      </div>

      <div class="ho-signout-overlay">
        <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Sign Out
      </div>
    </a>
  </div>
</aside>

<!-- ==================== MOBILE FLOATING ISLAND ==================== -->
<div class="ho-m-backdrop" id="hoBackdrop" onclick="closeMobileIsland()" aria-hidden="true"></div>

<div class="ho-m-island" id="hoIsland" aria-label="Mobile Navigation">
  <div class="ho-m-collapsed-row">
    <a href="/dashboard" class="ho-m-brand">
      <div class="ho-logo-box">
        <div class="ho-ring-1"></div>
        <div class="ho-ring-2"></div>
        <div class="ho-nucleus"></div>
      </div>
      <div class="ho-m-brand-title">Health<span class="hl">Orbit</span></div>
    </a>

    <div class="ho-m-right-actions">
      <a href="/emergency" class="ho-m-quick-btn ho-m-emergency-btn" title="Emergency" aria-label="Emergency">
        <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      </a>

      <a href="/ai-assistant" class="ho-m-quick-btn ho-m-ai-btn" title="AI Health Assistant" aria-label="Ask AI">
        <svg viewBox="0 0 24 24"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path></svg>
      </a>

      <button class="ho-m-toggle" id="hoIslandToggle" aria-label="Toggle menu" aria-expanded="false" onclick="toggleMobileIsland()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </button>
    </div>
  </div>

  <nav class="ho-m-full-links">
