<script>
  document.addEventListener("DOMContentLoaded", () => {
  const currentPath = window.location.pathname;

  // 1. Highlight Active Links based on URL
  const navLinks = document.querySelectorAll('.ho-nav-links a, .ho-m-full-links a');
  navLinks.forEach(link => {
    if (currentPath.startsWith(link.getAttribute('href'))) {
      link.classList.add('active');
    }
  });

  // 2. Mobile Menu Toggle Logic
  const island = document.getElementById('hoIsland');
  const backdrop = document.getElementById('hoBackdrop');
  const toggleBtn = document.getElementById('hoIslandToggle');

  window.toggleMobileIsland = function() {
    if (island) {
      const isOpen = island.classList.toggle('open');
      if (backdrop) backdrop.classList.toggle('show', isOpen);
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', String(isOpen));
    }
  };

  window.closeMobileIsland = function() {
    if (island) island.classList.remove('open');
    if (backdrop) backdrop.classList.remove('show');
    if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
  };

  // Close mobile menu when tapping any internal link
  const mobileActionLinks = document.querySelectorAll('.ho-m-full-links a, .ho-m-signout');
  mobileActionLinks.forEach(a => {
    a.addEventListener('click', closeMobileIsland);
  });
});
</script>
