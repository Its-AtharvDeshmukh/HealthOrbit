    </div>

    <!-- BOTTOM BAR: STATUS & COPYRIGHT -->
    <div class="ho-footer-bottom">
      <div class="ho-footer-status" title="Platform Operational Status">
        <span class="ho-status-dot"></span> HealthOrbit Platform Active
      </div>
      
      <div class="ho-footer-copyright">
        <strong>&copy; 2026 HealthOrbit.</strong> All rights reserved.<br>
