<!-- views/partials/footer.ejs -->
<style>
/* ==========================================================
   HEALTHORBIT - PERFECTLY ALIGNED TRANSPARENT FOOTER
   ========================================================== */

.ho-footer-wrapper {
  width: 100%;
  margin-top: 4rem; /* Breathing room from the last dashboard card */
  padding-top: 2.5rem;
  padding-bottom: 2rem;
  border-top: 1px solid rgba(13, 122, 110, 0.15); /* Clean top separator */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
  position: relative;
  z-index: 10;
}

/* 
  THIS IS THE FIX FOR THE SIDEBAR OVERLAP 
  We push the content past the floating desktop sidebar to align perfectly with your dashboard cards.
*/
@media (min-width: 1025px) {
  .ho-footer-wrapper {
    padding-left: 110px; 
    padding-right: 2.5rem;
  }
}

@media (max-width: 1024px) {
  .ho-footer-wrapper {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}

.ho-footer-container {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 3rem;
}

/* --- TOP SPLIT LAYOUT --- */
.ho-footer-top {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 4rem;
}

/* LEFT SIDE: Brand & Trust */
.ho-footer-brand-col {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.ho-footer-logo-row {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  text-decoration: none;
}

/* EXACT EXISTING HEALTHORBIT LOGO - STRICTLY UNTOUCHED */
.ho-foot-logo-box { width: 34px; height: 34px; position: relative; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.ho-foot-ring-1 { position: absolute; inset: 0; border: 1.5px dashed #0d7a6e; border-radius: 50%; animation: hoFootSpinSlow 12s linear infinite; }
.ho-foot-ring-2 { position: absolute; inset: -4px; border: 1.5px dashed #e07a68; border-radius: 50%; animation: hoFootSpinFast 8s linear infinite reverse; }
.ho-foot-nucleus { width: 8px; height: 8px; background: #0b5e55; border-radius: 50%; box-shadow: 0 0 10px #42b89d; }
@keyframes hoFootSpinSlow { 100% { transform: rotate(360deg); } }
@keyframes hoFootSpinFast { 100% { transform: rotate(360deg); } }

.ho-footer-brand-title {
  font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  font-weight: 800;
  font-size: 1.25rem;
  color: #0b5e55;
  letter-spacing: -0.02em;
}
.ho-footer-brand-title span { color: #e07a68; }

.ho-footer-mission {
  font-size: 0.85rem;
  font-weight: 600;
  color: #4e6b63;
  line-height: 1.5;
}

/* Safety Card */
.ho-footer-safety-card {
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(13, 122, 110, 0.1);
  border-radius: 14px;
  padding: 1rem;
  display: flex;
  gap: 0.85rem;
  align-items: flex-start;
}
.ho-safety-icon {
  width: 20px;
  height: 20px;
  color: #0d7a6e;
  flex-shrink: 0;
  margin-top: 2px;
}
.ho-safety-text {
  font-size: 0.75rem;
  color: #4e6b63;
  line-height: 1.5;
}
.ho-safety-text strong { color: #0b5e55; display: block; margin-bottom: 0.2rem; }

/* RIGHT SIDE: Navigation Grid */
.ho-footer-nav-col {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.ho-footer-nav-group {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.ho-footer-nav-title {
  font-size: 0.75rem;
  font-weight: 800;
  color: #0b5e55;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 0.5rem;
}

.ho-footer-nav-group a {
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 600;
  color: #4e6b63;
  transition: all 0.2s ease;
  display: inline-block;
  width: fit-content;
}

.ho-footer-nav-group a:hover,
.ho-footer-nav-group a:focus-visible {
  color: #0d7a6e;
  transform: translateX(4px);
  outline: none;
}

/* --- BOTTOM BAR --- */
.ho-footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(13, 122, 110, 0.1);
  flex-wrap: wrap;
  gap: 1rem;
}

.ho-footer-status {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.75rem;
  font-weight: 700;
  color: #0b5e55;
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(13, 122, 110, 0.1);
  padding: 6px 14px;
  border-radius: 999px;
}

.ho-status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #0d7a6e;
  box-shadow: 0 0 0 rgba(13, 122, 110, 0.6);
  animation: hoStatusPulse 2s infinite;
}
@keyframes hoStatusPulse {
  0% { box-shadow: 0 0 0 0 rgba(13, 122, 110, 0.4); }
  70% { box-shadow: 0 0 0 5px rgba(13, 122, 110, 0); }
  100% { box-shadow: 0 0 0 0 rgba(13, 122, 110, 0); }
}

.ho-footer-copyright {
  font-size: 0.75rem;
  color: #4e6b63;
  line-height: 1.5;
  text-align: right;
}
.ho-footer-copyright strong { color: #0b5e55; }

/* ==========================================================
   RESPONSIVE DESIGN ADAPTATIONS
   ========================================================== */
@media (max-width: 1024px) {
  .ho-footer-top { grid-template-columns: 1fr; gap: 2.5rem; }
}

@media (max-width: 768px) {
  .ho-footer-wrapper {
    margin-top: 2.5rem;
    padding-top: 2rem;
  }
  .ho-footer-nav-col { grid-template-columns: 1fr 1fr; gap: 2rem 1rem; }
  .ho-footer-bottom { flex-direction: column; align-items: flex-start; }
  .ho-footer-copyright { text-align: left; }
}
</style>

