<!-- views/partials/ai-widget.ejs -->
<style>
  /* ==========================================================================
     HEALTHORBIT AI WIDGET - PREMIUM GLASSMORPHISM UI
     ========================================================================== */
  :root {
    --ho-ai-teal: #0d7a6e;
    --ho-ai-teal-dark: #095950;
    --ho-ai-teal-light: #15b3a1;
    --ho-ai-coral: #e07a68;
    --ho-ai-bg-airy: #edf6f4;
    --ho-ai-text-main: #0f1c1a;
    --ho-ai-text-muted: #4e6b63;
    
    --ho-ai-glass-bg: rgba(255, 255, 255, 0.75);
    --ho-ai-glass-border: rgba(255, 255, 255, 0.7);
    --ho-ai-glass-shadow: 0 24px 54px rgba(13, 122, 110, 0.15);
    --ho-ai-easing: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ho-ai-widget-root {
    position: fixed; bottom: 2rem; right: 2.5rem; z-index: 9999;
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  /* ---------- FLOATING ACTION BUTTON (FAB) ---------- */
  .ho-ai-fab-container { position: relative; width: 64px; height: 64px; }
  
  .ho-ai-fab-ring {
    position: absolute; inset: -4px; border-radius: 50%;
    background: linear-gradient(135deg, var(--ho-ai-teal-light), var(--ho-ai-teal));
    opacity: 0.4; filter: blur(10px);
    animation: hoAiPulse 3s infinite var(--ho-ai-easing);
  }

  .ho-ai-fab {
    position: absolute; inset: 0; width: 100%; height: 100%;
    background: linear-gradient(135deg, var(--ho-ai-teal), var(--ho-ai-teal-dark));
    color: #fff; border: 1px solid rgba(255,255,255,0.25); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; box-shadow: 0 10px 25px rgba(13, 122, 110, 0.4);
    transition: transform 0.4s var(--ho-ai-easing), box-shadow 0.4s var(--ho-ai-easing);
    z-index: 2;
  }
  .ho-ai-fab:hover { transform: translateY(-4px) scale(1.05); box-shadow: 0 15px 35px rgba(13, 122, 110, 0.5); }
  .ho-ai-fab:active { transform: scale(0.95); }
  .ho-ai-fab svg { width: 28px; height: 28px; stroke: currentColor; fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; transition: 0.3s; }
  
  .ho-ai-widget-root.open .ho-ai-fab { transform: scale(0.8) translateY(10px); opacity: 0; pointer-events: none; }

  /* ---------- THE GLASS CHAT PANEL ---------- */
  .ho-ai-panel {
    position: absolute; bottom: 85px; right: 0;
    width: 420px; height: 680px; max-height: calc(100vh - 120px);
    background: var(--ho-ai-glass-bg);
    backdrop-filter: blur(28px) saturate(180%); -webkit-backdrop-filter: blur(28px) saturate(180%);
    border: 1px solid var(--ho-ai-glass-border);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.8), var(--ho-ai-glass-shadow);
    border-radius: 28px; display: flex; flex-direction: column; overflow: hidden;
    opacity: 0; visibility: hidden; pointer-events: none;
    transform: translateY(40px) scale(0.95); transform-origin: bottom right;
    transition: all 0.5s var(--ho-ai-easing);
  }
  .ho-ai-widget-root.open .ho-ai-panel {
    opacity: 1; visibility: visible; pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  /* ---------- HEADER & LOGO ---------- */
  .ho-ai-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.5rem; background: rgba(255, 255, 255, 0.5);
    border-bottom: 1px solid rgba(13, 122, 110, 0.1); flex-shrink: 0;
  }
  
  .ho-ai-brand { display: flex; align-items: center; gap: 0.8rem; }
  
  /* Animated 3-Ring Logo Integration */
  .ho-ai-logo-box { width: 34px; height: 34px; position: relative; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .ho-ai-ring-1 { position: absolute; inset: 0; border: 1.5px dashed var(--ho-ai-teal); border-radius: 50%; animation: hoAiSpin 12s linear infinite; }
  .ho-ai-ring-2 { position: absolute; inset: -4px; border: 1.5px dashed var(--ho-ai-coral); border-radius: 50%; animation: hoAiSpinAnti 8s linear infinite; }
  .ho-ai-nucleus { width: 8px; height: 8px; background: var(--ho-ai-teal-dark); border-radius: 50%; box-shadow: 0 0 10px var(--ho-ai-teal-light); }
  
  .ho-ai-brand-text { display: flex; flex-direction: column; gap: 2px; }
  .ho-ai-brand-title { font-family: 'Fraunces', serif; font-size: 1.25rem; font-weight: 800; color: var(--ho-ai-teal-dark); line-height: 1; letter-spacing: -0.5px;}
  .ho-ai-brand-title span { font-family: 'Plus Jakarta Sans', sans-serif; color: var(--ho-ai-coral); font-weight: 700; }
  .ho-ai-brand-status { font-size: 0.7rem; font-weight: 700; color: var(--ho-ai-teal); text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 5px; }
  .ho-ai-status-dot { width: 6px; height: 6px; border-radius: 50%; background: #27ae60; animation: hoAiPulseStatus 2s infinite; }

  .ho-ai-close {
    width: 32px; height: 32px; border-radius: 50%; border: none;
    background: rgba(13, 122, 110, 0.08); color: var(--ho-ai-teal-dark);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: 0.2s;
  }
  .ho-ai-close:hover { background: rgba(224, 122, 104, 0.15); color: var(--ho-ai-coral); transform: rotate(90deg); }

  /* ---------- CHAT AREA ---------- */
  .ho-ai-chat-body {
    flex: 1; padding: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem;
    overflow-y: auto; scrollbar-width: thin; scrollbar-color: rgba(13, 122, 110, 0.2) transparent;
  }
  .ho-ai-chat-body::-webkit-scrollbar { width: 6px; }
  .ho-ai-chat-body::-webkit-scrollbar-thumb { background: rgba(13, 122, 110, 0.2); border-radius: 999px; }

  .ho-ai-msg-group { display: flex; gap: 0.8rem; opacity: 0; animation: hoMsgPop 0.4s var(--ho-ai-easing) forwards; }
  .ho-ai-msg-group.user { flex-direction: row-reverse; }

  .ho-ai-avatar {
    width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, var(--ho-ai-teal), var(--ho-ai-teal-dark));
    display: flex; align-items: center; justify-content: center; color: #fff;
    box-shadow: 0 4px 10px rgba(13,122,110,0.2);
  }
  .ho-ai-avatar svg { width: 16px; height: 16px; }

  .ho-ai-bubble {
    max-width: 78%; padding: 1rem 1.2rem; font-size: 0.95rem; line-height: 1.55; font-weight: 500;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03); position: relative;
  }
  .ho-ai-bubble.assistant {
    background: rgba(255, 255, 255, 0.85); color: var(--ho-ai-text-main);
    border-radius: 4px 20px 20px 20px; border: 1px solid rgba(13,122,110,0.1);
  }
  .ho-ai-bubble.assistant strong { color: var(--ho-ai-teal-dark); font-weight: 700; }
  
  .ho-ai-bubble.user {
    background: linear-gradient(135deg, var(--ho-ai-teal), var(--ho-ai-teal-dark)); color: #fff;
    border-radius: 20px 4px 20px 20px; border: 1px solid rgba(255,255,255,0.15);
  }

  .ho-ai-bubble.error {
    background: rgba(251, 228, 222, 0.9); color: #c0392b;
    border-radius: 4px 20px 20px 20px; border: 1px solid rgba(224, 122, 104, 0.3);
  }

  /* Typing Indicator */
  .ho-ai-typing { display: none; padding: 1.2rem; background: rgba(255, 255, 255, 0.85); border-radius: 4px 20px 20px 20px; border: 1px solid rgba(13,122,110,0.1); align-items: center; gap: 0.4rem; width: fit-content; }
  .ho-ai-dot { width: 6px; height: 6px; background: var(--ho-ai-teal-light); border-radius: 50%; animation: hoTypingBounce 1.4s infinite ease-in-out both; }
  .ho-ai-dot:nth-child(1) { animation-delay: -0.32s; }
  .ho-ai-dot:nth-child(2) { animation-delay: -0.16s; }

  /* ---------- INPUT AREA ---------- */
  .ho-ai-footer { padding: 1.2rem 1.5rem 1.5rem; background: rgba(255,255,255,0.6); border-top: 1px solid rgba(13,122,110,0.1); flex-shrink: 0; }
  
  .ho-ai-input-wrapper {
    display: flex; align-items: center; gap: 0.6rem;
    background: rgba(255, 255, 255, 0.9); border: 1px solid rgba(13,122,110,0.2); border-radius: 999px;
    padding: 0.4rem 0.4rem 0.4rem 1.4rem; transition: 0.3s var(--ho-ai-easing);
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  }
  .ho-ai-input-wrapper:focus-within { border-color: var(--ho-ai-teal); box-shadow: 0 0 0 4px rgba(13, 122, 110, 0.1); transform: translateY(-2px); }

  .ho-ai-input {
    flex: 1; border: none; background: transparent; font-family: inherit; font-size: 0.95rem; font-weight: 500;
    color: var(--ho-ai-text-main); outline: none; padding: 0.5rem 0;
  }
  .ho-ai-input::placeholder { color: #8ba8a4; }

  .ho-ai-send {
    width: 44px; height: 44px; border-radius: 50%; border: none;
    background: var(--ho-ai-teal); color: #fff;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: 0.3s var(--ho-ai-easing); flex-shrink: 0;
  }
  .ho-ai-send:hover:not(:disabled) { background: var(--ho-ai-teal-dark); transform: scale(1.05) rotate(-10deg); box-shadow: 0 6px 16px rgba(13,122,110,0.3); }
  .ho-ai-send:active:not(:disabled) { transform: scale(0.95); }
  .ho-ai-send:disabled { background: #d1e0de; color: #8ba8a4; cursor: not-allowed; }
  .ho-ai-send svg { width: 18px; height: 18px; stroke-width: 2.5; stroke: currentColor; fill: none; stroke-linecap: round; stroke-linejoin: round; margin-left: -2px; transition: transform 0.3s var(--ho-ai-easing); }
  .ho-ai-send:hover:not(:disabled) svg { transform: translateX(2px) translateY(-2px); }

  /* ---------- ANIMATIONS ---------- */
  @keyframes hoAiPulse { 0% { transform: scale(0.9); opacity: 0.5; } 50% { transform: scale(1.2); opacity: 0; } 100% { transform: scale(0.9); opacity: 0; } }
  @keyframes hoAiPulseStatus { 0% { box-shadow: 0 0 0 0 rgba(39, 174, 96, 0.6); } 70% { box-shadow: 0 0 0 5px rgba(39, 174, 96, 0); } 100% { box-shadow: 0 0 0 0 rgba(39, 174, 96, 0); } }
  @keyframes hoMsgPop { 0% { opacity: 0; transform: translateY(15px) scale(0.95); } 100% { opacity: 1; transform: translateY(0) scale(1); } }
  @keyframes hoTypingBounce { 0%, 80%, 100% { transform: translateY(0); opacity: 0.4; } 40% { transform: translateY(-4px); opacity: 1; } }
  @keyframes hoAiSpin { 100% { transform: rotate(360deg); } }
  @keyframes hoAiSpinAnti { 100% { transform: rotate(-360deg); } }

  /* ---------- MOBILE ERGONOMICS ---------- */
  @media (max-width: 768px) {
    .ho-ai-widget-root { bottom: 1.5rem; right: 1.5rem; }
    .ho-ai-panel { position: fixed; inset: 0; width: 100vw; height: 100dvh; max-height: 100dvh; border-radius: 0; border: none; transform: translateY(100%); }
    .ho-ai-header { border-radius: 0; padding-top: calc(1.5rem + env(safe-area-inset-top)); }
    .ho-ai-footer { padding-bottom: calc(1.5rem + env(safe-area-inset-bottom)); }
    .ho-ai-input { font-size: 16px; /* Prevents iOS auto-zoom */ }
  }
</style>

<!-- ==========================================================================
     HTML STRUCTURE
     ========================================================================== -->
<div class="ho-ai-widget-root" id="hoAiWidget">
  
  <!-- FAB -->
  <div class="ho-ai-fab-container">
    <div class="ho-ai-fab-ring"></div>
    <button id="hoAiFabBtn" class="ho-ai-fab" aria-label="Open HealthOrbit AI">
      <svg viewBox="0 0 24 24"><path d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275L12 3z"></path></svg>
    </button>
  </div>

  <!-- PANEL -->
  <div class="ho-ai-panel" id="hoAiPanel">
    
    <!-- HEADER -->
    <header class="ho-ai-header">
      <div class="ho-ai-brand">
        <div class="ho-ai-logo-box" aria-hidden="true">
          <div class="ho-ai-ring-1"></div>
          <div class="ho-ai-ring-2"></div>
          <div class="ho-ai-nucleus"></div>
        </div>
        <div class="ho-ai-brand-text">
          <div class="ho-ai-brand-title">Health<span>Orbit</span></div>
          <div class="ho-ai-brand-status"><span class="ho-ai-status-dot"></span> AI Online</div>
        </div>
      </div>
      <button id="hoAiCloseBtn" class="ho-ai-close" aria-label="Close Chat">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </header>

    <!-- CHAT AREA -->
    <div class="ho-ai-chat-body" id="hoAiChatBody">
      
      <!-- Greeting -->
      <div class="ho-ai-msg-group assistant">
        <div class="ho-ai-avatar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275L12 3z"></path></svg>
        </div>
        <div class="ho-ai-bubble assistant">
          Hello! I am your <strong>HealthOrbit AI</strong>. I can securely analyze your clinical dashboard, explain medical records, and track your health trends. How can I assist you today?
        </div>
      </div>

      <!-- Typing Indicator -->
      <div class="ho-ai-msg-group assistant" id="hoAiTypingWrapper" style="display: none;">
        <div class="ho-ai-avatar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275L12 3z"></path></svg>
        </div>
        <div class="ho-ai-typing">
          <div class="ho-ai-dot"></div><div class="ho-ai-dot"></div><div class="ho-ai-dot"></div>
        </div>
      </div>

    </div>

    <!-- INPUT AREA -->
    <footer class="ho-ai-footer">
      <form id="hoAiForm" class="ho-ai-input-wrapper">
        <input type="text" id="hoAiInput" class="ho-ai-input" placeholder="Message HealthOrbit AI..." autocomplete="off">
        <button type="submit" id="hoAiSendBtn" class="ho-ai-send" disabled aria-label="Send">
          <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
      </form>
    </footer>

  </div>
</div>

<!-- ==========================================================================
     JAVASCRIPT ENGINE
     ========================================================================== -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const widgetRoot = document.getElementById('hoAiWidget');
    const fabBtn = document.getElementById('hoAiFabBtn');
    const closeBtn = document.getElementById('hoAiCloseBtn');
    const form = document.getElementById('hoAiForm');
    const input = document.getElementById('hoAiInput');
    const sendBtn = document.getElementById('hoAiSendBtn');
    const chatBody = document.getElementById('hoAiChatBody');
    const typingWrapper = document.getElementById('hoAiTypingWrapper');

    // --- UI Controls ---
    const toggleWidget = () => {
      const isOpen = widgetRoot.classList.toggle('open');
      if (isOpen) {
        input.focus();
        scrollToBottom();
      }
    };

    fabBtn.addEventListener('click', toggleWidget);
    closeBtn.addEventListener('click', toggleWidget);

    input.addEventListener('input', () => {
      sendBtn.disabled = input.value.trim() === '';
    });

    const scrollToBottom = () => {
      chatBody.scrollTop = chatBody.scrollHeight;
    };

    // Extract Context Data for Server
    const getSelectedRecordId = () => {
      const urlParams = new URLSearchParams(window.location.search);
      let reportId = urlParams.get('reportId');
      if (!reportId) {
        const hiddenInput = document.getElementById('currentReportId');
        if (hiddenInput) reportId = hiddenInput.value;
      }
      return reportId || null;
    };

    // Safe HTML Escaping & Markdown Parser
    const escapeHTML = (str) => {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    };

    const appendMessage = (text, sender, isError = false) => {
      const group = document.createElement('div');
      group.className = `ho-ai-msg-group ${sender}`;

      let innerHTML = '';

      // Avatar for AI
      if (sender === 'assistant') {
        innerHTML += `
          <div class="ho-ai-avatar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275L12 3z"></path></svg>
          </div>
        `;
      }

      // Format Text
      let formattedText = escapeHTML(text);
      formattedText = formattedText.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br>');
      
      const bubbleClass = isError ? 'error' : sender;
      innerHTML += `<div class="ho-ai-bubble ${bubbleClass}">${formattedText}</div>`;
      group.innerHTML = innerHTML;

      chatBody.insertBefore(group, typingWrapper);
      scrollToBottom();
    };

    // --- Submission Engine ---
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const message = input.value.trim();
      if (!message) return;

      appendMessage(message, 'user');
      input.value = '';
      sendBtn.disabled = true;
      
      typingWrapper.style.display = 'flex';
      scrollToBottom();

      try {
        const payload = { 
          message: message, 
          currentPage: window.location.pathname,
          selectedRecordId: getSelectedRecordId()
        };

        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        // Detect Session Expiration (Server redirecting to HTML login page)
        const contentType = response.headers.get("content-type");
        if (response.status === 401 || response.redirected || (contentType && contentType.includes("text/html"))) {
          throw new Error("Your session has expired. Please refresh the page or log in again.");
        }
        
        const data = await response.json();
        
        if (!response.ok) {
          throw new Error(data.error || "Failed to process request. Please try again.");
        }

        typingWrapper.style.display = 'none';
        appendMessage(data.reply, 'assistant');

      } catch (error) {
        typingWrapper.style.display = 'none';
        appendMessage(error.message || "An unexpected error occurred connecting to HealthOrbit.", 'assistant', true);
      }
    });
  });
</script>