<!-- views/partials/ai-widget.ejs -->
<style>
  /* ==========================================================================
     STRICTLY SCOPED AI WIDGET STYLES — HealthOrbit Glass Edition
     ========================================================================== */

  .ho-ai-widget-root {
    position: fixed;
    bottom: 2rem;
    right: 2.5rem;
    z-index: 9999;
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
  }

  @media (prefers-reduced-motion: reduce) {
    .ho-ai-widget-root *, .ho-ai-widget-root *::before, .ho-ai-widget-root *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* ---------- Orbit logo mark: a core with an orbiting satellite dot ---------- */
  .ho-orbit-mark {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ho-orbit-mark .ho-orbit-ring {
    position: absolute;
    inset: 0;
    border: 1.5px dashed rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    animation: hoOrbitSpin 6s linear infinite;
  }

  .ho-orbit-mark .ho-orbit-core {
    width: 40%;
    height: 40%;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, var(--ho-coral, #e07a68) 70%);
    box-shadow: 0 0 8px rgba(224, 122, 104, 0.7);
  }

  .ho-orbit-mark .ho-orbit-satellite {
    position: absolute;
    top: -2px;
    left: 50%;
    width: 16%;
    height: 16%;
    margin-left: -8%;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.9);
    transform-origin: 50% 500%;
    animation: hoOrbitSpin 6s linear infinite;
  }

  @keyframes hoOrbitSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* ---------- Floating Action Button ---------- */
  .ho-ai-fab {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--ho-teal-700, #0d7a6e), var(--ho-teal-900, #0b5e55));
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 10px 30px rgba(13, 122, 110, 0.45), inset 0 1px 1px rgba(255, 255, 255, 0.3);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ho-ai-fab::before {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(13, 122, 110, 0.35), transparent 70%);
    opacity: 0.8;
    animation: hoFabPulse 2.6s ease-in-out infinite;
    z-index: -1;
  }

  @keyframes hoFabPulse {
    0%, 100% { transform: scale(0.9); opacity: 0.55; }
    50% { transform: scale(1.18); opacity: 0.1; }
  }

  .ho-ai-fab:hover {
    transform: translateY(-4px) scale(1.06);
    box-shadow: 0 18px 40px rgba(13, 122, 110, 0.55), inset 0 1px 1px rgba(255, 255, 255, 0.35);
  }

  .ho-ai-fab:active {
    transform: scale(0.93);
  }

  .ho-ai-fab svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ho-ai-fab.is-open svg {
    transform: rotate(135deg);
  }

  .ho-ai-fab-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #34d399;
    border: 2px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 0 rgba(52, 211, 153, 0.6);
    animation: hoStatusPulse 2s ease-in-out infinite;
  }

  @keyframes hoStatusPulse {
    0% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6); }
    70% { box-shadow: 0 0 0 6px rgba(52, 211, 153, 0); }
    100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); }
  }

  /* ---------- Glass panel ---------- */
  .ho-ai-panel {
    position: absolute;
    bottom: 84px;
    right: 0;
    width: 390px;
    height: 620px;
    max-height: calc(100vh - 120px);
    background: rgba(255, 255, 255, 0.68);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 28px;
    box-shadow:
      0 30px 70px rgba(11, 94, 85, 0.22),
      0 2px 8px rgba(11, 94, 85, 0.08),
      inset 0 1px 1px rgba(255, 255, 255, 0.9);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(24px) scale(0.93);
    transform-origin: bottom right;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.35s;
  }

  .ho-ai-panel::before {
    /* subtle glass sheen along the top edge */
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9), transparent);
  }

  .ho-ai-panel.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  /* ---------- Header ---------- */
  .ho-ai-header {
    position: relative;
    background: linear-gradient(135deg, var(--ho-teal-900, #0b5e55), var(--ho-teal-700, #0d7a6e));
    padding: 1.25rem 1.4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: white;
    flex-shrink: 0;
    overflow: hidden;
  }

  .ho-ai-header::after {
    content: '';
    position: absolute;
    top: -60%;
    right: -20%;
    width: 60%;
    height: 220%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.16), transparent 65%);
    pointer-events: none;
  }

  .ho-ai-header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
    z-index: 1;
  }

  .ho-ai-header-logo {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .ho-ai-header-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ho-ai-header-title {
    font-weight: 800;
    font-size: 1.05rem;
    font-family: 'Fraunces', serif;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .ho-ai-header-title span {
    font-family: 'Plus Jakarta Sans', sans-serif;
    color: var(--ho-coral, #e07a68);
  }

  .ho-ai-header-status {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.75);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ho-ai-header-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0 rgba(52, 211, 153, 0.6);
    animation: hoStatusPulse 2s ease-in-out infinite;
  }

  .ho-ai-close {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .ho-ai-close:hover {
    background: rgba(255, 255, 255, 0.22);
    color: white;
    transform: rotate(90deg);
  }

  /* ---------- Chat area ---------- */
  .ho-ai-chat-area {
    flex: 1;
    padding: 1.4rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(13, 122, 110, 0.3) transparent;
  }

  .ho-ai-chat-area::-webkit-scrollbar { width: 6px; }
  .ho-ai-chat-area::-webkit-scrollbar-thumb { background: rgba(13, 122, 110, 0.25); border-radius: 999px; }
  .ho-ai-chat-area::-webkit-scrollbar-track { background: transparent; }

  @keyframes hoMsgIn {
    from { opacity: 0; transform: translateY(10px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .ho-ai-msg {
    max-width: 85%;
    padding: 0.85rem 1.15rem;
    border-radius: 18px;
    font-size: 0.9rem;
    line-height: 1.55;
    word-wrap: break-word;
    animation: hoMsgIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .ho-ai-msg.user {
    align-self: flex-end;
    background: linear-gradient(135deg, var(--ho-teal-50, #e8f8f5), rgba(232, 248, 245, 0.7));
    backdrop-filter: blur(6px);
    color: var(--ho-teal-900, #0b5e55);
    border-bottom-right-radius: 4px;
    border: 1px solid rgba(13, 122, 110, 0.14);
  }

  .ho-ai-msg.assistant {
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(6px);
    color: var(--ho-text-main, #0f1c1a);
    border-bottom-left-radius: 4px;
    border: 1px solid var(--ho-glass-border-subtle, rgba(13, 122, 110, 0.12));
    box-shadow: 0 6px 18px rgba(11, 94, 85, 0.06);
  }

  .ho-ai-msg.assistant strong {
    color: var(--ho-teal-900, #0b5e55);
  }

  .ho-ai-msg.error {
    background: var(--ho-coral-soft, #fbe4de);
    color: var(--ho-danger, #d94b4b);
    border-color: rgba(217, 75, 75, 0.25);
  }

  .ho-ai-typing {
    display: none;
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(6px);
    padding: 0.85rem 1.15rem;
    border-radius: 18px;
    border-bottom-left-radius: 4px;
    border: 1px solid rgba(13, 122, 110, 0.1);
    align-items: center;
    gap: 0.3rem;
  }

  .ho-ai-dot {
    width: 6px;
    height: 6px;
    background: var(--ho-teal-600, #109485);
    border-radius: 50%;
    animation: hoAiBlink 1.4s infinite both;
  }

  .ho-ai-dot:nth-child(1) { animation-delay: 0.2s; }
  .ho-ai-dot:nth-child(2) { animation-delay: 0.4s; }
  .ho-ai-dot:nth-child(3) { animation-delay: 0.6s; }

  @keyframes hoAiBlink {
    0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); }
    40% { opacity: 1; transform: scale(1.2); }
  }

  /* ---------- Input area ---------- */
  .ho-ai-input-area {
    position: relative;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255, 255, 255, 0.6);
    display: flex;
    gap: 0.7rem;
    flex-shrink: 0;
  }

  .ho-ai-input-wrap {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
  }

  .ho-ai-input {
    width: 100%;
    background: rgba(237, 246, 244, 0.75);
    backdrop-filter: blur(8px);
    border: 1.5px solid rgba(13, 122, 110, 0.16);
    border-radius: 999px;
    padding: 0.8rem 1.2rem;
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--ho-text-main, #0f1c1a);
    outline: none;
    transition: border-color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
  }

  .ho-ai-input::placeholder {
    color: rgba(15, 28, 26, 0.4);
  }

  .ho-ai-input:focus {
    border-color: var(--ho-teal-600, #109485);
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 0 0 4px rgba(16, 148, 133, 0.14);
  }

  .ho-ai-send {
    position: relative;
    background: linear-gradient(135deg, var(--ho-teal-700, #0d7a6e), var(--ho-teal-900, #0b5e55));
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.25);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(13, 122, 110, 0.35);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, background 0.25s ease;
    flex-shrink: 0;
  }

  .ho-ai-send:hover:not(:disabled) {
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 10px 22px rgba(13, 122, 110, 0.45);
  }

  .ho-ai-send:active:not(:disabled) {
    transform: scale(0.92);
  }

  .ho-ai-send:disabled {
    background: #cbd5e1;
    box-shadow: none;
    cursor: not-allowed;
    transform: none;
  }

  .ho-ai-send svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-left: -2px;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ho-ai-send:hover:not(:disabled) svg {
    transform: translateX(1px) translateY(-1px);
  }

  .ho-ai-send.is-sending svg {
    animation: hoSendSpin 0.8s linear infinite;
  }

  @keyframes hoSendSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* ---------- Mobile responsiveness ---------- */
  @media (max-width: 768px) {
    .ho-ai-widget-root {
      bottom: 1.5rem;
      right: 1.5rem;
    }
    .ho-ai-panel {
      position: fixed;
      bottom: 0;
      right: 0;
      width: 100vw;
      height: 100dvh;
      max-height: 100dvh;
      border-radius: 0;
      border: none;
    }
  }
</style>

<div class="ho-ai-widget-root" aria-label="AI Assistant Widget">
  <button id="hoAiFab" class="ho-ai-fab" aria-label="Open AI Assistant" aria-expanded="false">
    <span class="ho-ai-fab-badge" aria-hidden="true"></span>
    <svg viewBox="0 0 24 24">
      <path d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275L12 3z"></path>
    </svg>
  </button>

  <div id="hoAiPanel" class="ho-ai-panel" role="dialog" aria-modal="false" aria-label="HealthOrbit AI Assistant">
    <div class="ho-ai-header">
      <div class="ho-ai-header-left">
        <span class="ho-orbit-mark ho-ai-header-logo" aria-hidden="true">
          <span class="ho-orbit-ring"></span>
          <span class="ho-orbit-satellite"></span>
          <span class="ho-orbit-core"></span>
        </span>
        <div class="ho-ai-header-text">
          <div class="ho-ai-header-title">Health<span>Orbit</span> AI</div>
          <div class="ho-ai-header-status"><span class="ho-ai-header-status-dot" aria-hidden="true"></span> Online &amp; ready</div>
        </div>
      </div>
      <button id="hoAiClose" class="ho-ai-close" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div id="hoAiChatArea" class="ho-ai-chat-area">
      <div class="ho-ai-msg assistant">
        Hello! I am your <strong>HealthOrbit AI</strong>. I can analyze your dashboard, explain your medical reports, calculate your trends, and answer health questions based on your securely stored records. How can I help you today?
      </div>
      <div id="hoAiTyping" class="ho-ai-typing">
        <div class="ho-ai-dot"></div>
        <div class="ho-ai-dot"></div>
        <div class="ho-ai-dot"></div>
      </div>
    </div>

    <form id="hoAiForm" class="ho-ai-input-area">
      <div class="ho-ai-input-wrap">
        <input type="text" id="hoAiInput" class="ho-ai-input" placeholder="Ask about your health data..." autocomplete="off">
      </div>
      <button type="submit" id="hoAiSend" class="ho-ai-send" aria-label="Send Message" disabled>
        <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
      </button>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fab = document.getElementById('hoAiFab');
    const panel = document.getElementById('hoAiPanel');
    const closeBtn = document.getElementById('hoAiClose');
    const form = document.getElementById('hoAiForm');
    const input = document.getElementById('hoAiInput');
    const sendBtn = document.getElementById('hoAiSend');
    const chatArea = document.getElementById('hoAiChatArea');
    const typingIndicator = document.getElementById('hoAiTyping');

    // UI Toggles
    const togglePanel = () => {
      const isOpen = panel.classList.toggle('open');
      fab.classList.toggle('is-open', isOpen);
      fab.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) {
        input.focus();
        scrollToBottom();
      }
    };

    fab.addEventListener('click', togglePanel);
    closeBtn.addEventListener('click', togglePanel);

    // Close on Escape for keyboard users
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('open')) {
        togglePanel();
      }
    });

    // Input Validation
    input.addEventListener('input', () => {
      sendBtn.disabled = input.value.trim() === '';
    });

    const scrollToBottom = () => {
      chatArea.scrollTop = chatArea.scrollHeight;
    };

    // SECURITY: XSS Sanitizer for AI responses
    const escapeHTML = (str) => {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    };

    const appendMessage = (text, sender) => {
      const msgDiv = document.createElement('div');
      msgDiv.className = `ho-ai-msg ${sender}`;

      // Escape all HTML first to prevent XSS, then safely restore bold/newlines
      let safeText = escapeHTML(text);
      safeText = safeText.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      safeText = safeText.replace(/\n/g, '<br>');

      msgDiv.innerHTML = safeText;
      chatArea.insertBefore(msgDiv, typingIndicator);
      scrollToBottom();
    };

    // Extract Report ID securely for Context
    const getSelectedRecordId = () => {
      const urlParams = new URLSearchParams(window.location.search);
      let reportId = urlParams.get('reportId');
      if (!reportId) {
        const hiddenInput = document.getElementById('currentReportId');
        if (hiddenInput) reportId = hiddenInput.value;
      }
      return reportId || null;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const message = input.value.trim();
      if (!message) return;

      appendMessage(message, 'user');
      input.value = '';
      sendBtn.disabled = true;
      sendBtn.classList.add('is-sending');
      typingIndicator.style.display = 'flex';
      scrollToBottom();

      try {
        // STRICT PAYLOAD: Only contextual hints, NO userId.
        const payload = {
          message: message,
          currentPage: window.location.pathname,
          selectedRecordId: getSelectedRecordId()
        };

        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        // FIXED: Detect if the server redirected us to the login page due to
        // an expired session. An expired-session redirect usually comes back
        // as a followed redirect to an HTML login page rather than JSON, so
        // checking response.redirected / content-type catches it before we
        // try (and fail) to parse it as JSON.
        const contentType = response.headers.get("content-type");
        if (response.redirected || (contentType && contentType.includes("text/html"))) {
          throw new Error("Your session has expired. Please refresh the page or log in again.");
        }

        // Handle explicit JSON Auth errors
        if (response.status === 401 || response.status === 403) {
          throw new Error("Unauthorized request. Please log in again.");
        }

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || "Failed to process request.");
        }

        typingIndicator.style.display = 'none';
        appendMessage(data.reply, 'assistant');

      } catch (error) {
        typingIndicator.style.display = 'none';
        appendMessage(error.message || "An unexpected error occurred. Please try again.", 'error');
      } finally {
        sendBtn.classList.remove('is-sending');
      }
    });
  });
</script>
