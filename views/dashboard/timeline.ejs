<!DOCTYPE html>
<html lang="en">
<head>
<!-- 1. Imports your common Fonts, Title, and Global CSS -->
<%- include('../partials/header', { title: 'Longitudinal Health Timeline' }) %>
<!-- < %- include('../partials/header', { title: 'HealthOrbit - Profile & Privacy', cssFile: 'profile' }) % > -->
<link rel="icon" href="/images/Logo.png">

<style>
/* 
==================================================================
  STRICTLY SCOPED TIMELINE CSS (PREFIXED WITH 'ho-')
  (Note: Global variables and background orbs are now in global.css)
================================================================== 
*/
.ho-mono { font-family: 'JetBrains Mono', monospace; }

/* Top Header */
.ho-topbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 2rem 3rem 1.2rem; flex-shrink: 0; background: transparent;
  position: sticky; top: 0; z-index: 20;
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
}
.ho-topbar-text h1 { font-family: 'Fraunces', serif; font-weight: 800; font-size: 2.1rem; color: var(--ho-teal-900); margin-bottom: 0.2rem; letter-spacing: -0.8px; }
.ho-topbar-text p { font-size: 0.92rem; color: var(--ho-text-muted); font-weight: 600; display: flex; align-items: center; gap: 0.5rem; }
.ho-pulse-dot { width: 8px; height: 8px; background: var(--ho-mint-400); border-radius: 50%; box-shadow: 0 0 10px var(--ho-mint-400); animation: hoPulse 2s infinite; }
@keyframes hoPulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.4); } }

/* Filter Tabs */
.ho-filter-bar { display: flex; gap: 0.4rem; background: var(--ho-glass-solid); border: 1.5px solid var(--ho-glass-border); padding: 5px; border-radius: 999px; box-shadow: 0 4px 15px rgba(0,0,0,0.02); }
.ho-filter-btn { border: none; background: transparent; padding: 0.55rem 1.2rem; border-radius: 999px; font-weight: 700; font-size: 0.82rem; color: var(--ho-text-muted); cursor: pointer; transition: 0.25s; font-family: inherit; }
.ho-filter-btn.active { background: var(--ho-teal-900); color: #fff; box-shadow: 0 4px 12px rgba(11, 94, 85, 0.25); }
.ho-filter-btn:hover:not(.active) { color: var(--ho-teal-900); background: rgba(13, 122, 110, 0.08); }

/* Dual Workspace Grid */
.ho-timeline-workspace {
  display: grid; grid-template-columns: 7fr 5fr; gap: 2rem;
  padding: 0.5rem 3rem 4rem; flex: 1;
}

/* ==========================================================
   LEFT PANE: INTERACTIVE VERTICAL TIMELINE
   ========================================================== */
.ho-timeline-track { position: relative; padding-left: 2.2rem; display: flex; flex-direction: column; gap: 1.8rem; }
.ho-timeline-track::before {
  content: ''; position: absolute; left: 9px; top: 12px; bottom: 12px; width: 2.5px;
  background: linear-gradient(to bottom, var(--ho-mint-400), var(--ho-teal-700), rgba(13, 122, 110, 0.15));
  border-radius: 999px;
}

.ho-tl-event {
  position: relative; display: flex; flex-direction: column; gap: 0.4rem;
  animation: hoSlideIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  opacity: 0; transform: translateX(-20px);
}
@keyframes hoSlideIn { to { opacity: 1; transform: translateX(0); } }
.ho-tl-event:nth-child(1) { animation-delay: 0.05s; }
.ho-tl-event:nth-child(2) { animation-delay: 0.12s; }
.ho-tl-event:nth-child(3) { animation-delay: 0.2s; }
.ho-tl-event:nth-child(4) { animation-delay: 0.28s; }
.ho-tl-event:nth-child(5) { animation-delay: 0.35s; }

/* Glowing Milestone Markers */
.ho-tl-marker {
  position: absolute; left: -2.48rem; top: 4px; width: 18px; height: 18px;
  border-radius: 50%; background: #fff; border: 4px solid var(--ho-teal-700);
  box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.8), 0 0 12px rgba(13, 122, 110, 0.3);
  z-index: 2; transition: transform 0.25s ease;
}
.ho-tl-event:hover .ho-tl-marker { transform: scale(1.3); }
.ho-tl-marker.report { border-color: var(--ho-teal-600); }
.ho-tl-marker.wearable { border-color: var(--ho-mint-400); }
.ho-tl-marker.med { border-color: var(--ho-coral); }
.ho-tl-marker.doctor { border-color: var(--ho-purple); }

.ho-tl-date-badge { font-family: 'JetBrains Mono', monospace; font-size: 0.76rem; font-weight: 800; color: var(--ho-teal-700); letter-spacing: 0.04em; text-transform: uppercase; }

.ho-tl-card {
  background: var(--ho-glass-solid); backdrop-filter: blur(35px) saturate(200%);
  border: 1.5px solid var(--ho-glass-border); border-radius: var(--ho-radius-lg);
  padding: 1.4rem 1.6rem; box-shadow: var(--ho-shadow-glass);
  cursor: pointer; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative; overflow: hidden;
}
.ho-tl-card:hover {
  transform: translateY(-3px) translateX(4px);
  border-color: var(--ho-teal-600);
  box-shadow: 0 16px 35px rgba(13, 122, 110, 0.1);
  background: #ffffff;
}

.ho-tl-card-header { display: flex; align-items: center; gap: 1rem; }
.ho-tl-icon {
  width: 44px; height: 44px; border-radius: 12px; display: flex;
  align-items: center; justify-content: center; font-size: 1.3rem; flex-shrink: 0;
}
.ho-tl-icon.report { background: rgba(16, 148, 133, 0.12); color: var(--ho-teal-700); }
.ho-tl-icon.wearable { background: rgba(66, 184, 157, 0.15); color: var(--ho-teal-900); }
.ho-tl-icon.med { background: var(--ho-coral-soft); color: var(--ho-coral); }
.ho-tl-icon.doctor { background: rgba(142, 68, 173, 0.12); color: var(--ho-purple); }

.ho-tl-card-body strong { display: block; font-size: 1.05rem; color: var(--ho-teal-900); font-weight: 800; margin-bottom: 0.2rem; }
.ho-tl-card-body p { font-size: 0.86rem; color: var(--ho-text-muted); line-height: 1.5; font-weight: 500; }

.ho-tl-pills { display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap; }
.ho-tl-pill {
  font-family: 'JetBrains Mono', monospace; font-size: 0.74rem; font-weight: 700;
  background: var(--ho-bg-airy); border: 1px solid var(--ho-glass-border-subtle);
  padding: 4px 10px; border-radius: 8px; color: var(--ho-teal-900);
}
.ho-tl-pill.alert { background: var(--ho-coral-soft); color: var(--ho-danger); border-color: rgba(217, 75, 75, 0.2); }

/* ==========================================================
   RIGHT PANE: MODULE 16 HEALTH JOURNEY REPLAY HUD
   ========================================================== */
.ho-replay-panel {
  position: sticky; top: 110px; height: calc(100vh - 140px);
  background: linear-gradient(145deg, var(--ho-teal-900) 0%, var(--ho-teal-700) 100%);
  border-radius: var(--ho-radius-xl); padding: 2.2rem; color: #fff;
  display: flex; flex-direction: column; justify-content: space-between;
  box-shadow: 0 25px 60px rgba(11, 94, 85, 0.25); overflow: hidden;
}
.ho-replay-panel::before {
  content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
  background: linear-gradient(115deg, transparent, rgba(255,255,255,0.08), transparent);
  transform: skewX(-20deg); animation: hoReplayShine 7s infinite; pointer-events: none;
}
@keyframes hoReplayShine { 0%, 100% { left: -100%; } 20% { left: 200%; } }

.ho-replay-header h2 { font-family: 'Fraunces', serif; font-size: 1.8rem; font-weight: 600; margin-bottom: 0.4rem; }
.ho-replay-header p { font-size: 0.9rem; color: #dcebe8; line-height: 1.5; font-weight: 500; }

/* Multimedia Scrubber Player */
.ho-player-ui {
  background: rgba(0, 0, 0, 0.22); border: 1px solid rgba(255, 255, 255, 0.15);
  padding: 1.4rem; border-radius: var(--ho-radius-lg); margin: 1.5rem 0;
  backdrop-filter: blur(20px);
}
.ho-month-label { font-family: 'JetBrains Mono', monospace; font-size: 1.25rem; font-weight: 800; text-align: center; color: var(--ho-mint-400); letter-spacing: 0.05em; margin-bottom: 1rem; }

.ho-scrubber-track {
  width: 100%; height: 8px; background: rgba(255, 255, 255, 0.18);
  border-radius: 999px; position: relative; cursor: pointer; margin-bottom: 1.4rem;
}
.ho-scrubber-fill { position: absolute; left: 0; top: 0; height: 100%; width: 68%; background: var(--ho-mint-400); border-radius: 999px; transition: width 0.3s ease; }
.ho-scrubber-thumb {
  position: absolute; left: 68%; top: 50%; transform: translate(-50%, -50%);
  width: 18px; height: 18px; background: #ffffff; border-radius: 50%;
  box-shadow: 0 0 12px rgba(0,0,0,0.4); cursor: grab; transition: left 0.3s ease;
}

.ho-controls { display: flex; justify-content: center; gap: 1.8rem; align-items: center; }
.ho-ctrl-btn { background: none; border: none; color: #fff; font-size: 1.3rem; cursor: pointer; opacity: 0.8; transition: 0.2s; }
.ho-ctrl-btn:hover { opacity: 1; transform: scale(1.15); }
.ho-play-btn {
  width: 48px; height: 48px; background: var(--ho-coral); border-radius: 50%;
  display: flex; align-items: center; justify-content: center; opacity: 1; font-size: 1.2rem;
  box-shadow: 0 6px 18px rgba(224, 122, 104, 0.45);
}
.ho-play-btn:hover { transform: scale(1.08); background: #d95a46; }

/* AI Replay Synopsis */
.ho-replay-summary {
  background: rgba(255, 255, 255, 0.09); border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: var(--ho-radius-lg); padding: 1.4rem; flex: 1; overflow-y: auto;
  backdrop-filter: blur(20px);
}
.ho-replay-summary h4 { font-family: 'Fraunces', serif; font-size: 1.05rem; margin-bottom: 0.6rem; display: flex; align-items: center; gap: 0.5rem; color: #fff; }
.ho-replay-summary p { font-size: 0.88rem; line-height: 1.6; color: #dcebe8; font-weight: 500; }

.ho-replay-kpi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem; }
.ho-r-kpi { background: rgba(0, 0, 0, 0.18); padding: 0.9rem 1rem; border-radius: 12px; }
.ho-r-kpi span { display: block; font-size: 0.68rem; text-transform: uppercase; color: #a4c9c3; font-weight: 800; letter-spacing: 0.05em; margin-bottom: 0.2rem; }
.ho-r-kpi strong { font-family: 'JetBrains Mono', monospace; font-size: 1.25rem; }

/* ==========================================================
   MICRO-INSPECTOR POPUP MODAL
   ========================================================== */
.ho-modal-overlay {
  position: fixed; inset: 0; background: rgba(11, 94, 85, 0.45);
  backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  display: flex; align-items: center; justify-content: center;
  z-index: 9999; opacity: 0; visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}
.ho-modal-overlay.active { opacity: 1; visibility: visible; }

.ho-modal-panel {
  width: 100%; max-width: 540px; background: #ffffff;
  border-radius: var(--ho-radius-xl); padding: 2.2rem;
  box-shadow: 0 30px 70px rgba(0,0,0,0.2); transform: translateY(30px) scale(0.96);
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex; flex-direction: column; gap: 1.4rem;
}
.ho-modal-overlay.active .ho-modal-panel { transform: translateY(0) scale(1); }

.ho-modal-head { display: flex; justify-content: space-between; align-items: flex-start; }
.ho-modal-head h3 { font-family: 'Fraunces', serif; font-size: 1.4rem; color: var(--ho-teal-900); font-weight: 700; }
.ho-modal-close {
  background: rgba(13, 122, 110, 0.08); border: none; width: 34px; height: 34px;
  border-radius: 50%; font-size: 1.2rem; color: var(--ho-teal-900); cursor: pointer;
  display: flex; align-items: center; justify-content: center; transition: 0.2s;
}
.ho-modal-close:hover { background: rgba(13, 122, 110, 0.16); }

.ho-detail-list { display: flex; flex-direction: column; gap: 0.75rem; }
.ho-detail-row { display: flex; justify-content: space-between; align-items: center; padding: 0.9rem 1.1rem; background: var(--ho-bg-airy); border-radius: 12px; }
.ho-detail-row label { font-size: 0.85rem; font-weight: 700; color: var(--ho-text-muted); }
.ho-detail-row span { font-family: 'JetBrains Mono', monospace; font-size: 0.95rem; font-weight: 800; color: var(--ho-teal-900); }

/* Responsive Adjustments */
@media (max-width: 1200px) {
  .ho-timeline-workspace { grid-template-columns: 1fr; }
  .ho-replay-panel { position: relative; top: 0; height: auto; margin-top: 1rem; }
}
@media (max-width: 768px) {
  .ho-topbar { padding: 1.5rem; flex-direction: column; align-items: flex-start; gap: 1rem; }
  .ho-timeline-workspace { padding: 1rem; }
  .ho-filter-bar { width: 100%; overflow-x: auto; scrollbar-width: none; }
}





@media (max-width: 1024px) {
    /* Using 'body .ho-main-content' makes this rule stronger than the original */
    body .ho-main-content {
       margin-top: 5.5rem;
        padding: 0 !important; 
    }
}
</style>
</head>
<body>

<!-- 2. Imports the superb 3-orb background you wanted -->
<%- include('../partials/ambient') %>

<div class="ho-app-layout">
  
  <%- include('../partials/sidebar') %>

  <main class="ho-main-content">
    
    <header class="ho-topbar">
      <div class="ho-topbar-text">
        <h1>Longitudinal Health Timeline</h1>
        <p><span class="ho-pulse-dot"></span> Normalized Multi-Source Ledger • Module 9 & 16 Architecture</p>
      </div>
      
      <!-- Category Filter Bar -->
      <div class="ho-filter-bar">
        <button class="ho-filter-btn active" onclick="filterTimeline('all', this)">All</button>
        <button class="ho-filter-btn" onclick="filterTimeline('report', this)">Reports</button>
        <button class="ho-filter-btn" onclick="filterTimeline('wearable', this)">Wearables</button>
        <button class="ho-filter-btn" onclick="filterTimeline('med', this)">Meds</button>
        <button class="ho-filter-btn" onclick="filterTimeline('doctor', this)">Consults</button>
      </div>
    </header>

    <div class="ho-timeline-workspace">
      
      <!-- LEFT PANE: INTERACTIVE VERTICAL TIMELINE -->
      <div class="ho-timeline-track" id="timelineTrack">
        
        <!-- EVENT 1: OCR REPORT -->
        <div class="ho-tl-event" data-type="report">
          <div class="ho-tl-marker report"></div>
          <span class="ho-tl-date-badge">Today • 10:42 AM</span>
          <div class="ho-tl-card" onclick="openEventInspector('cbc')">
            <div class="ho-tl-card-header">
              <div class="ho-tl-icon report">📄</div>
              <div class="ho-tl-card-body">
                <strong>Complete Blood Count (CBC) Uploaded</strong>
                <p>OCR engine extracted parameters. Vitamin D deficiency flagged for clinical review.</p>
              </div>
            </div>
            <div class="ho-tl-pills">
              <span class="ho-tl-pill">Hemoglobin: 13.2 g/dL</span>
              <span class="ho-tl-pill alert">Vitamin D: 18 ng/mL (Low)</span>
              <span class="ho-tl-pill">Platelets: 2.4 Lakh</span>
            </div>
          </div>
        </div>

        <!-- EVENT 2: MEDICATION STARTED -->
        <div class="ho-tl-event" data-type="med">
          <div class="ho-tl-marker med"></div>
          <span class="ho-tl-date-badge">Aug 18, 2026</span>
          <div class="ho-tl-card" onclick="openEventInspector('med_vitd')">
            <div class="ho-tl-card-header">
              <div class="ho-tl-icon med">💊</div>
              <div class="ho-tl-card-body">
                <strong>Prescription Initiated: Cholecalciferol</strong>
                <p>Therapeutic regimen added: 60,000 IU weekly dosage following morning meal.</p>
              </div>
            </div>
            <div class="ho-tl-pills">
              <span class="ho-tl-pill">Frequency: 1x / Week</span>
              <span class="ho-tl-pill">Duration: 8 Weeks</span>
            </div>
          </div>
        </div>

        <!-- EVENT 3: WEARABLE ANOMALY -->
        <div class="ho-tl-event" data-type="wearable">
          <div class="ho-tl-marker wearable"></div>
          <span class="ho-tl-date-badge">Aug 15, 2026</span>
          <div class="ho-tl-card" onclick="openEventInspector('bpm_anomaly')">
            <div class="ho-tl-card-header">
              <div class="ho-tl-icon wearable">⌚</div>
              <div class="ho-tl-card-body">
                <strong>Telemetry Shift: Elevated Resting BPM</strong>
                <p>Resting heart rate baseline shifted to 82 BPM over a continuous 3-day window.</p>
              </div>
            </div>
            <div class="ho-tl-pills">
              <span class="ho-tl-pill">Source: Apple HealthKit</span>
              <span class="ho-tl-pill alert">Deviation: +12% Baseline</span>
            </div>
          </div>
        </div>

        <!-- EVENT 4: DOCTOR CONSULTATION -->
        <div class="ho-tl-event" data-type="doctor">
          <div class="ho-tl-marker doctor"></div>
          <span class="ho-tl-date-badge">Aug 02, 2026</span>
          <div class="ho-tl-card" onclick="openEventInspector('dr_visit')">
            <div class="ho-tl-card-header">
              <div class="ho-tl-icon doctor">🩺</div>
              <div class="ho-tl-card-body">
                <strong>Physician Visit: Dr. Alex Morgan</strong>
                <p>Routine consultation. Doctor Visit Assistant generated pre-consult summary.</p>
              </div>
            </div>
            <div class="ho-tl-pills">
              <span class="ho-tl-pill">Care Hospitals</span>
              <span class="ho-tl-pill">Diagnosis: Vitals Review</span>
            </div>
          </div>
        </div>

        <!-- EVENT 5: DIAGNOSTIC REPORT -->
        <div class="ho-tl-event" data-type="report">
          <div class="ho-tl-marker report"></div>
          <span class="ho-tl-date-badge">Jul 28, 2026</span>
          <div class="ho-tl-card" onclick="openEventInspector('ecg_summary')">
            <div class="ho-tl-card-header">
              <div class="ho-tl-icon report">📈</div>
              <div class="ho-tl-card-body">
                <strong>Electrocardiogram (ECG) Report</strong>
                <p>Normal sinus rhythm confirmed. No acute ST-T wave abnormalities detected.</p>
              </div>
            </div>
            <div class="ho-tl-pills">
              <span class="ho-tl-pill">Heart Rate: 74 BPM</span>
              <span class="ho-tl-pill">Status: Normal</span>
            </div>
          </div>
        </div>

      </div>

      <!-- RIGHT PANE: MODULE 16 HEALTH JOURNEY REPLAY HUD -->
      <div>
        <div class="ho-replay-panel">
          
          <div class="ho-replay-header">
            <h2>Health Journey Replay</h2>
            <p>Scrub longitudinally through your normalized history. Observe how biometrics, lab values, and symptoms evolved over time.</p>
          </div>

          <!-- Multimedia Player UI -->
          <div class="ho-player-ui">
            <div class="ho-month-label" id="replayMonthLabel">AUGUST 2026</div>
            <div class="ho-scrubber-track" id="scrubberTrack" onclick="scrubTimeline(event)">
              <div class="ho-scrubber-fill" id="scrubberFill"></div>
              <div class="ho-scrubber-thumb" id="scrubberThumb"></div>
            </div>
            <div class="ho-controls">
              <button class="ho-ctrl-btn" onclick="stepMonth(-1)">⏮</button>
              <button class="ho-ctrl-btn ho-play-btn" id="playBtn" onclick="toggleReplay()">▶</button>
              <button class="ho-ctrl-btn" onclick="stepMonth(1)">⏭</button>
            </div>
          </div>

          <!-- AI Longitudinal Synopsis -->
          <div class="ho-replay-summary">
            <h4>✨ Longitudinal AI Summary</h4>
            <p id="replaySummaryText">
              During August, your resting heart rate exhibited a slight upward drift (+12%) following minor sleep reductions. Your uploaded CBC report revealed a Vitamin D deficiency (18 ng/mL), prompting the initiation of an 8-week Cholecalciferol protocol.
            </p>
            
            <div class="ho-replay-kpi-grid">
              <div class="ho-r-kpi">
                <span>Avg Resting BPM</span>
                <strong id="kpiBpm">78 <small style="font-size:0.75rem; font-family:sans-serif;">BPM</small></strong>
              </div>
              <div class="ho-r-kpi">
                <span>Reports Logged</span>
                <strong id="kpiReports">2 Docs</strong>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
      <%- include('../partials/footer') %>
  </main>
</div>

<!-- EVENT INSPECTION MODAL -->
<div class="ho-modal-overlay" id="eventModal" onclick="closeInspector(event)">
  <div class="ho-modal-panel" onclick="event.stopPropagation()">
    <div class="ho-modal-head">
      <h3 id="inspectTitle">Event Details</h3>
      <button class="ho-modal-close" onclick="closeInspector()">✕</button>
    </div>
    
    <p id="inspectDesc" style="font-size: 0.92rem; color: var(--ho-text-muted); line-height: 1.6;"></p>
    
    <div class="ho-detail-list" id="inspectDetails">
      <!-- Injected dynamically via JS -->
    </div>
  </div>
</div>

<script>
  // Filter Engine
  function filterTimeline(type, btn) {
    document.querySelectorAll('.ho-filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    const events = document.querySelectorAll('.ho-tl-event');
    events.forEach(el => {
      if (type === 'all' || el.getAttribute('data-type') === type) {
        el.style.display = 'flex';
      } else {
        el.style.display = 'none';
      }
    });
  }

  // Event Inspection Data Dictionary
  const eventDetails = {
    cbc: {
      title: "Complete Blood Count (CBC)",
      desc: "Multi-parameter hematology scan parsed via OCR. Correlated with dietary Vitamin D deficiency.",
      rows: [
        { label: "Hemoglobin", val: "13.2 g/dL (Normal)" },
        { label: "Vitamin D (25-OH)", val: "18.0 ng/mL (Low)" },
        { label: "WBC Count", val: "7,200 /µL (Normal)" },
        { label: "Source File", val: "Complete_Blood_Count.pdf" }
      ]
    },
    med_vitd: {
      title: "Cholecalciferol Therapy",
      desc: "High-dose Vitamin D3 replenishment protocol logged in your medication schedule.",
      rows: [
        { label: "Dosage", val: "60,000 IU" },
        { label: "Cadence", val: "Weekly (Sunday morning)" },
        { label: "Target", val: "Elevate serum level > 30 ng/mL" }
      ]
    },
    bpm_anomaly: {
      title: "Wearable Anomaly Flag",
      desc: "Multi-day biometric baseline deviation detected by HealthOrbit's statistical normalization engine.",
      rows: [
        { label: "Recorded Baseline", val: "82 BPM" },
        { label: "Historical Baseline", val: "68 - 72 BPM" },
        { label: "Sync Platform", val: "Apple HealthKit (REST Node)" }
      ]
    },
    dr_visit: {
      title: "Clinical Consultation",
      desc: "In-person assessment. The Doctor Visit Assistant module prepared clinical telemetry exports.",
      rows: [
        { label: "Provider", val: "Dr. Alex Morgan" },
        { label: "Location", val: "Care Hospitals, OPD Ward" },
        { label: "Outcome", val: "Initiated supplement protocol" }
      ]
    },
    ecg_summary: {
      title: "Standard 12-Lead ECG",
      desc: "Cardiac rhythm verification report uploaded and indexed in your medical records vault.",
      rows: [
        { label: "Rhythm", val: "Normal Sinus Rhythm" },
        { label: "Ventricular Rate", val: "74 BPM" },
        { label: "PR Interval", val: "148 ms" }
      ]
    }
  };

  const modal = document.getElementById('eventModal');

  function openEventInspector(key) {
    const data = eventDetails[key];
    if (!data) return;

    document.getElementById('inspectTitle').innerText = data.title;
    document.getElementById('inspectDesc').innerText = data.desc;

    const list = document.getElementById('inspectDetails');
    list.innerHTML = '';
    data.rows.forEach(r => {
      list.innerHTML += `
        <div class="ho-detail-row">
          <label>${r.label}</label>
          <span>${r.val}</span>
        </div>
      `;
    });

    modal.classList.add('active');
  }

  function closeInspector(e) {
    if (!e || e.target === modal) {
      modal.classList.remove('active');
    }
  }

  // Module 16 Replay Scrubber Simulation
  const months = [
    { name: "JUNE 2026", fill: "20%", bpm: "71 BPM", reports: "0 Docs", summary: "Stable physiological baseline. Sleep duration averaged 7.8 hours with consistent daily step cadence." },
    { name: "JULY 2026", fill: "50%", bpm: "73 BPM", reports: "1 Doc", summary: "ECG summary uploaded showing healthy sinus rhythm. Physical training load peaked during week 3." },
    { name: "AUGUST 2026", fill: "85%", bpm: "78 BPM", reports: "2 Docs", summary: "Resting BPM elevated to 82 BPM. CBC report revealed Vitamin D deficiency (18 ng/mL). Initiated weekly Cholecalciferol." }
  ];
  let currentMonthIndex = 2;
  let isPlaying = false;
  let playInterval = null;

  function updateReplayUI(index) {
    const m = months[index];
    document.getElementById('replayMonthLabel').innerText = m.name;
    document.getElementById('scrubberFill').style.width = m.fill;
    document.getElementById('scrubberThumb').style.left = m.fill;
    document.getElementById('replaySummaryText').innerText = m.summary;
    document.getElementById('kpiBpm').innerText = m.bpm;
    document.getElementById('kpiReports').innerText = m.reports;
  }

  function stepMonth(dir) {
    currentMonthIndex = (currentMonthIndex + dir + months.length) % months.length;
    updateReplayUI(currentMonthIndex);
  }

  function toggleReplay() {
    isPlaying = !isPlaying;
    const btn = document.getElementById('playBtn');
    if (isPlaying) {
      btn.innerText = '⏸';
      playInterval = setInterval(() => stepMonth(1), 2400);
    } else {
      btn.innerText = '▶';
      clearInterval(playInterval);
    }
  }

  function scrubTimeline(e) {
    const rect = e.currentTarget.getBoundingClientRect();
    const pos = (e.clientX - rect.left) / rect.width;
    currentMonthIndex = Math.min(Math.floor(pos * months.length), months.length - 1);
    updateReplayUI(currentMonthIndex);
  }
</script>

</body>
</html>