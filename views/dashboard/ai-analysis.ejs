      border: 1px solid rgba(13, 122, 110, 0.12);
    }

    /* 4 Interactive Hero KPI Tiles */
    .ho-hc-metrics { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .ho-hc-stat {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      padding: 0.75rem 1rem;
      background: rgba(255, 255, 255, 0.78);
