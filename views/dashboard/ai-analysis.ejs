<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HealthOrbit — AI Medical Analyst</title>
  <link rel="icon" href="/images/Logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/sidebar.css">
  <style>
    :root {
      --ho-bg-airy: #edf6f4;
      --ho-teal-900: #0b5e55;
      --ho-teal-800: #0c6b61;
      --ho-teal-700: #0d7a6e;
      --ho-teal-600: #109485;
      --ho-mint-400: #42b89d;
      --ho-coral: #e07a68;
      --ho-coral-soft: #fbe4de;
      --ho-text-main: #0f1c1a;
      --ho-text-muted: #4e6b63;
      
      --ho-glass-clear: rgba(255, 255, 255, 0.55);
      --ho-glass-solid: rgba(255, 255, 255, 0.88);
      --ho-glass-border: rgba(255, 255, 255, 0.95);
      --ho-glass-border-subtle: rgba(13, 122, 110, 0.15);
      
      --ho-radius-xl: 26px;
      --ho-radius-lg: 18px;
      --ho-radius-md: 12px;
      --ho-shadow-glass: 0 16px 40px rgba(13, 122, 110, 0.06), inset 0 1px 1px rgba(255, 255, 255, 1);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      min-height: 100vh;
      font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
      background-color: var(--ho-bg-airy);
      color: var(--ho-text-main);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      display: flex;
    }

    .ho-ambient-canvas { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
    .ho-glow-orb { position: absolute; border-radius: 50%; filter: blur(120px); opacity: 0.45; }
    .ho-orb-1 { width: 650px; height: 650px; background: #a3e4d7; top: -140px; left: -110px; }
    .ho-orb-2 { width: 600px; height: 600px; background: #fce4dc; bottom: -150px; right: -120px; }

    .ho-app-layout { display: flex; width: 100vw; height: 100vh; position: relative; z-index: 10; }
    .ho-main-content {
      flex: 1; min-width: 0; display: flex; flex-direction: column; height: 100vh;
      overflow-y: auto; scrollbar-width: none;
    }
    .ho-main-content::-webkit-scrollbar { display: none; }

    /* Topbar */
    .ho-topbar {
      display: flex; justify-content: space-between; align-items: center;
      padding: 2.2rem 3rem 1.4rem; flex-shrink: 0; position: sticky; top: 0;
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); z-index: 20;
    }
    .ho-topbar-text h1 {
      font-family: 'Fraunces', serif; font-weight: 800; font-size: 2.1rem;
      color: var(--ho-teal-900); letter-spacing: -0.8px; display: flex; align-items: center; gap: 0.7rem;
    }
    .ho-topbar-text p { font-size: 0.92rem; color: var(--ho-text-muted); font-weight: 600; margin-top: 0.2rem; }
    .ho-topbar-actions { display: flex; align-items: center; gap: 0.8rem; }
    
    .ho-ai-core-mini {
      width: 32px; height: 32px; border-radius: 50%; background: radial-gradient(circle, #fff, var(--ho-mint-400));
      position: relative; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 15px rgba(66, 184, 157, 0.5);
    }
    .ho-ai-core-mini::before {
      content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 1.5px dashed var(--ho-teal-700);
      animation: hoSpin 6s linear infinite;
    }
    @keyframes hoSpin { 100% { transform: rotate(360deg); } }

    .ho-btn-primary {
      padding: 0.75rem 1.6rem; background: linear-gradient(135deg, var(--ho-coral), #d46350); color: #fff;
      border-radius: 999px; font-weight: 700; font-size: 0.9rem; text-decoration: none; border: none; cursor: pointer;
      display: inline-flex; align-items: center; gap: 0.5rem; box-shadow: 0 6px 20px rgba(224, 122, 104, 0.3);
      transition: all 0.2s ease;
    }
    .ho-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(224, 122, 104, 0.4); }
    .ho-btn-ghost {
      padding: 0.75rem 1.5rem; background: var(--ho-glass-solid); border: 1px solid var(--ho-glass-border-subtle);
      border-radius: 999px; color: var(--ho-teal-900); font-weight: 700; font-size: 0.9rem; cursor: pointer;
      text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; transition: all 0.2s ease;
    }
    .ho-btn-ghost:hover { background: #fff; border-color: var(--ho-teal-600); transform: translateY(-1px); }

    /* Mosaic Grid */
    .ho-mosaic-grid {
      display: grid; grid-template-columns: repeat(12, 1fr); gap: 1.5rem;
      padding: 0.5rem 3rem 2.5rem; flex: 1;
    }
    .ho-panel {
      background: var(--ho-glass-clear);
      backdrop-filter: blur(35px) saturate(180%); -webkit-backdrop-filter: blur(35px) saturate(180%);
      border: 1px solid var(--ho-glass-border); border-radius: var(--ho-radius-xl);
      padding: 1.8rem; display: flex; flex-direction: column; box-shadow: var(--ho-shadow-glass);
      position: relative; overflow: hidden;
    }
    .ho-panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem; gap: 0.5rem; }
    .ho-panel-head h3 { font-family: 'Fraunces', serif; font-size: 1.2rem; font-weight: 700; color: var(--ho-teal-900); display: flex; align-items: center; gap: 0.5rem; }
    .ho-badge {
      background: rgba(13, 122, 110, 0.1); color: var(--ho-teal-700); padding: 4px 12px;
      border-radius: 999px; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;
      white-space: nowrap;
    }

    /* Section 1: Summary Banner */
    .ho-summary-banner { grid-column: span 12; background: linear-gradient(135deg, var(--ho-teal-900), #084039); color: #fff; border: none; padding: 2.2rem 2.8rem; }
    .ho-sum-layout { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; }
    .ho-sum-text h2 { font-family: 'Fraunces', serif; font-size: 1.75rem; font-weight: 700; line-height: 1.25; margin-bottom: 0.6rem; }
    .ho-sum-text p { font-size: 0.96rem; color: #dcebe8; line-height: 1.6; max-width: 850px; }
    .ho-report-meta-tag { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ho-mint-400); margin-bottom: 0.4rem; display: block; }

    /* Section 2: Report Switcher Strip */
    .ho-report-strip {
      grid-column: span 12; background: var(--ho-glass-solid); border: 1px solid var(--ho-glass-border-subtle);
      border-radius: var(--ho-radius-lg); padding: 1rem 1.6rem; display: flex; justify-content: space-between;
      align-items: center; flex-wrap: wrap; gap: 1rem;
    }
    .ho-strip-info { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .ho-strip-title { font-family: 'Fraunces', serif; font-weight: 700; font-size: 1.1rem; color: var(--ho-teal-900); margin-right: 0.5rem; }
    .ho-strip-pill { background: rgba(13, 122, 110, 0.08); padding: 4px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; color: var(--ho-teal-800); white-space: nowrap;}

    /* Section 3: Extracted Data Table (Truncated Cells) */
    .ho-table-panel { grid-column: span 12; }
    .ho-table-wrapper { width: 100%; overflow-x: auto; max-height: 440px; overflow-y: auto; scrollbar-width: thin; }
    .ho-ref-table { width: 100%; border-collapse: collapse; min-width: 650px; table-layout: fixed; }
    .ho-ref-table th {
      text-align: left; padding: 0.9rem 1.1rem; font-size: 0.74rem; color: var(--ho-text-muted);
      text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 2px solid var(--ho-glass-border-subtle);
      position: sticky; top: 0; background: #fff; z-index: 2;
    }
    /* Strictly Constrain Table Cells */
    .ho-ref-table td {
      padding: 0.95rem 1.1rem; border-bottom: 1px solid rgba(13, 122, 110, 0.08); font-size: 0.88rem; 
      color: var(--ho-teal-900); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .ho-ref-table th:nth-child(1), .ho-ref-table td:nth-child(1) { width: 35%; }
    .ho-ref-table th:nth-child(2), .ho-ref-table td:nth-child(2) { width: 20%; }
    .ho-ref-table tr:hover td { background: rgba(255, 255, 255, 0.65); }
    .mono-val { font-family: 'JetBrains Mono', monospace; font-weight: 800; font-size: 0.95rem; }

    /* Pills */
    .ho-pill { display: inline-flex; padding: 3px 9px; border-radius: 999px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.03em; white-space: nowrap; }
    .ho-pill.good { background: #dff1ec; color: var(--ho-teal-800); }
    .ho-pill.warn { background: var(--ho-coral-soft); color: #c0392b; }
    .ho-pill.neutral { background: rgba(94, 115, 111, 0.1); color: var(--ho-text-muted); }

    /* Section 4 & 5: Findings & Explanation */
    .ho-findings-panel { grid-column: span 6; }
    .ho-finding-feed { display: flex; flex-direction: column; gap: 0.85rem; }
    .ho-finding-card {
      display: flex; align-items: flex-start; justify-content: space-between; padding: 1.1rem 1.3rem;
      background: rgba(255,255,255,0.78); border: 1px solid var(--ho-glass-border-subtle); border-radius: 14px;
      transition: all 0.2s ease; gap: 1rem; width: 100%;
    }
    .ho-finding-card:hover { background: #fff; transform: translateX(3px); border-color: var(--ho-teal-600); }
    
    /* Strict Truncation for Hallucinated OCR Content */
    .ho-fc-left { display: flex; align-items: flex-start; gap: 0.9rem; min-width: 0; flex: 1; }
    .ho-fc-meta { min-width: 0; flex: 1; }
    .ho-fc-meta strong { 
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;
      font-size: 0.95rem; color: var(--ho-teal-900); font-weight: 800; line-height: 1.3; margin-bottom: 0.2rem; word-break: break-word;
    }
    .ho-fc-meta span { 
      font-size: 0.74rem; color: var(--ho-text-muted); font-weight: 600; 
      display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .ho-fc-val { 
      font-family: 'JetBrains Mono', monospace; font-size: 1.1rem; font-weight: 800; text-align: right; 
      color: var(--ho-teal-900); flex-shrink: 0; max-width: 35%; word-break: break-all;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .ho-fc-val small { font-size: 0.72rem; color: var(--ho-text-muted); font-family: 'Plus Jakarta Sans', sans-serif; display: block; margin-top: 0.2rem;}

    .ho-explanation-panel { grid-column: span 6; }
    .ho-expl-box {
      background: rgba(255,255,255,0.85); border: 1px solid var(--ho-glass-border-subtle); border-left: 4px solid var(--ho-mint-400);
      border-radius: 16px; padding: 1.6rem; height: 100%; display: flex; flex-direction: column; justify-content: center;
    }
    .ho-expl-box h4 { font-family: 'Fraunces', serif; font-size: 1.15rem; color: var(--ho-teal-900); margin-bottom: 0.6rem; }
    .ho-expl-box p { font-size: 0.92rem; color: var(--ho-text-muted); line-height: 1.65; font-weight: 500; }

    /* Section 6 & 7: Longitudinal & Synthesis */
    .ho-comparison-panel { grid-column: span 6; }
    .ho-comp-card {
      background: linear-gradient(135deg, #fff, rgba(223, 241, 236, 0.65)); border: 1.5px solid var(--ho-mint-400);
      border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.9rem; margin-bottom: 0.8rem;
    }
    .ho-comp-card:last-child { margin-bottom: 0; }
    .ho-comp-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
    .ho-comp-header strong { font-family: 'Fraunces', serif; font-size: 1.15rem; color: var(--ho-teal-900); display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;}
    .ho-comp-badge { background: rgba(46, 204, 113, 0.15); color: #27ae60; font-size: 0.75rem; font-weight: 800; padding: 4px 10px; border-radius: 999px; white-space: nowrap;}
    .ho-comp-metrics { display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.75); padding: 0.9rem 1.2rem; border-radius: 12px; }
    .ho-cm-col { min-width: 0; }
    .ho-cm-col span { display: block; font-size: 0.7rem; color: var(--ho-text-muted); text-transform: uppercase; font-weight: 800; margin-bottom: 0.2rem; }
    .ho-cm-col strong { font-family: 'JetBrains Mono', monospace; font-size: 1.15rem; color: var(--ho-teal-900); word-break: break-all; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;}
    .ho-arrow-icon { color: var(--ho-text-muted); font-weight: 800; font-size: 1.1rem; padding: 0 0.5rem;}

    .ho-ai-summary-panel { grid-column: span 6; }
    .ho-ai-text-box {
      background: var(--ho-teal-900); color: #fff; border-radius: 16px; padding: 1.8rem;
      box-shadow: 0 10px 25px rgba(11, 94, 85, 0.15); height: 100%; display: flex; align-items: center;
    }
    .ho-ai-text-box p { font-size: 0.96rem; line-height: 1.65; color: #dcebe8; font-weight: 500; }

    /* Section 8: Doctor Questions */
    .ho-doctor-panel { grid-column: span 12; }
    .ho-qa-feed { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1rem; }
    .ho-qa-item {
      display: flex; gap: 0.9rem; align-items: flex-start; padding: 1.1rem 1.3rem;
      background: rgba(255,255,255,0.8); border: 1px solid var(--ho-glass-border-subtle); border-radius: 14px;
    }
    .ho-qa-num {
      width: 26px; height: 26px; border-radius: 50%; background: var(--ho-teal-900); color: #fff;
      display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; flex-shrink: 0;
    }
    .ho-qa-item p { font-size: 0.9rem; color: var(--ho-teal-900); font-weight: 600; line-height: 1.5; }

    /* Section 9: Report Vault */
    .ho-vault-panel { grid-column: span 12; }
    .ho-vault-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
    .ho-vault-card {
      background: rgba(255,255,255,0.78); border: 1px solid var(--ho-glass-border-subtle); border-radius: var(--ho-radius-md);
      padding: 1.1rem 1.3rem; display: flex; flex-direction: column; justify-content: space-between; gap: 0.8rem; transition: all 0.2s;
    }
    .ho-vault-card.active { border-color: var(--ho-teal-700); background: #eef8f5; box-shadow: 0 6px 18px rgba(13, 122, 110, 0.08); }
    .ho-vault-card:hover:not(.active) { background: #fff; border-color: var(--ho-teal-600); transform: translateY(-2px); }
    .ho-vc-title { font-weight: 800; font-size: 0.95rem; color: var(--ho-teal-900); display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; word-break: break-all;}

    /* Section 10: Safety Notice */
    .ho-disclaimer-panel {
      grid-column: span 12; background: rgba(239, 111, 91, 0.06); border: 1.5px dashed rgba(239, 111, 91, 0.4);
      border-radius: 16px; padding: 1.2rem; text-align: center;
    }
    .ho-disclaimer-panel p {
      font-size: 0.85rem; color: #a13d2d; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    }

    /* Empty state */
    .ho-empty-box { text-align: center; padding: 2rem 1.5rem; color: var(--ho-text-muted); }
    .ho-empty-box p { font-size: 0.88rem; font-weight: 600; }

    /* Mobile Responsive Stack */
    @media (max-width: 1024px) {
      .ho-app-layout { flex-direction: column !important; }
      .ho-main-content { height: auto !important; margin-top: 5.5rem; padding: 0 !important; }
      .ho-mosaic-grid { display: flex !important; flex-direction: column !important; padding: 1rem 1.2rem 2.5rem !important; gap: 1.2rem !important; }
      .ho-panel { width: 100% !important; padding: 1.4rem !important; }
      .ho-topbar { flex-direction: column; align-items: flex-start; padding: 1.4rem 1.2rem 0.8rem; gap: 1rem; }
      .ho-sum-layout { flex-direction: column; align-items: flex-start; }
      .ho-strip-info { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>

<div class="ho-ambient-canvas">
  <div class="ho-glow-orb ho-orb-1"></div>
  <div class="ho-glow-orb ho-orb-2"></div>
</div>

<div class="ho-app-layout">
  <%- include('../partials/sidebar') %>

  <main class="ho-main-content">
    <header class="ho-topbar">
      <div class="ho-topbar-text">
        <h1><div class="ho-ai-core-mini"></div> <b style="color: var(--ho-coral);">AI</b> Medical Analyst</h1>
        <p>Translating complex medical reports into simple, understandable health information.</p>
      </div>
      <div class="ho-topbar-actions">
        <% if (analysisView && analysisView.selectedReport) { %>
          <a href="/ocr?reportId=<%= analysisView.selectedReport.id %>" class="ho-btn-ghost">View Original Report</a>
        <% } %>
        <a href="/ocr" class="ho-btn-primary">+ Upload Report</a>
      </div>
    </header>

    <div class="ho-mosaic-grid">

      <!-- SECTION 1: CLINICAL REPORT BREAKDOWN -->
      <section class="ho-panel ho-summary-banner">
        <div class="ho-sum-layout">
          <div class="ho-sum-text">
            <span class="ho-report-meta-tag">Clinical Report Breakdown</span>
            <h2>What does my medical report mean?</h2>
            <p>
              <% if (analysisView && analysisView.synthesisSummary) { %>
                <%= analysisView.synthesisSummary %>
              <% } else { %>
                Upload or select a processed medical report to inspect structured health measurements and longitudinal comparisons.
              <% } %>
            </p>
          </div>
          <div class="ho-badge" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3);">
            Status: <%= (analysisView && analysisView.selectedReport) ? analysisView.selectedReport.status : 'Standby' %>
          </div>
        </div>
      </section>

      <!-- SECTION 2: REPORT IDENTITY STRIP -->
      <% if (analysisView && analysisView.selectedReport) { %>
        <div class="ho-report-strip">
          <div class="ho-strip-info">
            <span class="ho-strip-title"><%= analysisView.selectedReport.title %></span>
            <span class="ho-strip-pill"><%= analysisView.selectedReport.fileName %></span>
            <span class="ho-strip-pill"><%= new Date(analysisView.selectedReport.uploadedAt).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
            <span class="ho-strip-pill"><%= analysisView.selectedReport.parameterCount %> Parameters Extracted</span>
          </div>
          <div>
            <a href="/ocr?reportId=<%= analysisView.selectedReport.id %>" class="ho-btn-ghost" style="padding: 0.45rem 1rem; font-size: 0.78rem;">
              Inspect Raw Text & Verification
            </a>
          </div>
        </div>
      <% } %>

      <!-- SECTION 3: EXTRACTED DATA TABLE -->
      <section class="ho-panel ho-table-panel">
        <div class="ho-panel-head">
          <h3><span>📊</span> Extracted Clinical Measurements</h3>
          <span class="ho-badge"><%= (analysisView && analysisView.extractedParameters) ? analysisView.extractedParameters.length : 0 %> Identified</span>
        </div>

        <% if (analysisView && analysisView.extractedParameters && analysisView.extractedParameters.length > 0) { %>
          <div class="ho-table-wrapper">
            <table class="ho-ref-table">
              <thead>
                <tr>
                  <th>Test Parameter</th>
                  <th>Observed Result</th>
                  <th>Unit</th>
                  <th>Printed Reference Range</th>
                  <th>Evaluation</th>
                </tr>
              </thead>
              <tbody>
                <% analysisView.extractedParameters.forEach(row => { %>
                  <tr>
                    <% const cleanName = row.name && row.name.length > 60 ? row.name.substring(0, 60) + '...' : row.name; %>
                    <td title="<%= row.name %>"><strong><%= cleanName %></strong></td>
                    <% const cleanVal = row.value && row.value.length > 30 ? row.value.substring(0, 30) + '...' : row.value; %>
                    <td class="mono-val" title="<%= row.value %>"><%= cleanVal %></td>
                    <td><%= row.unit || '—' %></td>
                    <td title="<%= row.referenceRange %>"><%= row.referenceRange && row.referenceRange.length > 40 ? row.referenceRange.substring(0, 40) + '...' : row.referenceRange %></td>
                    <td><span class="ho-pill <%= row.statusClass %>"><%= row.status %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="ho-empty-box">
            <p>No extracted parameters available for the active report.</p>
          </div>
        <% } %>
      </section>

      <!-- SECTION 4: IMPORTANT FINDINGS -->
      <section class="ho-panel ho-findings-panel">
        <div class="ho-panel-head">
          <h3><span>🔍</span> Important Findings</h3>
          <span class="ho-badge">Priority Review</span>
        </div>

        <div class="ho-finding-feed">
          <% if (analysisView && analysisView.importantFindings && analysisView.importantFindings.length > 0) { %>
            <% analysisView.importantFindings.forEach(finding => { %>
              <div class="ho-finding-card">
                <div class="ho-fc-left">
                  <span class="ho-pill <%= finding.statusClass %>"><%= finding.status %></span>
                  <div class="ho-fc-meta">
                    <% const cleanFndName = finding.name && finding.name.length > 80 ? finding.name.substring(0, 80) + '...' : finding.name; %>
                    <strong title="<%= finding.name %>"><%= cleanFndName %></strong>
                    <% const cleanRef = finding.referenceRange && finding.referenceRange.length > 40 ? finding.referenceRange.substring(0, 40) + '...' : finding.referenceRange; %>
                    <span title="<%= finding.referenceRange %>">Ref: <%= cleanRef %></span>
                  </div>
                </div>
                <div class="ho-fc-val" title="<%= finding.value %>">
                  <% const cleanFndVal = finding.value && finding.value.length > 25 ? finding.value.substring(0, 25) + '...' : finding.value; %>
                  <%= cleanFndVal %> <small><%= finding.unit %></small>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="ho-empty-box">
              <p>No prioritized clinical findings identified.</p>
            </div>
          <% } %>
        </div>
      </section>

      <!-- SECTION 5: PLAIN ENGLISH EXPLANATION -->
      <section class="ho-panel ho-explanation-panel">
        <div class="ho-panel-head">
          <h3><span>💡</span> Plain English Explanation</h3>
          <span class="ho-badge">Jargon Free</span>
        </div>

        <div class="ho-expl-box">
          <h4>Understanding Your Results</h4>
          <p>
            <% if (analysisView && analysisView.plainEnglishExplanation) { %>
              <%= analysisView.plainEnglishExplanation %>
            <% } else { %>
              HealthOrbit analyzes extracted values against the reference ranges printed in your clinical record. Select a report to read an understandable explanation of its contents.
            <% } %>
          </p>
        </div>
      </section>

      <!-- SECTION 6: CHANGE OVER TIME (LONGITUDINAL) -->
      <section class="ho-panel ho-comparison-panel">
        <div class="ho-panel-head">
          <h3><span>📈</span> Longitudinal Comparison</h3>
          <span class="ho-badge">Timeline Tracking</span>
        </div>

        <% if (analysisView && analysisView.longitudinalComparisons && analysisView.longitudinalComparisons.length > 0) { %>
          <% analysisView.longitudinalComparisons.forEach(item => { %>
            <div class="ho-comp-card">
              <div class="ho-comp-header">
                <strong title="<%= item.metric %>"><%= item.metric %></strong>
                <span class="ho-comp-badge"><%= item.trajectoryNote || item.changeStr %></span>
              </div>

              <div class="ho-comp-metrics">
                <div class="ho-cm-col">
                  <span>Previous Reading (<%= new Date(item.previousDate).toLocaleDateString() %>)</span>
                  <strong title="<%= item.previousValue %>"><%= item.previousValue %> <%= item.unit %></strong>
                </div>
                <div class="ho-arrow-icon">➔</div>
                <div class="ho-cm-col" style="text-align: right;">
                  <span>Current Reading</span>
                  <strong title="<%= item.currentValue %>"><%= item.currentValue %> <%= item.unit %></strong>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="ho-empty-box">
            <p>No previous comparable HealthOrbit measurement is available for this report's metrics.</p>
          </div>
        <% } %>
      </section>

      <!-- SECTION 7: AI SYNTHESIS SUMMARY -->
      <section class="ho-panel ho-ai-summary-panel">
        <div class="ho-panel-head">
          <h3><span>✨</span> AI Synthesis Summary</h3>
          <span class="ho-badge">Factual Context</span>
        </div>

        <div class="ho-ai-text-box">
          <p>
            <% if (analysisView && analysisView.synthesisSummary) { %>
              "<%= analysisView.synthesisSummary %>"
            <% } else { %>
              "Select a processed clinical document to view a verified synthesis comparing findings with your historical records."
            <% } %>
          </p>
        </div>
      </section>

      <!-- SECTION 8: QUESTIONS TO ASK YOUR DOCTOR -->
      <section class="ho-panel ho-doctor-panel">
        <div class="ho-panel-head">
          <h3><span>🗣️</span> Questions to Ask Your Doctor</h3>
          <span class="ho-badge">Doctor Discussion Support</span>
        </div>

        <div class="ho-qa-feed">
          <% if (analysisView && analysisView.doctorQuestions && analysisView.doctorQuestions.length > 0) { %>
            <% analysisView.doctorQuestions.forEach((q, idx) => { %>
              <div class="ho-qa-item">
                <div class="ho-qa-num"><%= idx + 1 %></div>
                <p><%= q %></p>
              </div>
            <% }) %>
          <% } else { %>
            <div class="ho-qa-item">
              <div class="ho-qa-num">1</div>
              <p>Are there any specific lifestyle or dietary habits relevant to interpreting these lab results?</p>
            </div>
          <% } %>
        </div>
      </section>

      <!-- SECTION 9: RECENT REPORTS VAULT -->
      <section class="ho-panel ho-vault-panel">
        <div class="ho-panel-head">
          <h3><span>📁</span> Medical Report Archive</h3>
          <span class="ho-badge"><%= (analysisView && analysisView.recentReports) ? analysisView.recentReports.length : 0 %> Reports Available</span>
        </div>

        <% if (analysisView && analysisView.recentReports && analysisView.recentReports.length > 0) { %>
          <div class="ho-vault-grid">
            <% analysisView.recentReports.forEach(rep => { 
              const isSelected = analysisView.selectedReport && analysisView.selectedReport.id === rep._id.toString();
            %>
              <div class="ho-vault-card <%= isSelected ? 'active' : '' %>">
                <div>
                  <div class="ho-vc-title" title="<%= rep.originalFileName %>"><%= rep.originalFileName %></div>
                  <div style="font-size: 0.75rem; color: var(--ho-text-muted); margin-top: 0.2rem;">
                    <%= new Date(rep.createdAt).toLocaleDateString() %> • <%= (rep.extractedData && rep.extractedData.parameters) ? rep.extractedData.parameters.length : 0 %> Parameters
                  </div>
                </div>
                <div style="display: flex; gap: 0.5rem; margin-top: 0.4rem;">
                  <a href="/ai-analysis?reportId=<%= rep._id %>" class="ho-btn-ghost" style="padding: 0.4rem 0.8rem; font-size: 0.78rem; flex: 1; justify-content: center;">
                    <%= isSelected ? 'Active Focus' : 'Analyze' %>
                  </a>
                  <a href="/ocr?reportId=<%= rep._id %>" class="ho-btn-ghost" style="padding: 0.4rem 0.8rem; font-size: 0.78rem;">
                    Original
                  </a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="ho-empty-box">
            <p>Your uploaded reports will be archived here.</p>
          </div>
        <% } %>
      </section>

      <!-- SECTION 10: SAFETY DISCLAIMER -->
      <div class="ho-disclaimer-panel">
        <p>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          HealthOrbit provides automated health-information summaries and decision support based on available user data. It does not provide medical diagnosis or replace professional medical advice.
        </p>
      </div>

    </div>

    <%- include('../partials/footer') %>
  </main>
</div>

</body>
</html>