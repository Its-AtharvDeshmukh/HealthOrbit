  /* ==================================================================
     SERVER-SIDE VIEW MODEL (100% REAL BACKEND VARIABLES ONLY)
  ================================================================== */
  const aView = (typeof analysisView !== 'undefined' && analysisView) ? analysisView : null;
  const selRep = (aView && aView.selectedReport) ? aView.selectedReport : null;
  const allParams = (aView && Array.isArray(aView.extractedParameters)) ? aView.extractedParameters : [];
  const findings = (aView && Array.isArray(aView.importantFindings)) ? aView.importantFindings : [];
  const comparisons = (aView && Array.isArray(aView.longitudinalComparisons)) ? aView.longitudinalComparisons : [];
  const questions = (aView && Array.isArray(aView.doctorQuestions)) ? aView.doctorQuestions : [];
  const reportsList = (aView && Array.isArray(aView.recentReports)) ? aView.recentReports : [];

  const totalParamsCount = selRep && selRep.parameterCount ? selRep.parameterCount : allParams.length;
  const outsideRangeCount = allParams.filter(p => p.statusClass === 'warn').length;
  const withinRangeCount = allParams.filter(p => p.statusClass === 'good').length;
  const neutralRangeCount = Math.max(0, allParams.length - outsideRangeCount - withinRangeCount);
  const comparedCount = comparisons.filter(c => c.hasComparison).length;

  /* Parse printed numeric reference range bounds deterministically */
  function parseRangeBounds(valStr, rangeStr) {
    if (!rangeStr || typeof rangeStr !== 'string') return null;
    const cleanVal = parseFloat(String(valStr || '').replace(/,/g, '').trim());
    if (isNaN(cleanVal)) return null;
    const cleanRange = rangeStr.replace(/,/g, '').trim();
    const dashMatch = cleanRange.match(/([\d.]+)\s*(?:-|to|–)\s*([\d.]+)/i);
    if (dashMatch) {
      const low = parseFloat(dashMatch[1]);
      const high = parseFloat(dashMatch[2]);
      if (!isNaN(low) && !isNaN(high) && high > low) {
        const span = high - low;
        const minScale = low - span * 0.28;
        const maxScale = high + span * 0.28;
        const pct = Math.max(5, Math.min(95, ((cleanVal - minScale) / (maxScale - minScale)) * 100));
        return {
          hasBounds: true,
          low,
          high,
          val: cleanVal,
          markerPct: Number(pct.toFixed(1)),
          zoneLeftPct: Number((((low - minScale) / (maxScale - minScale)) * 100).toFixed(1)),
          zoneWidthPct: Number(((span / (maxScale - minScale)) * 100).toFixed(1))
        };
      }
    }
    return null;
  }

  const enrichedParams = allParams.map((p, idx) => {
    const bounds = parseRangeBounds(p.value, p.referenceRange);
    const pNameLower = String(p.name || '').toLowerCase().trim();
    const matchedComp = comparisons.find(c =>
      c.hasComparison &&
      (String(c.metric || '').toLowerCase().trim() === pNameLower ||
       pNameLower.includes(String(c.metric || '').toLowerCase().trim()) ||
       String(c.metric || '').toLowerCase().trim().includes(pNameLower))
    ) || null;
    const numVal = parseFloat(String(p.value || '').replace(/,/g, '').trim());

    return {
      idx,
      name: p.name || 'Parameter',
      value: p.value !== undefined && p.value !== null ? String(p.value) : '--',
      numericValue: !isNaN(numVal) && /^-?\d+(\.\d+)?$/.test(String(p.value || '').replace(/,/g, '').trim()) ? numVal : null,
      unit: p.unit || '',
      referenceRange: p.referenceRange || 'Not provided in report',
      category: p.category || 'Clinical Panel',
      status: p.status || 'Observed',
      statusClass: p.statusClass || 'neutral',
      bounds,
      comparison: matchedComp
    };
  });
%>

  <style>
    /* ==================================================================
       AI MEDICAL ANALYST STUDIO — PREMIUM BENTO GLASS DESIGN SYSTEM
    ================================================================== */
    :root {
      --ho-bg-airy: #edf6f4;
      --ho-teal-950: #06302b;
      --ho-teal-900: #0b5e55;
      --ho-teal-800: #0c6b61;
      --ho-teal-700: #0d7a6e;
      --ho-teal-600: #109485;
      --ho-mint-400: #42b89d;
      --ho-mint-200: #9be8d3;
      --ho-mint-soft: #dff1ec;
      --ho-coral: #e07a68;
      --ho-coral-soft: #fbe4de;
      --ho-amber: #e09a2b;
      --ho-blue: #3b82f6;
      --ho-blue-soft: #dbeafe;
      --ho-green: #27ae60;
      --ho-red: #e5484d;
      --ho-text-main: #0f1c1a;
      --ho-text-muted: #4e6b63;
      --ho-text-subtle: #78948d;

      --ho-glass-clear: rgba(255, 255, 255, 0.56);
      --ho-glass-solid: rgba(255, 255, 255, 0.9);
      --ho-glass-border: rgba(255, 255, 255, 0.95);
      --ho-glass-border-subtle: rgba(13, 122, 110, 0.14);

      --ho-radius-xl: 28px;
      --ho-radius-lg: 20px;
      --ho-radius-md: 14px;
      --ho-shadow-glass: 0 20px 50px rgba(13, 122, 110, 0.08), inset 0 1px 1px rgba(255, 255, 255, 1);
      --ho-shadow-elevated: 0 26px 56px rgba(13, 122, 110, 0.15);
      --ho-ease: cubic-bezier(0.16, 1, 0.3, 1);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { -webkit-tap-highlight-color: transparent; }

    body {
      min-height: 100vh;
      min-height: 100dvh;
      font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
      background-color: var(--ho-bg-airy);
      color: var(--ho-text-main);
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
      display: flex;
    }

    /* ---------- Custom Visible Scrollbars (.ho-custom-scroll) ---------- */
    .ho-custom-scroll {
      scrollbar-width: thin;
      scrollbar-color: rgba(13, 122, 110, 0.34) rgba(13, 122, 110, 0.05);
    }
    .ho-custom-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
    .ho-custom-scroll::-webkit-scrollbar-track { background: rgba(13, 122, 110, 0.05); border-radius: 999px; }
    .ho-custom-scroll::-webkit-scrollbar-thumb { background: rgba(13, 122, 110, 0.34); border-radius: 999px; }
    .ho-custom-scroll::-webkit-scrollbar-thumb:hover { background: var(--ho-teal-600); }

    /* ---------- Ambient Dynamic Glow Orbs ---------- */
    .ho-ambient-canvas { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
    .ho-glow-orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.6; animation: hoFloatOrb 20s ease-in-out infinite alternate; }
    .ho-orb-1 { width: 580px; height: 580px; background: #76d7c4; top: -120px; left: -100px; }
    .ho-orb-2 { width: 620px; height: 620px; background: #fadbd8; bottom: -160px; right: -100px; animation-delay: -5s; }
    .ho-orb-3 { width: 400px; height: 400px; background: #85c1e9; top: 36%; left: 42%; opacity: 0.28; animation-delay: -10s; }
    @keyframes hoFloatOrb { 0% { transform: translate(0, 0) scale(1); } 100% { transform: translate(55px, 65px) scale(1.14); } }

    /* ---------- App Layout & Top Scroll Progress ---------- */
    .ho-app-layout { display: flex; width: 100vw; height: 100vh; height: 100dvh; position: relative; z-index: 10; }
    .ho-main-content {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      height: 100vh;
      height: 100dvh;
      overflow-y: auto;
      overflow-x: hidden;
      scroll-behavior: smooth;
    }

    .ho-scroll-progress {
      position: fixed; top: 0; left: 0; height: 3px; width: 0; z-index: 3000;
      background: linear-gradient(90deg, var(--ho-mint-400), var(--ho-coral));
      border-radius: 0 3px 3px 0;
      transition: width 0.1s linear;
    }

    /* ---------- Sticky Studio Topbar ---------- */
    .ho-topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
      padding: 2rem 3rem 1.2rem;
      flex-shrink: 0;
      background: transparent;
      z-index: 20;
      position: sticky;
      top: 0;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      mask-image: linear-gradient(to bottom, black 82%, transparent);
      -webkit-mask-image: linear-gradient(to bottom, black 82%, transparent);
      animation: hoDrop 0.65s var(--ho-ease) both;
    }
    @keyframes hoDrop { from { opacity: 0; transform: translateY(-16px); } to { opacity: 1; transform: none; } }

    .ho-eyebrow-pill {
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.11em;
      text-transform: uppercase;
      color: var(--ho-teal-700);
      margin-bottom: 0.35rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .ho-pulse-dot {
      width: 8px; height: 8px;
      background: var(--ho-mint-400);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--ho-mint-400);
      animation: hoPulse 2s infinite;
      flex-shrink: 0;
    }
    @keyframes hoPulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.5); } }

    .ho-topbar-text h1 {
      font-family: 'Fraunces', serif;
      font-weight: 800;
      font-size: 2.2rem;
