    .ho-tag.good { background: var(--ho-mint-soft); color: var(--ho-teal-900); }
    .ho-tag.blue { background: var(--ho-blue-soft); color: #1d4ed8; }

    /* ==================================================================
       1. STUDIO HERO (SPAN 8) — BIOSTATISTICAL RINGS + WAVEFORM SCANNER
    ================================================================== */
    .ho-hero {
      grid-column: span 8;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.75rem;
      padding: 2.2rem 2.4rem;
      background:
        radial-gradient(90% 120% at 100% 0%, rgba(66, 184, 157, 0.18), transparent 60%),
        radial-gradient(80% 100% at 0% 100%, rgba(224, 122, 104, 0.12), transparent 60%),
        linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(236, 248, 245, 0.92));
      border: 1.5px solid var(--ho-glass-border);
    }
    .ho-hero-text { flex: 1; z-index: 2; min-width: 0; }
    .ho-hero-eyebrow {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--ho-teal-700);
      font-weight: 800;
      display: flex;
