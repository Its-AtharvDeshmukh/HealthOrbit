    .ho-topbar-text h1 b { color: var(--ho-coral); font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; }

    .ho-topbar-actions { display: flex; gap: 0.7rem; align-items: center; flex-wrap: wrap; }
