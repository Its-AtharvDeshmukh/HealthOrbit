<!DOCTYPE html>
<html lang="en">
<link rel="icon" href="/images/Logo.png">
<head>
<!-- 1. Imports your common Fonts, Title, and Global CSS -->
<%- include('../partials/header', { title: 'Longitudinal Health Timeline' }) %>
<!-- < %- include('../partials/header', { title: 'HealthOrbit - Profile & Privacy', cssFile: 'profile' }) % > -->
<style>
/* 
==================================================================
  STRICTLY SCOPED CSS FOR AI ANALYSIS (DESKTOP FINAL)
================================================================== 
*/
:root {
  --ho-bg-airy: #edf6f4;
  --ho-teal-900: #0b5e55;
  --ho-teal-700: #0d7a6e;
  --ho-teal-600: #109485;
  --ho-mint-400: #42b89d;
  --ho-coral: #e07a68;
  --ho-text-main: #0f1c1a;
  --ho-text-muted: #4e6b63;
  --ho-danger: #d94b4b;
  
  --ho-glass-clear: rgba(255, 255, 255, 0.45);
  --ho-glass-solid: rgba(255, 255, 255, 0.85);
  --ho-glass-border: rgba(255, 255, 255, 0.95);
  --ho-glass-border-subtle: rgba(13, 122, 110, 0.15);
  
  --ho-radius-xl: 28px;
  --ho-radius-lg: 20px;
  --ho-radius-md: 12px;
  --ho-shadow-glass: 0 20px 50px rgba(13, 122, 110, 0.08), inset 0 1px 1px rgba(255, 255, 255, 1);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body { min-height: 100vh; font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; background-color: var(--ho-bg-airy); color: var(--ho-text-main); overflow-x: hidden; -webkit-font-smoothing: antialiased; display: flex; }

/* ---------- AMBIENT ORBS ---------- */
/* .ho-ambient-canvas { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
.ho-glow-orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.65; animation: hoFloatOrb 20s ease-in-out infinite alternate; }
.ho-orb-1 { width: 600px; height: 600px; background: #76d7c4; top: -150px; left: -100px; }
.ho-orb-2 { width: 700px; height: 700px; background: #a9dfbf; bottom: -200px; right: -150px; animation-delay: -5s; }
@keyframes hoFloatOrb { 0% { transform: translate(0, 0) scale(1); } 100% { transform: translate(60px, 70px) scale(1.15); } } */

/* ---------- MAIN WORKSPACE LAYOUT ---------- */
.ho-app-layout { display: flex; width: 100vw; height: 100vh; position: relative; z-index: 10; }
.ho-main-content { 
  flex: 1; min-width: 0; display: flex; flex-direction: column; height: 100vh; 
  overflow-y: auto; scrollbar-width: none; 
}
.ho-main-content::-webkit-scrollbar { display: none; }

/* TOP NAVBAR */
.ho-topbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 2.5rem 3rem 1.5rem; flex-shrink: 0; background: transparent;
  z-index: 20; position: sticky; top: 0;
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
}
.ho-topbar-text h1 { font-family: 'Fraunces', serif; font-weight: 800; font-size: 2.2rem; color: var(--ho-teal-900); margin-bottom: 0.3rem; letter-spacing: -1px; display: flex; align-items: center; gap: 0.8rem;}
.ho-topbar-text p { font-size: 0.95rem; color: var(--ho-text-muted); font-weight: 600; display: flex; align-items: center; gap: 0.5rem;}
.ho-pulse-dot { width: 8px; height: 8px; background: var(--ho-coral); border-radius: 50%; box-shadow: 0 0 10px var(--ho-coral); animation: hoPulse 2s infinite; }
@keyframes hoPulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.5); } }

.ho-ai-core-mini { width: 34px; height: 34px; border-radius: 50%; background: radial-gradient(circle, #fff, var(--ho-mint-400)); position: relative; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 15px rgba(66, 184, 157, 0.5);}
.ho-ai-core-mini::before { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 1.5px dashed var(--ho-teal-700); animation: hoSpin 4s linear infinite; }
@keyframes hoSpin { 100% { transform: rotate(360deg); } }

.ho-btn-ghost { padding: 0.85rem 1.8rem; background: var(--ho-glass-solid); border: 1.5px solid var(--ho-glass-border); border-radius: 999px; color: var(--ho-teal-900); font-weight: 700; font-size: 0.95rem; cursor: pointer; text-decoration: none; transition: 0.2s; box-shadow: 0 4px 15px rgba(0,0,0,0.02); display: inline-block; }
.ho-btn-ghost:hover { background: #fff; box-shadow: 0 8px 25px rgba(13, 122, 110, 0.1); transform: translateY(-1px); }

/* ---------- MOSAIC GRID (DESKTOP) ---------- */
.ho-mosaic-grid {
  display: grid; grid-template-columns: repeat(12, 1fr); gap: 1.5rem;
  padding: 0.5rem 3rem 2rem; flex: 1;
}

.ho-panel {
  background: var(--ho-glass-clear);
  backdrop-filter: blur(40px) saturate(200%); -webkit-backdrop-filter: blur(40px) saturate(200%);
  border: 1px solid var(--ho-glass-border); border-radius: var(--ho-radius-xl);
  padding: 1.8rem; display: flex; flex-direction: column; box-shadow: var(--ho-shadow-glass);
  position: relative; overflow: hidden; transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  animation: hoSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
}
@keyframes hoSlideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

.ho-panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem; z-index: 2;}
.ho-panel-head h3 { font-family: 'Fraunces', serif; font-size: 1.2rem; font-weight: 700; color: var(--ho-teal-900); display: flex; align-items: center; gap: 0.5rem;}
.ho-badge { background: rgba(13, 122, 110, 0.1); color: var(--ho-teal-700); padding: 4px 10px; border-radius: 999px; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;}

/* --- ① REPORT SUMMARY --- */
.ho-summary-banner { grid-column: span 12; background: linear-gradient(135deg, var(--ho-teal-900), var(--ho-teal-700)); color: #fff; border: none; padding: 2.2rem 2.8rem; }
.ho-sum-layout { display: flex; justify-content: space-between; align-items: center; gap: 2rem; position: relative; z-index: 2; }
.ho-sum-text h2 { font-family: 'Fraunces', serif; font-size: 1.8rem; font-weight: 600; line-height: 1.2; margin-bottom: 0.6rem; }
.ho-sum-text p { font-size: 0.95rem; color: #dcebe8; line-height: 1.6; max-width: 800px; }

/* --- ② IMPORTANT FINDINGS --- */
.ho-findings-panel { grid-column: span 6; }
.ho-finding-feed { display: flex; flex-direction: column; gap: 0.8rem; }
.ho-finding-card { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.2rem; background: rgba(255,255,255,0.7); border: 1px solid var(--ho-glass-border-subtle); border-radius: 14px; transition: 0.2s; }
.ho-finding-card:hover { background: #fff; transform: translateX(3px); }
.ho-fc-left { display: flex; align-items: center; gap: 1rem; }
.ho-fc-status-icon { font-size: 1.2rem; }
.ho-fc-meta strong { display: block; font-size: 0.95rem; color: var(--ho-teal-900); font-weight: 800; margin-bottom: 0.15rem; }
.ho-fc-meta span { font-size: 0.75rem; color: var(--ho-text-muted); font-weight: 600; }
.ho-fc-val { font-family: 'JetBrains Mono', monospace; font-size: 1.05rem; font-weight: 800; color: var(--ho-teal-900); text-align: right; }
.ho-fc-val small { font-size: 0.7rem; color: var(--ho-text-muted); font-family: 'Plus Jakarta Sans', sans-serif; display: block; }

/* --- ③ SIMPLE EXPLANATION --- */
.ho-explanation-panel { grid-column: span 6; }
.ho-expl-box { background: rgba(255,255,255,0.75); border: 1px solid var(--ho-glass-border-subtle); border-left: 4px solid var(--ho-mint-400); border-radius: 16px; padding: 1.5rem; height: 100%;}
.ho-expl-box h4 { font-family: 'Fraunces', serif; font-size: 1.1rem; color: var(--ho-teal-900); margin-bottom: 0.6rem; }
.ho-expl-box p { font-size: 0.9rem; color: var(--ho-text-muted); line-height: 1.6; font-weight: 500; }

/* --- ④ REFERENCE RANGE TABLE --- */
.ho-table-panel { grid-column: span 6; display: flex; flex-direction: column; }
.ho-table-wrapper { width: 100%; overflow-x: auto; scrollbar-width: none; }
.ho-ref-table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; min-width: 400px; }
.ho-ref-table th { text-align: left; padding: 0.8rem 1rem; font-size: 0.72rem; color: var(--ho-text-muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 2px solid var(--ho-glass-border-subtle); }
.ho-ref-table td { padding: 1rem; border-bottom: 1px solid var(--ho-glass-border-subtle); font-size: 0.88rem; color: var(--ho-teal-900); font-weight: 600; }
.ho-ref-table tr:hover td { background: rgba(255,255,255,0.5); }

/* --- ⑤ PREVIOUS VS CURRENT --- */
.ho-comparison-panel { grid-column: span 6; }
.ho-comp-card { background: linear-gradient(135deg, #fff, rgba(223, 241, 236, 0.6)); border: 1.5px solid var(--ho-mint-400); border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; height: 100%; }
.ho-comp-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;}
.ho-comp-header strong { font-family: 'Fraunces', serif; font-size: 1.2rem; color: var(--ho-teal-900); }
.ho-comp-badge { background: rgba(46, 204, 113, 0.15); color: #27ae60; font-size: 0.75rem; font-weight: 800; padding: 4px 10px; border-radius: 999px; }

.ho-comp-metrics { display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.7); padding: 1rem 1.2rem; border-radius: 12px; }
.ho-cm-col span { display: block; font-size: 0.7rem; color: var(--ho-text-muted); text-transform: uppercase; font-weight: 800; margin-bottom: 0.2rem; }
.ho-cm-col strong { font-family: 'JetBrains Mono', monospace; font-size: 1.2rem; color: var(--ho-teal-900); }
.ho-arrow-icon { color: var(--ho-text-muted); font-weight: 800; font-size: 1.2rem;}

/* --- ⑥ AI SYNTHESIS SUMMARY --- */
.ho-ai-summary-panel { grid-column: span 6; }
.ho-ai-text-box { background: var(--ho-teal-900); color: #fff; border-radius: 16px; padding: 1.6rem; box-shadow: 0 10px 25px rgba(11, 94, 85, 0.15); height: 100%; display: flex; align-items: center;}
.ho-ai-text-box p { font-size: 0.95rem; line-height: 1.6; color: #dcebe8; font-weight: 500; }

/* --- ⑦ QUESTIONS TO ASK YOUR DOCTOR --- */
.ho-doctor-panel { grid-column: span 6; }
.ho-qa-feed { display: flex; flex-direction: column; gap: 0.8rem; }
.ho-qa-item { display: flex; gap: 0.9rem; align-items: flex-start; padding: 1rem 1.2rem; background: rgba(255,255,255,0.7); border: 1px solid var(--ho-glass-border-subtle); border-radius: 14px; }
.ho-qa-num { width: 26px; height: 26px; border-radius: 50%; background: var(--ho-teal-900); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; flex-shrink: 0; }
.ho-qa-item p { font-size: 0.88rem; color: var(--ho-teal-900); font-weight: 600; line-height: 1.5; }

/* --- ⑧ RAG CHAT INTERFACE --- */
.ho-rag-chat { grid-column: span 12; display: flex; flex-direction: row; gap: 2rem; padding: 0; background: rgba(255,255,255,0.5);}
.ho-chat-area { flex: 2; display: flex; flex-direction: column; border-right: 1px solid var(--ho-glass-border-subtle); padding: 2rem;}
.ho-context-area { flex: 1; padding: 2rem; display: flex; flex-direction: column; gap: 1.5rem; background: rgba(223, 241, 236, 0.35);}
.ho-chat-feed { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 1.5rem; padding-bottom: 2rem; scrollbar-width: none;}
.ho-msg-wrap { display: flex; max-width: 85%; gap: 1rem;}
.ho-msg-wrap.ai { align-self: flex-start; }
.ho-msg-wrap.user { align-self: flex-end; flex-direction: row-reverse; }
.ho-msg-avatar { width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; box-shadow: 0 4px 10px rgba(0,0,0,0.05);}
.ai .ho-msg-avatar { background: var(--ho-teal-900); color: #fff; }
.user .ho-msg-avatar { background: var(--ho-coral); color: #fff; font-weight: 800; font-family: 'Fraunces', serif;}
.ho-msg-bubble { padding: 1.2rem 1.5rem; border-radius: 16px; font-size: 0.95rem; line-height: 1.6; }
.ai .ho-msg-bubble { background: #fff; color: var(--ho-text-main); border: 1px solid var(--ho-glass-border-subtle); border-top-left-radius: 4px; box-shadow: 0 4px 15px rgba(13, 122, 110, 0.04);}
.user .ho-msg-bubble { background: linear-gradient(135deg, var(--ho-teal-700), var(--ho-teal-900)); color: #fff; border-top-right-radius: 4px; box-shadow: 0 4px 15px rgba(13, 122, 110, 0.15);}

.ho-input-bar { display: flex; gap: 1rem; align-items: flex-end; background: #fff; border: 1px solid var(--ho-glass-border-subtle); border-radius: 20px; padding: 0.6rem; box-shadow: 0 10px 25px rgba(0,0,0,0.03); transition: 0.2s;}
.ho-input-bar:focus-within { border-color: var(--ho-teal-600); box-shadow: 0 0 0 4px rgba(13, 122, 110, 0.1);}
.ho-chat-input { flex: 1; border: none; background: transparent; padding: 0.8rem 1rem; font-family: 'Inter', sans-serif; font-size: 0.95rem; color: var(--ho-text-main); resize: none; max-height: 120px; outline: none;}
.ho-send-btn { width: 44px; height: 44px; border-radius: 14px; background: var(--ho-coral); color: white; border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s; flex-shrink: 0; margin-bottom: 2px; margin-right: 2px;}

.ho-context-head { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--ho-teal-700); letter-spacing: 0.05em; display: flex; align-items: center; gap: 0.5rem;}
.ho-context-box { background: rgba(255,255,255,0.85); border: 1px solid var(--ho-glass-border-subtle); border-radius: 16px; padding: 1.2rem; font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; color: var(--ho-text-muted); box-shadow: inset 0 2px 10px rgba(0,0,0,0.02);}
.ho-rag-step { display: flex; align-items: flex-start; gap: 0.6rem; margin-bottom: 0.6rem; line-height: 1.4;}
.ho-rag-step::before { content: '>'; color: var(--ho-mint-400); font-weight: 800;}
.ho-typing { overflow: hidden; white-space: nowrap; border-right: 2px solid var(--ho-teal-700); width: 0; animation: hoTyping 2s steps(40, end) forwards, hoBlink 0.75s step-end infinite; }
@keyframes hoTyping { from { width: 0 } to { width: 100% } }
@keyframes hoBlink { from, to { border-color: transparent } 50% { border-color: var(--ho-teal-700); } }
.ho-delay-1 { animation-delay: 0.5s; } .ho-delay-2 { animation-delay: 1s; } .ho-delay-3 { animation-delay: 1.5s; }

/* --- ⑨ SAFETY DISCLAIMER --- */
.ho-disclaimer-panel { grid-column: span 12; background: rgba(239, 111, 91, 0.05); border: 1.5px dashed rgba(239, 111, 91, 0.4); border-radius: 16px; padding: 1.2rem; text-align: center; }
.ho-disclaimer-panel p { font-size: 0.85rem; color: #a13d2d; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 0.5rem; }

/* 
==================================================================
  MOBILE OPTIMIZATION (THE ULTIMATE GRID STACKER FIX)
  This guarantees zero squishing on phones and tablets.
================================================================== 
*/
@media (max-width: 1024px) {
  .ho-app-layout { flex-direction: column !important; }
  .ho-main-content { margin-left: 0 !important; padding-left: 0 !important; }
  
  /* Kill the Grid, Embrace the Flex Stack */
  .ho-mosaic-grid {
    display: flex !important;
    flex-direction: column !important;
    padding: 1rem 1.2rem 2rem 1.2rem !important;
    gap: 1.2rem !important;
  }
  
  .ho-panel {
    grid-column: unset !important;
    width: 100% !important;
    padding: 1.5rem !important;
    margin: 0 !important;
  }

  .ho-topbar {
    flex-direction: column;
    align-items: flex-start;
    padding: 1.2rem 1.2rem;
    gap: 1rem;
    height: auto;
  }
  
  .ho-sum-layout { flex-direction: column; align-items: flex-start; text-align: left; }
  .ho-comp-metrics { flex-direction: column; gap: 1rem; align-items: flex-start; }
  .ho-cm-col { text-align: left !important; }
  .ho-arrow-icon { transform: rotate(90deg); margin: 0.5rem 0; align-self: center; }

  .ho-rag-chat { flex-direction: column !important; padding: 0 !important; }
  .ho-chat-area { border-right: none !important; border-bottom: 1px solid var(--ho-glass-border-subtle); padding: 1.5rem !important; }
  .ho-context-area { padding: 1.5rem !important; }
  .ho-msg-wrap { max-width: 95%; }
  .ho-msg-avatar { display: none; }
  
  /* Prevent iOS Input Zoom */
  .ho-chat-input, .ho-input { font-size: 16px !important; }
}











    @media (max-width: 1024px) {
        /* Using 'body .ho-main-content' makes this rule stronger than the original */
        body .ho-main-content {
          margin-top: 5.5rem;
            padding: 0 !important; 
        }
    }






</style>
</head>
<body>

<div class="ho-ambient-canvas">
  <div class="ho-glow-orb ho-orb-1"></div>
  <div class="ho-glow-orb ho-orb-2"></div>
</div>

<div class="ho-app-layout">
  
  <!-- UNIVERSAL SIDEBAR IMPORT -->
  <%- include('../partials/sidebar') %>

  <!-- SCOPED MAIN CONTENT -->
  <main class="ho-main-content">
    
    <header class="ho-topbar">
      <div class="ho-topbar-text">
        <h1><div class="ho-ai-core-mini"></div> <b style="color: #e07a68;"> AI </b>Medical Analyst</h1>
        <p>Translating complex medical reports into simple, actionable intelligence[cite: 4].</p>
      </div>
      <div class="ho-topbar-actions">
        <a href="/xyz" class="ho-btn-ghost">Upload New Report</a>
      </div>
    </header>

    <div class="ho-mosaic-grid">

      <!-- ① REPORT SUMMARY -->
      <section class="ho-panel ho-summary-banner">
        <div class="ho-sum-layout">
          <div class="ho-sum-text">
            <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ho-mint-400); font-weight: 800; display: block; margin-bottom: 0.5rem;">Clinical Report Breakdown</span>
            <h2>What does my medical report mean?</h2>
            <p>Your CBC report contains 18 extracted parameters. Most values are within the provided reference ranges. Two values require attention[cite: 4].</p>
          </div>
          <div class="ho-badge" style="background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.25);">Status: Verified</div>
        </div>
      </section>

      <!-- ② IMPORTANT FINDINGS -->
      <section class="ho-panel ho-findings-panel">
        <div class="ho-panel-head">
          <h3><span>🔍</span> Important Findings</h3>
          <span class="ho-badge">Module 3 Engine</span>
        </div>

        <div class="ho-finding-feed">
          <div class="ho-finding-card">
            <div class="ho-fc-left">
              <span class="ho-fc-status-icon">🟢</span>
              <div class="ho-fc-meta">
                <strong>Hemoglobin</strong>
                <span>Oxygen carrying capacity</span>
              </div>
            </div>
            <div class="ho-fc-val">13.2 <small>g/dL</small></div>
          </div>

          <div class="ho-finding-card" style="border-color: rgba(239, 111, 91, 0.4); background: rgba(251, 228, 222, 0.4);">
            <div class="ho-fc-left">
              <span class="ho-fc-status-icon">🟠</span>
              <div class="ho-fc-meta">
                <strong style="color: #c0392b;">Vitamin D (Below Reference)</strong>
                <span>Bone absorption & immunity</span>
              </div>
            </div>
            <div class="ho-fc-val" style="color: #c0392b;">18 <small>ng/mL</small></div>
          </div>

          <div class="ho-finding-card">
            <div class="ho-fc-left">
              <span class="ho-fc-status-icon">🟢</span>
              <div class="ho-fc-meta">
                <strong>Platelets</strong>
                <span>Clotting function</span>
              </div>
            </div>
            <div class="ho-fc-val">2.4 <small>lakh</small></div>
          </div>
        </div>
      </section>

      <!-- ③ SIMPLE EXPLANATION -->
      <section class="ho-panel ho-explanation-panel">
        <div class="ho-panel-head">
          <h3><span>💡</span> Plain English Explanation</h3>
          <span class="ho-badge">Jargon Free</span>
        </div>

        <div class="ho-expl-box">
          <h4>What does Vitamin D mean?</h4>
          <p>Vitamin D helps the body absorb calcium and supports bone health[cite: 4]. When your serum level is below the reference range mentioned in the report, your body may experience reduced calcium absorption efficiency. Continuing your prescribed supplement protocol will help restore optimal balance.</p>
        </div>
      </section>

      <!-- ④ REFERENCE RANGE TABLE -->
      <section class="ho-panel ho-table-panel">
        <div class="ho-panel-head">
          <h3><span>📊</span> Reference Range Matrix</h3>
        </div>

        <div class="ho-table-wrapper">
          <table class="ho-ref-table">
            <thead>
              <tr>
                <th>Test Parameter</th>
                <th>Result</th>
                <th>Reference Range</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Hemoglobin</td>
                <td>13.2 g/dL</td>
                <td>13 – 17 g/dL</td>
              </tr>
              <tr style="background: rgba(239, 111, 91, 0.05);">
                <td>Vitamin D</td>
                <td style="color: #c0392b; font-weight: 800;">18 ng/mL ⚠️</td>
                <td>20 – 50 ng/mL</td>
              </tr>
              <tr>
                <td>Platelets</td>
                <td>2.4 lakh</td>
                <td>1.5 – 4.5 lakh</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ⑤ PREVIOUS VS CURRENT -->
      <section class="ho-panel ho-comparison-panel">
        <div class="ho-panel-head">
          <h3><span>📈</span> Longitudinal Comparison</h3>
          <span class="ho-badge">Timeline & Trends</span>
        </div>

        <div class="ho-comp-card">
          <div class="ho-comp-header">
            <strong>Vitamin D Progression</strong>
            <span class="ho-comp-badge">↑ Improved by 4 ng/mL</span>
          </div>

          <div class="ho-comp-metrics">
            <div class="ho-cm-col">
              <span>Previous Reading</span>
              <strong>14 ng/mL</strong>
            </div>
            <div class="ho-arrow-icon">➔</div>
            <div class="ho-cm-col" style="text-align: right;">
              <span>Current Reading</span>
              <strong style="color: var(--ho-teal-900);">18 ng/mL</strong>
            </div>
          </div>
        </div>
      </section>

      <!-- ⑥ AI SYNTHESIS SUMMARY -->
      <section class="ho-panel ho-ai-summary-panel">
        <div class="ho-panel-head">
          <h3><span>✨</span> AI Synthesis Summary</h3>
        </div>

        <div class="ho-ai-text-box">
          <p>"Compared with your previous report, Vitamin D has increased from 14 to 18 ng/mL. The value remains below the reference range shown in the report."</p>
        </div>
      </section>

      <!-- ⑦ QUESTIONS TO ASK YOUR DOCTOR -->
      <section class="ho-panel ho-doctor-panel">
        <div class="ho-panel-head">
          <h3><span>🗣️</span> Questions to Ask Your Doctor</h3>
          <span class="ho-badge">Module 10 Prep</span>
        </div>

        <div class="ho-qa-feed">
          <div class="ho-qa-item">
            <div class="ho-qa-num">1</div>
            <p>"Given my Vitamin D level is 18 ng/mL, should I adjust my current 60,000 IU weekly dosage?"</p>
          </div>
          <div class="ho-qa-item">
            <div class="ho-qa-num">2</div>
            <p>"Are there specific dietary changes I can combine with my supplements to speed up absorption?"</p>
          </div>
        </div>
        <p style="font-size: 0.78rem; color: var(--ho-text-muted); margin-top: 1rem; font-weight: 600;">You may discuss these questions with your healthcare professional[cite: 4].</p>
      </section>

      <!-- ⑧ RAG CHAT INTERFACE (Spans 12) -->
      <div class="ho-panel ho-rag-chat">
        
        <!-- Chat Area -->
        <div class="ho-chat-area">
          <div class="ho-panel-head" style="margin-bottom: 2rem;">
            <h3><span>🤖</span> Health Assistant</h3>
            <span class="ho-badge">RAG Active</span>
          </div>

          <div class="ho-chat-feed">
            <div class="ho-msg-wrap user">
              <div class="ho-msg-avatar"><%= locals.userName ? userName.substring(0,1).toUpperCase() : 'U' %></div>
              <div class="ho-msg-bubble">What was my cholesterol six months ago?[cite: 4]</div>
            </div>

            <div class="ho-msg-wrap ai">
              <div class="ho-msg-avatar">✨</div>
              <div class="ho-msg-bubble">
                Based on your authorized health records, your total cholesterol level was <strong>185 mg/dL</strong> six months ago (measured on February 12, 2026). This value was within the optimal reference range. Is there anything else you'd like to check?
              </div>
            </div>
          </div>

          <div class="ho-input-bar">
            <textarea class="ho-chat-input" rows="1" placeholder="Ask about your health data..."></textarea>
            <button class="ho-send-btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            </button>
          </div>
        </div>

        <!-- RAG Context Visualizer Terminal -->
        <div class="ho-context-area">
          <div class="ho-context-head">
            <span class="ho-pulse-dot" style="background:var(--ho-teal-600); box-shadow:none;"></span> Context Retrieval Engine
          </div>
          
          <p style="font-size: 0.88rem; color: var(--ho-text-muted); line-height: 1.5;">The AI uses <strong>Retrieval-Augmented Generation (RAG)</strong> to answer questions using your own authorized health information[cite: 4].</p>

          <div class="ho-context-box">
            <div class="ho-rag-step">Parsing user query for entities...</div>
            <div class="ho-rag-step ho-typing">Target: "Cholesterol"</div>
            <div class="ho-rag-step ho-typing ho-delay-1">Timeframe: "Six months ago"</div>
            <div class="ho-rag-step ho-typing ho-delay-2" style="color: var(--ho-teal-700); font-weight: 700;">Querying MongoDB (userId: <%= locals.userId || '1001' %>)[cite: 4]...</div>
            <div class="ho-rag-step ho-typing ho-delay-3">Document found: Lipid_Profile_Feb.pdf</div>
            <div class="ho-rag-step ho-typing ho-delay-3" style="color: var(--ho-coral);">Injecting context into prompt...</div>
          </div>
        </div>

      </div>

      <!-- ⑨ SAFETY DISCLAIMER -->
      <div class="ho-disclaimer-panel">
        <p>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          HealthOrbit provides health information and decision-support based on available data. It does not provide medical diagnosis or replace professional medical advice[cite: 4].
        </p>
      </div>

    </div>

    <!-- UNIVERSAL FOOTER IMPORT -->
    <%- include('../partials/footer') %>

  </main>
</div>

</body>
</html>