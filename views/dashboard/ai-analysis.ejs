    }
    .ho-btn-ghost svg { width: 16px; height: 16px; }
    .ho-btn-ghost:hover { background: #ffffff; box-shadow: 0 8px 25px rgba(13, 122, 110, 0.12); transform: translateY(-2px); border-color: var(--ho-teal-600); }
    .ho-btn-ghost:active { transform: scale(0.96); }
    .ho-btn-solid {
      background: linear-gradient(135deg, var(--ho-teal-600), var(--ho-teal-900));
      color: #ffffff;
      border-color: transparent;
      box-shadow: 0 10px 22px rgba(11, 94, 85, 0.25);
    }
    .ho-btn-solid:hover { background: linear-gradient(135deg, var(--ho-teal-600), var(--ho-teal-900)); color: #ffffff; box-shadow: 0 14px 28px rgba(11, 94, 85, 0.34); }

    /* ---------- 12-COLUMN BENTO MOSAIC GRID ---------- */
    .ho-mosaic-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 1.5rem;
      padding: 0.5rem 3rem 3rem;
      max-width: 1600px;
      width: 100%;
      margin: 0 auto;
      flex: 1 0 auto;
    }

    /* Base Glass Panel + Cursor Spotlight */
    .ho-panel {
      --mx: 50%;
      --my: 50%;
      background: var(--ho-glass-clear);
      backdrop-filter: blur(40px) saturate(200%);
      -webkit-backdrop-filter: blur(40px) saturate(200%);
      border: 1px solid var(--ho-glass-border);
      border-radius: var(--ho-radius-xl);
      padding: 1.8rem;
      display: flex;
      flex-direction: column;
      box-shadow: var(--ho-shadow-glass);
      position: relative;
      overflow: hidden;
      transition: 0.4s var(--ho-ease);
      animation: hoSlideUp 0.7s var(--ho-ease) both;
      min-width: 0;
    }
    .ho-mosaic-grid > .ho-panel:nth-child(1) { animation-delay: 0.05s; }
    .ho-mosaic-grid > .ho-panel:nth-child(2) { animation-delay: 0.12s; }
    .ho-mosaic-grid > .ho-panel:nth-child(3) { animation-delay: 0.18s; }
    .ho-mosaic-grid > .ho-panel:nth-child(4) { animation-delay: 0.24s; }
    .ho-mosaic-grid > .ho-panel:nth-child(5) { animation-delay: 0.30s; }
    .ho-mosaic-grid > .ho-panel:nth-child(6) { animation-delay: 0.36s; }
    .ho-mosaic-grid > .ho-panel:nth-child(7) { animation-delay: 0.42s; }
    @keyframes hoSlideUp { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }

    .ho-panel::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.3s ease;
      background: radial-gradient(380px circle at var(--mx) var(--my), rgba(66, 184, 157, 0.16), transparent 60%);
    }
