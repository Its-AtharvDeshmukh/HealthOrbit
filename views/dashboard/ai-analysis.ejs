      border: 1px solid rgba(13, 122, 110, 0.1);
      display: flex;
      align-items: center;
    }
    .ho-scan-strip svg { width: 100%; height: 100%; display: block; }
    .ho-scan-strip .base { fill: none; stroke: rgba(13, 122, 110, 0.14); stroke-width: 1.5; }
    .ho-scan-strip .live {
      fill: none;
      stroke: var(--ho-teal-600);
      stroke-width: 2.2;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-dasharray: 70 230;
