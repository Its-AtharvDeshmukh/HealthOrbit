              <span><%= nm.dosage %><%= nm.dosage && nm.scheduledTime ? ' · ' : '' %><%= nm.scheduledTime %></span>
            </div>
            <a href="/medicines" class="hd-btn light" style="height:40px;padding:0 1rem;font-size:.8rem;box-shadow:0 6px 16px rgba(11,94,85,.14);border-color:var(--hd-line); margin-left: auto;">Log dose</a>
          </div>
        <% } else { %>
          <div class="hd-empty" style="padding:1rem .5rem; margin-top: auto;">
            <div class="e-ico" style="background:rgba(224,122,104,.12);color:var(--hd-coral)"><%- ic('pill') %></div>
            <div>No medication due right now.</div>
            <a href="/medicines" class="hd-more">Manage medicines <%- ic('arrow') %></a>
          </div>
        <% } %>
      </section>



      <!-- ===================== 3. HEALTH SCORE (new, separate section) ===================== -->
      <section id="hd-score" class="hd-card hd-score hd-s-score hd-reveal" style="--i:2;--sc:<%= score ? score.color : '#0d7a6e' %>" aria-labelledby="hdScoreH">
        <div class="hd-sec-h">
          <h2 id="hdScoreH"><i><%- ic('spark') %></i> Health score</h2>
          <span class="hd-badge <%= score && score.source === 'ai' ? 'ok' : 'info' %>"><%= score && score.source === 'ai' ? 'AI analysis' : 'Estimated from vitals' %></span>
        </div>
        <% if (!score) { %>
          <div class="hd-empty">
            <div class="e-ico"><%- ic('pulse') %></div>
            <div>Your score appears once at least two vitals are available.</div>
            <a href="/wearables" class="hd-pill"><%- ic('watch') %> Connect device</a>
          </div>
        <% } else { %>
          <div class="hd-score-body">
            <div class="hd-gauge">
              <svg viewBox="0 0 120 120" aria-hidden="true">
                <defs><linearGradient id="hdGaugeG" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#42b89d"/><stop offset="1" stop-color="<%= score.color %>"/></linearGradient></defs>
                <circle class="spin" cx="60" cy="60" r="58"/>
                <circle class="bg" cx="60" cy="60" r="52"/>
                <circle class="fg" cx="60" cy="60" r="52" style="stroke-dasharray:<%= score.C %>;--off:<%= score.off %>"/>
              </svg>
              <div class="hd-gauge-num"><span data-count="<%= score.value %>" data-dec="0"><%= score.value %></span><small>/ 100</small></div>
            </div>
            <div class="hd-score-main">
              <span class="hd-score-label"><%= score.label %></span>
              <p><%= score.focus ? 'Your biggest opportunity right now is ' + score.focus.toLowerCase() + '.' : 'All tracked vitals are in a healthy range. Keep it up.' %></p>
              <a href="/trends" class="hd-more">See trends <%- ic('arrow') %></a>
            </div>
            <div class="hd-score-parts">
              <% parts.forEach(p => { %>
                <div class="hd-sp" style="--c:<%= p.c %>;--w:<%= Math.round(p.s) %>%">
                  <span class="n"><%- ic(p.icon) %> <%= p.label %></span>
                  <span class="bar"><i></i></span>
                  <span class="v"><%= Math.round(p.s) %></span>
                </div>
              <% }) %>
              <% if (!parts.length) { %><div class="hd-note" style="margin:0">Breakdown not available for this score.</div><% } %>
            </div>
          </div>
          <p class="hd-note">AI-assisted wellness indicator only. It does not diagnose conditions or recommend treatment.</p>
        <% } %>
      </section>

      <!-- ===================== 4. QUICK ACTIONS (Mobile Only) ===================== -->
      <section class="hd-span-12 hd-s-actions hd-reveal m-only" style="--i:1" aria-label="Quick actions">
        <div class="hd-dock">
          <a href="/ocr" class="hd-card hd-lift hd-act" style="--c:#3b82f6">
            <div class="hd-act-top"><span class="hd-tile"><%- ic('upload') %></span><span class="hd-go"><%- ic('arrow') %></span></div>
            <div><strong>Upload report</strong><span class="s">OCR extraction</span></div>
          </a>
          <a href="/wearables" class="hd-card hd-lift hd-act" style="--c:#0d7a6e">
            <div class="hd-act-top"><span class="hd-tile"><%- ic('watch') %></span><span class="hd-go"><%- ic('arrow') %></span></div>
            <div><strong>Connect device</strong><span class="s">Health Connect</span></div>
          </a>
          <a href="/medicines" class="hd-card hd-lift hd-act" style="--c:#f59e0b">
            <div class="hd-act-top"><span class="hd-tile"><%- ic('pill') %></span><span class="hd-go"><%- ic('arrow') %></span></div>
            <div><strong>Add medicine</strong><span class="s">Schedule &amp; reminders</span></div>
          </a>
          <a href="/medicines" class="hd-card hd-lift hd-act" style="--c:#8b5cf6">
            <div class="hd-act-top"><span class="hd-tile"><%- ic('edit') %></span><span class="hd-go"><%- ic('arrow') %></span></div>
            <div><strong>Log symptom</strong><span class="s">Journal entry</span></div>
          </a>
          <a href="/body-twin" class="hd-card hd-lift hd-act" style="--c:#e07a68">
            <div class="hd-act-top"><span class="hd-tile"><%- ic('scan') %></span><span class="hd-go"><%- ic('arrow') %></span></div>
            <div><strong>Body twin</strong><span class="s">Visual health map</span></div>
          </a>
          <a href="#hd-score" class="hd-card hd-lift hd-act primary">
            <div class="hd-act-top"><span class="hd-tile"><%- ic('spark') %></span><span class="hd-go"><%- ic('arrow') %></span></div>
            <div><strong>My health score</strong><span class="s">Scored out of 100</span></div>
          </a>
        </div>
      </section>

      <!-- ===================== 5. VITALS ===================== -->
      <section class="hd-span-12 hd-s-vitals" aria-label="Latest vitals">
        <div class="hd-sec-h hd-reveal" style="--i:0">
          <h2><i><%- ic('pulse') %></i> Latest vitals</h2>
          <a href="/trends" class="hd-more">Open trends <%- ic('arrow') %></a>
        </div>
        <div class="hd-vitals">
          <% if (VITALS.length === 0) { %>
            <div class="hd-card hd-empty-vitals hd-reveal" style="--i:1">
              <div class="big"><%- ic('pulse') %></div>
              <div>
                <b>No vitals recorded yet</b>
                <p>Sync a wearable through Health Connect and your heart rate, oxygen, sleep and activity will appear here.</p>
              </div>
              <a href="/wearables" class="hd-btn light" style="border-color:var(--hd-line);box-shadow:none;">Sync wearable</a>
            </div>
          <% } else { VITALS.forEach((v, idx) => {
                const m = ms[v.key]; const raw = m.value; const num = toNum(raw);
                const dec = (num !== null && String(raw).indexOf('.') > -1) ? (String(raw).split('.')[1] || '').length : 0;
          %>
            <a href="/trends?metric=<%= v.key %>" class="hd-card hd-lift hd-vital hd-reveal" style="--i:<%= idx %>;--c:<%= v.color %>">
              <div class="hd-v-head">
                <span class="hd-v-label"><%= v.label %></span>
                <span class="hd-v-ico <%= v.beat ? 'beat' : '' %>"><%- ic(v.icon) %></span>
              </div>
              <div class="hd-v-val">
                <% if (num !== null) { %><span data-count="<%= num %>" data-dec="<%= dec %>"><%= num %></span><% } else { %><span><%= raw %></span><% } %>
                <% if (m.unit) { %><small><%= m.unit %></small><% } %>
              </div>
              <div class="hd-v-bar"></div>
              <div class="hd-v-foot">
                <span class="d"><% if (fmtShort(m.timestamp)) { %>Recorded <time datetime="<%= new Date(m.timestamp).toISOString() %>"><%= fmtShort(m.timestamp) %></time><% } else { %>Latest reading<% } %></span>
                <span>View trend →</span>
              </div>
            </a>
          <% }); } %>
        </div>
      </section>

      <!-- ===================== 6. ACTIVITY (scrollable) ===================== -->
      <section class="hd-card hd-span-7 hd-s-activity hd-reveal" style="--i:1" aria-labelledby="hdActH">
        <div class="hd-sec-h">
          <h2 id="hdActH"><i><%- ic('clock') %></i> Recent health activity</h2>
          <a href="/timeline" class="hd-more">Full timeline <%- ic('arrow') %></a>
        </div>

        <% if (acts.length === 0) { %>
          <div class="hd-empty" style="margin: auto;">
            <div class="e-ico"><%- ic('clock') %></div>
            <div>No activity yet. Your timeline fills up as you add reports, vitals and medicines.</div>
            <div class="row">
              <a href="/ocr" class="hd-pill"><%- ic('upload') %> Upload report</a>
              <a href="/wearables" class="hd-pill"><%- ic('watch') %> Connect device</a>
            </div>
          </div>
        <% } else { %>
          <div class="hd-feed-scroll">
            <div class="hd-feed">
              <% acts.slice(0, 12).forEach(evt => { const st = EVT[evt.eventType] || { i: 'clock', c: '#0d7a6e' }; %>
                <a href="/timeline" class="hd-ev" style="--c:<%= st.c %>">
                  <span class="hd-ev-ico"><%- ic(st.i) %></span>
                  <div>
                    <b><%= evt.title %></b>
                    <span class="m"><%= evt.sourceLabel || evt.eventType %></span>
                  </div>
                  <time><%= evt.dateFormatted %><% if (evt.timeFormatted) { %><small><%= evt.timeFormatted %></small><% } %></time>
                </a>
              <% }) %>
            </div>
          </div>
        <% } %>
      </section>

      <!-- ===================== 7. HEALTH CONNECT (redesigned) ===================== -->
      <section class="hd-card hd-s-sync hd-reveal" style="--i:3" aria-labelledby="hdSyncH">
        <div class="hd-sec-h">
          <h2 id="hdSyncH"><i style="background:rgba(66,133,244,.1);color:#4285f4"><%- ic('link') %></i> Health Connect</h2>
          <span class="hd-badge <%= ws.hasData ? 'ok' : '' %>"><%= ws.hasData ? 'Connected' : 'Standby' %></span>
        </div>
        <div class="hd-link <%= ws.hasData ? 'live' : '' %>" aria-hidden="true">
          <span class="nd"><%- ic('watch') %></span>
          <span class="ln"><i></i><i></i><i></i></span>
          <span class="nd hub"><%- ic('heart') %></span>
        </div>
        <div class="hd-sync-txt" style="text-align:center">
          <b><%= ws.hasData ? 'Wearable data flowing' : 'No wearable connected' %></b>
          <span><% if (ws.hasData && ws.lastSyncedAt) { %>Last sync <time class="hdAgo" datetime="<%= new Date(ws.lastSyncedAt).toISOString() %>"><%= new Date(ws.lastSyncedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></time><% } else { %>Pair a device to start syncing<% } %></span>
        </div>
        <div class="hd-streams">
          <% [['heart_rate','Heart rate'],['spo2','Oxygen'],['sleep_duration','Sleep'],['steps','Steps']].forEach(s => { %>
            <span class="<%= ms[s[0]] && ms[s[0]].value !== undefined && ms[s[0]].value !== null ? 'on' : '' %>"><i></i><%= s[1] %></span>
          <% }) %>
        </div>
      </section>

      <!-- ===================== 8. LATEST REPORTS ===================== -->
      <section class="hd-card hd-s-reports hd-reveal" style="--i:4" aria-labelledby="hdRepH">
        <div class="hd-sec-h">
          <h2 id="hdRepH"><i style="background:rgba(59,130,246,.1);color:#3b82f6"><%- ic('file') %></i> Latest reports</h2>
          <a href="/ocr" class="hd-more">All <%- ic('arrow') %></a>
        </div>
        <% if (reps.length === 0) { %>
          <div class="hd-empty" style="padding:1rem .5rem; margin: auto;">
            <div class="e-ico" style="background:rgba(59,130,246,.1);color:#3b82f6"><%- ic('upload') %></div>
            <div>No reports uploaded yet.</div>
            <a href="/ocr" class="hd-more">Upload your first report <%- ic('arrow') %></a>
          </div>
        <% } else { %>
          <div class="hd-rep" style="margin-top: auto;">
            <% reps.slice(0, 3).forEach(r => {
                 const title = (r.extractedData && r.extractedData.documentTitle) || r.originalFileName || 'Medical report';
                 const s = REP_STATUS[r.status] || ['Saved', 'info'];
                 const when = fmtShort(r.recordedAt || r.createdAt);
            %>
              <a href="/ocr">
                <span class="ri"><%- ic('file') %></span>
                <div><b><%= title %></b><span class="m"><%= when || 'Uploaded report' %></span></div>
                <span class="hd-badge <%= s[1] %>"><%= s[0] %></span>
              </a>
            <% }) %>
          </div>
        <% } %>
      </section>

      <!-- ===================== 9. NUTRITION & LIFESTYLE ===================== -->
      <section class="hd-card hd-wellness hd-s-ai hd-reveal" style="--i:1" aria-labelledby="hdWellH">
        <div class="hd-wellness-content d-only">
          <div class="hd-wellness-orb" aria-hidden="true"><%- ic('flame') %></div>
          <div>
            <h3 id="hdWellH">Nutrition &amp; Lifestyle</h3>
            <p>Track your daily meals, hydration, and wellness habits to complete your longitudinal health profile.</p>
            <a href="/nutrition" class="hd-btn light" style="color: #4c1d95;">Open Nutrition <svg class="go" viewBox="0 0 24 24"><%- P.arrow %></svg></a>
            <small>Log daily habits to improve your Body Twin accuracy.</small>
          </div>
        </div>

        <div class="hd-ai-content m-only">
          <div class="hd-ai-orb" aria-hidden="true" style="color: #c4b5fd;"><%- ic('flame') %></div>
          <div>
            <h3 id="hdWellH_m">Nutrition &amp; Lifestyle</h3>
            <p>Track your daily meals, hydration, and wellness habits to complete your longitudinal health profile.</p>
            <a href="/nutrition" class="hd-btn light" style="color: #4c1d95;">Open Nutrition <svg class="go" viewBox="0 0 24 24"><%- P.arrow %></svg></a>
            <small>Log daily habits to improve your Body Twin accuracy.</small>
          </div>
        </div>
      </section>

      <!-- ===================== 10. SAFETY & PREPAREDNESS ===================== -->
      <section class="hd-span-12 hd-s-safety hd-reveal" style="--i:2" aria-label="Safety and preparedness">
        <div class="hd-safe">
          <a href="/emergency" style="--c:#d94b4b">
            <span class="si"><%- ic('shield') %><i class="hd-dot red"></i></span>
            <div><b>Emergency health info</b><span class="s">Critical details, ready when needed</span></div>
            <span class="arrow"><%- ic('arrow') %></span>
          </a>
          <a href="/insurance" style="--c:#3b82f6">
            <span class="si"><%- ic('card') %></span>
            <div><b>Insurance</b><span class="s">Policies and claims in one place</span></div>
            <span class="arrow"><%- ic('arrow') %></span>
          </a>
        </div>
      </section>

    </div>
    <% } %>

    <%- include('../partials/footer') %>

  </main>
</div>

<script>
(function () {
  'use strict';
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };

  /* greeting + date, in the visitor's own timezone */
  var h = new Date().getHours();
  var gs = $$('.hdGreet');
  if (gs.length) gs.forEach(function (g) { g.textContent = h < 5 ? 'Good night' : h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : h < 22 ? 'Good evening' : 'Good night'; });

  var ds = $$('.hdDate');
  if (ds.length) { try { var dstr = new Date().toLocaleDateString(undefined, { weekday: 'long', day: 'numeric', month: 'long' }); ds.forEach(function (d) { d.textContent = dstr; }); } catch (e) {} }

  /* sun / moon orb follows time of day */
  var tod = document.getElementById('hdTod');
  if (tod) tod.setAttribute('data-night', (h < 6 || h >= 19) ? '1' : '0');

  /* "last synced x min ago" */
  var agos = $$('.hdAgo');
  if (agos.length) {
    agos.forEach(function (ago) {
      var t = new Date(ago.getAttribute('datetime')).getTime();
      if (!isNaN(t)) {
        var m = Math.round((Date.now() - t) / 60000);
        ago.textContent = m < 1 ? 'just now' : m < 60 ? m + ' min ago' : m < 1440 ? Math.round(m / 60) + ' h ago' : Math.round(m / 1440) + ' d ago';
      }
    });
  }

  /* count-up for numeric vitals and the health score */
  function countUp(el) {
    var end = parseFloat(el.getAttribute('data-count')); var dec = parseInt(el.getAttribute('data-dec') || '0', 10);
    if (isNaN(end)) return;
    var fmt = function (v) { return v.toLocaleString(undefined, { minimumFractionDigits: dec, maximumFractionDigits: dec }); };
    if (reduce) { el.textContent = fmt(end); return; }
    var t0 = performance.now(), dur = 1100;
    (function tick(now) {
      var p = Math.min(1, (now - t0) / dur), e = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
      el.textContent = fmt(end * e);
      if (p < 1) requestAnimationFrame(tick);
    })(t0);
  }

  /* scroll-reveal (starts only after the splash is gone, so nothing animates unseen) */
  function startMotion() {
    var items = $$('.hd-reveal');
    if (!('IntersectionObserver' in window)) { items.forEach(function (n) { n.classList.add('in'); }); $$('[data-count]').forEach(countUp); return; }
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting) return;
        e.target.classList.add('in');
        $$('[data-count]', e.target).forEach(countUp);
        io.unobserve(e.target);
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -4% 0px' });
    items.forEach(function (n) { io.observe(n); });
    /* safety net: never leave content hidden */
    setTimeout(function () { items.forEach(function (n) { n.classList.add('in'); }); }, 2500);
  }

  /* cursor spotlight on cards (pointer devices only) */
  if (window.matchMedia && window.matchMedia('(hover: hover)').matches && !reduce) {
    document.addEventListener('pointermove', function (e) {
      var c = e.target.closest && e.target.closest('.hd-card');
      if (!c) return;
      var r = c.getBoundingClientRect();
      c.style.setProperty('--mx', (e.clientX - r.left) + 'px');
      c.style.setProperty('--my', (e.clientY - r.top) + 'px');
    }, { passive: true });
  }

  /* splash: first visit of the session only */
  var sp = document.getElementById('hd-splash');
  function finish() { if (sp) { sp.classList.add('out'); setTimeout(function () { if (sp) sp.remove(); }, 650); } startMotion(); }
  if (sp) {
    try { sessionStorage.setItem('hdSplashSeen', '1'); } catch (e) {}
    var min = reduce ? 0 : 1100;
    var go = function () { setTimeout(finish, Math.max(0, min - performance.now())); };
    if (document.readyState === 'complete') go(); else window.addEventListener('load', go);
    setTimeout(function () { if (document.getElementById('hd-splash')) finish(); }, 5000);
  } else {
    startMotion();
  }
})();
</script>
</body>
</html>
