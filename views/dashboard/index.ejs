      <!-- 6. ACTIVE MEDICATION REMINDER WIDGET (Span 5) -->
      <div class="ho-panel ho-med-reminder-panel">
        <div class="ho-panel-head">
          <h3><span>⏰</span> Next Due Medication</h3>
          <span class="ho-badge" style="background: var(--ho-coral-soft); color: var(--ho-coral);">Pending Dose</span>
        </div>

        <p style="font-size: 0.85rem; color: var(--ho-text-muted); font-weight: 500;">Your next scheduled prescription protocol:</p>

        <div class="ho-med-rem-card">
          <div class="ho-mrem-left">
            <div class="ho-mrem-icon">💊</div>
            <div class="ho-mrem-text">
              <strong>Levothyroxine</strong>
              <span>50 mcg • Empty Stomach (08:00 AM)</span>
            </div>
          </div>
          <button class="ho-mrem-btn" onclick="alert('Dose marked as taken!')">Mark Taken</button>
        </div>
      </div>

    </div>

    <!-- UNIVERSAL FOOTER IMPORT -->
    <%- include('../partials/footer') %>

  </main>
</div>

