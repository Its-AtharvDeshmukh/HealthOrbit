<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HealthOrbit — Omni-Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet">
<!-- Universal Sidebar CSS -->
<link rel="stylesheet" href="/css/sidebar.css">
<style>
/* 
==================================================================
  STRICTLY SCOPED CSS (PREFIXED WITH 'ho-') FOR OMNI-DASHBOARD
================================================================== 
*/
:root {
  --ho-bg-airy: #edf6f4;
  --ho-teal-900: #0b5e55;
  --ho-teal-700: #0d7a6e;
  --ho-teal-600: #109485;
  --ho-mint-400: #42b89d;
  --ho-coral: #e07a68;
  --ho-coral-soft: #fbe4de;
  --ho-text-main: #0f1c1a;
  --ho-text-muted: #4e6b63;
  --ho-danger: #d94b4b;
  
  --ho-glass-clear: rgba(255, 255, 255, 0.45);
  --ho-glass-solid: rgba(255, 255, 255, 0.85);
  --ho-glass-border: rgba(255, 255, 255, 0.95);
  
  --ho-radius-xl: 32px;
  --ho-radius-lg: 20px;
  --ho-radius-md: 12px;
  
  --ho-shadow-glass: 0 20px 50px rgba(13, 122, 110, 0.08), inset 0 1px 1px rgba(255, 255, 255, 1);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body { min-height: 100vh; font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; background-color: var(--ho-bg-airy); color: var(--ho-text-main); overflow: hidden; -webkit-font-smoothing: antialiased; }

/* ---------- AMBIENT ORBS ---------- */
.ho-ambient-canvas { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
.ho-glow-orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.65; animation: hoFloatOrb 20s ease-in-out infinite alternate; }
.ho-orb-1 { width: 600px; height: 600px; background: #76d7c4; top: -150px; left: -100px; }
.ho-orb-2 { width: 700px; height: 700px; background: #a9dfbf; bottom: -200px; right: -150px; animation-delay: -5s; }
.ho-orb-3 { width: 500px; height: 500px; background: #fbe4de; top: 20%; left: 30%; opacity: 0.4; animation-delay: -10s; }
@keyframes hoFloatOrb { 0% { transform: translate(0, 0) scale(1); } 100% { transform: translate(60px, 70px) scale(1.15); } }

.ho-app-layout { display: flex; width: 100vw; height: 100vh; position: relative; z-index: 10; }
.ho-main-content { flex: 1; min-width: 0; display: flex; flex-direction: column; height: 100vh; overflow-y: auto; scrollbar-width: none;}
.ho-main-content::-webkit-scrollbar { display: none; }

/* ---------- TOP NAVBAR ---------- */
.ho-topbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 2.5rem 3rem 1.5rem; flex-shrink: 0; background: transparent;
  z-index: 20; position: sticky; top: 0;
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  mask-image: linear-gradient(to bottom, black 80%, transparent);
}
.ho-topbar-text h1 { font-family: 'Fraunces', serif; font-weight: 800; font-size: 2.2rem; color: var(--ho-teal-900); margin-bottom: 0.3rem; letter-spacing: -1px;}
.ho-topbar-text p { font-size: 0.95rem; color: var(--ho-text-muted); font-weight: 600; display: flex; align-items: center; gap: 0.5rem;}
.ho-pulse-dot { width: 8px; height: 8px; background: var(--ho-mint-400); border-radius: 50%; box-shadow: 0 0 10px var(--ho-mint-400); animation: hoPulse 2s infinite; }
@keyframes hoPulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.5); } }
.ho-topbar-actions { display: flex; gap: 1rem; align-items: center; }

.ho-btn-ghost { padding: 0.85rem 1.8rem; background: var(--ho-glass-solid); border: 1.5px solid var(--ho-glass-border); border-radius: 999px; color: var(--ho-teal-900); font-weight: 700; font-size: 0.95rem; cursor: pointer; text-decoration: none; transition: 0.2s; box-shadow: 0 4px 15px rgba(0,0,0,0.02); display: inline-block; }
.ho-btn-ghost:hover { background: #fff; box-shadow: 0 8px 25px rgba(13, 122, 110, 0.1); }

/* ---------- OMNI-DASHBOARD MOSAIC GRID ---------- */
.ho-mosaic-grid {
  display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-rows: minmax(140px, auto); gap: 1.5rem;
  padding: 0.5rem 3rem 4rem; flex: 1;
}

/* Base Panel */
.ho-panel {
  background: var(--ho-glass-clear);
  backdrop-filter: blur(40px) saturate(200%); -webkit-backdrop-filter: blur(40px) saturate(200%);
  border: 1px solid var(--ho-glass-border); border-radius: var(--ho-radius-xl);
  padding: 1.8rem; display: flex; flex-direction: column; box-shadow: var(--ho-shadow-glass);
  position: relative; overflow: hidden; transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  animation: hoSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
}
@keyframes hoSlideUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }

/* Staggered Animations */
.ho-panel:nth-child(1) { animation-delay: 0.1s; } .ho-panel:nth-child(2) { animation-delay: 0.15s; }
.ho-panel:nth-child(3) { animation-delay: 0.2s; } .ho-panel:nth-child(4) { animation-delay: 0.25s; }
.ho-panel:nth-child(5) { animation-delay: 0.3s; } .ho-panel:nth-child(6) { animation-delay: 0.35s; }
.ho-panel:nth-child(7) { animation-delay: 0.4s; } .ho-panel:nth-child(8) { animation-delay: 0.45s; }

/* Light Hover Effect */
.ho-panel:not(.ho-dark-panel):hover { transform: translateY(-4px); box-shadow: 0 20px 40px rgba(13, 122, 110, 0.1); border-color: var(--ho-teal-600); background: rgba(255,255,255,0.7);}

/* Mirror Shine */
.ho-panel::after {
  content: ""; position: absolute; top: 0; left: -150%; width: 50%; height: 100%;
  background: linear-gradient(115deg, transparent 0%, rgba(255,255,255,0.6) 45%, transparent 90%);
  transform: skewX(-20deg); transition: left 0.7s ease; pointer-events: none; z-index: 10;
}
.ho-panel:hover::after { left: 150%; }

.ho-panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; z-index: 2;}
.ho-panel-head h3 { font-family: 'Fraunces', serif; font-size: 1.15rem; font-weight: 700; color: var(--ho-teal-900); display: flex; align-items: center; gap: 0.5rem;}

/* --- 1. HERO: ACCESS & IDENTITY (Spans 8, Row 1) --- */
.ho-hero { grid-column: span 8; background: linear-gradient(135deg, var(--ho-teal-900), var(--ho-teal-700)); color: #fff; flex-direction: row; align-items: center; justify-content: space-between; padding: 2.5rem;}
.ho-hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at right, rgba(255,255,255,0.1), transparent); pointer-events: none;}
.ho-hero-text { flex: 1; z-index: 2;}
.ho-hero-text h2 { font-family: 'Fraunces', serif; font-size: 2.2rem; font-weight: 500; line-height: 1.1; margin-bottom: 1rem;}
.ho-hero-text p { font-size: 0.95rem; color: rgba(255,255,255,0.85); line-height: 1.5; margin-bottom: 1.5rem; max-width: 90%;}

.ho-access-group { display: flex; align-items: center; gap: 1rem; background: rgba(0,0,0,0.2); padding: 0.6rem 1rem; border-radius: 999px; width: fit-content; border: 1px solid rgba(255,255,255,0.1);}
.ho-access-group span { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ho-mint-400);}
.ho-avatar-stack { display: flex; margin-left: 0.5rem;}
.ho-avatar-mini { width: 32px; height: 32px; border-radius: 50%; background: var(--ho-coral); border: 2px solid var(--ho-teal-900); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 800; margin-left: -10px; color: #fff;}
.ho-avatar-mini:first-child { margin-left: 0; background: var(--ho-mist); }

/* Holographic Core Animation */
.ho-ai-core { width: 140px; height: 140px; position: relative; display: flex; align-items: center; justify-content: center; z-index: 2;}
.ho-core-nucleus { width: 70px; height: 70px; background: radial-gradient(circle, #fff, var(--ho-mint-400)); border-radius: 50%; box-shadow: 0 0 30px var(--ho-mint-400); animation: hoBreath 4s infinite alternate; }
.ho-core-ring { position: absolute; inset: 0; border: 1.5px dashed rgba(255,255,255,0.4); border-radius: 50%; animation: hoSpin 20s linear infinite; }
.ho-core-ring-2 { position: absolute; inset: -15px; border: 1px solid rgba(255,255,255,0.15); border-radius: 50%; animation: hoSpin 30s linear infinite reverse; border-top-color: var(--ho-coral);}
@keyframes hoBreath { 0% { transform: scale(0.95); box-shadow: 0 0 15px var(--ho-mint-400); } 100% { transform: scale(1.05); box-shadow: 0 0 40px rgba(255,255,255,0.9); } }
@keyframes hoSpin { 100% { transform: rotate(360deg); } }

/* --- 2. OCR SCANNER QUICKZONE (Spans 4, Row 1) --- */
.ho-ocr-zone { grid-column: span 4; background: rgba(255,255,255,0.6); align-items: center; justify-content: center; text-align: center; border: 2px dashed var(--ho-teal-600); cursor: pointer;}
.ho-ocr-zone:hover { background: #fff; border-color: var(--ho-teal-900); transform: scale(1.02); }
.ho-ocr-icon { font-size: 3rem; margin-bottom: 0.5rem; display: block; animation: hoFloat 3s ease-in-out infinite alternate;}
@keyframes hoFloat { 0% { transform: translateY(0); } 100% { transform: translateY(-8px); } }
.ho-ocr-zone h3 { font-family: 'Fraunces', serif; color: var(--ho-teal-900); font-size: 1.4rem; margin-bottom: 0.5rem;}
.ho-ocr-zone p { font-size: 0.85rem; color: var(--ho-text-muted); font-weight: 500;}

/* --- 3. MICRO VITALS (4 Cards, Span 3 Each, Row 2) --- */
.ho-micro-vital { grid-column: span 3; justify-content: space-between; padding: 1.5rem; }
.ho-mv-label { font-size: 0.75rem; font-weight: 800; color: var(--ho-text-muted); text-transform: uppercase; letter-spacing: 0.05em; display: flex; justify-content: space-between; align-items: center;}
.ho-mv-val { font-family: 'JetBrains Mono', monospace; font-size: 2.2rem; font-weight: 800; color: var(--ho-teal-900); display: flex; align-items: baseline; gap: 0.2rem; letter-spacing: -1px; margin-top: 0.5rem;}
.ho-mv-val small { font-size: 0.85rem; color: var(--ho-text-muted); font-family: 'Inter', sans-serif; font-weight: 600; letter-spacing: 0;}

/* TRUE EKG SVG Animation */
.ho-ekg-wrapper { width: 100%; height: 35px; margin-top: 0.8rem;}
.ho-ekg-svg { width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 0 6px rgba(224, 122, 104, 0.4));}
.ho-ekg-path { fill: none; stroke: var(--ho-coral); stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 100; animation: hoDrawEkg 2.5s linear infinite; }
@keyframes hoDrawEkg { 0% { stroke-dashoffset: 100; } 100% { stroke-dashoffset: -100; } }

/* Fluid Water Animation */
.ho-fluid-mini { width: 100%; height: 8px; background: rgba(66, 184, 157, 0.2); border-radius: 999px; margin-top: 1.5rem; position: relative; overflow: hidden;}
.ho-fluid-mini::after { content: ''; position: absolute; left: 0; top: 0; height: 100%; width: 98%; background: #3498db; border-radius: 999px; animation: hoFluidSweep 2s ease-in-out infinite alternate;}
@keyframes hoFluidSweep { 0% { width: 95%; } 100% { width: 99%; } }

/* --- 4. TRAINING / WEARABLES (Spans 5, Row 3) --- */
.ho-training { grid-column: span 5; }
.ho-activity-block { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 0.5rem;}

/* Animated SVG Rings */
.ho-ring-wrapper { width: 130px; height: 130px; position: relative; }
.ho-ring-svg { transform: rotate(-90deg); width: 100%; height: 100%; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.1)); overflow: visible;}
.ho-ring-bg { fill: none; stroke: rgba(13, 122, 110, 0.1); stroke-width: 9; stroke-linecap: round;}
.ho-ring-path { fill: none; stroke-linecap: round; stroke-width: 9; animation: hoDrawRing 2s ease-out forwards; }
@keyframes hoDrawRing { 0% { stroke-dasharray: 0, 1000; } }

.ho-activity-stats { flex: 1; display: flex; flex-direction: column; gap: 0.8rem; }
.ho-a-stat { display: flex; flex-direction: column; gap: 0.2rem;}
.ho-a-stat-head { display: flex; justify-content: space-between; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--ho-text-muted);}
.ho-a-stat-bar { width: 100%; height: 6px; background: rgba(13,122,110,0.1); border-radius: 999px; overflow: hidden;}
.ho-a-stat-fill { height: 100%; border-radius: 999px; animation: hoFillBar 1.5s ease-out forwards;}
@keyframes hoFillBar { from { transform: scaleX(0); transform-origin: left;} to { transform: scaleX(1); transform-origin: left;} }

/* --- 5. NUTRITION MACROS (Spans 3, Row 3) --- */
.ho-nutrition { grid-column: span 3; }
.ho-macro-wrapper { display: flex; flex-direction: column; justify-content: center; flex: 1; gap: 1.2rem;}
.ho-macro-row { display: flex; justify-content: space-between; align-items: center;}
.ho-macro-text strong { display: block; font-size: 1rem; color: var(--ho-teal-900); font-family: 'JetBrains Mono', monospace;}
.ho-macro-text span { font-size: 0.75rem; color: var(--ho-text-muted); font-weight: 700; text-transform: uppercase;}
.ho-macro-pct { font-size: 1.1rem; font-weight: 800;}

/* --- 6. MEDICINE PILLBOX (Spans 4, Row 3) --- */
.ho-medicine { grid-column: span 4; background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(223, 241, 236, 0.6));}
.ho-pill-card { background: #fff; border: 1px solid var(--ho-glass-border-subtle); border-radius: 16px; padding: 1rem; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 4px 10px rgba(0,0,0,0.02); margin-bottom: 0.5rem; transition: 0.2s;}
.ho-pill-card:hover { border-color: var(--ho-teal-600); transform: translateX(4px);}
.ho-pill-info strong { display: block; font-size: 0.95rem; color: var(--ho-teal-900); font-weight: 700;}
.ho-pill-info span { font-size: 0.75rem; color: var(--ho-text-muted); font-family: 'JetBrains Mono', monospace;}
.ho-pill-check { width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--ho-glass-border-subtle); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s;}
.ho-pill-check:hover { border-color: var(--ho-teal-600); }

/* --- 7. DIGITAL WALLET [FIXED HOVER] (Spans 4, Row 4) --- */
.ho-dark-panel { grid-column: span 4; background: linear-gradient(135deg, var(--ho-teal-900), #062b26); color: #fff; border-color: rgba(255,255,255,0.1);}
/* Isolate hover for dark panel to prevent white washout */
.ho-dark-panel:hover { transform: translateY(-4px); box-shadow: 0 20px 40px rgba(13, 122, 110, 0.3); border-color: var(--ho-mint-400); background: linear-gradient(135deg, #062b26, var(--ho-teal-900));}
.ho-dark-panel h3 { color: #fff; }
.ho-id-snippet { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); border-radius: 16px; padding: 1.5rem; position: relative; overflow: hidden; flex: 1; display: flex; flex-direction: column; justify-content: center;}
.ho-id-snippet::after { content: '💳'; position: absolute; right: -15px; bottom: -15px; font-size: 5rem; opacity: 0.08;}
.ho-id-snippet span { display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ho-mint-400); font-weight: 700; margin-bottom: 0.2rem;}
.ho-id-snippet strong { font-family: 'JetBrains Mono', monospace; font-size: 1.2rem; letter-spacing: 1px;}
.ho-policy-status { display: inline-block; margin-top: auto; font-size: 0.75rem; font-weight: 700; background: var(--ho-sage); padding: 4px 12px; border-radius: 999px; width: fit-content;}

/* --- 8. AI INTELLIGENCE FEED (Spans 8, Row 4) --- */
.ho-intelligence { grid-column: span 8; }
.ho-ai-feed { display: flex; flex-direction: column; gap: 0.8rem; flex: 1; overflow-y: auto;}
.ho-feed-item { display: flex; gap: 1rem; align-items: flex-start; padding: 1.2rem; background: rgba(255,255,255,0.6); border: 1px solid var(--ho-glass-border-subtle); border-radius: 16px; transition: 0.2s;}
.ho-feed-item:hover { background: #fff; border-color: var(--ho-teal-600); transform: translateX(4px); box-shadow: 0 6px 15px rgba(13, 122, 110, 0.06);}
.ho-feed-icon { width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; flex-shrink: 0; background: var(--ho-coral-soft); color: var(--ho-coral);}
.ho-feed-text strong { display: block; font-size: 1rem; color: var(--ho-teal-900); margin-bottom: 0.3rem; font-weight: 700;}
.ho-feed-text p { font-size: 0.85rem; color: var(--ho-text-muted); line-height: 1.5; margin-bottom: 0.5rem;}
.ho-feed-module { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; font-weight: 700; color: var(--ho-mint-400); text-transform: uppercase;}

/* ---------- RESPONSIVE ---------- */
@media (max-width: 1400px) {
  .ho-hero, .ho-training, .ho-intelligence { grid-column: span 8; }
  .ho-ocr-zone, .ho-medicine, .ho-dark-panel { grid-column: span 4; }
  .ho-nutrition { grid-column: span 12; }
}
@media (max-width: 1024px) {
  .ho-mosaic-grid { grid-template-columns: repeat(6, 1fr); }
  .ho-hero, .ho-ocr-zone, .ho-training, .ho-nutrition, .ho-medicine, .ho-dark-panel, .ho-intelligence { grid-column: span 6; }
  .ho-micro-vital { grid-column: span 3; }
}
@media (max-width: 768px) {
  .ho-topbar { flex-direction: column; align-items: flex-start; padding: 1.5rem; gap: 1rem;}
  .ho-mosaic-grid { display: flex; flex-direction: column; padding: 1rem; gap: 1rem;}
  .ho-hero { flex-direction: column; text-align: left; align-items: flex-start; }
  .ho-ai-core { display: none; }
  .ho-micro-vital { padding: 1.2rem; }
}
</style>
</head>
<body>

<div class="ho-ambient-canvas">
  <div class="ho-glow-orb ho-orb-1"></div>
  <div class="ho-glow-orb ho-orb-2"></div>
  <div class="ho-glow-orb ho-orb-3"></div>
</div>

<div class="ho-app-layout">
  
  <!-- UNIVERSAL SIDEBAR IMPORT -->
  <%- include('../partials/sidebar') %>

  <!-- SCOPED MAIN CONTENT -->
  <main class="ho-main-content">
    
    <header class="ho-topbar">
      <div class="ho-topbar-text">
        <h1>HealthOrbit Omni-Dashboard</h1>
        <p><span class="ho-pulse-dot"></span> All Modules Synced • Telemetry Live</p>
      </div>
      <div class="ho-topbar-actions">
        <a href="/ai-assistant" class="ho-btn-ghost">Ask AI Assistant</a>
      </div>
    </header>

    <div class="ho-mosaic-grid">
      
      <!-- 1. HERO: PROFILE & ACCESS (Span 8) -->
    <!-- 1. HERO: PROFILE & ACCESS (Span 8) -->
      <div class="ho-panel ho-hero" onclick="window.location.href='/profile'" style="cursor:pointer; background: linear-gradient(135deg, rgba(255,255,255,0.85), rgba(223, 241, 236, 0.85)); border: 1.5px solid var(--ho-glass-border);">
        <div class="ho-hero-text" style="color: var(--ho-text-main);">
          <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ho-teal-700); font-weight: 800; display: block; margin-bottom: 0.6rem;">HealthOrbit Engine Active</span>
          <h2 style="color: var(--ho-teal-900); font-family: 'Fraunces', serif; font-size: 2.2rem; font-weight: 600; line-height: 1.1; margin-bottom: 0.8rem;">Welcome back, <%= locals.userName ? userName.split(' ')[0] : 'Explorer' %>.</h2>
          <p style="color: var(--ho-text-muted); font-size: 0.95rem; line-height: 1.5; margin-bottom: 1.5rem; max-width: 90%;">Your unified medical profile is active. HealthKit telemetry and OCR data streams are currently flowing into your dashboard.</p>
          
          <div class="ho-access-group" style="background: rgba(13, 122, 110, 0.08); border: 1px solid rgba(13, 122, 110, 0.15);">
            <span style="color: var(--ho-teal-700);">Authorized Network</span>
            <div class="ho-avatar-stack">
              <div class="ho-avatar-mini" style="z-index: 3;">AD</div>
              <div class="ho-avatar-mini" style="z-index: 2; background: var(--ho-sage);">M</div>
              <div class="ho-avatar-mini" style="z-index: 1; background: var(--ho-teal-600);">F</div>
            </div>
          </div>
        </div>
        <div class="ho-ai-core">
          <div class="ho-core-ring"></div>
          <div class="ho-core-ring-2"></div>
          <div class="ho-core-nucleus"></div>
        </div>
      </div>
      
      <!-- 2. OCR SCANNER QUICKZONE (Span 4) -->
      <div class="ho-panel ho-ocr-zone" onclick="window.location.href='/xyz'">
        <span class="ho-ocr-icon">📄</span>
        <h3>Document Engine</h3>
        <p><%= locals.reportCount || 0 %> Reports Vaulted</p>
      </div>

      <!-- 3. MICRO VITALS (Span 3 each x 4 = 12) -->
      <!-- Heart Rate with True SVG EKG -->
      <div class="ho-panel ho-micro-vital">
        <div class="ho-mv-label">Heart Rate <span style="font-size:1.2rem; color:#e74c3c; animation:hoPulse 1.5s infinite;">❤️</span></div>
        <div>
          <div class="ho-mv-val">72<small>bpm</small></div>
          <div class="ho-ekg-wrapper">
            <svg class="ho-ekg-svg" viewBox="0 0 100 30" preserveAspectRatio="none">
              <!-- Using pathLength="100" makes the CSS stroke-dash array perfectly mapped 0-100 -->
              <path class="ho-ekg-path" pathLength="100" d="M0,15 L20,15 L25,5 L30,28 L35,15 L100,15" />
            </svg>
          </div>
        </div>
      </div>

      <!-- SpO2 -->
      <div class="ho-panel ho-micro-vital">
        <div class="ho-mv-label">Blood Oxygen <span style="font-size:1.2rem; color:#3498db;">💧</span></div>
        <div>
          <div class="ho-mv-val">98<small>%</small></div>
          <div class="ho-fluid-mini"></div>
        </div>
      </div>

      <!-- Sleep -->
      <div class="ho-panel ho-micro-vital">
        <div class="ho-mv-label">Deep Sleep <span style="font-size:1.2rem; color:#9b59b6;">🌙</span></div>
        <div>
          <div class="ho-mv-val">2<small>h</small> 15<small>m</small></div>
          <div style="margin-top: 1rem; font-size: 0.75rem; font-weight: 700; color: var(--ho-teal-700); background: rgba(13,122,110,0.1); padding: 4px 8px; border-radius: 6px; width: fit-content;">Optimal</div>
        </div>
      </div>

      <!-- Stress -->
      <div class="ho-panel ho-micro-vital">
        <div class="ho-mv-label">Stress Level <span style="font-size:1.2rem;">🧠</span></div>
        <div>
          <div class="ho-mv-val">34<small>/100</small></div>
          <div style="margin-top: 1rem; font-size: 0.75rem; font-weight: 700; color: #2980b9; background: rgba(133, 193, 233, 0.2); padding: 4px 8px; border-radius: 6px; width: fit-content;">Relaxed State</div>
        </div>
      </div>

      <!-- 4. TRAINING & WEARABLES (Span 5) -->
      <div class="ho-panel ho-training" onclick="window.location.href='/wearables'" style="cursor:pointer;">
        <div class="ho-panel-head">
          <h3><span>⌚</span> Telemetry</h3>
        </div>
        <div class="ho-activity-block">
          <div class="ho-ring-wrapper">
            <svg class="ho-ring-svg" viewBox="0 0 100 100">
              <!-- Backgrounds -->
              <circle class="ho-ring-bg" cx="50" cy="50" r="40"></circle>
              <circle class="ho-ring-bg" cx="50" cy="50" r="26"></circle>
              <circle class="ho-ring-bg" cx="50" cy="50" r="12"></circle>
              <!-- Fills (Dash calculations based on radius) -->
              <circle class="ho-ring-path" cx="50" cy="50" r="40" stroke="var(--ho-coral)" stroke-dasharray="251" style="stroke-dashoffset: 60; animation-delay: 0.3s;"></circle>
              <circle class="ho-ring-path" cx="50" cy="50" r="26" stroke="var(--ho-mint-400)" stroke-dasharray="163" style="stroke-dashoffset: 40; animation-delay: 0.4s;"></circle>
              <circle class="ho-ring-path" cx="50" cy="50" r="12" stroke="var(--ho-teal-700)" stroke-dasharray="75" style="stroke-dashoffset: 10; animation-delay: 0.5s;"></circle>
            </svg>
          </div>
          <div class="ho-activity-stats">
            <div class="ho-a-stat">
              <div class="ho-a-stat-head"><span style="color: var(--ho-coral);">Move</span> <strong>420/500</strong></div>
              <div class="ho-a-stat-bar"><div class="ho-a-stat-fill" style="width: 84%; background: var(--ho-coral); animation-delay: 0.3s;"></div></div>
            </div>
            <div class="ho-a-stat">
              <div class="ho-a-stat-head"><span style="color: var(--ho-mint-400);">Exercise</span> <strong>34/45</strong></div>
              <div class="ho-a-stat-bar"><div class="ho-a-stat-fill" style="width: 75%; background: var(--ho-mint-400); animation-delay: 0.4s;"></div></div>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. NUTRITION MACROS (Span 3) -->
      <div class="ho-panel ho-nutrition" onclick="window.location.href='/nutrition'" style="cursor:pointer;">
        <div class="ho-panel-head">
          <h3><span>🥗</span> Nutrition</h3>
        </div>
        <div class="ho-macro-wrapper">
          <div class="ho-macro-row">
            <div class="ho-macro-text"><span>Carbs</span><strong>180g</strong></div>
            <div class="ho-macro-pct" style="color: var(--ho-mint-400);">72%</div>
          </div>
          <div class="ho-macro-row">
            <div class="ho-macro-text"><span>Protein</span><strong>115g</strong></div>
            <div class="ho-macro-pct" style="color: var(--ho-coral);">82%</div>
          </div>
          <div class="ho-macro-row">
            <div class="ho-macro-text"><span>Fats</span><strong>45g</strong></div>
            <div class="ho-macro-pct" style="color: #f1c40f;">69%</div>
          </div>
        </div>
      </div>

      <!-- 6. MEDICINE PILLBOX (Span 4) -->
      <div class="ho-panel ho-medicine" onclick="window.location.href='/medicines'" style="cursor:pointer;">
        <div class="ho-panel-head">
          <h3><span>💊</span> Up Next</h3>
        </div>
        <div style="flex:1;">
          <div class="ho-pill-card">
            <div class="ho-pill-info">
              <strong>Vitamin D3</strong>
              <span>60,000 IU • After breakfast</span>
            </div>
            <div class="ho-pill-check">✓</div>
          </div>
          <div class="ho-pill-card">
            <div class="ho-pill-info">
              <strong>Levothyroxine</strong>
              <span>50 mcg • Empty stomach</span>
            </div>
            <div class="ho-pill-check" style="background: var(--ho-teal-700); border-color: var(--ho-teal-700); color: #fff;">✓</div>
          </div>
        </div>
      </div>

      <!-- 7. INSURANCE & ID (Span 4) -->
      <div class="ho-panel ho-dark-panel" onclick="window.location.href='/insurance'" style="cursor:pointer;">
        <div class="ho-panel-head">
          <h3 style="color: #fff;"><span>🪪</span> Digital Wallet</h3>
        </div>
        <div class="ho-id-snippet">
          <span>Primary Member</span>
          <strong><%= locals.userName ? userName.toUpperCase() : 'ATHARV D.' %></strong>
          <span style="margin-top: 1rem;">Policy ID</span>
          <strong>2831-9982-HD</strong>
        </div>
        <div class="ho-policy-status">Coverage Active</div>
      </div>

      <!-- 8. INTELLIGENCE & TRENDS (Span 8) -->
      <div class="ho-panel ho-intelligence" onclick="window.location.href='/trends'" style="cursor:pointer;">
        <div class="ho-panel-head">
          <h3><span>🧠</span> Intelligence & Trends</h3>
        </div>
        <div class="ho-ai-feed">
          
          <div class="ho-feed-item">
            <div class="ho-feed-icon">⚠️</div>
            <div class="ho-feed-text">
              <strong>Elevated Resting Heart Rate</strong>
              <p>Resting BPM shifted from baseline (70 BPM) to 82 BPM over 14 days.</p>
              <span class="ho-feed-module">Module: Trend Anomaly</span>
            </div>
          </div>

          <div class="ho-feed-item" style="border-color: var(--ho-teal-600);">
            <div class="ho-feed-icon" style="background: var(--ho-sage-soft); color: var(--ho-sage);">💡</div>
            <div class="ho-feed-text">
              <strong>Vitamin D Diet Recommended</strong>
              <p>Based on your recent CBC OCR upload, added Salmon and Egg Yolks to diet plan.</p>
              <span class="ho-feed-module" style="color: var(--ho-sage);">Module: Nutrition AI</span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </main>
</div>

<script>
  // Quick interactive toggle for the pillbox checkmark
  document.querySelectorAll('.ho-pill-check').forEach(check => {
    check.addEventListener('click', (e) => {
      e.stopPropagation(); // Prevent navigating to the medicine page when checking a pill
      if(check.style.background === 'var(--ho-teal-700)') {
        check.style.background = 'transparent';
        check.style.color = 'transparent';
        check.style.borderColor = 'var(--ho-glass-border-subtle)';
      } else {
        check.style.background = 'var(--ho-teal-700)';
        check.style.color = '#fff';
        check.style.borderColor = 'var(--ho-teal-700)';
      }
    });
  });
</script>

</body>
</html>