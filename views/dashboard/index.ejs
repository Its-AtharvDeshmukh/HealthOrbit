<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HealthOrbit — Command Center</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  /* Original HealthOrbit Green & Orange Palette */
  --void: #084039;       /* Deep Teal */
  --void-soft: #0d7a6e;  /* Primary Teal */
  --paper: #f2f8f6;      /* Airy Background */
  --card: #ffffff;
  
  --ink: #0f1c1a; 
  --ink-soft: #5e736f;
  
  --coral: #ef6f5b;      /* Orbit Orange */
  --coral-soft: #fbe4de;
  
  --sage: #109485;       /* Secondary Teal */
  --sage-soft: #dff1ec;
  
  --mist: #42b89d;       /* Bright accent */
  
  --line: rgba(13, 122, 110, 0.15); /* Soft transparent borders */
  --radius: 20px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Inter', sans-serif;
  background: var(--paper);
  color: var(--ink);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

.mono { font-family: 'JetBrains Mono', monospace; }
.display { font-family: 'Fraunces', serif; }

/* ---------- AMBIENT ORBS ---------- */
.ambient { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
.orb { position: absolute; border-radius: 50%; filter: blur(90px); opacity: 0.35; animation: float 22s infinite alternate; }
.orb1 { width: 420px; height: 420px; background: #a3e4d7; top: -120px; left: -100px; }
.orb2 { width: 460px; height: 460px; background: #fcefc9; bottom: -140px; right: -100px; animation-delay: -6s; }
@keyframes float { 100% { transform: translate(40px, 40px) scale(1.1); } }

/* ---------- APP LAYOUT ---------- */
.shell { 
    display: flex; 
    width: 100vw; 
    min-height: 100vh; 
    position: relative; 
    z-index: 1; 
}

/* ---------- TRANSPARENT, SLIM SIDEBAR ---------- */
.nav {
  width: 250px;
  position: sticky;
  top: 0;
  height: 100vh;
  background: transparent; /* FIXED: Blends with the page */
  display: flex;
  flex-direction: column;
  border-right: 1px solid var(--line);
  transition: width 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  overflow: hidden;
  z-index: 20;
  flex-shrink: 0;
}

/* Slim Shrunk State (FIXED: Reduced width to 70px) */
.nav.collapsed { width: 70px; }
.nav.collapsed .brand-text, 
.nav.collapsed .link-text, 
.nav.collapsed .quick-upload, 
.nav.collapsed .profile-info {
  opacity: 0; visibility: hidden; display: none;
}
.nav.collapsed .navlinks a { justify-content: center; padding: 0.85rem 0; }
.nav.collapsed .profile { justify-content: center; padding: 1.5rem 0; }
.nav.collapsed .nav-header { padding: 1.8rem 0; flex-direction: column; gap: 1.5rem; justify-content: center;}
.nav.collapsed .sidebar-toggle { margin: 0 auto; }

.nav-header { display: flex; justify-content: space-between; align-items: center; padding: 1.8rem 1.4rem; }
.brand { display: flex; align-items: center; gap: 0.8rem; font-family: 'Fraunces', serif; font-weight: 700; font-size: 1.3rem; white-space: nowrap; }

/* The 3-Circle Orbit Logo */
.orbit-mark { position: relative; width: 28px; height: 28px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;}
.orbit-mark .ring { position: absolute; inset: 0; border-radius: 50%; border: 2px dashed var(--void-soft); animation: spin 10s linear infinite; }
.orbit-mark .ring2 { inset: 4px; border-color: var(--coral); animation: spin 8s linear infinite reverse; }
.orbit-mark .ring3 { width: 8px; height: 8px; border-radius: 50%; background: var(--void); box-shadow: 0 0 8px var(--mist); }
@keyframes spin { to { transform: rotate(360deg); } }

.txt-h { color: var(--void); } 
.txt-o { color: var(--coral); }

.sidebar-toggle { background: none; border: none; color: var(--ink-soft); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s; }
.sidebar-toggle:hover { color: var(--void); transform: scale(1.1); }

.navlinks { display: flex; flex-direction: column; gap: 0.4rem; padding: 0 0.8rem; flex: 1; margin-top: 1rem;}
.navlinks a { text-decoration: none; color: var(--ink-soft); font-size: 0.95rem; font-weight: 600; padding: 0.8rem 1rem; border-radius: 12px; display: flex; align-items: center; gap: 0.8rem; transition: 0.2s; white-space: nowrap; }
.navlinks a .icon { font-size: 1.2rem; flex-shrink: 0; }
.navlinks a.active { background: var(--void-soft); color: #fff; box-shadow: 0 4px 12px rgba(13, 122, 110, 0.2);}
.navlinks a:hover:not(.active) { background: rgba(255,255,255,0.5); color: var(--void-soft); transform: translateX(4px);}

.quick-upload { background: rgba(255,255,255,0.6); padding: 1.2rem 1rem; border-radius: 14px; margin: 1.2rem 0.8rem; text-align: center; white-space: nowrap; border: 1px solid var(--line);}
.quick-upload p { font-size: 0.8rem; font-weight: 700; color: var(--void); margin-bottom: 0.8rem; }

.profile { display: flex; align-items: center; gap: 0.8rem; padding: 1.5rem 1rem; border-top: 1px solid var(--line); white-space: nowrap; }
.profile .av { width: 38px; height: 38px; border-radius: 50%; background: var(--void); color: #fff; display: flex; align-items: center; justify-content: center; font-family: 'Fraunces', serif; font-weight: 600; font-size: 0.9rem; flex-shrink: 0; }
.profile-info strong { display: block; font-size: 0.9rem; color: var(--void); }
.profile-info span { font-size: 0.75rem; color: var(--ink-soft); }

/* ---------- MAIN CONTENT AREA ---------- */
.main { flex: 1; min-width: 0; padding: 0; display: flex; flex-direction: column; transition: 0.4s cubic-bezier(0.25, 1, 0.5, 1); }

/* ---------- TRANSPARENT TOPBAR ---------- */
.topbar { 
    display: flex; justify-content: space-between; align-items: center; 
    padding: 2.5rem 3.5rem 1rem; /* FIXED: Transparent and borderless */
    background: transparent; 
    border-bottom: none; 
    z-index: 10; 
}
.topbar h1 { font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.8rem; color: var(--void);}
.topbar .sub { font-size: 0.85rem; color: var(--ink-soft); margin-top: 0.4rem; font-weight: 500;}
.actions { display: flex; gap: 0.8rem; }

/* Buttons */
.btn { border: none; border-radius: 999px; padding: 0.75rem 1.4rem; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: 0.2s; font-family: inherit; }
.btn.primary { background: var(--coral); color: #fff; box-shadow: 0 4px 15px rgba(239, 111, 91, 0.2);}
.btn.primary:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(239, 111, 91, 0.35); background: #d95a46;}
.btn.ghost { background: var(--card); color: var(--void); border: 1px solid var(--line); }
.btn.ghost:hover { background: var(--sage-soft); }

/* ---------- BENTO GRID ---------- */
.bento-wrapper { padding: 1rem 3.5rem 4rem; flex: 1;}
.bento { display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-rows: minmax(130px, auto); gap: 1.2rem; }

/* Card Base & Mirror Shine Animation */
.card {
  background: rgba(255, 255, 255, 0.75); backdrop-filter: blur(25px) saturate(180%);
  -webkit-backdrop-filter: blur(25px) saturate(180%);
  border: 1px solid rgba(255,255,255,1); border-radius: var(--radius); padding: 1.6rem;
  overflow: hidden; position: relative; box-shadow: 0 8px 20px rgba(8, 64, 57, 0.04);
  transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s;
}
.card::before {
  content: ""; position: absolute; top: 0; left: -150%; width: 60%; height: 100%;
  background: linear-gradient(115deg, transparent 0%, rgba(255,255,255,0.6) 45%, transparent 90%);
  transform: skewX(-18deg); transition: left 0.7s ease; pointer-events: none; z-index: 10;
}
.card:hover { transform: translateY(-4px); box-shadow: 0 15px 35px rgba(8, 64, 57, 0.1); border-color: var(--sage-soft);}
.card:hover::before { left: 150%; }

.card h3 { font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.15rem; margin-bottom: 1.2rem; color: var(--void);}

/* 1. HERO TWIN (Spans 4 columns) */
.c-twin { grid-column: span 4; grid-row: span 2; background: linear-gradient(135deg, var(--void), var(--void-soft)); color: #fff; display: flex; align-items: center; justify-content: space-between; border: none; padding: 2.5rem;}
.c-twin::before { background: linear-gradient(115deg, transparent 0%, rgba(255,255,255,0.15) 45%, transparent 90%); }
.twin-text { max-width: 60%; position: relative; z-index: 2;}
.c-twin .eyebrow { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mist); font-weight: 700; display: flex; align-items: center; gap: 0.5rem;}
.pulse-dot { width: 8px; height: 8px; background: var(--mist); border-radius: 50%; box-shadow: 0 0 10px var(--mist); animation: pulse 2s infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.4); } }
.c-twin h2 { font-family: 'Fraunces', serif; font-weight: 500; font-size: 2.4rem; line-height: 1.15; margin: 1rem 0; letter-spacing: -1px;}
.c-twin p { color: #dcebe8; font-size: 1rem; line-height: 1.5; }

/* 2. THE ANIMATED AI CORE */
.ai-core { position: relative; width: 220px; height: 220px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; z-index: 2;}
.ai-ring { position: absolute; border-radius: 50%; border: 2px dashed rgba(255,255,255,0.2); border-top: 2px solid var(--mist); }
.r1 { width: 100%; height: 100%; animation: spinCore 12s linear infinite; }
.r2 { width: 75%; height: 75%; animation: spinCore 8s linear infinite reverse; border-top-color: var(--coral); }
.r3 { width: 50%; height: 50%; animation: spinCore 5s linear infinite; border-top-color: #fff; }
.ai-center { width: 64px; height: 64px; background: #fff; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; animation: breath 3s infinite alternate; }
@keyframes spinCore { to { transform: rotate(360deg); } }
@keyframes breath { 0% { transform: scale(0.95); box-shadow: 0 0 15px rgba(255,255,255,0.2); } 100% { transform: scale(1.05); box-shadow: 0 0 40px rgba(255,255,255,0.8); } }
.ai-center strong { font-size: 1.2rem; color: var(--void); line-height: 1; font-family: 'Fraunces', serif; }
.ai-center span { font-size: 0.6rem; color: var(--coral); font-weight: 700; }

/* 3. VITALS */
.vital-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;}
.label { font-size: 0.8rem; font-weight: 700; color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.05em; }
.value { font-family: 'Inter', sans-serif; font-size: 2.4rem; font-weight: 800; color: var(--void); display: flex; align-items: baseline; gap: 0.3rem; letter-spacing: -1px; margin-bottom: 0.3rem;}
.value small { font-size: 0.95rem; color: var(--ink-soft); font-weight: 600; letter-spacing: 0;}
.foot { font-size: 0.8rem; color: var(--ink-soft); line-height: 1.4; font-weight: 500;}

/* Vitals Animations */
.anim-icon { font-size: 1.3rem; }
.beating-heart { animation: heartbeat 1.2s infinite; display: inline-block; }
@keyframes heartbeat { 0%, 100% { transform: scale(1); } 15% { transform: scale(1.25); } 30% { transform: scale(1); } }
.floating-drop { animation: floatDrop 3s ease-in-out infinite; display: inline-block; }
@keyframes floatDrop { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
.bounce { animation: bounce 2s infinite ease-in-out; display: inline-block;}
@keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
.pulse-soft { animation: pulseSoft 3s infinite; display: inline-block;}
@keyframes pulseSoft { 0%, 100% { opacity: 1; } 50% { opacity: 0.6; } }

/* Vitals Positioning */
.c-heart, .c-spo2, .c-steps, .c-sleep, .c-stress { grid-column: span 2; grid-row: span 1; }

.pill { display: inline-block; font-size: 0.75rem; font-weight: 700; padding: 0.3rem 0.8rem; border-radius: 999px; margin-top: 0.5rem; }
.pill.sage { background: var(--sage-soft); color: var(--void-soft); }
.pill.blue { background: rgba(133, 193, 233, 0.2); color: #2980b9; }

/* 4. MODULES: OCR & AI CHAT */
.c-ocr, .c-ai { grid-column: span 3; grid-row: span 2; display: flex; flex-direction: column; }
.card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem; }

.upload-zone { border: 2px dashed var(--mist); background: rgba(223, 241, 236, 0.4); border-radius: 16px; padding: 2.5rem; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.8rem; flex: 1; cursor: pointer; transition: 0.3s; }
.upload-zone:hover { background: var(--sage-soft); border-color: var(--void); }
.upload-icon { font-size: 2.5rem; }
.upload-zone strong { color: var(--void); font-size: 1.1rem; }
.upload-zone span { font-size: 0.85rem; color: var(--ink-soft); max-width: 280px; line-height: 1.5; }

/* Chat Box */
.ai-status { font-size: 0.8rem; font-weight: 700; color: var(--void-soft); display: flex; align-items: center; gap: 0.5rem; }
.pulse-dot-small { width: 6px; height: 6px; border-radius: 50%; background: var(--mist); animation: pulse 2s infinite; }
.chat-box { background: rgba(255,255,255,0.4); border: 1px solid rgba(255,255,255,0.8); border-radius: 16px; padding: 1.5rem; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; margin-bottom: 1rem; }
.chat-msg { background: #fff; padding: 1rem 1.2rem; border-radius: 12px 12px 12px 0; border: 1px solid rgba(255,255,255,0.8); font-size: 0.95rem; line-height: 1.5; color: var(--void); box-shadow: 0 4px 10px rgba(0,0,0,0.02); }
.chat-input-area { display: flex; gap: 0.6rem; }
.chat-input { flex: 1; border: 1px solid var(--line); border-radius: 999px; padding: 0.9rem 1.2rem; font-family: inherit; font-size: 0.95rem; outline: none; transition: 0.2s; background: rgba(255,255,255,0.7);}
.chat-input:focus { border-color: var(--void-soft); background: #fff; box-shadow: 0 0 0 3px var(--sage-soft);}
.send-btn { width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; padding: 0; background: var(--coral); border: none; color: white; cursor: pointer; transition: 0.2s;}
.send-btn:hover { background: #d95a46; transform: scale(1.05);}

/* ---------- RESPONSIVE ADAPTATIONS ---------- */
@media (max-width: 1280px) {
  .bento { grid-template-columns: repeat(4, 1fr); }
  .c-twin { grid-column: span 4; }
  .c-ocr, .c-ai { grid-column: span 2; }
}

@media (max-width: 768px) {
  .shell { flex-direction: column; width: 100%; overflow-x: hidden; }
  .nav { position: relative; height: auto; width: 100%; border-right: none; border-bottom: 1px solid var(--line); padding: 1rem; background: rgba(255,255,255,0.85); backdrop-filter: blur(20px);}
  .nav.collapsed { width: 100%; } 
  .navlinks, .quick-upload, .profile { display: none; }
  .nav-header { padding: 0.5rem; }
  
  .topbar { padding: 1.2rem 1.5rem; flex-direction: column; align-items: flex-start; gap: 1rem; background: rgba(255,255,255,0.85); }
  .bento-wrapper { padding: 1.5rem; }
  .bento { grid-template-columns: 1fr; }
  
  .c-twin, .c-heart, .c-spo2, .c-steps, .c-sleep, .c-stress, .c-ocr, .c-ai { grid-column: span 1; }
  .ai-core { display: none; }
  .hero { flex-direction: column; align-items: flex-start; padding: 2rem; }
}
</style>
</head>
<body>

<!-- Ambient Background Orbs -->
<div class="ambient"><div class="orb orb1"></div><div class="orb orb2"></div></div>

<div class="shell">
  
<!-- TRANSPARENT SLIM NAVBAR (UNIVERSAL) -->
<nav class="nav" id="sidebar">
  <div class="nav-header">
    <div class="brand">
      <div class="orbit-mark"><span class="ring"></span><span class="ring ring2"></span><span class="ring3"></span></div>
      <span class="brand-text"><span class="txt-h">Health</span><span class="txt-o">Orbit</span></span>
    </div>
    <button class="sidebar-toggle" onclick="document.getElementById('sidebar').classList.toggle('collapsed')" title="Toggle sidebar">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>

  <!-- All 10 Core Modules Mapped -->
  <div class="navlinks scroll-nav">
    <a href="/dashboard" class="active"><span class="icon">⊞</span><span class="link-text">Dashboard View</span></a>
    
    <!-- Mod 1 -->
    <a href="#"><span class="icon">👪</span><span class="link-text">Profile & Family</span></a>
    
    <!-- Mod 2 -->
    <a href="/xyz"><span class="icon">📄</span><span class="link-text">OCR Reports</span></a>
    
    <!-- Mod 3 -->
    <a href="#"><span class="icon">🧠</span><span class="link-text">AI Analysis</span></a>
    
    <!-- Mod 4 -->
    <a href="#"><span class="icon">⌚</span><span class="link-text">Wearable Data</span></a>
    
    <!-- Mod 5 -->
    <a href="#"><span class="icon">⏱️</span><span class="link-text">Health Timeline</span></a>
    
    <!-- Mod 6 -->
    <a href="#"><span class="icon">📈</span><span class="link-text">Trends & Anomalies</span></a>
    
    <!-- Mod 7 -->
    <a href="#"><span class="icon">💊</span><span class="link-text">Meds & Symptoms</span></a>
    
    <!-- Mod 8 -->
    <a href="#"><span class="icon">🪪</span><span class="link-text">Insurance & ID Card</span></a>
    
    <!-- Mod 9 -->
    <a href="#"><span class="icon">🤖</span><span class="link-text">AI Assistant</span></a>
    
    <!-- Mod 10 -->
    <a href="#"><span class="icon">🥗</span><span class="link-text">Nutrition & Lifestyle</span></a>
  </div>

  <!-- Keeps the profile anchored at the bottom -->
<div class="sidebar-footer">
  <div class="profile">
    <div class="av"><%= (userName && userName.length > 0) ? userName.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'HO' %></div>
    <div class="profile-info"><strong><%= userName || 'User' %></strong><span>Health ID active</span></div>
  </div>
</div>
</nav>


  <!-- MAIN EXPANDING DASHBOARD -->
  <main class="main">
    
    <!-- CLEAR TOPBAR -->
   <!-- CLEAR TOPBAR -->
<div class="topbar">
  <div>
    <h1>Welcome, <%= userName || 'Explorer' %>.</h1>
    <div class="sub">Telemetry & Records Active • Health Node Synced</div>
  </div>
  <div class="actions">
    <a href="/xyz" class="btn ghost" style="text-decoration: none;">Upload Report</a>
    <a href="/logout" class="btn primary" style="text-decoration: none;">Sign Out</a>
  </div>
</div>



    <div class="bento-wrapper">
      <div class="bento">

        <!-- 1. HEALTH TWIN HERO (Spans 4 Columns) -->
        <div class="card c-twin shine-effect">
          <div class="twin-text">
            <span class="eyebrow"><span class="pulse-dot"></span> HealthOrbit Engine · Active</span>
            <h2>Your health, in one orbit.</h2>
            <p>Reports, wearables, and history pulled into a single profile. Upload a report and OCR extracts the numbers instantly — the AI Core analyzes your live telemetry.</p>
          </div>
          
          <!-- Animated AI Core inside Hero -->
          <div class="ai-core">
            <div class="ai-ring r1"></div><div class="ai-ring r2"></div><div class="ai-ring r3"></div>
            <div class="ai-center"><strong>AI</strong><span>CORE</span></div>
          </div>
        </div>

        <!-- 2. HEART RATE -->
        <div class="card c-heart shine-effect">
          <div class="vital-top"><span class="label">Heart Rate</span><span class="anim-icon beating-heart">❤️</span></div>
          <div class="value">72<small>BPM</small></div>
          <div class="foot">4% lower than weekly average</div>
        </div>

        <!-- 3. BLOOD OXYGEN -->
        <div class="card c-spo2 shine-effect">
          <div class="vital-top"><span class="label">Blood Oxygen</span><span class="anim-icon floating-drop">💧</span></div>
          <div class="value">98<small>%</small></div>
          <span class="pill sage">Optimal Range</span>
        </div>

        <!-- 4. DAILY STEPS -->
        <div class="card c-steps shine-effect">
          <div class="vital-top"><span class="label">Daily Steps</span><span class="anim-icon bounce">🏃</span></div>
          <div class="value">7,500<small>/ 10k</small></div>
          <div class="foot">2,500 steps to today's goal</div>
        </div>

        <!-- 5. SLEEP DURATION -->
        <div class="card c-sleep shine-effect">
          <div class="vital-top"><span class="label">Sleep Duration</span><span class="anim-icon float-slow">🌙</span></div>
          <div class="value">7<small>h</small> 15<small>m</small></div>
          <span class="pill sage">Deep Sleep Detected</span>
        </div>

        <!-- 6. STRESS LEVEL -->
        <div class="card c-stress shine-effect">
          <div class="vital-top"><span class="label">Stress Level</span><span class="anim-icon pulse-soft">🧠</span></div>
          <div class="value">34<small>/ 100</small></div>
          <span class="pill blue">Relaxed</span>
        </div>

        <!-- 7. OCR UPLOAD ZONE (Spans 3 Columns) -->
        <div class="card c-ocr shine-effect">
          <div class="card-head"><h3>OCR Report Engine</h3></div>
          <div class="upload-zone">
            <div class="upload-icon">📄</div>
            <strong>Upload Medical Report</strong>
            <span>Our OCR model extracts test names, values, and units automatically to your timeline.</span>
            <button class="btn primary">Select PDF/JPG</button>
          </div>
        </div>

        <!-- 8. AI ASSISTANT CHAT (Spans 3 Columns) -->
        <div class="card c-ai shine-effect">
          <div class="card-head">
            <h3>Ask AI Assistant</h3>
            <div class="ai-status"><span class="pulse-dot-small"></span> Live</div>
          </div>
          <div class="chat-box">
            <div class="chat-msg">Hello! I've analyzed your latest OCR blood report and smartwatch vitals. What would you like to know?</div>
          </div>
          <div class="chat-input-area">
            <input type="text" placeholder="e.g. What was my hemoglobin?" class="chat-input">
            <button class="send-btn">➤</button>
          </div>
        </div>

      </div>
    </div>
  </main>
</div>

</body>
</html>