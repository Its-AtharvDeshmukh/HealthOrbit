@keyframes hdRipple { 70% { box-shadow: 0 0 0 8px rgba(66,184,157,0); } 100% { box-shadow: 0 0 0 0 rgba(66,184,157,0); } }
@keyframes hdRippleRed { 70% { box-shadow: 0 0 0 8px rgba(217,75,75,0); } 100% { box-shadow: 0 0 0 0 rgba(217,75,75,0); } }

