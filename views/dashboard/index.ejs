        <div class="ho-vc-val">72 <small>bpm</small></div>
        <div style="font-size: 0.72rem; color: var(--ho-teal-700); font-weight: 700; margin-top: 0.5rem;">Normal Resting Range</div>
      </div>

      <div class="ho-panel ho-vital-card" onclick="window.location.href='/wearables'">
        <div class="ho-vc-label"><span>Blood Oxygen</span> <span style="color:#3498db;">💧</span></div>
        <div class="ho-vc-val">98 <small>%</small></div>
        <div style="font-size: 0.72rem; color: var(--ho-teal-700); font-weight: 700; margin-top: 0.5rem;">Optimal Saturation</div>
      </div>

      <div class="ho-panel ho-vital-card" onclick="window.location.href='/wearables'">
        <div class="ho-vc-label"><span>Deep Sleep</span> <span style="color:#9b59b6;">🌙</span></div>
        <div class="ho-vc-val">2<small>h</small> 15<small>m</small></div>
