        <div class="ho-vc-val">34 <small>/100</small></div>
        <div style="font-size: 0.72rem; color: #2980b9; font-weight: 700; margin-top: 0.5rem;">Relaxed State</div>
      </div>

      <!-- 5. RECENT HEALTH ACTIVITY FEED (Span 7) -->
      <div class="ho-panel ho-activity-feed-panel">
        <div class="ho-panel-head">
          <h3><span>⏱️</span> Recent Health Activity</h3>
          <span style="font-size: 0.78rem; color: var(--ho-teal-700); font-weight: 700; cursor: pointer;" onclick="window.location.href='/timeline'">View Timeline →</span>
        </div>

        <div class="ho-act-list">
          <div class="ho-act-item" onclick="window.location.href='/xyz'">
            <div class="ho-act-left">
              <div class="ho-act-icon">📄</div>
              <div class="ho-act-text">
                <strong>CBC Report Uploaded</strong>
                <span>OCR Engine extracted 4 parameters successfully</span>
              </div>
            </div>
            <div class="ho-act-time">2 hours ago</div>
          </div>

          <div class="ho-act-item" onclick="window.location.href='/wearables'">
            <div class="ho-act-left">
              <div class="ho-act-icon">❤️</div>
              <div class="ho-act-text">
                <strong>Heart Rate Synced</strong>
                <span>Resting average stable at 72 BPM</span>
              </div>
            </div>
            <div class="ho-act-time">10 mins ago</div>
          </div>

          <div class="ho-act-item" onclick="window.location.href='/medicines'">
            <div class="ho-act-left">
              <div class="ho-act-icon">💊</div>
