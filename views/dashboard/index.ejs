<%- include('../partials/header', { title: 'HealthOrbit — Dashboard' }) %>
<link rel="icon" href="/images/Logo.png">
<meta name="theme-color" content="#0b5e55">

<%
/* ==========================================================
   SERVER-SIDE VIEW MODEL  (no new backend work needed —
   uses exactly what dashboardService.getDashboardData returns)
========================================================== */
const dd   = (typeof dashboardData !== 'undefined' && dashboardData) ? dashboardData : {};
const first = (dd.user && dd.user.firstName && dd.user.firstName !== 'User')
  ? dd.user.firstName
  : ((typeof userName !== 'undefined' && userName) ? String(userName).split(' ')[0] : 'there');
const ws    = dd.wearableStatus || { hasData: false, lastSyncedAt: null };
const ms    = dd.metricsSummary || {};
const acts  = Array.isArray(dd.recentActivity) ? dd.recentActivity : [];
const reps  = Array.isArray(dd.recentReports) ? dd.recentReports : [];
const nm    = dd.nextMedication || null;
const hasData = !!dd.hasHealthData;

/* ---- inline SVG icon set (matches the sidebar's stroke style) ---- */
const P = {
  heart:   '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>',
  drop:    '<path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>',
  pulse:   '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
  moon:    '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>',
  sun:     '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>',
  flame:   '<path d="M12 2c1 4 5 5.5 5 10a5 5 0 0 1-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-5 1-9z"/>',
  steps:   '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>',
  upload:  '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 12 15 15"/>',
  file:    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/>',
  watch:   '<rect x="6" y="4" width="12" height="16" rx="3"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
  pill:    '<path d="M10.5 20.5l10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"/><line x1="8.5" y1="8.5" x2="15.5" y2="15.5"/>',
  edit:    '<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>',
  spark:   '<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>',
  shield:  '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>',
  card:    '<rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/>',
  clock:   '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  arrow:   '<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>',
  scan:    '<path d="M10 9a2 2 0 1 0 4 0a2 2 0 0 0-4 0"/><path d="M4 8V6a2 2 0 0 1 2-2h2"/><path d="M4 16v2a2 2 0 0 0 2 2h2"/><path d="M16 4h2a2 2 0 0 1 2 2v2"/><path d="M16 20h2a2 2 0 0 0 2-2v-2"/><path d="M8 16a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2"/>',
  link:    '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  alert:   '<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
  lock:    '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>'
};
const ic = (n) => '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">' + (P[n] || '') + '</svg>';

/* ---- vitals ---- */
const VITALS = [
  { key: 'heart_rate',     label: 'Heart rate',     icon: 'heart', color: '#e5594f', beat: true },
  { key: 'blood_pressure', label: 'Blood pressure', icon: 'drop',  color: '#3b82f6' },
  { key: 'spo2',           label: 'Blood oxygen',   icon: 'pulse', color: '#06b6d4' },
  { key: 'sleep_duration', label: 'Sleep',          icon: 'moon',  color: '#8b5cf6' },
  { key: 'steps',          label: 'Steps today',    icon: 'steps', color: '#0d7a6e' },
  { key: 'calories',       label: 'Calories today', icon: 'flame', color: '#f59e0b' }
].filter(v => ms[v.key] && ms[v.key].value !== undefined && ms[v.key].value !== null && ms[v.key].value !== '');

const toNum = (raw) => {
  if (typeof raw === 'number' && isFinite(raw)) return raw;
  const s = String(raw).trim();
  return /^-?\d+(\.\d+)?$/.test(s) ? parseFloat(s) : null;
};
const fmtShort = (ts) => {
  const d = new Date(ts);
  return isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
};

/* ---- activity visuals ---- */
const EVT = {
  medical_report:     { i: 'file',  c: '#3b82f6' },
  wearable_summary:   { i: 'heart', c: '#e5594f' },
  medication:         { i: 'pill',  c: '#f59e0b' },
  medicine_log:       { i: 'pill',  c: '#f59e0b' },
  symptom:            { i: 'edit',  c: '#8b5cf6' },
  manual_measurement: { i: 'pulse', c: '#0d7a6e' }
};
const REP_STATUS = {
  completed:   ['Processed', 'ok'],  extracted: ['Processed', 'ok'],
  needs_review:['Needs review', 'warn'], partial: ['Partial', 'warn'],
  processing:  ['Processing', 'info'], failed: ['Failed', 'bad']
};

/* ---- orbit satellites light up from REAL data only (mobile) ---- */
const sat = {
  reports:  reps.length > 0,
  wearable: !!ws.hasData,
  dose:     !!nm,
  timeline: acts.length > 0
};

/* ---- hero live numbers ---- */
const hrNum   = ms.heart_rate ? toNum(ms.heart_rate.value) : null;
const spoNum  = ms.spo2 ? toNum(ms.spo2.value) : null;
const stepNum = ms.steps ? toNum(ms.steps.value) : null;
const bpmDur  = hrNum && hrNum > 30 && hrNum < 220 ? (60 / hrNum).toFixed(2) : '1.1';

/* ---- HEALTH SCORE (0-100) ----
   Uses dd.healthScore if your AI service returns one (0-100).
   Otherwise it is estimated from the latest vitals below. */
const clamp = (n, a, b) => Math.max(a, Math.min(b, n));
const parts = [];
if (hrNum !== null) parts.push({ label: 'Heart', icon: 'heart', c: '#e5594f', w: 25, s: clamp(100 - Math.max(0, Math.abs(hrNum - 70) - 10) * 3, 20, 100) });
const bpm = ms.blood_pressure ? String(ms.blood_pressure.value).match(/(\d+)\s*\/\s*(\d+)/) : null;
if (bpm) { const sy = +bpm[1], di = +bpm[2];
  parts.push({ label: 'Blood pressure', icon: 'drop', c: '#3b82f6', w: 20, s: clamp(100 - Math.max(0, sy - 120) * 1.5 - Math.max(0, di - 80) * 2 - (sy < 90 ? (90 - sy) * 2 : 0), 20, 100) }); }
if (spoNum !== null) parts.push({ label: 'Oxygen', icon: 'pulse', c: '#06b6d4', w: 20, s: spoNum >= 97 ? 100 : clamp(100 - (97 - spoNum) * 12, 20, 100) });
const slRaw = ms.sleep_duration ? toNum(ms.sleep_duration.value) : null;
if (slRaw !== null) { const hrs = slRaw > 24 ? slRaw / 60 : slRaw; const dist = hrs < 7 ? 7 - hrs : hrs > 9 ? hrs - 9 : 0;
  parts.push({ label: 'Sleep', icon: 'moon', c: '#8b5cf6', w: 20, s: clamp(100 - dist * 18, 20, 100) }); }
if (stepNum !== null) parts.push({ label: 'Activity', icon: 'steps', c: '#0d7a6e', w: 15, s: clamp(stepNum / 100, 10, 100) });

let score = null;
const aiVal = Number(dd.healthScore);
if (isFinite(aiVal) && dd.healthScore !== null && dd.healthScore !== undefined && aiVal >= 0 && aiVal <= 100) {
  score = { value: Math.round(aiVal), source: 'ai' };
} else if (parts.length >= 2) {
  const tw = parts.reduce((a, p) => a + p.w, 0);
  score = { value: Math.round(parts.reduce((a, p) => a + p.w * p.s, 0) / tw), source: 'est' };
}
if (score) {
  const v = score.value;
  score.label = v >= 85 ? 'Excellent' : v >= 70 ? 'Good' : v >= 50 ? 'Fair' : 'Needs attention';
  score.color = v >= 85 ? '#1e8e4e' : v >= 70 ? '#0d7a6e' : v >= 50 ? '#f59e0b' : '#d94b4b';
  const low = parts.length ? parts.slice().sort((a, b) => a.s - b.s)[0] : null;
  score.focus = low && low.s < 85 ? low.label : null;
  score.C = 326.7;                                   /* 2*pi*52 */
  score.off = (326.7 * (1 - v / 100)).toFixed(1);
}
%>

<style>
/* ==========================================================================
   HEALTHORBIT — DASHBOARD HOME  ·  scoped with "hd-"
   Desktop gets a premium grid layout, Mobile preserves the original design
   ========================================================================== */
:root {
  --hd-bg: #edf6f4;
  --hd-t9: #0b5e55; --hd-t8: #073f39; --hd-t7: #0d7a6e; --hd-t6: #109485; --hd-mint: #42b89d;
  --hd-coral: #e07a68; --hd-coral-soft: #fbe4de; --hd-amber: #f59e0b; --hd-red: #d94b4b;
  --hd-ink: #0f1c1a; --hd-mute: #4e6b63; --hd-dim: #8aa39c;
  --hd-card: rgba(255,255,255,.74); --hd-card-solid: #ffffff;
  --hd-line: rgba(13,122,110,.12);
  --hd-r: 24px; --hd-r-md: 16px;
  --hd-shadow: 0 10px 30px rgba(13,122,110,.07), inset 0 1px 0 #fff;
  --hd-shadow-up: 0 22px 46px rgba(13,122,110,.15);
  --hd-ease: cubic-bezier(.16,1,.3,1);
}
* { box-sizing: border-box; }
body { background: var(--hd-bg); color: var(--hd-ink); font-family: 'Plus Jakarta Sans','Inter',sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
a { color: inherit; text-decoration: none; }
svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

/* ---------- ambient background ---------- */
.hd-ambient { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
.hd-orb { position: absolute; border-radius: 50%; filter: blur(90px); opacity: .6; animation: hdDrift 22s ease-in-out infinite alternate; }
.hd-orb.a { width: 560px; height: 560px; background: #76d7c4; top: -160px; left: -120px; }
.hd-orb.b { width: 620px; height: 620px; background: #fadbd8; bottom: -220px; right: -160px; animation-delay: -7s; }
.hd-orb.c { width: 380px; height: 380px; background: #85c1e9; top: 38%; left: 42%; opacity: .25; animation-delay: -12s; }
@keyframes hdDrift { to { transform: translate(60px, 70px) scale(1.14); } }

/* ---------- layout ---------- */
.ho-app-layout { position: relative; z-index: 10; display: flex; min-height: 100vh;}
.ho-main-content { flex: 1; display: flex; flex-direction: column; overflow-y: auto; overflow-x: hidden; scrollbar-width: none; }
.ho-main-content::-webkit-scrollbar { display: none; }

/* ---------- utility classes ---------- */
.d-only { display: block; }
.m-only { display: none; }


/* ---------- base card ---------- */
.hd-card {
  position: relative; overflow: hidden; border-radius: var(--hd-r); padding: 1.35rem; display: flex; flex-direction: column;
  background: var(--hd-card); border: 1px solid rgba(255,255,255,.95);
  backdrop-filter: blur(26px) saturate(180%); -webkit-backdrop-filter: blur(26px) saturate(180%);
  box-shadow: var(--hd-shadow); transition: transform .45s var(--hd-ease), box-shadow .45s var(--hd-ease), border-color .3s;
}
.hd-card::after { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; opacity: 0; transition: opacity .35s ease; background: radial-gradient(380px circle at var(--mx, 50%) var(--my, 50%), rgba(66,184,157,.16), transparent 46%); }
@media (hover: hover) {
  .hd-card.hd-lift:hover { transform: translateY(-4px); box-shadow: var(--hd-shadow-up); border-color: rgba(16,148,133,.45); }
  .hd-card:hover::after { opacity: 1; }
}
.hd-card.hd-lift:active { transform: scale(.985); }
.hd-sec-h { display: flex; align-items: center; justify-content: space-between; gap: .75rem; margin-bottom: 1rem; position: relative; z-index: 2; flex-shrink: 0;}
.hd-sec-h h2 { font-family: 'Fraunces', serif; font-size: 1.12rem; font-weight: 700; color: var(--hd-t9); display: flex; align-items: center; gap: .55rem; letter-spacing: -.2px; margin: 0; }
.hd-sec-h h2 i { width: 28px; height: 28px; border-radius: 9px; display: grid; place-items: center; background: rgba(13,122,110,.09); color: var(--hd-t7); font-style: normal; }
.hd-sec-h h2 i svg { width: 15px; height: 15px; }
.hd-more { display: inline-flex; align-items: center; gap: .3rem; font-size: .78rem; font-weight: 800; color: var(--hd-t7); transition: gap .25s var(--hd-ease), color .2s; white-space: nowrap; }
.hd-more svg { width: 14px; height: 14px; }
.hd-more:hover { gap: .6rem; color: var(--hd-t9); }
.hd-badge { display: inline-flex; align-items: center; gap: .3rem; padding: 4px 10px; border-radius: 999px; font-size: .68rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; background: rgba(13,122,110,.1); color: var(--hd-t7); white-space: nowrap; }
.hd-badge.ok { background: rgba(39,174,96,.12); color: #1e8e4e; } .hd-badge.warn { background: rgba(245,158,11,.14); color: #b86e00; }
.hd-badge.info { background: rgba(59,130,246,.12); color: #2563eb; } .hd-badge.bad { background: rgba(217,75,75,.12); color: var(--hd-red); }
.hd-badge.coral { background: var(--hd-coral-soft); color: #c4533f; }

/* ---------- HERO ---------- */
.hd-hero {
  color: #fff; border: none; padding: clamp(1.4rem, 2.6vw, 2.4rem); min-height: 330px; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); align-items: center; gap: 1rem;
  background:
    radial-gradient(800px 360px at 85% 0%, rgba(66,184,157,.45), transparent 60%),
    radial-gradient(600px 320px at 0% 100%, rgba(224,122,104,.28), transparent 60%),
    linear-gradient(135deg, var(--hd-t8) 0%, var(--hd-t9) 48%, var(--hd-t6) 100%);
  box-shadow: 0 26px 60px rgba(11,94,85,.26), inset 0 1px 0 rgba(255,255,255,.22);
}
.hd-hero::before { content: ''; position: absolute; inset: 0; opacity: .5; pointer-events: none; background-image: radial-gradient(rgba(255,255,255,.16) 1px, transparent 1.4px); background-size: 22px 22px; -webkit-mask-image: radial-gradient(ellipse at 70% 40%, #000 10%, transparent 70%); mask-image: radial-gradient(ellipse at 70% 40%, #000 10%, transparent 70%); }
.hd-hero-copy { position: relative; z-index: 3; min-width: 0; }
.hd-eyebrow { display: inline-flex; align-items: center; gap: .55rem; font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #9be8d3; padding: 6px 12px 6px 10px; border-radius: 999px; background: rgba(255,255,255,.09); border: 1px solid rgba(255,255,255,.18); margin-bottom: 1rem; }
.hd-hero h1 { font-family: 'Fraunces', serif; font-weight: 600; font-size: clamp(1.85rem, 3.3vw, 2.9rem); line-height: 1.08; letter-spacing: -1px; margin-bottom: .7rem; }
.hd-hero h1 em { font-style: normal; background: linear-gradient(100deg, #9be8d3, #ffd2c8 70%); -webkit-background-clip: text; background-clip: text; color: transparent; }
.hd-hero .hd-hero-h2 { font-family: 'Fraunces', serif; font-weight: 600; font-size: clamp(2rem, 3vw, 2.7rem); line-height: 1.06; letter-spacing: -1px; margin-bottom: .8rem; }
.hd-hero .hd-hero-h2 em { font-style: normal; background: linear-gradient(100deg, #9be8d3, #ffd2c8 70%); -webkit-background-clip: text; background-clip: text; color: transparent; }
.hd-hero p.lead { font-size: clamp(.9rem, 1.1vw, 1rem); line-height: 1.6; color: rgba(255,255,255,.82); max-width: 54ch; margin-bottom: 1.15rem; }
.hd-chips { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.3rem; }
.hd-chip { display: inline-flex; align-items: center; gap: .45rem; padding: 7px 13px; border-radius: 999px; font-size: .76rem; font-weight: 700; color: #fff; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.22); backdrop-filter: blur(8px); transition: background .25s, transform .25s var(--hd-ease); max-width: 100%; }
.hd-chip:hover { background: rgba(255,255,255,.2); transform: translateY(-1px); }
.hd-chip svg { width: 13px; height: 13px; flex-shrink: 0; }
.hd-chip.ok { color: #aef0dc; border-color: rgba(66,184,157,.55); background: rgba(66,184,157,.16); }
.hd-chip.warn { color: #ffe0a3; border-color: rgba(245,158,11,.5); background: rgba(245,158,11,.14); }
.hd-chip span.t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hd-hero-cta { display: flex; flex-wrap: wrap; gap: .65rem; }
.hd-btn { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; height: 46px; padding: 0 1.3rem; border-radius: 14px; font-weight: 800; font-size: .88rem; cursor: pointer; border: 1.5px solid transparent; transition: transform .25s var(--hd-ease), box-shadow .25s, background .2s; }
.hd-btn svg { width: 17px; height: 17px; transition: transform .3s var(--hd-ease); }
.hd-btn:hover svg.go { transform: translateX(4px); }
.hd-btn:hover { transform: translateY(-2px); } .hd-btn:active { transform: scale(.96); }
.hd-btn.light { background: #fff; color: var(--hd-t9); box-shadow: 0 10px 26px rgba(0,0,0,.18); }
.hd-btn.ghost { background: rgba(255,255,255,.1); color: #fff; border-color: rgba(255,255,255,.3); }
.hd-btn.ghost:hover { background: rgba(255,255,255,.2); }

/* hero stat tiles (desktop) */
.hd-stats { width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem; margin-bottom: 1.3rem; max-width: 520px; }
.hd-stat { display: flex; align-items: center; gap: .7rem; padding: .65rem .8rem; border-radius: 16px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2); backdrop-filter: blur(8px); transition: transform .3s var(--hd-ease), background .25s; min-width: 0; }
.hd-stat:hover { transform: translateY(-2px); background: rgba(255,255,255,.18); }
.hd-stat .si { width: 36px; height: 36px; border-radius: 11px; display: grid; place-items: center; background: rgba(255,255,255,.14); flex-shrink: 0; }
.hd-stat .si svg { width: 17px; height: 17px; }
.hd-stat.ok .si { background: rgba(66,184,157,.3); color: #aef0dc; } .hd-stat.warn .si { background: rgba(245,158,11,.28); color: #ffe0a3; }
.hd-stat div { min-width: 0; }
.hd-stat b { display: block; font-size: .88rem; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hd-stat div > span { display: block; font-size: .68rem; font-weight: 600; color: rgba(255,255,255,.7); margin-top: 1px; }

/* mobile orbit visual */
.hd-orbit { --s: 320px; position: relative; width: var(--s); height: var(--s); margin: 0 auto; z-index: 2; justify-self: center; }
.hd-core { position: absolute; inset: 0; margin: auto; width: 74px; height: 74px; border-radius: 50%; display: grid; place-items: center; background: radial-gradient(circle at 35% 30%, #ffffff, #bff1e3 55%, #42b89d); box-shadow: 0 0 0 10px rgba(255,255,255,.08), 0 0 50px rgba(66,184,157,.75); animation: hdBreath 3.6s ease-in-out infinite; }
.hd-core svg { width: 30px; height: 30px; color: var(--hd-t9); stroke-width: 2.4; animation: hdBeat 1.8s ease-in-out infinite; }
@keyframes hdBreath { 50% { transform: scale(1.08); box-shadow: 0 0 0 16px rgba(255,255,255,.05), 0 0 70px rgba(66,184,157,.9); } }
@keyframes hdBeat { 0%,100% { transform: scale(1); } 12% { transform: scale(1.22); } 24% { transform: scale(1); } 36% { transform: scale(1.14); } }
.hd-ring { position: absolute; inset: 0; margin: auto; border-radius: 50%; border: 1px dashed rgba(255,255,255,.3); animation: hdSpin var(--d) linear infinite; }
.hd-ring.r1 { width: 100%; height: 100%; --d: 36s; }
.hd-ring.r2 { width: 72%; height: 72%; --d: 26s; animation-direction: reverse; border-color: rgba(255,255,255,.22); }
.hd-ring.r3 { width: 46%; height: 46%; --d: 18s; border-color: rgba(155,232,211,.4); }
@keyframes hdSpin { to { transform: rotate(360deg); } }
.hd-sat { position: absolute; left: 50%; width: 0; height: 0; }
.hd-sat.top { top: 0; } .hd-sat.bot { bottom: 0; }
.hd-sat-in { position: absolute; left: 0; top: 0; transform: translate(-50%, -50%); animation: hdSpin var(--d) linear infinite reverse; display: flex; flex-direction: column; align-items: center; gap: 5px; }
.hd-sat.bot .hd-sat-in { top: auto; bottom: 0; transform: translate(-50%, 50%); }
.hd-ring.r2 .hd-sat-in { animation-direction: normal; }
.hd-node { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; color: rgba(255,255,255,.7); background: rgba(255,255,255,.1); border: 1.5px dashed rgba(255,255,255,.35); backdrop-filter: blur(6px); }
.hd-node svg { width: 17px; height: 17px; }
.hd-node.on { color: var(--hd-t9); background: #fff; border: 1.5px solid #fff; box-shadow: 0 0 0 5px rgba(155,232,211,.2), 0 0 24px rgba(155,232,211,.85); animation: hdGlow 2.8s ease-in-out infinite; }
@keyframes hdGlow { 50% { box-shadow: 0 0 0 9px rgba(155,232,211,.1), 0 0 34px rgba(155,232,211,1); } }
.hd-node-l { font-size: .62rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.9); background: rgba(7,63,57,.55); padding: 2px 7px; border-radius: 999px; white-space: nowrap; }

/* ECG line */
.hd-ecg { position: absolute; left: 0; right: 0; bottom: 0; height: 64px; z-index: 1; pointer-events: none; opacity: .9; }
.hd-ecg svg { width: 100%; height: 100%; stroke-width: 1.8; }
.hd-ecg .base { stroke: rgba(255,255,255,.14); }
.hd-ecg .trace { stroke: #9be8d3; stroke-dasharray: 90 910; stroke-dashoffset: 0; filter: drop-shadow(0 0 5px rgba(155,232,211,.9)); animation: hdTrace 4.2s linear infinite; }
@keyframes hdTrace { from { stroke-dashoffset: 90; } to { stroke-dashoffset: -910; } }

/* ---------- Desktop "Vital Scope" animation ---------- */
.hd-scope { position: relative; width: 100%; height: 100%; min-height: 320px; align-items: center; justify-content: center; z-index: 2; }
.hd-scope-stage { position: relative; width: 300px; height: 300px; }
.hd-radar { position: absolute; inset: 20px; border-radius: 50%; border: 1px solid rgba(155,232,211,.45); overflow: hidden;
  background: repeating-radial-gradient(circle, transparent 0 28px, rgba(155,232,211,.16) 28px 29px), linear-gradient(rgba(155,232,211,.12) 1px, transparent 1px) center/100% 50px, rgba(7,63,57,.25);
  box-shadow: inset 0 0 40px rgba(66,184,157,.25), 0 0 40px rgba(66,184,157,.2); }
.hd-radar .sweep { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from 0deg, rgba(155,232,211,0) 0deg, rgba(155,232,211,.5) 70deg, rgba(155,232,211,0) 71deg); animation: hdSpin 4.5s linear infinite; }
.hd-radar .pulse { position: absolute; inset: 0; margin: auto; width: 60px; height: 60px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,.6); animation: hdPing 3s ease-out infinite; opacity: 0; }
.hd-radar .pulse.p2 { animation-delay: 1.5s; }
@keyframes hdPing { 0% { transform: scale(.5); opacity: .8; } 100% { transform: scale(4); opacity: 0; } }
.hd-radar .blip { position: absolute; width: 8px; height: 8px; border-radius: 50%; background: #ffd2c8; box-shadow: 0 0 12px #ffd2c8; animation: hdBlip 4.5s ease-in-out infinite; }
.hd-radar .b1 { top: 28%; left: 66%; } .hd-radar .b2 { top: 68%; left: 30%; animation-delay: -1.5s; background: #9be8d3; box-shadow: 0 0 12px #9be8d3; } .hd-radar .b3 { top: 40%; left: 20%; animation-delay: -3s; }
@keyframes hdBlip { 0%,100% { opacity: .15; transform: scale(.6); } 50% { opacity: 1; transform: scale(1.3); } }
.hd-scope-core { position: absolute; inset: 0; margin: auto; width: 96px; height: 96px; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: radial-gradient(circle at 35% 30%, rgba(255,255,255,.35), rgba(255,255,255,.08)); border: 1px solid rgba(255,255,255,.5); backdrop-filter: blur(8px); box-shadow: 0 0 40px rgba(66,184,157,.55); }
.hd-scope-core svg { width: 18px; height: 18px; color: #ffb4a6; animation: hdBeat var(--bpm, 1.1s) ease-in-out infinite; }
.hd-scope-core strong { font-family: 'JetBrains Mono', monospace; font-size: 1.5rem; font-weight: 800; line-height: 1; margin-top: 2px; }
.hd-scope-core small { font-size: .58rem; font-weight: 800; letter-spacing: .12em; color: rgba(255,255,255,.75); }
.hd-fcard { position: absolute; display: flex; align-items: center; gap: .55rem; padding: 8px 12px; border-radius: 14px; background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.32); backdrop-filter: blur(12px); box-shadow: 0 8px 22px rgba(0,0,0,.12); animation: hdBioFloat 5s ease-in-out infinite alternate; white-space: nowrap; }
.hd-fcard svg { width: 16px; height: 16px; color: #9be8d3; }
.hd-fcard b { display: block; font-size: .86rem; font-weight: 800; line-height: 1.1; } .hd-fcard span { display: block; font-size: .62rem; font-weight: 700; color: rgba(255,255,255,.75); }
.hd-fcard.f1 { top: 2%; right: -6%; } .hd-fcard.f2 { bottom: 10%; left: -8%; animation-delay: -2s; } .hd-fcard.f3 { bottom: 0; right: 0; animation-delay: -4s; }
.hd-scope-ecg { position: absolute; left: 10%; top: -2px; height: 30px; width: 80%; fill: none; stroke: #9be8d3; stroke-width: 1.6; opacity: .8; stroke-dasharray: 60 240; animation: hdEcgRun 2.4s linear infinite; filter: drop-shadow(0 0 4px #9be8d3); }
@keyframes hdEcgRun { to { stroke-dashoffset: -300; } }
@keyframes hdBioFloat { from { transform: translateY(0); } to { transform: translateY(-10px); } }

/* ---------- HEALTH SCORE ---------- */
.hd-score { background: radial-gradient(520px 220px at 0% 0%, color-mix(in srgb, var(--sc) 14%, transparent), transparent 70%), var(--hd-card); }
.hd-score-body { display: grid; grid-template-columns: auto minmax(0, .8fr) minmax(0, 1.3fr); gap: 2rem; align-items: center; position: relative; z-index: 2; }
.hd-gauge { position: relative; width: 168px; height: 168px; }
.hd-gauge svg { width: 100%; height: 100%; transform: rotate(-90deg); fill: none; }
.hd-gauge circle { stroke-width: 10; stroke-linecap: round; }
.hd-gauge .bg { stroke: rgba(13,122,110,.12); }
.hd-gauge .spin { stroke: #c25915; stroke-width: 1; stroke-dasharray: 2 6; opacity: .5; transform-origin: 60px 60px; animation: hdSpin 30s linear infinite; }
.hd-gauge .fg { stroke: url(#hdGaugeG); stroke-dashoffset: 326.7; filter: drop-shadow(0 0 6px color-mix(in srgb, var(--sc) 55%, transparent)); }
html:not(.hd-js) .hd-gauge .fg, .hd-reveal.in .hd-gauge .fg { stroke-dashoffset: var(--off); transition: stroke-dashoffset 1.6s var(--hd-ease) .3s; }
.hd-gauge-num { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-weight: 800; font-size: 2.8rem; color: var(--sc); line-height: 1; }
.hd-gauge-num small { font-size: .78rem; color: var(--hd-mute); margin-top: 4px; font-weight: 700; }
.hd-score-label { display: inline-block; padding: 5px 14px; border-radius: 999px; font-weight: 800; font-size: .8rem; color: var(--sc); background: color-mix(in srgb, var(--sc) 14%, #fff); margin-bottom: .6rem; }
.hd-score-main p { font-size: .9rem; font-weight: 600; color: var(--hd-mute); line-height: 1.55; margin-bottom: .7rem; }
.hd-score-parts { display: flex; flex-direction: column; gap: .7rem; }
.hd-sp { display: grid; grid-template-columns: 130px 1fr 32px; align-items: center; gap: .8rem; font-size: .8rem; font-weight: 700; color: var(--hd-t9); }
.hd-sp .n { display: flex; align-items: center; gap: .45rem; } .hd-sp .n svg { width: 14px; height: 14px; color: var(--c); }
.hd-sp .bar { height: 8px; border-radius: 8px; background: rgba(13,122,110,.1); overflow: hidden; }
.hd-sp .bar i { display: block; height: 100%; width: var(--w); border-radius: 8px; background: linear-gradient(90deg, var(--c), color-mix(in srgb, var(--c) 55%, #fff)); transform-origin: left; transform: scaleX(0); }
.hd-reveal.in .hd-sp .bar i { transform: scaleX(1); transition: transform 1.2s var(--hd-ease) .5s; }
.hd-sp .v { font-family: 'JetBrains Mono', monospace; text-align: right; }

/* ---------- QUICK ACTION DOCK (Mobile only) ---------- */
.hd-dock { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: .8rem; }
.hd-act { display: flex; flex-direction: column; gap: .8rem; padding: 1.05rem 1.05rem .95rem; min-width: 0; }
.hd-act-top { display: flex; align-items: center; justify-content: space-between; }
.hd-tile { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; color: var(--c, var(--hd-t7)); background: color-mix(in srgb, var(--c, #0d7a6e) 12%, #fff); border: 1px solid color-mix(in srgb, var(--c, #0d7a6e) 22%, transparent); transition: transform .4s var(--hd-ease); }
.hd-tile svg { width: 21px; height: 21px; }
.hd-act:hover .hd-tile { transform: rotate(-7deg) scale(1.1); }
.hd-go { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; color: var(--hd-dim); background: rgba(13,122,110,.06); transition: all .3s var(--hd-ease); }
.hd-go svg { width: 14px; height: 14px; }
.hd-act:hover .hd-go { background: var(--hd-t7); color: #fff; transform: translateX(3px); }
.hd-act strong { display: block; font-size: .92rem; font-weight: 800; color: var(--hd-t9); line-height: 1.2; }
.hd-act span.s { display: block; margin-top: 3px; font-size: .72rem; font-weight: 600; color: var(--hd-mute); }
.hd-act.primary { background: linear-gradient(135deg, var(--hd-t7), var(--hd-t9)); border-color: transparent; }
.hd-act.primary strong { color: #fff; } .hd-act.primary span.s { color: #9be8d3; }
.hd-act.primary .hd-tile { background: rgba(255,255,255,.18); border-color: rgba(255,255,255,.25); color: #fff; }
.hd-act.primary .hd-go { background: rgba(255,255,255,.16); color: #fff; }
.hd-act.primary:hover .hd-go { background: #fff; color: var(--hd-t9); }

/* ---------- VITALS ---------- */
.hd-vitals { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: .85rem; }
.hd-vital { display: flex; flex-direction: column; gap: .9rem; padding: 1.15rem 1.2rem; min-width: 0; }
.hd-v-head { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
.hd-v-label { font-size: .72rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; color: var(--hd-mute); }
.hd-v-ico { width: 34px; height: 34px; border-radius: 11px; display: grid; place-items: center; color: var(--c); background: color-mix(in srgb, var(--c) 13%, #fff); flex-shrink: 0; }
.hd-v-ico svg { width: 17px; height: 17px; }
.hd-v-ico.beat svg { animation: hdBeat 1.6s ease-in-out infinite; }
.hd-v-val { font-family: 'JetBrains Mono', monospace; font-weight: 800; color: var(--hd-t9); font-size: clamp(1.7rem, 2.3vw, 2.15rem); letter-spacing: -1px; display: flex; align-items: baseline; gap: .35rem; flex-wrap: wrap; line-height: 1; margin-top: auto;}
.hd-v-val small { font-family: 'Plus Jakarta Sans', sans-serif; font-size: .8rem; font-weight: 700; color: var(--hd-mute); letter-spacing: 0; }
.hd-v-foot { display: flex; align-items: center; justify-content: space-between; font-size: .72rem; font-weight: 700; color: var(--hd-t7); gap: .5rem; margin-top: auto; }
.hd-v-foot .d { color: var(--hd-mute); font-weight: 600; }
.hd-v-bar { height: 3px; border-radius: 3px; background: linear-gradient(90deg, var(--c), transparent); opacity: .55; transform-origin: left; }
html.hd-js .hd-vital.in .hd-v-bar { animation: hdBar 1.1s var(--hd-ease) both .15s; }
@keyframes hdBar { from { transform: scaleX(0); } }
.hd-empty-vitals { grid-column: 1 / -1; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1.1rem; padding: 1.3rem 1.4rem; border: 1.5px dashed rgba(13,122,110,.3); background: rgba(255,255,255,.5); }
.hd-empty-vitals .big { width: 52px; height: 52px; border-radius: 16px; display: grid; place-items: center; background: rgba(13,122,110,.09); color: var(--hd-t7); }
.hd-empty-vitals .big svg { width: 24px; height: 24px; animation: hdBeat 2.2s ease-in-out infinite; }
.hd-empty-vitals b { display: block; color: var(--hd-t9); font-size: .98rem; margin-bottom: 2px; }
.hd-empty-vitals p { font-size: .82rem; color: var(--hd-mute); font-weight: 600; line-height: 1.5; }

/* ---------- ACTIVITY FEED (scrollable) ---------- */
.hd-feed-scroll { max-height: 340px; overflow-y: auto; padding-right: .5rem; position: relative; z-index: 2; scrollbar-width: thin; scrollbar-color: rgba(13,122,110,.4) transparent; }
.hd-feed-scroll::-webkit-scrollbar { width: 6px; }
.hd-feed-scroll::-webkit-scrollbar-thumb { background: rgba(13,122,110,.35); border-radius: 6px; }
.hd-feed-scroll::-webkit-scrollbar-thumb:hover { background: var(--hd-t7); }
.hd-feed-scroll::-webkit-scrollbar-track { background: rgba(13,122,110,.06); border-radius: 6px; }
.hd-feed { position: relative; display: flex; flex-direction: column; gap: .15rem; z-index: 2; flex: 1;}
.hd-feed::before { content: ''; position: absolute; left: 19px; top: 14px; bottom: 14px; width: 2px; border-radius: 2px; background: linear-gradient(to bottom, rgba(13,122,110,.35), rgba(13,122,110,.04)); }
.hd-ev { position: relative; display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; align-items: center; gap: .9rem; padding: .7rem .6rem .7rem 0; border-radius: 16px; transition: background .25s, transform .3s var(--hd-ease); }
.hd-ev:hover { background: rgba(255,255,255,.85); transform: translateX(5px); }
.hd-ev-ico { width: 40px; height: 40px; border-radius: 13px; display: grid; place-items: center; position: relative; z-index: 1; color: var(--c); background: color-mix(in srgb, var(--c) 12%, #fff); border: 3px solid #eef7f5; box-shadow: 0 2px 10px rgba(0,0,0,.05); }
.hd-ev-ico svg { width: 17px; height: 17px; }
.hd-ev b { display: block; font-size: .9rem; font-weight: 750; color: var(--hd-t9); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hd-ev span.m { display: block; font-size: .73rem; font-weight: 600; color: var(--hd-mute); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hd-ev time { font-family: 'JetBrains Mono', monospace; font-size: .7rem; font-weight: 700; color: var(--hd-mute); text-align: right; white-space: nowrap; }
.hd-ev time small { display: block; font-size: .64rem; color: var(--hd-dim); font-weight: 600; margin-top: 2px; }
.hd-empty { display: flex; flex-direction: column; align-items: center; text-align: center; gap: .6rem; padding: 1.6rem 1rem; color: var(--hd-mute); font-size: .86rem; font-weight: 600; position: relative; z-index: 2; margin: auto; }
.hd-empty .e-ico { width: 54px; height: 54px; border-radius: 18px; display: grid; place-items: center; background: rgba(13,122,110,.08); color: var(--hd-t7); }
.hd-empty .e-ico svg { width: 24px; height: 24px; }
.hd-empty .row { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; margin-top: .2rem; }

/* ---------- SIDE CARDS ---------- */
.hd-side { display: flex; flex-direction: column; gap: clamp(.8rem, 1.1vw, 1.15rem); min-width: 0; }
.hd-med { background: linear-gradient(135deg, rgba(255,255,255,.94), rgba(251,228,222,.6)); border-color: rgba(224,122,104,.3); }
.hd-med-body { display: flex; align-items: center; gap: .95rem; padding: 1rem; border-radius: 18px; background: #fff; border: 1px solid var(--hd-line); position: relative; z-index: 2; }
.hd-med-ico { width: 48px; height: 48px; border-radius: 15px; display: grid; place-items: center; background: var(--hd-coral-soft); color: var(--hd-coral); flex-shrink: 0; animation: hdPulseGlow 3s ease-in-out infinite; }
.hd-med-ico svg { width: 22px; height: 22px; }
@keyframes hdPulseGlow { 0%,100% { box-shadow: 0 0 0 0 rgba(224,122,104,.35); } 50% { box-shadow: 0 0 0 10px rgba(224,122,104,0); } }
.hd-med-txt { flex: 1; min-width: 0; }
.hd-med-txt b { display: block; font-size: 1rem; font-weight: 800; color: var(--hd-t9); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hd-med-txt span { display: block; margin-top: 3px; font-family: 'JetBrains Mono', monospace; font-size: .76rem; font-weight: 600; color: var(--hd-mute); }
.hd-sync-txt b { display: block; font-size: .95rem; font-weight: 800; color: var(--hd-t9); }
.hd-sync-txt span { display: block; margin-top: 3px; font-size: .75rem; font-weight: 600; color: var(--hd-mute); }
.hd-note { margin-top: .85rem; font-size: .76rem; font-weight: 600; color: var(--hd-mute); line-height: 1.5; position: relative; z-index: 2; }
.hd-rep { display: flex; flex-direction: column; gap: .5rem; position: relative; z-index: 2; }
.hd-rep a { display: grid; grid-template-columns: 38px minmax(0, 1fr) auto; align-items: center; gap: .8rem; padding: .65rem .75rem; border-radius: 14px; background: rgba(255,255,255,.7); border: 1px solid var(--hd-line); transition: all .3s var(--hd-ease); }
.hd-rep a:hover { background: #fff; border-color: var(--hd-t6); transform: translateX(4px); }
.hd-rep .ri { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; background: rgba(59,130,246,.1); color: #3b82f6; }
.hd-rep .ri svg { width: 17px; height: 17px; }
.hd-rep b { display: block; font-size: .85rem; font-weight: 750; color: var(--hd-t9); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hd-rep span.m { display: block; font-size: .7rem; font-weight: 600; color: var(--hd-mute); margin-top: 2px; }

/* ---------- HEALTH CONNECT (redesigned) ---------- */
.hd-link { display: flex; align-items: center; justify-content: center; gap: .6rem; margin: auto 0 1rem; position: relative; z-index: 2; }
.hd-link .nd { width: 56px; height: 56px; border-radius: 18px; display: grid; place-items: center; background: rgba(66,133,244,.1); color: #4285f4; }
.hd-link .nd.hub { background: linear-gradient(135deg, var(--hd-t7), var(--hd-t9)); color: #fff; }
.hd-link .nd svg { width: 24px; height: 24px; }
.hd-link.live .nd.hub svg { animation: hdBeat 1.8s ease-in-out infinite; }
.hd-link .ln { position: relative; flex: 1; max-width: 160px; height: 2px; background: repeating-linear-gradient(90deg, rgba(13,122,110,.35) 0 6px, transparent 6px 12px); }
.hd-link .ln i { position: absolute; top: -3px; left: 0; width: 8px; height: 8px; border-radius: 50%; background: var(--hd-mint); box-shadow: 0 0 10px var(--hd-mint); opacity: 0; }
.hd-link.live .ln i { animation: hdPacket 2.4s linear infinite; }
.hd-link .ln i:nth-child(2) { animation-delay: .8s; } .hd-link .ln i:nth-child(3) { animation-delay: 1.6s; }
@keyframes hdPacket { 0% { left: 0; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { left: calc(100% - 8px); opacity: 0; } }
.hd-streams { display: flex; flex-wrap: wrap; gap: .45rem; justify-content: center; margin-top: .9rem; position: relative; z-index: 2; }
.hd-streams span { display: inline-flex; align-items: center; gap: .4rem; padding: 5px 11px; border-radius: 999px; font-size: .72rem; font-weight: 700; color: var(--hd-dim); background: rgba(13,122,110,.05); border: 1px dashed rgba(13,122,110,.25); }
.hd-streams span i { width: 6px; height: 6px; border-radius: 50%; background: var(--hd-dim); }
.hd-streams span.on { color: var(--hd-t7); background: rgba(66,184,157,.12); border: 1px solid rgba(66,184,157,.35); }
.hd-streams span.on i { background: var(--hd-mint); animation: hdRipple 2s infinite; }

/* ---------- WELLNESS & NUTRITION ---------- */
.hd-wellness { color: #fff; border: none; display: flex; flex-direction: column; justify-content: center; background: radial-gradient(500px 240px at 100% 0%, rgba(139,92,246,.28), transparent 60%), linear-gradient(135deg, #2e1065, #4c1d95 55%, #7c3aed); box-shadow: 0 22px 50px rgba(76, 29, 149, 0.22); }
.hd-wellness-content { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.2rem; align-items: center; }
.hd-wellness-orb { width: 74px; height: 74px; border-radius: 24px; display: grid; place-items: center; background: linear-gradient(135deg, rgba(255,255,255,.22), rgba(255,255,255,.06)); border: 1px solid rgba(255,255,255,.3); position: relative; z-index: 2; color: #c4b5fd; }
.hd-wellness-orb svg { width: 32px; height: 32px; animation: hdTwinkle 3.2s ease-in-out infinite; }
.hd-wellness h3 { font-family: 'Fraunces', serif; font-size: 1.25rem; font-weight: 600; margin-bottom: .35rem; position: relative; z-index: 2; }
.hd-wellness p { font-size: .86rem; line-height: 1.55; color: rgba(255,255,255,.8); margin-bottom: .9rem; position: relative; z-index: 2; max-width: 60ch; }
.hd-wellness small { display: block; margin-top: .75rem; font-size: .7rem; font-weight: 600; color: rgba(255,255,255,.62); position: relative; z-index: 2; }
.hd-wellness .hd-btn { position: relative; z-index: 2; width: fit-content; color: #4c1d95;}

/* Mobile wellness block (same module, mobile layout class names) */
.hd-ai { color: #fff; border: none; display: flex; flex-direction: column; justify-content: center; background: radial-gradient(500px 240px at 100% 0%, rgba(245,158,11,.28), transparent 60%), linear-gradient(135deg, #0b3f4a, var(--hd-t9) 55%, #0d7a6e); box-shadow: 0 22px 50px rgba(11,94,85,.22); }
.hd-ai-content { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.2rem; align-items: center; }
.hd-ai-orb { width: 74px; height: 74px; border-radius: 24px; display: grid; place-items: center; background: linear-gradient(135deg, rgba(255,255,255,.22), rgba(255,255,255,.06)); border: 1px solid rgba(255,255,255,.3); position: relative; z-index: 2; }
.hd-ai-orb svg { width: 32px; height: 32px; color: #ffd98a; animation: hdTwinkle 3.2s ease-in-out infinite; }
@keyframes hdTwinkle { 0%,100% { transform: scale(1) rotate(0); } 50% { transform: scale(1.18) rotate(12deg); } }
.hd-ai h3 { font-family: 'Fraunces', serif; font-size: 1.25rem; font-weight: 600; margin-bottom: .35rem; position: relative; z-index: 2; }
.hd-ai p { font-size: .86rem; line-height: 1.55; color: rgba(255,255,255,.8); margin-bottom: .9rem; position: relative; z-index: 2; max-width: 60ch; }
.hd-ai small { display: block; margin-top: .75rem; font-size: .7rem; font-weight: 600; color: rgba(255,255,255,.62); position: relative; z-index: 2; }
.hd-ai .hd-btn { position: relative; z-index: 2; width: fit-content;}

.hd-safe { display: flex; gap: 1.5rem; flex-wrap: wrap; height: 100%;}
.hd-safe a { flex: 1; min-width: 250px; display: grid; grid-template-columns: 46px minmax(0, 1fr) auto; align-items: center; gap: .9rem; padding: .85rem 1rem; border-radius: 18px; background: rgba(255,255,255,.75); border: 1px solid var(--hd-line); transition: all .3s var(--hd-ease); position: relative; z-index: 2; }
.hd-safe a:hover { background: #fff; transform: translateY(-3px); box-shadow: 0 14px 30px rgba(13,122,110,.12); }
.hd-safe .si { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; color: var(--c); background: color-mix(in srgb, var(--c) 12%, #fff); position: relative; }
.hd-safe .si svg { width: 21px; height: 21px; }
.hd-safe .si .hd-dot { position: absolute; top: -2px; right: -2px; width: 9px; height: 9px; border: 2px solid #fff; }
.hd-safe b { display: block; font-size: .92rem; font-weight: 800; color: var(--hd-t9); }
.hd-safe span.s { display: block; font-size: .73rem; font-weight: 600; color: var(--hd-mute); margin-top: 2px; }
.hd-safe .arrow { color: var(--hd-dim); transition: transform .3s var(--hd-ease), color .2s; }
.hd-safe .arrow svg { width: 16px; height: 16px; }
.hd-safe a:hover .arrow { transform: translateX(4px); color: var(--hd-t7); }

.hd-err { text-align: center; padding: 3rem 1.5rem; }
.hd-err .e { width: 64px; height: 64px; border-radius: 20px; background: rgba(217,75,75,.1); color: var(--hd-red); display: grid; place-items: center; margin: 0 auto 1rem; }
.hd-err .e svg { width: 28px; height: 28px; }
.hd-err h2 { font-family: 'Fraunces', serif; color: var(--hd-t9); margin-bottom: .5rem; }
.hd-err p { color: var(--hd-mute); font-weight: 600; margin-bottom: 1.2rem; }

/* ---------- entrance motion ---------- */
html.hd-js .hd-reveal { opacity: 0; transform: translateY(22px) scale(.985); }
html.hd-js .hd-reveal.in { opacity: 1; transform: none; transition: opacity .75s var(--hd-ease), transform .75s var(--hd-ease), box-shadow .45s var(--hd-ease), border-color .3s; transition-delay: calc(var(--i, 0) * 70ms); }
html.hd-js .hd-reveal.in.hd-lift:hover { transition-delay: 0s; }

/* ---------- splash (first visit per session) ---------- */
.hd-splash { position: fixed; inset: 0; z-index: 999999; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.1rem; background: radial-gradient(700px 400px at 50% 40%, #d9f3ec, var(--hd-bg) 70%); transition: opacity .6s var(--hd-ease), visibility .6s, transform .6s var(--hd-ease); }
.hd-splash.out { opacity: 0; visibility: hidden; pointer-events: none; transform: scale(1.04); }
.hd-sp-stage { position: relative; width: 96px; height: 96px; display: grid; place-items: center; }
.hd-sp-core { width: 24px; height: 24px; border-radius: 50%; background: var(--hd-t9); box-shadow: 0 0 22px rgba(66,184,157,.7); animation: hdBreath 2.4s ease-in-out infinite; }
.hd-sp-ring { position: absolute; border-radius: 50%; border: 1.5px dashed var(--hd-t6); opacity: .65; }
.hd-sp-ring.o { inset: 0; animation: hdSpin 4s linear infinite; }
.hd-sp-ring.i { inset: 18px; border-color: var(--hd-coral); animation: hdSpin 3s linear infinite reverse; }
.hd-sp-ring i { position: absolute; top: -4px; left: 50%; width: 8px; height: 8px; margin-left: -4px; border-radius: 50%; background: var(--hd-coral); box-shadow: 0 0 8px var(--hd-coral); }
.hd-sp-ring.i i { background: var(--hd-mint); box-shadow: 0 0 8px var(--hd-mint); width: 6px; height: 6px; margin-left: -3px; top: -3px; }
.hd-sp-brand { font-weight: 800; font-size: 1.8rem; letter-spacing: -.6px; color: var(--hd-t9); }
.hd-sp-brand span { color: var(--hd-coral); }
.hd-sp-tag { font-size: .8rem; font-weight: 700; color: var(--hd-mute); letter-spacing: .04em; margin-top: -.5rem; }
.hd-sp-bar { width: 150px; height: 3px; border-radius: 3px; background: rgba(13,122,110,.14); overflow: hidden; }
.hd-sp-bar::after { content: ''; display: block; height: 100%; width: 40%; border-radius: 3px; background: linear-gradient(90deg, var(--hd-t6), var(--hd-mint)); animation: hdLoad 1.1s ease-in-out infinite; }
@keyframes hdLoad { from { transform: translateX(-100%); } to { transform: translateX(260%); } }

/* ==========================================================================
   DESKTOP GRID SYSTEM (The "Command Center" layout)
   ========================================================================== */
@media (min-width: 1025px) {
  .hd-main { padding: 2rem 3rem 4rem !important; max-width: 1600px; margin: 0 auto; }
  .hd-wrap { display: grid; grid-template-columns: repeat(12, 1fr); gap: 1.5rem; grid-auto-flow: row dense; }

  .hd-s-hero { grid-column: span 8; grid-row: 1; }
  .hd-s-meds { grid-column: span 4; grid-row: 1; display: flex; flex-direction: column; }
  .hd-s-score { grid-column: span 12; grid-row: 2; }
  .hd-s-vitals { grid-column: span 12; grid-row: 3; }
  .hd-s-activity { grid-column: span 7; grid-row: 4; display: flex; flex-direction: column; }
  .hd-s-sync { grid-column: span 5; grid-row: 4; display: flex; flex-direction: column; }
  .hd-s-ai { grid-column: span 8; grid-row: 5; display: flex; flex-direction: column; }
  .hd-s-reports { grid-column: span 4; grid-row: 5; display: flex; flex-direction: column; }
  .hd-s-safety { grid-column: span 12; grid-row: 6; }
}

@media (max-width: 1280px) {
  .hd-dock { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .hd-orbit { --s: 290px; }
}
@media (max-width: 1100px) {
  .hd-s-activity, .hd-s-sync, .hd-s-ai, .hd-s-reports, .hd-s-score { grid-column: span 12; }
  .hd-s-safety .hd-safe { flex-direction: column; }
  .hd-side { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .hd-hero { grid-template-columns: minmax(0, 1fr) minmax(0, .6fr); }
  .hd-orbit { --s: 250px; }
  .hd-node { width: 34px; height: 34px; } .hd-node svg { width: 15px; height: 15px; }
  .hd-score-body { grid-template-columns: auto 1fr; }
  .hd-score-parts { grid-column: 1 / -1; }
}

/* ==========================================================================
   MOBILE PRESERVATION
   ========================================================================== */
@media (max-width: 1024px) {
  html body .ho-app-layout .ho-main-content.hd-main { padding: 5.35rem .7rem calc(2rem + env(safe-area-inset-bottom)) !important; }
  .d-only { display: none !important; }
  .m-only { display: block !important; }
}
@media (min-width: 1025px) {
  .d-only { display: flex !important; }
  .m-only { display: none !important; }
}

@media (max-width: 760px) {
  .hd-wrap { gap: .8rem; display: flex; flex-direction: column;}
  .hd-card { border-radius: 22px; padding: 1.1rem; }
  .hd-hero { grid-template-columns: 1fr; min-height: 0; padding: 1.35rem 1.15rem 4.4rem; border-radius: 26px; }
  .hd-hero h1 { font-size: 1.85rem; letter-spacing: -.7px; }
  .hd-hero p.lead { font-size: .9rem; }
  .hd-orbit { position: absolute; --s: 230px; right: -78px; top: -62px; opacity: .38; margin: 0; pointer-events: none; }
  .hd-node-l { display: none; }
  .hd-hero-cta .hd-btn { flex: 1 1 100%; }
  .hd-ecg { height: 54px; }
  .hd-dock { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
  .hd-act { padding: .95rem; gap: .65rem; }
  .hd-act.primary { grid-column: span 2; flex-direction: row; align-items: center; }
  .hd-act.primary .hd-act-top { gap: .8rem; }
  .hd-act.primary .hd-go { display: none; }
  .hd-vitals { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
  .hd-vital { padding: 1rem; gap: .7rem; }
  .hd-v-val { font-size: 1.5rem; }
  .hd-v-foot .d { display: none; }
  .hd-empty-vitals { grid-template-columns: 1fr; text-align: left; }
  .hd-ai-content, .hd-wellness-content { grid-template-columns: 1fr; gap: .9rem; }
  .hd-ai-orb, .hd-wellness-orb { width: 58px; height: 58px; border-radius: 18px; }
  .hd-ai-orb svg, .hd-wellness-orb svg { width: 26px; height: 26px; }
  .hd-ev { grid-template-columns: 40px minmax(0, 1fr); }
  .hd-ev time { grid-column: 2; text-align: left; margin-top: -.3rem; display: flex; gap: .5rem; align-items: baseline; }
  .hd-ev time small { margin: 0; }
  .hd-med-body { flex-wrap: wrap; }
  .hd-med-body .hd-btn { width: 100%; }
  .hd-score-body { grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 1.2rem; }
  .hd-score-parts { width: 100%; text-align: left; }
  .hd-sp { grid-template-columns: 110px 1fr 28px; }
  .hd-feed-scroll { max-height: 300px; }
}
@media (max-width: 380px) {
  .hd-vitals { grid-template-columns: 1fr; }
  .hd-hero h1 { font-size: 1.6rem; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
  html.hd-js .hd-reveal { opacity: 1; transform: none; }
  .hd-ecg .trace { animation: none; stroke-dasharray: none; }
}


