                <div class="bt-tl-header">
                    <span class="bt-tl-title" id="ho-timeline-title">Health Journey</span>
                    <span class="bt-tl-date" id="ho-current-date-display">...</span>
                </div>
                <div class="bt-slider-row">
                    <button class="bt-btn-glass" style="padding: 0.6rem; border-radius: 12px; box-shadow:none;" id="btnPlayJourney">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                    </button>
                    <!-- Stop pointer events from bubbling to orbit controls -->
                    <input type="range" id="ho-time-slider" min="0" max="1" value="0" onpointerdown="event.stopPropagation()" ontouchstart="event.stopPropagation()">
                </div>
            </div>
        </div>

      </div>
