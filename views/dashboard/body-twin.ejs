<body>

<%- include('../partials/ambient') %>

<div class="ho-app-layout">
  <%- include('../partials/sidebar') %>

  <main class="ho-main-content">
    <div class="bt-wrap">

      <!-- Header & Family Selector -->
      <header class="bt-header">
        <div class="bt-title">
          <h1>Living <em>Body Twin</em></h1>
          <span class="bt-identity-subtitle" id="bt-identity-subtitle">Loading...</span>
        </div>
        <div class="bt-family-rail" id="bt-family-rail">
            <!-- Injected via JS -->
        </div>
      </header>

      <!-- 3D Stage Area -->
      <div class="bt-stage">

        <!-- 3D Canvas Background -->
        <div id="ho-3d-canvas-container"></div>
        <div class="bt-viewport">
            <div class="bt-placeholder-text" id="bt-canvas-text">[ INITIALIZING SCENE ]</div>
        </div>

        <!-- Floating UI Overlays -->
        <div class="bt-top-controls">
          <!-- Layers Popover -->
          <div class="bt-layers-popover">
            <button class="bt-btn-glass" id="btnToggleLayers">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg> Layers
            </button>
            <div class="bt-layers-menu" id="layersMenu">
              <label class="bt-layer-toggle"><input type="checkbox" checked style="accent-color: var(--d-coral);"> Current Issues</label>
              <label class="bt-layer-toggle"><input type="checkbox" checked style="accent-color: var(--d-amber);"> Follow-up Records</label>
              <label class="bt-layer-toggle"><input type="checkbox" checked style="accent-color: var(--d-blue);"> Historical Records</label>
              <label class="bt-layer-toggle"><input type="checkbox" style="accent-color: var(--d-teal-500);"> Wearables & Measurements</label>
            </div>
          </div>

          <!-- Mode Switcher -->
          <div class="bt-mode-switch">
            <button class="bt-mode-btn active" id="btnMapMode">Health Map</button>
            <button class="bt-mode-btn" id="btnProgressMode">Body Progress</button>
