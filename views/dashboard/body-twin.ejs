<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/header', { title: 'HealthOrbit — Living Body Twin' }) %>
  <link rel="icon" href="/images/Logo.png">

  <!-- Three.js Libraries -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>

  <style>
    /* ==================================================================
       LIVING BODY TWIN - COMBINED STYLES & VARIABLES
    ================================================================== */
    :root {
      --d-bg: #eef6f3;
      --d-ink: #0c2a26;
      --d-ink-2: #4a6861;
      --d-ink-3: #8aa39c;
      --d-teal-950: #06302b;
      --d-teal-900: #0b5e55;
      --d-teal-700: #0d7a6e;
      --d-teal-500: #17a795;
      --d-mint: #5fe0c4;
      --d-coral: #e5806c;
      --d-coral-soft: #fdeae5;
      --d-blue: #4285f4;
      --d-amber: #e09a2b;
      --d-red: #e5484d;
      --d-card: rgba(255, 255, 255, 0.72);
      --d-card-solid: #ffffff;
      --d-edge: rgba(255, 255, 255, 0.95);
      --d-line: rgba(11, 94, 85, 0.11);
      --d-shadow: 0 18px 40px -22px rgba(6, 48, 43, 0.28);
      --d-r-xl: 28px;
      --d-r-lg: 20px;
      --d-r-md: 14px;
    }

    body { overflow: hidden; background: var(--d-bg); }

    .bt-wrap { display: flex; flex-direction: column; height: 100vh; padding: 1.6rem 2.4rem 2.5rem; max-width: 1600px; margin: 0 auto; width: 100%;}

    /* Header & Family Rail */
    .bt-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.2rem; flex-wrap: wrap; gap: 1.5rem; flex-shrink: 0;}
    .bt-title h1 { font-family: 'Fraunces', serif; font-weight: 700; font-size: 2.2rem; color: var(--d-teal-950); letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 0.2rem; }
    .bt-title h1 em { font-style: normal; color: var(--d-coral); }
    .bt-identity-subtitle { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.95rem; font-weight: 750; color: var(--d-teal-700); background: rgba(13, 122, 110, 0.08); padding: 6px 14px; border-radius: 999px; }

    .bt-family-rail { display: flex; gap: 0.8rem; overflow-x: auto; scrollbar-width: none; padding-bottom: 0.5rem; }
    .bt-family-rail::-webkit-scrollbar { display: none; }
    .bt-fam-card { display: flex; align-items: center; gap: 0.8rem; background: var(--d-card); border: 1px solid var(--d-line); padding: 0.6rem 1rem 0.6rem 0.6rem; border-radius: 999px; cursor: pointer; transition: all 0.2s ease; backdrop-filter: blur(20px); white-space: nowrap; }
    .bt-fam-card:hover { background: #fff; border-color: var(--d-teal-500); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(13, 122, 110, 0.1); }
    .bt-fam-card.active { border-color: var(--d-teal-700); background: #fff; box-shadow: inset 0 0 0 1px var(--d-teal-700); }
    .bt-fam-av { width: 34px; height: 34px; border-radius: 50%; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.8rem; flex-shrink: 0; }
    .bt-fam-info { display: flex; flex-direction: column; }
    .bt-fam-info strong { font-size: 0.85rem; font-weight: 800; color: var(--d-teal-950); }
    .bt-fam-info span { font-size: 0.65rem; font-weight: 700; color: var(--d-ink-3); text-transform: uppercase; letter-spacing: 0.05em; }

    /* Main Stage */
    .bt-stage { flex: 1; min-height: 0; display: flex; flex-direction: column; position: relative; overflow: hidden; padding: 0; border-radius: var(--d-r-xl); background: radial-gradient(circle at 50% 42%, rgba(255,255,255,0.85), #c9e2dd); border: 1px solid var(--d-edge); box-shadow: var(--d-shadow); }

    /* Floating Controls (Top) */
    .bt-top-controls { position: absolute; top: 1.5rem; left: 1.5rem; right: 1.5rem; display: flex; justify-content: space-between; z-index: 20; pointer-events: none; }
    .bt-top-controls > * { pointer-events: auto; }

    .bt-mode-switch { display: flex; background: rgba(255,255,255,0.6); backdrop-filter: blur(20px); border: 1px solid var(--d-edge); padding: 4px; border-radius: 999px; box-shadow: 0 8px 25px rgba(13, 122, 110, 0.08); }
    .bt-mode-btn { border: none; background: transparent; padding: 0.6rem 1.4rem; font-size: 0.85rem; font-weight: 800; color: var(--d-ink-2); cursor: pointer; border-radius: 999px; transition: 0.2s; }
    .bt-mode-btn:hover { color: var(--d-teal-950); }
    .bt-mode-btn.active { background: var(--d-teal-950); color: #fff; box-shadow: 0 4px 12px rgba(11, 94, 85, 0.2); }

    .bt-layers-popover { position: relative; }
    .bt-btn-glass { background: rgba(255,255,255,0.7); color: var(--d-teal-950); backdrop-filter: blur(20px); padding: 0.8rem 1.4rem; border-radius: 999px; border: 1px solid var(--d-edge); font-weight: 700; font-size: 0.85rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: 0.2s; }
    .bt-btn-glass:hover { background: #fff; border-color: var(--d-teal-500); }

    .bt-layers-menu { position: absolute; top: calc(100% + 0.5rem); left: 0; background: var(--d-card-solid); border: 1px solid var(--d-line); border-radius: var(--d-r-md); padding: 1.2rem; box-shadow: 0 15px 35px rgba(0,0,0,0.1); width: 220px; display: none; flex-direction: column; gap: 1rem; z-index: 50; }
    .bt-layers-menu.show { display: flex; animation: fadeIn 0.2s ease; }
    .bt-layer-toggle { display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; font-weight: 700; color: var(--d-teal-950); cursor: pointer; }
    .bt-layer-toggle input { accent-color: var(--d-teal-700); width: 16px; height: 16px; cursor: pointer; }

    /* Viewport */
    .bt-viewport { position: absolute; inset: 0; z-index: 10; display: flex; align-items: center; justify-content: center; pointer-events: none;}
    #ho-3d-canvas-container { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 5;}

    .bt-placeholder-text { font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; font-weight: 700; color: var(--d-ink-3); text-transform: uppercase; letter-spacing: 0.1em; opacity: 0.6; text-align: center; background: rgba(255,255,255,0.7); padding: 10px 20px; border-radius: 12px;}

    .bt-camera-controls { position: absolute; right: 1.5rem; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; gap: 0.5rem; z-index: 20; pointer-events: auto; }
    .bt-cam-btn { width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,0.7); backdrop-filter: blur(10px); border: 1px solid var(--d-edge); color: var(--d-teal-950); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s; box-shadow: 0 4px 15px rgba(0,0,0,0.05); font-weight: 800;}
    .bt-cam-btn:hover { background: #fff; border-color: var(--d-teal-500); transform: scale(1.05); }

    /* Progressive Details Panel (Right Slide-over) */
    .bt-details-drawer { position: absolute; top: 0; right: 0; bottom: 0; width: 380px; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(40px); border-left: 1px solid var(--d-line); padding: 2.5rem 2rem; z-index: 30; transform: translateX(100%); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); display: flex; flex-direction: column; overflow-y: auto; box-shadow: -15px 0 40px rgba(0,0,0,0.05); pointer-events: auto; }
    .bt-details-drawer.open { transform: translateX(0); }
    .bt-details-drawer .close-btn { align-self: flex-end; background: none; border: none; font-size: 2rem; cursor: pointer; color: var(--d-ink-3); line-height: 1; margin-bottom: 1rem;}
    .bt-region-title { font-family: 'Fraunces', serif; font-weight: 800; font-size: 1.5rem; color: var(--d-teal-950); margin-bottom: 1.5rem; text-transform: uppercase; }

    .bt-event-card { background: #fff; border: 1px solid var(--d-line); border-radius: var(--d-r-md); padding: 1.2rem; margin-bottom: 1rem; box-shadow: 0 4px 15px rgba(0,0,0,0.02); border-left: 4px solid var(--d-coral); }
    .bt-event-card.amber { border-left-color: var(--d-amber); }
    .bt-event-card.blue { border-left-color: var(--d-blue); }
    .bt-event-card.cyan { border-left-color: var(--d-teal-500); }
    .bt-event-card strong { display: block; font-size: 1rem; font-weight: 800; color: var(--d-teal-950); margin-bottom: 0.4rem; line-height: 1.3;}
    .bt-event-meta { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--d-ink-2); font-weight: 600; display: block; margin-bottom: 0.6rem; }
    .bt-event-source { font-size: 0.75rem; font-weight: 750; color: var(--d-teal-700); background: rgba(13,122,110,0.08); padding: 4px 10px; border-radius: 6px; display: inline-block; }

    /* Timeline Dock (Bottom) */
    .bt-bottom-dock { position: absolute; bottom: 1.5rem; left: 1.5rem; right: 1.5rem; display: flex; justify-content: center; z-index: 20; pointer-events: none; }
    .bt-timeline-card { background: rgba(255,255,255,0.85); backdrop-filter: blur(30px); border: 1px solid var(--d-edge); border-radius: var(--d-r-xl); padding: 1.2rem 2rem; width: 100%; max-width: 800px; box-shadow: 0 15px 40px rgba(11, 94, 85, 0.1); pointer-events: auto; display: flex; flex-direction: column; gap: 1rem; }
    .bt-tl-header { display: flex; justify-content: space-between; align-items: center; }
    .bt-tl-title { font-size: 0.85rem; font-weight: 800; color: var(--d-teal-950); text-transform: uppercase; letter-spacing: 0.05em; }
    .bt-tl-date { font-family: 'JetBrains Mono', monospace; font-weight: 800; font-size: 1.2rem; color: var(--d-coral); transition: 0.3s; }
    .bt-slider-row { display: flex; align-items: center; gap: 1rem; width: 100%; }

    input[type=range] { flex: 1; -webkit-appearance: none; background: transparent; touch-action: none; }
    input[type=range]::-webkit-slider-runnable-track { width: 100%; height: 8px; background: rgba(13, 122, 110, 0.15); border-radius: 999px; }
    input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; height: 22px; width: 22px; border-radius: 50%; background: var(--d-teal-700); cursor: pointer; margin-top: -7px; box-shadow: 0 0 0 4px rgba(13, 122, 110, 0.2); transition: 0.1s; }
    input[type=range]::-webkit-slider-thumb:active { transform: scale(1.2); }

    .bt-btn-primary { background: var(--d-teal-950); color: #fff; border: none; padding: 0.8rem; border-radius: 12px; font-weight: 700; cursor: pointer; transition: 0.2s; display: flex; align-items: center; gap: 0.5rem; justify-content: center;}
    .bt-btn-primary:hover { background: var(--d-teal-900); transform: translateY(-2px); }

    /* Privacy Overlay */
    .bt-overlay-state { position: absolute; inset: 0; background: rgba(238, 246, 243, 0.95); backdrop-filter: blur(10px); z-index: 25; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem; transition: opacity 0.3s ease; pointer-events: auto; }
    .bt-overlay-state svg { width: 56px; height: 56px; color: var(--d-ink-3); margin-bottom: 1.5rem; }
    .bt-overlay-state h3 { font-family: 'Fraunces', serif; font-size: 1.8rem; color: var(--d-teal-950); margin-bottom: 0.5rem; }
    .bt-overlay-state p { font-size: 1rem; color: var(--d-ink-2); font-weight: 600; max-width: 400px; line-height: 1.5; margin-bottom: 1.5rem;}

    @keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

    /* Modal Evidence Overlay */
    .ho-modal { position: fixed; inset: 0; background: rgba(11, 94, 85, 0.45); backdrop-filter: blur(10px); display: none; align-items: center; justify-content: center; z-index: 3000; padding: 1.2rem; opacity: 0; transition: opacity 0.3s ease; pointer-events: auto; }
    .ho-modal.active { display: flex; opacity: 1; }
    .ho-modal-box { background: #ffffff; border: 1px solid var(--d-edge); border-radius: var(--d-r-xl); padding: 2.5rem; width: 100%; max-width: 600px; box-shadow: 0 35px 70px rgba(0,0,0,0.2); transform: translateY(20px); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);}
    .ho-modal.active .ho-modal-box { transform: translateY(0); }
    .ho-modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.8rem; }
    .ho-modal-head h3 { font-size: 1.4rem; font-weight: 800; color: var(--d-teal-950); }
    .ho-modal-close { background: none; border: none; font-size: 2.2rem; color: var(--d-ink-3); cursor: pointer; transition: 0.2s; line-height: 1;}

    /* Mobile */
    @media (max-width: 1024px) {
      .ho-main-content { margin-top: 5rem; padding: 0 !important;}
      .bt-wrap { padding: 1rem 1rem 1rem; }
      .bt-header { flex-direction: column; align-items: flex-start; gap: 1rem;}
      .bt-top-controls { flex-direction: column; gap: 1rem; align-items: flex-start;}
      .bt-details-drawer { width: 100%; top: auto; height: 65vh; border-left: none; border-top: 1px solid var(--d-line); border-radius: 24px 24px 0 0; transform: translateY(100%); }
      .bt-details-drawer.open { transform: translateY(0); }
      .bt-camera-controls { top: auto; bottom: 8rem; right: 1rem; transform: none; flex-direction: row;}
      .bt-bottom-dock { bottom: 1rem; left: 1rem; right: 1rem; }
      .bt-timeline-card { padding: 1.2rem; border-radius: 20px;}
    }









    /* ==================================================================
   LIVING BODY TWIN — MOBILE (<= 1024px) — REPLACES your old
   "@media (max-width: 1024px) { ... }" block. Desktop CSS untouched.
   Layout: compact header → full-bleed 3D stage → floating timeline
   dock (always reachable) → floating detail card above the dock.
================================================================== */
@media (max-width: 1024px) {
  :root { --bt-dock: 118px; }

  body { overscroll-behavior: none; }
  .ho-main-content { margin-top: 5rem; padding: 0 !important; }
  .bt-top-controls .desktop-only { display: none; }

  /* ---------- Shell: use real visible height (dvh) ---------- */
  .bt-wrap {
    height: calc(100vh - 5rem);
    height: calc(100dvh - 5rem);
    padding: 0.6rem 0.75rem calc(0.75rem + env(safe-area-inset-bottom));
  }

  /* ---------- Header: one title row + story-style member rail ---------- */
  .bt-header {
    flex-direction: column; align-items: stretch;
    gap: 0.55rem; margin-bottom: 0.6rem;
  }
  .bt-title { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; }
  .bt-title h1 { font-size: 1.45rem; margin: 0; white-space: nowrap; }
  .bt-identity-subtitle {
    font-size: 0.7rem; padding: 5px 10px; min-width: 0;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .bt-family-rail {
    margin: 0 -0.75rem; padding: 0.1rem 0.75rem 0.15rem;
    gap: 0.5rem; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch;
  }
  .bt-fam-card {
    scroll-snap-align: start; flex-shrink: 0;
    padding: 5px 14px 5px 5px; gap: 0.55rem; min-height: 46px;
  }
  .bt-fam-av { width: 36px; height: 36px; font-size: 0.85rem; }
  .bt-fam-info strong { font-size: 0.8rem; }
  .bt-fam-info span { font-size: 0.58rem; }

  /* ---------- Stage ---------- */
  .bt-stage { border-radius: 24px; }

  /* 3D canvas stops above the dock so the figure's feet are never covered */
  #ho-3d-canvas-container,
  .bt-viewport {
    bottom: calc(var(--bt-dock) + env(safe-area-inset-bottom));
    height: auto;
  }
  #ho-3d-canvas-container canvas { touch-action: none; display: block; }
  .bt-placeholder-text { font-size: 0.7rem; padding: 8px 14px; }

  /* ---------- Top controls: icon-only Layers + compact segmented switch ---------- */
  .bt-top-controls {
    top: 0.75rem; left: 0.75rem; right: 0.75rem;
    flex-direction: row; align-items: center; justify-content: space-between; gap: 0.5rem;
  }
  .bt-btn-glass#btnToggleLayers {
    font-size: 0; gap: 0; width: 44px; height: 44px; padding: 0;
    justify-content: center; border-radius: 50%;
  }
  .bt-layers-menu { width: 230px; padding: 0.4rem 1rem; gap: 0; }
  .bt-layer-toggle { min-height: 46px; font-size: 0.9rem; }
  .bt-layer-toggle input { width: 20px; height: 20px; }

  .bt-mode-switch { padding: 3px; }
  .bt-mode-btn { padding: 0.65rem 0.95rem; min-height: 40px; font-size: 0.78rem; white-space: nowrap; }

  /* ---------- Camera: slim vertical rail under the mode switch ---------- */
  .bt-camera-controls {
    right: 0.75rem; top: 4.4rem; bottom: auto; transform: none;
    flex-direction: column; gap: 0.45rem;
  }
  .bt-cam-btn { width: 42px; height: 42px; border-radius: 50%; }
  .bt-cam-btn[title="Reset Camera"] { margin-top: 0.35rem !important; }

  /* ---------- Timeline dock: floating glass, thumb-reachable ---------- */
  .bt-bottom-dock {
    left: 0.75rem; right: 0.75rem;
    bottom: calc(0.75rem + env(safe-area-inset-bottom));
  }
  .bt-timeline-card { padding: 0.7rem 1rem 0.5rem; gap: 0.15rem; border-radius: 24px; max-width: none; }
  .bt-tl-title { font-size: 0.68rem; }
  .bt-tl-date { font-size: 1.05rem; }
  .bt-slider-row { gap: 0.7rem; }
  #btnPlayJourney {
    width: 46px; height: 46px; padding: 0 !important; flex-shrink: 0;
    justify-content: center; border-radius: 50% !important;
    background: var(--d-teal-950); color: #fff; border: none;
  }
  input[type=range] { height: 46px; }
  input[type=range]::-webkit-slider-runnable-track { height: 10px; }
  input[type=range]::-webkit-slider-thumb { height: 30px; width: 30px; margin-top: -10px; box-shadow: 0 0 0 5px rgba(13,122,110,0.2), 0 3px 8px rgba(0,0,0,0.2); }
  input[type=range]::-moz-range-track { height: 10px; background: rgba(13,122,110,0.15); border-radius: 999px; }
  input[type=range]::-moz-range-thumb { height: 30px; width: 30px; border: none; border-radius: 50%; background: var(--d-teal-700); box-shadow: 0 0 0 5px rgba(13,122,110,0.2); }

  /* ---------- Detail card: floats ABOVE the dock, timeline stays usable ---------- */
  .bt-details-drawer {
    top: auto; left: 0.75rem; right: 0.75rem; width: auto;
    bottom: calc(var(--bt-dock) + env(safe-area-inset-bottom) + 0.5rem);
    height: auto; max-height: 40%;
    padding: 1rem 1rem 1rem; border: 1px solid var(--d-edge); border-radius: 22px;
    box-shadow: 0 18px 40px -12px rgba(6,48,43,0.35);
    transform: translateY(16px) scale(0.98); opacity: 0; pointer-events: none;
    transition: transform 0.35s cubic-bezier(0.16,1,0.3,1), opacity 0.25s ease;
  }
  .bt-details-drawer.open { transform: none; opacity: 1; pointer-events: auto; }
  .bt-details-drawer .close-btn {
    position: absolute; top: 6px; right: 6px; width: 40px; height: 40px;
    font-size: 1.6rem; margin: 0; display: flex; align-items: center; justify-content: center;
  }
  .bt-region-title { font-size: 1.05rem; margin: 0 0 0.7rem; padding-right: 2.5rem; }
  .bt-event-card { padding: 0.85rem 0.9rem; margin-bottom: 0.7rem; }
  .bt-event-card strong { font-size: 0.92rem; }
  .bt-event-meta { margin-bottom: 0.4rem; }
  .bt-details-drawer > div[style*="flex-direction:column"] { flex-direction: row !important; margin-top: 0.5rem !important; gap: 0.5rem !important; }
  .bt-details-drawer > div[style*="flex-direction:column"] button { flex: 1; min-height: 46px; padding: 0.6rem 0.5rem; font-size: 0.78rem; border-radius: 14px; }
  .bt-details-drawer div[style*="padding: 2rem 0"] { padding: 0.4rem 0 !important; }
  .bt-details-drawer div[style*="padding: 2rem 0"] span { font-size: 2.2rem !important; }
  .bt-details-drawer div[style*="padding-top: 1.5rem"] { padding-top: 0.7rem !important; }

  /* ---------- Privacy overlay ---------- */
  .bt-overlay-state { padding: 1.5rem; }
  .bt-overlay-state svg { width: 44px; height: 44px; margin-bottom: 1rem; }
  .bt-overlay-state h3 { font-size: 1.4rem; }
  .bt-overlay-state p { font-size: 0.92rem; margin-bottom: 1.2rem; }

  /* ---------- Evidence modal → bottom sheet ---------- */
  .ho-modal { align-items: flex-end; padding: 0; }
  .ho-modal-box {
    max-width: none; border-radius: 28px 28px 0 0; max-height: 88vh; max-height: 88dvh; overflow-y: auto;
    padding: 1.6rem 1.25rem calc(1.4rem + env(safe-area-inset-bottom));
    transform: translateY(40px); position: relative;
  }
  .ho-modal-box::before {
    content: ""; position: absolute; top: 8px; left: 50%; transform: translateX(-50%);
    width: 40px; height: 4px; border-radius: 4px; background: rgba(11,94,85,0.18);
  }
  .ho-modal-head { margin-bottom: 1.1rem; }
  .ho-modal-head h3 { font-size: 1.15rem; }
  .ho-modal-close { width: 44px; height: 44px; margin-right: -10px; }
}

/* ---------- Small phones ---------- */
@media (max-width: 380px) {
  .bt-title h1 { font-size: 1.25rem; }
  .bt-mode-btn { padding: 0.65rem 0.7rem; font-size: 0.72rem; }
  .bt-identity-subtitle { max-width: 45%; }
}

/* ---------- Phone landscape: maximise the figure ---------- */
@media (max-width: 1024px) and (max-height: 520px) and (orientation: landscape) {
  :root { --bt-dock: 84px; }
  .bt-header { display: none; }
  .bt-wrap { height: calc(100dvh - 4rem); padding-top: 0.4rem; }
  .bt-timeline-card { padding: 0.35rem 0.9rem; }
  .bt-tl-header { position: absolute; right: 1rem; top: -1.6rem; gap: 0.6rem; }
  .bt-bottom-dock { left: 20%; right: 20%; }
  .bt-details-drawer { left: auto; width: 320px; top: 0.75rem; bottom: calc(var(--bt-dock) + 0.5rem); max-height: none; }
}

/* ---------- Touch devices: no sticky hover states ---------- */
@media (hover: none) {
