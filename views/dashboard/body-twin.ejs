        <!-- Camera Controls -->
        <div class="bt-camera-controls">
            <button class="bt-cam-btn" title="Front View" onclick="BodyTwin3D.resetCamera('front')">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </button>
            <button class="bt-cam-btn" title="Back View" onclick="BodyTwin3D.resetCamera('back')">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-2a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </button>
            <button class="bt-cam-btn" title="Reset Camera" style="margin-top: 1rem;" onclick="BodyTwin3D.resetCamera('front')">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><polyline points="3 3 3 8 8 8"></polyline></svg>
            </button>
        </div>

        <!-- Privacy Overlay -->
        <div class="bt-overlay-state" id="bt-privacy-overlay" style="display:none;"></div>

        <!-- Details Slide-Out Drawer -->
        <div class="bt-details-drawer" id="bt-details-panel">
