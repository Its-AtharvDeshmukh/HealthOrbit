<!-- ==================================================================
     JAVASCRIPT LOGIC (MOCK DATA, UI STATE, THREE.JS ENGINE)
================================================================== -->
<script>
/* ------------------------------------------------------------------
   1. MOCK DATA LAYER (Frontend Hackathon DB) — unchanged from before
------------------------------------------------------------------ */
const MockDB = {
    members: [
        { id: "demo-self", name: "Atharv", relationship: "Self", access: "full", model: "adult" },
        { id: "demo-mother", name: "Demo Mother", relationship: "Mother", access: "shared", model: "adult-female" },
        { id: "demo-child", name: "Demo Child", relationship: "Child", access: "shared", model: "child" },
        { id: "demo-father", name: "Demo Father", relationship: "Father", access: "limited", model: "adult" }
    ],
    markers: {
        "demo-self": [
            { dateId: "May 2026", region: "LEFT_FOREARM", state: "none", color: "none" },
            { dateId: "Jun 2026", region: "LEFT_FOREARM", state: "Current record", color: "coral", title: "Distal radius fracture", date: "12 Jun 2026", source: "X-Ray Report" },
            { dateId: "Jul 2026", region: "LEFT_FOREARM", state: "Follow-up record", color: "amber", title: "Orthopedic Follow-up", date: "08 Jul 2026", source: "Clinical Visit" },
            { dateId: "Sep 2026", region: "LEFT_FOREARM", state: "Historical record", color: "blue", title: "Physical Therapy Assessment", date: "15 Sep 2026", source: "Measurement" }
        ],
        "demo-mother": [
            { dateId: "Aug 2026", region: "CHEST", state: "Measurement record", color: "cyan", title: "Echocardiogram Routine", date: "10 Aug 2026", source: "Medical Report" },
            { dateId: "Sep 2026", region: "CHEST", state: "Measurement record", color: "cyan", title: "Echocardiogram Routine", date: "10 Aug 2026", source: "Medical Report" }
        ],
        "demo-child": [
            { dateId: "Jan 2026", region: "RIGHT_KNEE", state: "none", color: "none" },
            { dateId: "Sep 2026", region: "RIGHT_KNEE", state: "Current record", color: "coral", title: "Sports Injury Assessment", date: "02 Sep 2026", source: "Clinical Visit" }
        ]
    },
    progress: {
        "demo-self": { type: "weight", target: 72, history: { "Jan 2026": 82, "Mar 2026": 79, "May 2026": 77, "Jun 2026": 76, "Jul 2026": 75, "Sep 2026": 74 } },
        "demo-mother": { type: "weight", target: 65, history: { "Jan 2026": 68, "May 2026": 67, "Aug 2026": 66, "Sep 2026": 65 } },
        "demo-child": { type: "growth", target: null, history: { "2024": "110 cm", "2025": "115 cm", "Jan 2026": "118 cm", "Sep 2026": "122 cm" } }
    },
    timelines: {
        "demo-self": ["Jan 2026", "Mar 2026", "May 2026", "Jun 2026", "Jul 2026", "Sep 2026"],
        "demo-mother": ["Jan 2026", "May 2026", "Aug 2026", "Sep 2026"],
        "demo-child": ["2024", "2025", "Jan 2026", "Sep 2026"]
    }
};

const BodyTwinDataService = {
    getFamilyMembers: () => MockDB.members,
    getMemberById: (id) => MockDB.members.find(m => m.id === id),
    getTimeline: (memberId) => MockDB.timelines[memberId] || [],
    getMarkersForDate: (memberId, dateId) => {
        return (MockDB.markers[memberId] || []).filter(m => m.dateId === dateId && m.state !== "none");
    },
    getProgress: (memberId) => MockDB.progress[memberId] || null
};

/* ------------------------------------------------------------------
   2. THREE.JS ENGINE & CANONICAL REGION ANCHOR SYSTEM
   CORRECTED: the fallback body is now a proportionally realistic,
   clothed, rest-pose (arms at sides, not T-pose) humanoid built from
   smooth capsule-style limbs instead of blocky raw cylinders, with
   male/female/child silhouettes and a subtle breathing idle animation.
------------------------------------------------------------------ */
const BodyTwin3D = (function() {
    let scene, camera, renderer, controls, raycaster, mouse;
    let bodyModel = null;
    let bodyParts = {};          // name -> mesh/group, used for region anchoring + raycasting
    let markersGroup = new THREE.Group();
    let container;
    let clock = new THREE.Clock();
    let usingFallback = false;

    // Canonical mapping. meshName now matches the part names the fallback
    // builder actually creates, so highlight/focus/markers all resolve
    // correctly instead of silently no-op'ing against a mismatched name.
    const BodyRegionSystem = {
        HEAD:           { meshName: 'head',         fallbackPos: {x:0,    y:2.52, z:0.22} },
        CHEST:          { meshName: 'chest',        fallbackPos: {x:0,    y:1.75, z:0.32} },
        ABDOMEN:        { meshName: 'waist',        fallbackPos: {x:0,    y:1.38, z:0.26} },
        LEFT_FOREARM:   { meshName: 'leftForearm',  fallbackPos: {x:-0.58,y:1.08, z:0.08} },
        RIGHT_FOREARM:  { meshName: 'rightForearm', fallbackPos: {x:0.58, y:1.08, z:0.08} },
        LEFT_KNEE:      { meshName: 'leftShin',     fallbackPos: {x:-0.16,y:0.0,  z:0.12} },
        RIGHT_KNEE:     { meshName: 'rightShin',    fallbackPos: {x:0.16, y:0.0,  z:0.12} }
    };

    function init(domElement) {
        container = domElement;

        scene = new THREE.Scene();
        scene.add(markersGroup);

        const width = container.clientWidth || window.innerWidth * 0.7;
        const height = container.clientHeight || window.innerHeight * 0.7;

        camera = new THREE.PerspectiveCamera(32, width / height, 0.1, 100);
        camera.position.set(0, 1.0, 6.2);

        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        renderer.outputEncoding = THREE.sRGBEncoding;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.05;

        container.appendChild(renderer.domElement);

        controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.08;
        controls.minDistance = 3.2;
        controls.maxDistance = 11;
        controls.maxPolarAngle = Math.PI * 0.62;
        controls.minPolarAngle = Math.PI * 0.25;
        controls.target.set(0, 1.1, 0);

        raycaster = new THREE.Raycaster();
        mouse = new THREE.Vector2();
        renderer.domElement.addEventListener('click', onCanvasClick);

        const ambientLight = new THREE.AmbientLight(0xffffff, 0.55);
        scene.add(ambientLight);

        const mainLight = new THREE.DirectionalLight(0xfff3e8, 0.95);
        mainLight.position.set(2.2, 4.5, 4.5);
        scene.add(mainLight);

        const fillLight = new THREE.DirectionalLight(0x9fd8ce, 0.45);
        fillLight.position.set(-4, 1.5, 3);
        scene.add(fillLight);

        const rimLight = new THREE.DirectionalLight(0x5fe0c4, 0.5);
        rimLight.position.set(0, 4, -6);
        scene.add(rimLight);

        window.addEventListener('resize', onWindowResize);
        setTimeout(onWindowResize, 100);

        animate();
    }

    function loadModel(modelType, onLoadComplete) {
        if (bodyModel) {
            scene.remove(bodyModel);
            bodyModel = null;
            bodyParts = {};
        }

        const loaderText = document.getElementById('bt-canvas-text');
        if (loaderText) {
            loaderText.style.display = 'block';
            loaderText.textContent = `[ LOADING BODY TWIN: ${modelType.toUpperCase()} ]`;
        }

        const loader = new THREE.GLTFLoader();
        const modelUrl = `/models/body/${modelType}.glb`;

        loader.load(
            modelUrl,
            function (gltf) {
                if (loaderText) loaderText.style.display = 'none';
                usingFallback = false;
                bodyModel = gltf.scene;

                const box = new THREE.Box3().setFromObject(bodyModel);
                const center = box.getCenter(new THREE.Vector3());
                const size = box.getSize(new THREE.Vector3());
                const maxDim = Math.max(size.x, size.y, size.z);
                const scale = 3.2 / maxDim;

                bodyModel.scale.set(scale, scale, scale);
                bodyModel.position.set(-center.x * scale, -center.y * scale, -center.z * scale);

                bodyModel.traverse(child => { if (child.isMesh) bodyParts[child.name] = child; });

                scene.add(bodyModel);
                if (onLoadComplete) onLoadComplete();
            },
            undefined,
            function () {
                console.warn(`[HealthOrbit 3D] No GLB at ${modelUrl} yet — using the detailed procedural fallback body.`);
                createDetailedFallback(modelType);
                if (onLoadComplete) onLoadComplete();
            }
        );
    }

    // ----------------------------------------------------------------
    // DETAILED PROCEDURAL FALLBACK — replaces the old blocky T-pose
    // cylinders. Smooth capsule-style limbs (cylinder + sphere caps),
    // realistic proportion differences for male / female / child, a
    // natural arms-at-sides rest pose, simple respectful clothing on
    // the torso/hips (not bare skin), and subtle hair geometry.
    // ----------------------------------------------------------------
    function createDetailedFallback(modelType) {
        const loaderText = document.getElementById('bt-canvas-text');
        if (loaderText) loaderText.style.display = 'none';
        usingFallback = true;
        bodyParts = {};

        const isFemale = modelType === 'adult-female';
        const isChild = modelType === 'child';

        const SKIN = isFemale ? 0xe8c0a0 : (isChild ? 0xedc9a8 : 0xe3b48d);
        const CLOTH = isFemale ? 0x4a5b76 : (isChild ? 0xe09a2b : 0x0d7a6e);
        const HAIR = isFemale ? 0x3b2a22 : 0x271d16;

        const skinMat = new THREE.MeshStandardMaterial({ color: SKIN, roughness: 0.6, metalness: 0.0 });
        const clothMat = new THREE.MeshStandardMaterial({ color: CLOTH, roughness: 0.85, metalness: 0.0 });
        const hairMat = new THREE.MeshStandardMaterial({ color: HAIR, roughness: 0.92, metalness: 0.0 });

        const shoulderW = isChild ? 0.3 : (isFemale ? 0.4 : 0.46);
        const waistW    = isChild ? 0.26: (isFemale ? 0.27: 0.33);
        const hipW      = isChild ? 0.27: (isFemale ? 0.37: 0.32);
        const scale     = isChild ? 0.62: (isFemale ? 0.95: 1.0);

        const g = new THREE.Group();
        g.scale.setScalar(scale);

        function part(name, geo, mat, pos, rot) {
            const m = new THREE.Mesh(geo, mat);
            m.position.set(pos[0], pos[1], pos[2]);
            if (rot) m.rotation.set(rot[0] || 0, rot[1] || 0, rot[2] || 0);
            m.name = name;
            g.add(m);
            bodyParts[name] = m;
            return m;
        }

        // smooth capsule limb: cylinder body + two sphere end-caps grouped
        // as one unit (r128 has no native CapsuleGeometry)
        function capsule(name, rTop, rBot, length, mat, pos, rotZ) {
            const grp = new THREE.Group();
            const cyl = new THREE.Mesh(new THREE.CylinderGeometry(rTop, rBot, length, 20), mat);
            grp.add(cyl);
            const top = new THREE.Mesh(new THREE.SphereGeometry(rTop, 16, 12, 0, Math.PI * 2, 0, Math.PI / 2), mat);
            top.position.y = length / 2; grp.add(top);
            const bot = new THREE.Mesh(new THREE.SphereGeometry(rBot, 16, 12, 0, Math.PI * 2, Math.PI / 2, Math.PI / 2), mat);
            bot.position.y = -length / 2; grp.add(bot);
            grp.position.set(pos[0], pos[1], pos[2]);
            if (rotZ) grp.rotation.z = rotZ;
            grp.name = name;
            grp.children.forEach(c => c.userData.region = name);
            g.add(grp);
            bodyParts[name] = grp;
            return grp;
        }

        // Torso: tapered chest -> waist -> pelvis for a real silhouette
        part('chest', new THREE.CylinderGeometry(shoulderW, waistW + 0.03, 0.56, 24), clothMat, [0, 1.75, 0]);
        part('waist', new THREE.CylinderGeometry(waistW, hipW, 0.26, 24), clothMat, [0, 1.42, 0]);
        part('pelvis', new THREE.CylinderGeometry(hipW, hipW - 0.04, 0.34, 20), clothMat, [0, 1.18, 0]);

        // Shoulder caps smooth the chest-to-arm junction
        part('leftShoulderCap', new THREE.SphereGeometry(0.12, 16, 12), clothMat, [-shoulderW + 0.02, 1.98, 0]);
        part('rightShoulderCap', new THREE.SphereGeometry(0.12, 16, 12), clothMat, [shoulderW - 0.02, 1.98, 0]);

        part('neck', new THREE.CylinderGeometry(0.09, 0.11, 0.18, 16), skinMat, [0, 2.1, 0]);
        part('head', new THREE.SphereGeometry(0.21, 26, 22), skinMat, [0, 2.36, 0]);

        // Simple, tasteful hair silhouette
        if (isFemale) {
            part('hair', new THREE.SphereGeometry(0.235, 18, 14, 0, Math.PI * 2, 0, Math.PI * 0.6), hairMat, [0, 2.4, -0.015]);
            part('hairBack', new THREE.CylinderGeometry(0.17, 0.1, 0.42, 16), hairMat, [0, 2.1, -0.09]);
        } else {
            part('hair', new THREE.SphereGeometry(0.215, 18, 14, 0, Math.PI * 2, 0, Math.PI * 0.5), hairMat, [0, 2.41, -0.01]);
        }

        // Arms in a natural, slightly-relaxed rest pose (not T-pose): a
        // small inward rotation at the shoulder so forearms angle toward
        // the body, reading as a calm standing figure.
        const armAngle = 0.18;
        capsule('leftUpperArm', 0.085, 0.072, 0.56, skinMat, [-(shoulderW + 0.09), 1.74, 0], armAngle);
        capsule('leftForearm', 0.07, 0.06, 0.52, skinMat, [-(shoulderW + 0.17), 1.18, 0.04], armAngle * 1.4);
        part('leftHand', new THREE.SphereGeometry(0.062, 14, 12), skinMat, [-(shoulderW + 0.23), 0.86, 0.07]);

        capsule('rightUpperArm', 0.085, 0.072, 0.56, skinMat, [shoulderW + 0.09, 1.74, 0], -armAngle);
        capsule('rightForearm', 0.07, 0.06, 0.52, skinMat, [shoulderW + 0.17, 1.18, 0.04], -armAngle * 1.4);
        part('rightHand', new THREE.SphereGeometry(0.062, 14, 12), skinMat, [shoulderW + 0.23, 0.86, 0.07]);

        // Legs: thigh + shin as smooth capsules, simple foot
        function leg(side) {
            const sign = side === 'left' ? -1 : 1;
            const x = sign * (hipW * 0.52);
            capsule(side + 'Thigh', 0.115, 0.09, 0.66, skinMat, [x, 0.78, 0]);
            capsule(side + 'Shin', 0.082, 0.062, 0.62, skinMat, [x, 0.14, 0]);
            part(side + 'Foot', new THREE.BoxGeometry(0.13, 0.07, 0.26, 2, 1, 2), skinMat, [x, -0.22, 0.05]);
        }
        leg('left'); leg('right');

        g.position.y = -0.25;
        scene.add(g);
        bodyModel = g;
    }

    function highlightRegion(regionName, colorCode) {
        if (!bodyModel) return;
        const colors = { coral: 0xe5806c, amber: 0xe09a2b, blue: 0x4285f4, cyan: 0x17a795 };
        const hexColor = colors[colorCode] || 0x000000;

        Object.values(bodyParts).forEach(obj => {
            const target = obj.isMesh ? obj : (obj.children && obj.children[0]);
            if (target && target.material && target.material.emissive) target.material.emissive.setHex(0x000000);
        });

        const sys = BodyRegionSystem[regionName];
        if (!sys) return;
        const node = bodyParts[sys.meshName];
        if (!node) return;
        const target = node.isMesh ? node : node.children[0];
        if (target && target.material && target.material.emissive) {
            target.material.emissive.setHex(hexColor);
            target.material.emissiveIntensity = 0.45;
        }
    }

    function renderMarkers(markerDataList) {
        markersGroup.clear();
        Object.values(bodyParts).forEach(obj => {
            const target = obj.isMesh ? obj : (obj.children && obj.children[0]);
            if (target && target.material && target.material.emissive) target.material.emissive.setHex(0x000000);
        });

        const colors = { coral: 0xe5806c, amber: 0xe09a2b, blue: 0x4285f4, cyan: 0x17a795 };

        markerDataList.forEach(data => {
            const sys = BodyRegionSystem[data.region];
            if (!sys) return;

            highlightRegion(data.region, data.color);

            const anchorGroup = new THREE.Group();
            anchorGroup.position.set(sys.fallbackPos.x, sys.fallbackPos.y, sys.fallbackPos.z);

            const geo = new THREE.SphereGeometry(0.055, 16, 16);
            const mat = new THREE.MeshBasicMaterial({ color: colors[data.color] || 0xffffff });
            const sphere = new THREE.Mesh(geo, mat);
            sphere.userData = data;
            anchorGroup.add(sphere);

            const ringGeo = new THREE.RingGeometry(0.08, 0.1, 28);
            const ringMat = new THREE.MeshBasicMaterial({ color: colors[data.color], side: THREE.DoubleSide, transparent: true, opacity: 0.8 });
            const ring = new THREE.Mesh(ringGeo, ringMat);
            ring.userData = { isRing: true };
            anchorGroup.add(ring);

            markersGroup.add(anchorGroup);
        });
    }

    function applyMorphTarget(percentage) {
        if (!bodyModel) return;
        let morphApplied = false;
        bodyModel.traverse((child) => {
            if (child.isMesh && child.morphTargetInfluences && child.morphTargetInfluences.length > 0) {
                child.morphTargetInfluences[0] = percentage;
                morphApplied = true;
            }
        });
        if (!morphApplied) {
            // Illustrative-only, dampened whole-figure scale — honestly
            // labeled in the UI, never claimed as a real body morph.
            const influence = 1 + (percentage - 0.5) * 0.18;
            bodyModel.scale.x = (bodyModel.userData.baseScale || bodyModel.scale.y) * influence;
            bodyModel.scale.z = (bodyModel.userData.baseScale || bodyModel.scale.y) * influence;
            if (!bodyModel.userData.baseScale) bodyModel.userData.baseScale = bodyModel.scale.y;
        }
    }

    function focusRegion(regionName) {
        const sys = BodyRegionSystem[regionName];
        if (!sys) return;
        const pos = sys.fallbackPos;
        const targetPos = new THREE.Vector3(pos.x, pos.y, pos.z);
        camera.position.lerp(new THREE.Vector3(targetPos.x * 1.1, targetPos.y + 0.2, targetPos.z + 2.6), 0.12);
        controls.target.lerp(targetPos, 0.12);
    }

    function onCanvasClick(event) {
        if (!container) return;
        const rect = renderer.domElement.getBoundingClientRect();
        mouse.x = ((event.clientX - rect.left) / container.clientWidth) * 2 - 1;
        mouse.y = -((event.clientY - rect.top) / container.clientHeight) * 2 + 1;

        raycaster.setFromCamera(mouse, camera);
        let targets = [];
        markersGroup.children.forEach(g => targets.push(...g.children));
        const intersects = raycaster.intersectObjects(targets);

        if (intersects.length > 0) {
            const hit = intersects[0].object;
            if (hit.userData && !hit.userData.isRing && hit.userData.region) {
                focusRegion(hit.userData.region);
                document.dispatchEvent(new CustomEvent('markerClicked', { detail: hit.userData }));
            }
        }
    }

    function resetCamera(view) {
        controls.target.set(0, 1.1, 0);
        if (view === 'front') camera.position.set(0, 1.0, 6.2);
        if (view === 'back') camera.position.set(0, 1.0, -6.2);
        controls.update();
    }

    function onWindowResize() {
        if (!container) return;
        const width = container.clientWidth;
        const height = container.clientHeight;
        if (width === 0 || height === 0) return;
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
    }

    function animate() {
        requestAnimationFrame(animate);
        controls.update();
        const t = clock.getElapsedTime();

        if (bodyModel) {
            // Subtle breathing/idle sway — small enough to feel alive,
            // never distracting from the health data itself.
            bodyModel.position.y = (usingFallback ? -0.25 : 0) + Math.sin(t * 0.9) * 0.012;
            if (usingFallback && bodyParts.chest) {
                bodyParts.chest.scale.y = 1 + Math.sin(t * 0.9) * 0.012;
            }
        }

        markersGroup.children.forEach((group, i) => {
            const s = 1 + Math.sin(t * 2.4 + i) * 0.18;
            group.children.forEach(c => {
                if (c.userData && c.userData.isRing) { c.lookAt(camera.position); c.scale.setScalar(s); }
            });
        });

        renderer.render(scene, camera);
    }

    return { init, loadModel, renderMarkers, applyMorphTarget, resetCamera };
})();

/* ------------------------------------------------------------------
   3. FRONTEND STATE & UI LOGIC — unchanged behavior
------------------------------------------------------------------ */
document.addEventListener("DOMContentLoaded", async () => {
    const state = {
        memberId: "demo-self",
        mode: "map",
        currentTimelineIndex: 0,
        timelineKeys: [],
        playInterval: null
    };

    const avatarColors = { "demo-self": "#0b5e55", "demo-mother": "#9c4f84", "demo-child": "#c2812a", "demo-father": "#355f99" };

    const els = {
        familyRail: document.getElementById('bt-family-rail'),
        identitySubtitle: document.getElementById('bt-identity-subtitle'),
        canvasContainer: document.getElementById('ho-3d-canvas-container'),
        canvasText: document.getElementById('bt-canvas-text'),
        modeSwitch: document.querySelector('.bt-mode-switch'),
        btnMapMode: document.getElementById('btnMapMode'),
        btnProgressMode: document.getElementById('btnProgressMode'),
        privacyOverlay: document.getElementById('bt-privacy-overlay'),
        timelineDock: document.getElementById('bt-timeline-dock'),
        timeSlider: document.getElementById('ho-time-slider'),
        dateDisplay: document.getElementById('ho-current-date-display'),
        timelineTitle: document.getElementById('ho-timeline-title'),
        detailsPanel: document.getElementById('bt-details-panel'),
        layersBtn: document.getElementById('btnToggleLayers'),
        layersMenu: document.getElementById('layersMenu'),
        btnPlay: document.getElementById('btnPlayJourney')
    };

    BodyTwin3D.init(els.canvasContainer);

    els.btnMapMode.addEventListener('click', () => setMode('map'));
    els.btnProgressMode.addEventListener('click', () => {
        const member = BodyTwinDataService.getMemberById(state.memberId);
        setMode(member && member.model === 'child' ? 'growth' : 'progress');
    });

    els.timeSlider.addEventListener('input', (e) => {
        state.currentTimelineIndex = parseInt(e.target.value);
        updateTimelineView();
    });

    els.btnPlay.addEventListener('click', togglePlay);
    els.layersBtn.addEventListener('click', () => els.layersMenu.classList.toggle('show'));

    document.addEventListener('click', (e) => {
        if (!els.layersBtn.contains(e.target) && !els.layersMenu.contains(e.target)) {
            els.layersMenu.classList.remove('show');
        }
    });

    document.addEventListener('markerClicked', (e) => openDetailDrawer(e.detail));

    loadMember(state.memberId);

    function renderFamilyRail() {
        els.familyRail.innerHTML = BodyTwinDataService.getFamilyMembers().map(m => `
            <div class="bt-fam-card ${m.id === state.memberId ? 'active' : ''}" data-id="${m.id}">
                <div class="bt-fam-av" style="background:${avatarColors[m.id] || '#0b5e55'}">${m.name.charAt(0)}</div>
                <div class="bt-fam-info">
                    <strong>${m.name}</strong>
                    <span>${m.relationship} ${m.access !== 'full' ? '· ' + m.access : ''}</span>
                </div>
            </div>
        `).join('');

        els.familyRail.querySelectorAll('.bt-fam-card').forEach(card => {
            card.addEventListener('click', (e) => {
                const id = e.currentTarget.getAttribute('data-id');
                if (id !== state.memberId) loadMember(id);
            });
        });
    }

    function loadMember(id) {
        state.memberId = id;
        const member = BodyTwinDataService.getMemberById(id);
        if (!member) return;

        renderFamilyRail();
        els.identitySubtitle.textContent = `${member.name} • ${member.relationship === 'Self' ? 'My Body' : 'Shared with you'}`;
        els.detailsPanel.classList.remove('open');
        stopPlay();

        if (member.access === 'limited') {
            els.privacyOverlay.style.display = 'flex';
            els.privacyOverlay.innerHTML = `
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <h3>Limited Access</h3>
                <p>Body Twin health information has not been shared with you by this family member.</p>
                <a href="/profile" class="bt-btn-primary" style="padding: 0.8rem 2rem; text-decoration:none;">View Permissions</a>
            `;
            els.modeSwitch.style.display = 'none';
            els.timelineDock.style.display = 'none';
            BodyTwin3D.renderMarkers([]);
            return;
        }

        els.privacyOverlay.style.display = 'none';
        els.modeSwitch.style.display = 'flex';
        els.timelineDock.style.display = 'flex';

        BodyTwin3D.loadModel(member.model, () => {
            updateTimelineView();
        });

        els.btnProgressMode.textContent = member.model === 'child' ? 'Growth Journey' : 'Body Progress';
        setMode('map');

        state.timelineKeys = BodyTwinDataService.getTimeline(id);
        if (state.timelineKeys.length > 0) {
            els.timeSlider.max = state.timelineKeys.length - 1;
            els.timeSlider.value = state.timelineKeys.length - 1;
            state.currentTimelineIndex = state.timelineKeys.length - 1;
        } else {
            els.dateDisplay.textContent = 'No Data';
        }
    }

    function setMode(mode) {
        state.mode = mode;
        els.btnMapMode.classList.toggle('active', mode === 'map');
        els.btnProgressMode.classList.toggle('active', mode !== 'map');
        els.detailsPanel.classList.remove('open');

        els.timelineTitle.textContent = mode === 'map' ? 'Health Journey' : (mode === 'growth' ? 'Growth Journey' : 'Weight Progress');

        if (mode === 'map') BodyTwin3D.applyMorphTarget(0.5);
        updateTimelineView();
    }

    function updateTimelineView() {
        if (state.timelineKeys.length === 0) {
            BodyTwin3D.renderMarkers([]);
            return;
        }

        const currentDate = state.timelineKeys[state.currentTimelineIndex];
        els.dateDisplay.textContent = currentDate;
        els.dateDisplay.style.color = 'var(--d-coral)';
        setTimeout(() => els.dateDisplay.style.color = 'var(--d-teal-950)', 300);

        if (state.mode === 'map') {
            const markers = BodyTwinDataService.getMarkersForDate(state.memberId, currentDate);
            BodyTwin3D.renderMarkers(markers);

            if (els.detailsPanel.classList.contains('open')) {
                if (markers.length === 0) els.detailsPanel.classList.remove('open');
                else openDetailDrawer(markers[0]);
            }
        } else {
            BodyTwin3D.renderMarkers([]);
            const prog = BodyTwinDataService.getProgress(state.memberId);
            const val = prog ? (prog.history[currentDate] || '--') : '--';

            const morphPercentage = state.currentTimelineIndex / (state.timelineKeys.length - 1 || 1);
            BodyTwin3D.applyMorphTarget(1 - morphPercentage);

            els.detailsPanel.innerHTML = `
                <button class="close-btn" onclick="document.getElementById('bt-details-panel').classList.remove('open')">&times;</button>
                <h2 class="bt-region-title" style="margin-bottom:0.5rem;">${state.mode === 'growth' ? 'Growth Journey' : 'Body Progress'}</h2>
                <p style="font-size:0.85rem; color:var(--d-ink-3); margin-bottom:1.5rem; font-weight:600;">Illustrative visualization</p>
                <div class="bt-event-card cyan">
                    <strong>Recorded Measurement</strong>
                    <span class="bt-event-meta">${currentDate}</span>
                </div>
                <div style="text-align:center; padding: 2rem 0;">
                    <span style="font-family:'JetBrains Mono', monospace; font-size:3rem; font-weight:800; color:var(--d-teal-950);">${val}</span>
                </div>
                ${(prog && prog.target) ? `
                <div style="text-align:center; font-weight:700; color:var(--d-ink-3); border-top: 1px dashed var(--d-line); padding-top: 1.5rem;">
                    Target: ${prog.target} kg<br>
                </div>` : ''}
            `;
            els.detailsPanel.classList.add('open');
        }
    }

    function openDetailDrawer(markerData) {
        if (!markerData) return;
        els.detailsPanel.innerHTML = `
            <button class="close-btn" onclick="document.getElementById('bt-details-panel').classList.remove('open')">&times;</button>
            <h2 class="bt-region-title">${markerData.region.replace('_', ' ')}</h2>
            <div class="bt-event-card ${markerData.color}">
                <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                    <strong>${markerData.title}</strong>
                    <span style="font-size:0.7rem; font-weight:800; text-transform:uppercase; color:var(--d-${markerData.color}); background:var(--d-bg); padding:2px 6px; border-radius:4px;">${markerData.state}</span>
                </div>
                <span class="bt-event-meta">${markerData.date}</span>
                <span class="bt-event-source">${markerData.source}</span>
            </div>
            <div style="display:flex; flex-direction:column; gap:0.8rem; margin-top:1.5rem;">
                <button class="bt-btn-primary" style="justify-content:center;">View Original Record</button>
                <button class="d-btn" style="background:var(--d-card); color:var(--d-teal-950); border:1px solid var(--d-edge); box-shadow:none; justify-content:center;" onclick="document.getElementById('evidenceModal').classList.add('active'); document.getElementById('evidenceModal').style.display='flex'; document.getElementById('evTitle').innerText='${markerData.title}'; document.getElementById('evSource').innerText='${markerData.source}'; document.getElementById('evDate').innerText='${markerData.date}'; document.getElementById('evRegion').innerText='${markerData.region.replace('_',' ')}';">Why is this highlighted?</button>
            </div>
        `;
        els.detailsPanel.classList.add('open');
    }

    function togglePlay() {
        if (state.playInterval) stopPlay();
        else startPlay();
    }

    function startPlay() {
        els.btnPlay.innerHTML = `<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>`;
        state.playInterval = setInterval(() => {
            state.currentTimelineIndex++;
            if (state.currentTimelineIndex >= state.timelineKeys.length) state.currentTimelineIndex = 0;
            els.timeSlider.value = state.currentTimelineIndex;
            updateTimelineView();
        }, 1500);
    }

    function stopPlay() {
        clearInterval(state.playInterval);
        state.playInterval = null;
        els.btnPlay.innerHTML = `<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`;
    }
});













</script>

