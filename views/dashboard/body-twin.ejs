                    <div style="font-weight: 700; color: var(--d-teal-700);" id="evDate">12 Jun 2026</div>
                </div>
                <div>
                    <strong style="display: block; font-size: 0.75rem; color: var(--d-ink-3); text-transform: uppercase;">Mapped Region</strong>
                    <div style="font-weight: 700; color: var(--d-teal-700);" id="evRegion">Left Forearm</div>
                </div>
                <div>
                    <strong style="display: block; font-size: 0.75rem; color: var(--d-ink-3); text-transform: uppercase;">Confidence</strong>
                    <div style="font-weight: 700; color: var(--d-mint);">High</div>
                </div>
            </div>
        </div>
        <p style="font-size: 0.8rem; color: var(--d-ink-3); text-align: center; font-weight: 600;">This visualization represents information from stored health records and is not a medical diagnosis.</p>
    </div>
