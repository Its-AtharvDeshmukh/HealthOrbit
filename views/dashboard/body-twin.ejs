    <div style="text-align: left;">
        <p style="color: var(--d-ink-2); font-weight: 500; margin-bottom: 1.5rem;">HealthOrbit found a stored health record associated with this body region.</p>
        <div style="background: var(--d-bg); padding: 1.2rem; border-radius: 16px; border: 1px solid var(--d-line); margin-bottom: 1.5rem;">
