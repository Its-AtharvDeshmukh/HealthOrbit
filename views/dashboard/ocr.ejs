<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/header', { title: 'HealthOrbit - Clinical Document Workspace', cssFile: 'document-engine' }) %>
  <link rel="icon" href="/images/Logo.png">
  <style>
    :root {
      --ho-bg-airy: #edf6f4;
      --ho-teal-900: #0b5e55;
      --ho-teal-700: #0d7a6e;
      --ho-teal-600: #109485;
      --ho-mint-400: #42b89d;
      --ho-coral: #e07a68;
      --ho-coral-soft: #fbe4de;
      --ho-text-main: #0f1c1a;
      --ho-text-muted: #4e6b63;
      --ho-danger: #d94b4b;
      --ho-green: #27ae60;
      
      --ho-glass-clear: rgba(255, 255, 255, 0.48);
      --ho-glass-solid: rgba(255, 255, 255, 0.88);
      --ho-glass-border: rgba(255, 255, 255, 0.95);
      --ho-glass-border-subtle: rgba(13, 122, 110, 0.12);
      
      --ho-radius-xl: 32px;
      --ho-radius-lg: 20px;
      --ho-radius-md: 12px;
      --ho-shadow-glass: 0 20px 50px rgba(13, 122, 110, 0.08), inset 0 1px 1px rgba(255, 255, 255, 1);
    }

    .ho-ambient-canvas { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
    .ho-glow-orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.65; animation: hoFloatOrb 20s ease-in-out infinite alternate; }
    .ho-orb-1 { width: 550px; height: 550px; background: #76d7c4; top: -100px; left: -100px; }
    .ho-orb-2 { width: 600px; height: 600px; background: #fadbd8 !important; bottom: -150px; right: -100px; animation-delay: -5s; }
    .ho-orb-3 { width: 400px; height: 400px; background: #85c1e9; top: 35%; left: 35%; opacity: 0.3; animation-delay: -10s; }
    
    @keyframes hoFloatOrb { 
      0% { transform: translate(0, 0) scale(1); } 
      100% { transform: translate(50px, 60px) scale(1.15); } 
    }

    @media (max-width: 1024px) {
      body .ho-main-content {
         margin-top: 5.5rem;
         padding: 0 !important; 
      }
    }
  </style>
</head>
<body>

<%- include('../partials/ambient') %>

<div class="ho-app-layout">
  
  <%- include('../partials/sidebar') %>

  <main class="ho-main-content">
    
    <header class="ho-topbar">
      <div>
        <h1>Document <b style="color: #e07a68;">Intelligence</b> Workspace</h1>
        <p>Inspect documents, verify AI extractions, and manage your clinical records.</p>
      </div>
      <div class="ho-topbar-actions">
        <button class="ho-btn-primary" onclick="openUpload()">+ Upload Report</button>
      </div>
    </header>

    <div class="ho-workspace-grid">
      
      <!-- MOBILE-ONLY UPLOAD CARD -->
      <div class="ho-mobile-upload-card" onclick="openUpload()">
        <div class="icon-wrap">📄</div>
        <h3>Add Medical Document</h3>
        <p>Upload a lab report or prescription for instant OCR & AI Extraction.</p>
        <button>Select File to Upload</button>
      </div>

      <!-- LEFT PANE: SECURE DOCUMENT VIEWER -->
      <section class="ho-panel">
        <div class="ho-panel-header">
          <h2>Original Source</h2>
          <span class="ho-badge"><%= locals.latestReport && latestReport.originalFileName ? latestReport.originalFileName : 'No File Active' %></span>
        </div>

        <div class="ho-doc-viewer">
          <% if (locals.latestReport && latestReport._id) { %>
            <% if (latestReport.mimeType === 'application/pdf' || latestReport.originalFileName.toLowerCase().endsWith('.pdf')) { %>
              <iframe src="/reports/<%= latestReport._id %>/file#toolbar=0"></iframe>
            <% } else { %>
              <img src="/reports/<%= latestReport._id %>/file" alt="Report Preview" style="max-width: 100%; max-height: 100%; padding: 0.8rem; border-radius: var(--ho-radius-md); object-fit: contain;">
            <% } %>
          <% } else { %>
            <div class="ho-empty-state">
              <span>📄</span>
              <h3 style="color: var(--ho-teal-900); font-weight: 800; font-size: 1.3rem;">Awaiting Document</h3>
              <p style="font-size: 0.9rem; margin-top: 0.6rem;">Upload a PDF or image report to begin AI extraction.</p>
            </div>
          <% } %>
        </div>
      </section>

      <!-- RIGHT PANE: INTELLIGENCE CONSOLE -->
      <section class="ho-panel">
        <div class="ho-panel-header">
          <h2>Intelligence Console</h2>
          <span class="ho-badge" style="background: var(--ho-teal-700); color: #fff; border:none;">
            Status: <%= locals.latestReport && latestReport.status ? latestReport.status.toUpperCase() : 'STANDBY' %>
          </span>
        </div>

        <!-- Glass Tabs -->
        <div class="ho-tabs">
          <button class="ho-tab-btn active" onclick="switchTab('ho-tab-findings', this)">
            🔬 Findings (<%= locals.latestReport && latestReport.extractedData && latestReport.extractedData.parameters ? latestReport.extractedData.parameters.length : 0 %>)
          </button>
          <button class="ho-tab-btn" onclick="switchTab('ho-tab-ai', this)">🤖 AI Summary</button>
          <button class="ho-tab-btn" onclick="switchTab('ho-tab-raw', this)">📝 Raw Text</button>
          <button class="ho-tab-btn" onclick="switchTab('ho-tab-vault', this)">📚 Vault (<%= locals.reports ? reports.length : 0 %>)</button>
        </div>

        <!-- TAB 1: FINDINGS -->
        <div id="ho-tab-findings" class="ho-tab-content active">
          <% if (locals.latestReport) { %>
            <form class="ho-findings-form" action="/reports/update/<%= latestReport._id %>" method="POST">
              
              <div class="ho-scroll-container">
                <div style="margin-bottom: 1.2rem; font-size: 0.82rem; color: var(--ho-teal-900); background: rgba(223, 241, 236, 0.9); padding: 12px 16px; border-radius: 12px; font-weight: 700; display: flex; gap: 0.6rem; align-items: center;">
                  <span style="font-size: 1.1rem;">✏️</span> Review findings below. Tap any field to edit before saving.
                </div>

                <% if (latestReport.extractedData && latestReport.extractedData.parameters && latestReport.extractedData.parameters.length > 0) { %>
                  <% latestReport.extractedData.parameters.forEach(function(param, index) { %>
                    <div class="ho-data-card">
                      <input type="hidden" name="params[<%= index %>][status]" value="<%= param.status || 'Optimal' %>">
                      <input type="hidden" name="params[<%= index %>][statusClass]" value="<%= param.statusClass || 'good' %>">

                      <div class="ho-card-top">
                        <input type="text" name="params[<%= index %>][name]" value="<%= param.name %>" placeholder="Finding Name">
                        <input type="text" name="params[<%= index %>][category]" value="<%= param.category || 'Observation' %>" class="ho-tag" style="border:none;">
                      </div>

                      <div class="ho-card-mid">
                        <label>Measured Value / Observation:</label>
                        <textarea name="params[<%= index %>][value]"><%= param.value %></textarea>
                      </div>

                      <div class="ho-card-bot">
                        <div class="ho-meta-group"><span>Unit:</span><input type="text" name="params[<%= index %>][unit]" value="<%= param.unit %>"></div>
                        <div class="ho-meta-group"><span>Ref:</span><input type="text" name="params[<%= index %>][referenceRange]" value="<%= param.referenceRange %>"></div>
                        <span class="ho-status-pill <%= param.statusClass || 'good' %>"><%= param.status || 'Standard' %></span>
                      </div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div class="ho-data-card">
                    <input type="hidden" name="params[0][status]" value="Attention">
                    <input type="hidden" name="params[0][statusClass]" value="warn">
                    <div class="ho-card-top">
                      <input type="text" name="params[0][name]" value="Scan Result" placeholder="Finding Name">
                      <input type="text" name="params[0][category]" value="General" class="ho-tag" style="border:none;">
                    </div>
                    <div class="ho-card-mid">
                      <label>Measured Value / Observation:</label>
                      <textarea name="params[0][value]"><%= latestReport.extractedData ? latestReport.extractedData.rawText : 'Document uploaded successfully.' %></textarea>
                    </div>
                    <div class="ho-card-bot">
                      <div class="ho-meta-group"><span>Unit:</span><input type="text" name="params[0][unit]" value="text"></div>
                      <div class="ho-meta-group"><span>Ref:</span><input type="text" name="params[0][referenceRange]" value="Review"></div>
                      <span class="ho-status-pill warn">Review</span>
                    </div>
                  </div>
                <% } %>
              </div>
              
              <button type="submit" class="ho-btn-primary" style="width: 100%; margin-top: 1.2rem; padding: 1rem; font-size: 0.95rem; flex-shrink: 0;">Save & Sync Corrections</button>
            </form>
          <% } else { %>
            <div class="ho-empty-state" style="margin-top: 2rem;">
              <h3 style="color: var(--ho-teal-900); font-weight: 800; font-size: 1.2rem;">No Extracted Data</h3>
              <p style="font-size: 0.9rem; margin-top: 0.5rem;">Upload a report to trigger automated parsing.</p>
            </div>
          <% } %>
        </div>

        <!-- TAB 2: AI SUMMARY -->
        <div id="ho-tab-ai" class="ho-tab-content">
          <div class="ho-scroll-container">
            <div class="ho-ai-box">
              <h3><span>✨</span> Medical Analyst Summary</h3>
              <p style="line-height: 1.6; margin-top: 0.5rem;">
                <%= (locals.latestReport && latestReport.aiExplanation) ? latestReport.aiExplanation : 'Clinical summaries will appear here once your document is analyzed.' %>
              </p>
              <% if (locals.latestReport && latestReport._id) { %>
                <a href="/ai-assistant?reportId=<%= latestReport._id %>" class="ho-btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.2rem; padding: 0.7rem 1.4rem; font-size: 0.85rem; text-decoration: none; width: fit-content;">
                  💬 Ask AI About This Report
                </a>
              <% } %>
            </div>
            <div style="background: rgba(255, 255, 255, 0.8); border: 1.5px dashed rgba(13, 122, 110, 0.3); border-radius: var(--ho-radius-md); padding: 1.2rem; font-size: 0.82rem; color: var(--ho-text-muted); line-height: 1.5; margin-top: 1rem;">
              🛡️ <strong>Decision Support Notice:</strong> HealthOrbit provides automated summaries. AI observations do not replace professional physician diagnosis or medical evaluation.
            </div>
          </div>
        </div>

        <!-- TAB 3: RAW TEXT -->
        <div id="ho-tab-raw" class="ho-tab-content">
          <div class="ho-scroll-container">
            <div class="ho-raw-text"><%= (locals.latestReport && latestReport.extractedData && latestReport.extractedData.rawText) ? latestReport.extractedData.rawText : 'No raw text available for this document.' %></div>
          </div>
        </div>

        <!-- TAB 4: VAULT (WITH DELETE) -->
        <div id="ho-tab-vault" class="ho-tab-content">
          <div class="ho-scroll-container">
            <% if (locals.reports && reports.length > 0) { %>
              <% reports.forEach(function(rep) { %>
                <div class="ho-vault-card <%= locals.latestReport && latestReport._id.toString() === rep._id.toString() ? 'active' : '' %>">
                  <a href="/ocr?reportId=<%= rep._id %>" style="text-decoration:none; flex:1; min-width:0;">
                    <div class="ho-vault-info">
                      <strong>📄 <%= rep.originalFileName %></strong>
                      <span><%= new Date(rep.createdAt).toLocaleDateString() %> • <%= rep.extractedData && rep.extractedData.parameters ? rep.extractedData.parameters.length : 0 %> Findings</span>
                    </div>
                  </a>
                  <form action="/reports/delete/<%= rep._id %>" method="POST" style="margin:0; padding-left: 1rem;">
                    <button type="submit" class="ho-btn-delete" title="Delete Report">🗑️</button>
                  </form>
                </div>
              <% }) %>
            <% } else { %>
              <div class="ho-empty-state"><p style="font-weight: 600;">No previous documents found.</p></div>
            <% } %>
          </div>
        </div>

      </section>

    </div>

    <!-- UNIVERSAL FOOTER -->
    <%- include('../partials/footer') %>

  </main>
</div>

<!-- UPLOAD MODAL -->
<div class="ho-modal" id="hoUploadModal" onclick="closeUpload(event)">
  <div class="ho-modal-box" onclick="event.stopPropagation()">
    <div class="ho-modal-head">
      <h3>Upload Medical Report</h3>
      <button class="ho-modal-close" onclick="closeUpload()">×</button>
    </div>
    <form id="hoModalUploadForm" action="/reports/upload" method="POST" enctype="multipart/form-data">
      <div class="ho-dropzone" onclick="document.getElementById('hoModalFileInput').click();">
        <span style="font-size: 3.5rem; display: block; margin-bottom: 1rem;">☁️</span>
        <strong style="font-size: 1.15rem; color: var(--ho-teal-900);">Tap to select document</strong>
        <p style="font-size: 0.85rem; color: var(--ho-text-muted); margin-top: 0.6rem; font-weight: 600;">Supported: PDF, PNG, JPG (Max 25MB)</p>
        <input type="file" id="hoModalFileInput" name="reportFile" accept=".pdf,.png,.jpg,.jpeg" style="display:none;" onchange="document.getElementById('hoModalUploadForm').submit();" required>
      </div>
    </form>
  </div>
</div>

<script>
  function switchTab(tabId, btn) {
    document.querySelectorAll('.ho-tab-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.ho-tab-btn').forEach(el => el.classList.remove('active'));
    document.getElementById(tabId).classList.add('active');
    btn.classList.add('active');
  }

  function openUpload() { document.getElementById('hoUploadModal').style.display = 'flex'; }
  function closeUpload(e) { 
    if (!e || e.target === document.getElementById('hoUploadModal') || e.target.classList.contains('ho-modal-close')) {
      document.getElementById('hoUploadModal').style.display = 'none'; 
    }
  }
</script>

</body>
</html>