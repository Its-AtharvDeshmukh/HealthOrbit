<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HealthOrbit — Nutrition & Life</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/sidebar.css">
<style>
:root {
  --void: #084039; --void-soft: #0d7a6e;
  --paper: #f2f8f6; --card: #ffffff;
  --ink: #0f1c1a; --ink-soft: #5e736f;
  --coral: #ef6f5b; --coral-soft: #fbe4de;
  --sage: #109485; --sage-soft: #dff1ec;
  --mist: #42b89d; --line: rgba(13, 122, 110, 0.15);
  --radius: 24px;
  --glass-bg: rgba(255, 255, 255, 0.75);
  --glass-border: rgba(255, 255, 255, 0.95);
  --shadow-glass: 0 10px 30px rgba(8, 64, 57, 0.05);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; background: var(--paper); color: var(--ink); overflow-x: hidden; }
.mono { font-family: 'JetBrains Mono', monospace; }

/* Ambient Orbs */
.ambient { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
.orb { position: absolute; border-radius: 50%; filter: blur(90px); opacity: 0.35; animation: float 22s infinite alternate; }
.orb1 { width: 420px; height: 420px; background: #a3e4d7; top: -120px; left: -100px; }
.orb2 { width: 460px; height: 460px; background: #fcefc9; bottom: -140px; right: -100px; animation-delay: -6s; }
@keyframes float { 100% { transform: translate(40px, 40px) scale(1.1); } }

/* App Layout */
.shell { display: flex; width: 100vw; min-height: 100vh; position: relative; z-index: 1; }
.main { flex: 1; min-width: 0; display: flex; flex-direction: column; transition: 0.4s cubic-bezier(0.25, 1, 0.5, 1); }

/* Topbar */
.topbar { display: flex; justify-content: space-between; align-items: center; padding: 2.5rem 3.5rem 1rem; background: transparent; z-index: 10; }
.topbar h1 { font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.8rem; color: var(--void); }
.topbar .sub { font-size: 0.85rem; color: var(--ink-soft); margin-top: 0.4rem; font-weight: 500; }
.actions { display: flex; gap: 0.8rem; align-items: center; }

.btn { border: none; border-radius: 999px; padding: 0.75rem 1.4rem; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: 0.2s; font-family: inherit; display: inline-flex; align-items: center; gap: 0.4rem; }
.btn.primary { background: var(--coral); color: #fff; box-shadow: 0 4px 15px rgba(239, 111, 91, 0.2); }
.btn.primary:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(239, 111, 91, 0.35); background: #d95a46; }

/* Bento Grid */
.bento-wrapper { padding: 1rem 3.5rem 4rem; flex: 1; }
.bento { display: grid; grid-template-columns: repeat(12, 1fr); gap: 1.5rem; }

.card {
  background: var(--glass-bg); backdrop-filter: blur(25px) saturate(180%); -webkit-backdrop-filter: blur(25px) saturate(180%);
  border: 1px solid var(--glass-border); border-radius: var(--radius); padding: 2rem;
  overflow: hidden; position: relative; box-shadow: var(--shadow-glass);
  transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s; display: flex; flex-direction: column;
}
.card::before {
  content: ""; position: absolute; top: 0; left: -150%; width: 60%; height: 100%;
  background: linear-gradient(115deg, transparent 0%, rgba(255,255,255,0.7) 45%, transparent 90%);
  transform: skewX(-18deg); transition: left 0.7s ease; pointer-events: none; z-index: 20;
}
.card:hover { transform: translateY(-4px); box-shadow: 0 20px 40px rgba(8, 64, 57, 0.1); border-color: var(--sage-soft); }
.card:hover::before { left: 150%; }
.card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; z-index: 2;}
.card h3 { font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.3rem; color: var(--void); }

/* 1. MACROS HERO (Spans 8 Cols) */
.c-macros { grid-column: span 8; background: linear-gradient(135deg, var(--void), var(--void-soft)); color: #fff; border: none;}
.c-macros::before { background: linear-gradient(115deg, transparent 0%, rgba(255,255,255,0.15) 45%, transparent 90%); }
.macro-layout { display: flex; justify-content: space-between; align-items: center; position: relative; z-index: 2; gap: 2rem;}
.macro-text { flex: 1; }
.macro-text h2 { font-family: 'Fraunces', serif; font-size: 2.2rem; margin-bottom: 0.5rem; line-height: 1.1;}
.macro-text p { font-size: 0.95rem; color: #dcebe8; margin-bottom: 1.5rem;}
.macro-stats { display: flex; gap: 1.5rem; }
.m-stat { display: flex; flex-direction: column; gap: 0.2rem;}
.m-stat span { font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: rgba(255,255,255,0.7);}
.m-stat strong { font-family: 'JetBrains Mono', monospace; font-size: 1.4rem; color: #fff;}

.macro-chart { width: 180px; height: 180px; position: relative; display: flex; align-items: center; justify-content: center;}
.macro-chart svg { width: 100%; height: 100%; transform: rotate(-90deg); }
.m-circle-bg { fill: none; stroke: rgba(255,255,255,0.1); stroke-width: 16; }
.m-circle { fill: none; stroke-width: 16; stroke-linecap: round; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.3)); }
.macro-center { position: absolute; text-align: center; }
.macro-center strong { display: block; font-family: 'JetBrains Mono', monospace; font-size: 1.8rem; line-height: 1;}
.macro-center span { font-size: 0.7rem; color: rgba(255,255,255,0.7); text-transform: uppercase; font-weight: 700;}

/* 2. HYDRATION (Spans 4 Cols) */
.c-water { grid-column: span 4; background: linear-gradient(135deg, #e0f2fe, #bae6fd); border-color: rgba(56, 189, 248, 0.3);}
.water-content { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; height: 100%; gap: 1rem;}
.water-glass { width: 80px; height: 100px; border: 4px solid var(--void); border-radius: 4px 4px 12px 12px; position: relative; overflow: hidden; background: rgba(255,255,255,0.5);}
.water-fill { position: absolute; bottom: 0; left: 0; width: 100%; height: 60%; background: #0ea5e9; animation: waves 3s ease-in-out infinite alternate; border-top-left-radius: 5px; border-top-right-radius: 5px;}
@keyframes waves { 0% { transform: scaleY(0.95); } 100% { transform: scaleY(1.05); } }
.water-text strong { display: block; font-size: 1.8rem; font-family: 'JetBrains Mono', monospace; color: var(--void);}
.water-text span { font-size: 0.85rem; color: var(--ink-soft); font-weight: 600;}

/* 3. AI DIETITIAN (Spans 6 Cols) */
.c-dietitian { grid-column: span 6; }
.diet-box { background: rgba(255,255,255,0.7); border: 1px solid var(--mist); border-radius: 16px; padding: 1.5rem; position: relative;}
.diet-box::before { content: ''; position: absolute; left: 0; top: 0; width: 5px; height: 100%; background: var(--mist); border-top-left-radius: 16px; border-bottom-left-radius: 16px;}
.diet-head { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1rem;}
.diet-icon { width: 36px; height: 36px; background: var(--void); color: #fff; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 1.1rem; box-shadow: 0 4px 10px rgba(8, 64, 57, 0.2);}
.diet-head h4 { font-family: 'Fraunces', serif; font-size: 1.1rem; color: var(--void);}
.diet-box p { font-size: 0.9rem; color: var(--ink-soft); line-height: 1.6; margin-bottom: 1rem;}
.food-recs { display: flex; gap: 0.5rem; flex-wrap: wrap; }
.food-chip { background: var(--sage-soft); color: var(--sage); font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 6px; border: 1px solid rgba(13, 122, 110, 0.2);}

/* 4. RECENT MEALS LOG (Spans 6 Cols) */
.c-meals { grid-column: span 6; }
.meal-feed { display: flex; flex-direction: column; gap: 0.8rem; }
.meal-item { display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-radius: 12px; border: 1px solid var(--line); background: rgba(255,255,255,0.5); transition: 0.2s;}
.meal-item:hover { background: #fff; border-color: var(--sage-soft); transform: translateX(4px);}
.meal-info { display: flex; align-items: center; gap: 1rem; }
.m-icon { font-size: 1.5rem; }
.m-details strong { display: block; font-size: 0.95rem; color: var(--void); margin-bottom: 0.2rem;}
.m-details span { font-size: 0.75rem; color: var(--ink-soft); }
.m-calories { font-family: 'JetBrains Mono', monospace; font-size: 1.1rem; font-weight: 700; color: var(--void);}

/* 5. WELLNESS & HABITS (Spans 12 Cols) */
.c-habits { grid-column: span 12; }
.habit-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
.habit-card { display: flex; align-items: center; justify-content: space-between; padding: 1.2rem; background: rgba(255,255,255,0.6); border: 1px solid var(--line); border-radius: 16px; cursor: pointer; transition: 0.2s;}
.habit-card:hover { background: #fff; border-color: var(--mist); box-shadow: 0 4px 15px rgba(66, 184, 157, 0.1);}
.h-info { display: flex; align-items: center; gap: 0.8rem; }
.h-info strong { font-size: 0.9rem; color: var(--void);}
.checkbox { width: 22px; height: 22px; border: 2px solid var(--ink-soft); border-radius: 6px; transition: 0.2s; display: flex; align-items: center; justify-content: center; color: transparent; font-weight: 800; font-size: 0.8rem;}
.habit-card.done .checkbox { background: var(--mist); border-color: var(--mist); color: #fff; }

@media (max-width: 1200px) {
  .bento { grid-template-columns: repeat(8, 1fr); }
  .c-macros { grid-column: span 8; }
  .c-water { grid-column: span 8; }
  .c-dietitian, .c-meals { grid-column: span 4; }
  .c-habits { grid-column: span 8; }
  .habit-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .shell { flex-direction: column; width: 100%; overflow-x: hidden; }
  .topbar { padding: 1.2rem 1.5rem; flex-direction: column; align-items: flex-start; gap: 1rem; }
  .bento-wrapper { padding: 1.5rem; }
  .bento { grid-template-columns: 1fr; }
  .c-macros, .c-water, .c-dietitian, .c-meals, .c-habits { grid-column: span 1; }
  .macro-layout { flex-direction: column; text-align: center; }
  .habit-grid { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<div class="ambient"><div class="orb orb1"></div><div class="orb orb2"></div></div>

<div class="shell">
  <!-- UNIVERSAL SIDEBAR IMPORT -->
  <%- include('../partials/sidebar') %>

  <main class="main">
    <header class="topbar">
      <div>
        <h1>Nutrition & Lifestyle</h1>
        <div class="sub">Caloric tracking, habit monitoring, and AI-driven dietary coaching.</div>
      </div>
      <div class="actions">
        <button class="btn primary">+ Log Meal</button>
      </div>
    </header>

    <div class="bento-wrapper">
      <div class="bento">

        <!-- 1. MACROS HERO (Spans 8 Cols) -->
        <div class="card c-macros shine-effect">
          <div class="macro-layout">
            <div class="macro-text">
              <h2>You have 520 kcal remaining today.</h2>
              <p>Your data is currently syncing with MyFitnessPal. You are on track to hit your protein targets, which aligns with your muscle recovery goals.</p>
              
              <div class="macro-stats">
                <div class="m-stat">
                  <span style="color: var(--mist);">Carbs</span>
                  <strong>180g <small style="font-size:0.7rem; font-weight:400;">/ 250g</small></strong>
                </div>
                <div class="m-stat">
                  <span style="color: var(--coral);">Protein</span>
                  <strong>115g <small style="font-size:0.7rem; font-weight:400;">/ 140g</small></strong>
                </div>
                <div class="m-stat">
                  <span style="color: #f1c40f;">Fats</span>
                  <strong>45g <small style="font-size:0.7rem; font-weight:400;">/ 65g</small></strong>
                </div>
              </div>
            </div>

            <div class="macro-chart">
              <svg viewBox="0 0 200 200">
                <circle class="m-circle-bg" cx="100" cy="100" r="85"></circle>
                <!-- Carbs -->
                <circle class="m-circle" cx="100" cy="100" r="85" stroke="var(--mist)" stroke-dasharray="534" style="stroke-dashoffset: 200;"></circle>
                <!-- Protein -->
                <circle class="m-circle" cx="100" cy="100" r="65" stroke="var(--coral)" stroke-dasharray="408" style="stroke-dashoffset: 80;"></circle>
                <!-- Fats -->
                <circle class="m-circle" cx="100" cy="100" r="45" stroke="#f1c40f" stroke-dasharray="282" style="stroke-dashoffset: 100;"></circle>
              </svg>
              <div class="macro-center">
                <strong>1,880</strong>
                <span>kcal Eaten</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. HYDRATION TRACKER (Spans 4 Cols) -->
        <div class="card c-water shine-effect">
          <div class="card-head" style="margin-bottom: 0;">
            <h3 style="color: #0284c7;">Hydration</h3>
            <button class="btn" style="background: rgba(255,255,255,0.5); color: #0284c7; padding: 4px 10px;">+ 250ml</button>
          </div>
          <div class="water-content">
            <div class="water-glass"><div class="water-fill"></div></div>
            <div class="water-text">
              <strong>1.8L</strong>
              <span>Target: 3.0L / Day</span>
            </div>
          </div>
        </div>

        <!-- 3. AI DIETITIAN (Spans 6 Cols) -->
        <div class="card c-dietitian shine-effect">
          <div class="card-head">
            <h3>Clinical Dietitian</h3>
            <span style="font-size: 0.75rem; color: var(--ink-soft); font-weight: 700; background: var(--sage-soft); padding: 3px 8px; border-radius: 6px;">Gemini Powered</span>
          </div>
          
          <div class="diet-box">
            <div class="diet-head">
              <div class="diet-icon">✨</div>
              <h4>Targeting: Vitamin D Deficiency</h4>
            </div>
            <p>Based on your latest CBC report (Aug 15) which flagged Vitamin D at 18 ng/mL, I recommend incorporating these specific dietary sources alongside your prescribed 60k IU supplement protocol to improve absorption.</p>
            <div class="food-recs">
              <span class="food-chip">🐟 Wild-caught Salmon</span>
              <span class="food-chip">🥚 Egg Yolks</span>
              <span class="food-chip">🍄 UV-exposed Mushrooms</span>
              <span class="food-chip">🥛 Fortified Almond Milk</span>
            </div>
          </div>
        </div>

        <!-- 4. RECENT MEALS (Spans 6 Cols) -->
        <div class="card c-meals shine-effect">
          <div class="card-head">
            <h3>Recent Logs</h3>
            <span style="font-size: 0.8rem; color: var(--coral); font-weight: 700; cursor: pointer;">View All</span>
          </div>

          <div class="meal-feed">
            <div class="meal-item">
              <div class="meal-info">
                <span class="m-icon">🥗</span>
                <div class="m-details">
                  <strong>Grilled Chicken Salad</strong>
                  <span>Lunch • 1:30 PM</span>
                </div>
              </div>
              <span class="m-calories">420 kcal</span>
            </div>

            <div class="meal-item">
              <div class="meal-info">
                <span class="m-icon">🍳</span>
                <div class="m-details">
                  <strong>Oatmeal & 2 Boiled Eggs</strong>
                  <span>Breakfast • 9:00 AM</span>
                </div>
              </div>
              <span class="m-calories">380 kcal</span>
            </div>
            
            <div class="meal-item">
              <div class="meal-info">
                <span class="m-icon">☕</span>
                <div class="m-details">
                  <strong>Black Coffee</strong>
                  <span>Morning • 7:30 AM</span>
                </div>
              </div>
              <span class="m-calories">5 kcal</span>
            </div>
          </div>
        </div>

        <!-- 5. WELLNESS HABITS (Spans 12 Cols) -->
        <div class="card c-habits shine-effect">
          <div class="card-head">
            <h3>Daily Wellness Habits</h3>
            <span style="font-size: 0.8rem; color: var(--ink-soft);">Reset at Midnight</span>
          </div>

          <div class="habit-grid">
            <div class="habit-card done" onclick="this.classList.toggle('done')">
              <div class="h-info">
                <span style="font-size: 1.2rem;">🧘</span>
                <strong>10 Min Meditation</strong>
              </div>
              <div class="checkbox">✓</div>
            </div>

            <div class="habit-card" onclick="this.classList.toggle('done')">
              <div class="h-info">
                <span style="font-size: 1.2rem;">🌞</span>
                <strong>15 Min Morning Sun</strong>
              </div>
              <div class="checkbox">✓</div>
            </div>

            <div class="habit-card" onclick="this.classList.toggle('done')">
              <div class="h-info">
                <span style="font-size: 1.2rem;">📱</span>
                <strong>No Screen 1hr Pre-Sleep</strong>
              </div>
              <div class="checkbox">✓</div>
            </div>

            <div class="habit-card" onclick="this.classList.toggle('done')">
              <div class="h-info">
                <span style="font-size: 1.2rem;">⏱️</span>
                <strong>16h Intermittent Fast</strong>
              </div>
              <div class="checkbox">✓</div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </main>
</div>

<script>
  function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('collapsed');
  }
</script>
</body>
</html>