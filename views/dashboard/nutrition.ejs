          <option value="Herbal / Green Tea">Herbal / Green Tea</option>
        </select>
      </div>
      <button type="submit" class="ho-btn-ghost ho-btn-solid" style="width:100%; justify-content:center; padding:0.95rem;">Save Hydration Log</button>
    </form>
  </div>
</div>

<!-- ADD LIFESTYLE HABIT MODAL -->
<div class="ho-modal-overlay" id="habitModal" onclick="closeModal('habitModal', event)">
  <div class="ho-modal-panel ho-custom-scroll" onclick="event.stopPropagation()">
    <div class="ho-modal-handle"></div>
    <div class="ho-modal-header">
      <h3 class="ho-modal-title">New Lifestyle Habit</h3>
      <button type="button" class="ho-modal-close" onclick="closeModal('habitModal')">✕</button>
    </div>
    <form action="/nutrition/habits" method="POST">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
      <div class="ho-form-group">
        <label>Habit Title</label>
        <input type="text" name="name" class="ho-input" placeholder="e.g. 30-Min Evening Walk" required>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
        <div class="ho-form-group">
          <label>Category</label>
          <select name="category" class="ho-input">
            <option value="Physical Activity">Physical Activity</option>
            <option value="Sleep Hygiene">Sleep Hygiene</option>
            <option value="Mindfulness">Mindfulness</option>
            <option value="Nutrition Routine">Nutrition Routine</option>
          </select>
        </div>
        <div class="ho-form-group">
          <label>Frequency</label>
          <select name="frequency" class="ho-input">
            <option value="Daily">Daily</option>
            <option value="Weekly">Weekly</option>
          </select>
        </div>
      </div>
      <button type="submit" class="ho-btn-ghost ho-btn-solid" style="width:100%; justify-content:center; padding:0.95rem;">Save Habit</button>
    </form>
  </div>
</div>

<!-- SET WELLNESS GOAL MODAL -->
<div class="ho-modal-overlay" id="goalModal" onclick="closeModal('goalModal', event)">
  <div class="ho-modal-panel ho-custom-scroll" onclick="event.stopPropagation()">
    <div class="ho-modal-handle"></div>
    <div class="ho-modal-header">
      <h3 class="ho-modal-title">Set Wellness Goal</h3>
      <button type="button" class="ho-modal-close" onclick="closeModal('goalModal')">✕</button>
    </div>
    <form action="/nutrition/goals" method="POST">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
      <div class="ho-form-group">
        <label>Goal Title</label>
        <input type="text" name="title" class="ho-input" placeholder="e.g. Daily Hydration Target" required>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:0.65rem;">
        <div class="ho-form-group">
          <label>Current</label>
          <input type="number" step="any" name="currentValue" class="ho-input" placeholder="0">
        </div>
        <div class="ho-form-group">
          <label>Target</label>
          <input type="number" step="any" name="targetValue" class="ho-input" placeholder="2500" required>
        </div>
        <div class="ho-form-group">
          <label>Unit</label>
          <input type="text" name="unit" class="ho-input" placeholder="ml / kcal / kg" required>
        </div>
      </div>
      <button type="submit" class="ho-btn-ghost ho-btn-solid" style="width:100%; justify-content:center; padding:0.95rem;">Save Wellness Goal</button>
    </form>
  </div>
</div>

<div class="ho-toast" id="hoToast">Saved</div>

<script>
  const mealsData = <%- JSON.stringify(normalizedMeals || []).replace(/</g, '\\u003c') %>;
  const hydrationData = <%- JSON.stringify(normalizedHydration || []).replace(/</g, '\\u003c') %>;
  const habitsData = <%- JSON.stringify(normalizedHabits || []).replace(/</g, '\\u003c') %>;
  const goalsData = <%- JSON.stringify(normalizedGoals || []).replace(/</g, '\\u003c') %>;

  const $ = (s, r) => (r || document).querySelector(s);
  const $$ = (s, r) => Array.from((r || document).querySelectorAll(s));

  function countUp(el) {
    const raw = el.textContent.trim();
    const target = parseFloat(raw.replace(/,/g, ''));
    if (isNaN(target)) return;
    const dur = 1100, start = performance.now();
    function tick(now) {
      const p = Math.min(1, (now - start) / dur), e = 1 - Math.pow(1 - p, 4);
      el.textContent = Math.round(target * e).toLocaleString();
      if (p < 1) requestAnimationFrame(tick); else el.textContent = raw;
    }
    requestAnimationFrame(tick);
  }
  $$('.js-count').forEach(countUp);

  (function initRings() {
    const pMeals = <%= calPct !== null ? (calPct / 100).toFixed(2) : (normalizedMeals.length > 0 ? Math.min(1, normalizedMeals.length / 4).toFixed(2) : 0) %>;
    const pWater = <%= hydPct !== null ? (hydPct / 100).toFixed(2) : (normalizedHydration.length > 0 ? Math.min(1, normalizedHydration.length / 6).toFixed(2) : 0) %>;
    const pHabits = <%= habPct !== null ? (habPct / 100).toFixed(2) : 0 %>;

    setTimeout(() => {
      const rM = $('#ringMeals'), rW = $('#ringWater'), rH = $('#ringHabits');
      if (rM) rM.style.strokeDashoffset = (402.1 * (1 - pMeals)).toFixed(1);
      if (rW) rW.style.strokeDashoffset = (301.6 * (1 - pWater)).toFixed(1);
      if (rH) rH.style.strokeDashoffset = (201.1 * (1 - pHabits)).toFixed(1);
    }, 300);
  })();

  $$('[data-meal-filter]').forEach(btn => {
    btn.addEventListener('click', () => {
      $$('[data-meal-filter]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const f = btn.dataset.mealFilter;
      $$('.ho-meal-card').forEach(card => {
        const t = card.dataset.mealType || '';
        card.style.display = (f === 'all' || t.includes(f)) ? '' : 'none';
      });
    });
  });

  window.openModal = function (id) {
    const m = document.getElementById(id);
    if (m) m.classList.add('active');
  };
  window.closeModal = function (id, e) {
    const m = document.getElementById(id);
    if (!m) return;
    if (!e || e.target === m) m.classList.remove('active');
  };

  window.openNutritionDetailModal = function (type, index) {
    const badge = $('#dmBadge');
    const title = $('#dmTitle');
    const body = $('#dmBody');
    const delForm = $('#dmDeleteForm');

    if (type === 'meal' && mealsData[index]) {
      const m = mealsData[index];
      badge.textContent = m.mealType;
      title.textContent = m.name;
      body.innerHTML = `
        <div class="ho-detail-row"><span class="ho-dr-label">Calories</span><span class="ho-dr-val">${m.calories !== null ? m.calories + ' kcal' : '--'}</span></div>
        <div class="ho-detail-row"><span class="ho-dr-label">Protein / Carbs / Fat</span><span class="ho-dr-val">${m.protein || 0}g / ${m.carbs || 0}g / ${m.fat || 0}g</span></div>
        <div class="ho-detail-row"><span class="ho-dr-label">Recorded At</span><span class="ho-dr-val">${m.dateStr} ${m.timeStr}</span></div>
        ${m.notes ? `<div class="ho-detail-row"><span class="ho-dr-label">Notes</span><span class="ho-dr-val">${m.notes}</span></div>` : ''}
      `;
      delForm.style.display = 'block';
      delForm.action = '/nutrition/meals/delete/' + m.id;
    } else if (type === 'hydration' && hydrationData[index]) {
      const h = hydrationData[index];
      badge.textContent = 'Hydration Log';
      title.textContent = h.beverageType;
      body.innerHTML = `
        <div class="ho-detail-row"><span class="ho-dr-label">Fluid Volume</span><span class="ho-dr-val">${h.amountMl} ml</span></div>
        <div class="ho-detail-row"><span class="ho-dr-label">Recorded At</span><span class="ho-dr-val">${h.dateStr} ${h.timeStr}</span></div>
      `;
      delForm.style.display = 'block';
      delForm.action = '/nutrition/hydration/delete/' + h.id;
    } else if (type === 'habit' && habitsData[index]) {
      const hb = habitsData[index];
      badge.textContent = hb.category;
      title.textContent = hb.name;
      body.innerHTML = `
        <div class="ho-detail-row"><span class="ho-dr-label">Frequency</span><span class="ho-dr-val">${hb.frequency}</span></div>
        <div class="ho-detail-row"><span class="ho-dr-label">Status Today</span><span class="ho-dr-val">${hb.completed ? 'Completed' : 'Pending'}</span></div>
      `;
      delForm.style.display = 'block';
      delForm.action = '/nutrition/habits/delete/' + hb.id;
    } else if (type === 'goal' && goalsData[index]) {
      const g = goalsData[index];
      badge.textContent = g.category;
      title.textContent = g.title;
      body.innerHTML = `
        <div class="ho-detail-row"><span class="ho-dr-label">Current Progress</span><span class="ho-dr-val">${g.currentValue !== null ? g.currentValue : 0} ${g.unit}</span></div>
        <div class="ho-detail-row"><span class="ho-dr-label">Target</span><span class="ho-dr-val">${g.targetValue !== null ? g.targetValue : '--'} ${g.unit}</span></div>
      `;
      delForm.style.display = 'block';
      delForm.action = '/nutrition/goals/delete/' + g.id;
    }

    openModal('detailModal');
  };

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      $$('.ho-modal-overlay.active').forEach(m => m.classList.remove('active'));
    }
  });

  const mainScroll = $('#mainScroll');
  if (mainScroll) {
    mainScroll.addEventListener('scroll', () => {
      const max = mainScroll.scrollHeight - mainScroll.clientHeight;
      $('#scrollProgress').style.width = (max > 0 ? (mainScroll.scrollTop / max) * 100 : 0) + '\%'; }, { passive: true }); }    $$('.ho-panel').forEach(p => {
    p.addEventListener('pointermove', e => {
      const r = p.getBoundingClientRect();
      p.style.setProperty('--mx', (e.clientX - r.left) + 'px');
      p.style.setProperty('--my', (e.clientY - r.top) + 'px');
    });
  });
</script>
</body>
</html>