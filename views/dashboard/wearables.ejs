<!-- ==========================================
     DYNAMIC METRIC MODAL WITH REFERENCE RANGES
     ========================================== -->
<div class="ho-modal-overlay" id="metricModal" onclick="closeMetricModal(event)">
  <div class="ho-modal-panel" onclick="event.stopPropagation()">
    
    <div class="ho-modal-header">
      <div class="ho-modal-title-group">
        <div class="ho-modal-icon" id="modalIcon">❤️</div>
        <div>
          <h3 class="ho-modal-title" id="modalTitle">Metric</h3>
          <span class="ho-modal-date">Today, 10:45 AM</span>
        </div>
      </div>
      <button class="ho-modal-close" onclick="closeMetricModal()">✕</button>
    </div>

    <div class="ho-modal-val-group">
      <div class="ho-modal-value-large">
        <span id="modalValue">0</span><small id="modalUnit">unit</small>
      </div>
      <!-- Enhanced Reference Range Badge -->
      <div class="ho-modal-range range-optimal" id="modalRangeBadge">
        <span id="modalRangeText">Normal Range: 60 - 100</span>
      </div>
    </div>

    <!-- SVG Chart Injection Area -->
    <div class="ho-modal-chart-area">
      <svg class="ho-mc-svg" viewBox="0 0 400 120" preserveAspectRatio="none">
        <path id="modalChartPath" class="ho-mc-path" stroke="var(--hc-red)" d="M 0,60 C 50,70 100,20 150,40 C 200,60 250,-10 300,30 C 350,70 380,50 400,60" />
      </svg>
    </div>

    <div class="ho-modal-details" id="modalDetailsList">
      <!-- Injected via JS -->
    </div>

  </div>
</div>

<script>
  // Comprehensive Data Dictionary with Clinical Reference Ranges
  const metricData = {
    heartPoints: {
      title: "Heart Points", icon: "💙", value: "45", unit: "pts", color: "var(--hc-blue)", bgColor: "rgba(66, 133, 244, 0.1)",
      range: "Goal: 150 pts/week", rangeClass: "range-optimal",
      chartPath: "M 0,100 C 40,85 80,40 120,60 C 160,80 200,20 240,40 C 280,60 320,10 360,50 C 380,70 400,20 400,20",
      details: [
        { label: "Weekly Total", val: "112 pts" },
        { label: "AHA Recommendation", val: "On Track" }
      ]
    },
    steps: {
      title: "Daily Steps", icon: "👟", value: "8,420", unit: "steps", color: "var(--hc-green)", bgColor: "rgba(52, 168, 83, 0.1)",
      range: "Goal: 10,000 steps/day", rangeClass: "range-optimal",
      chartPath: "M 0,110 C 50,110 80,80 120,80 C 160,80 180,50 220,50 C 260,50 300,20 340,20 C 380,20 400,10 400,10",
      details: [
        { label: "Distance", val: "5.8 km" },
        { label: "Flights Climbed", val: "12 floors" }
      ]
    },
    energy: {
      title: "Active Energy", icon: "🔥", value: "580", unit: "kcal", color: "var(--ho-coral)", bgColor: "rgba(234, 67, 53, 0.1)",
      range: "Goal: 650 kcal/day", rangeClass: "range-optimal",
      chartPath: "M 0,120 L 50,110 L 100,90 L 150,95 L 200,70 L 250,50 L 300,40 L 350,20 L 400,10",
      details: [
        { label: "Resting Energy", val: "1,450 kcal" },
        { label: "Total Burn", val: "2,030 kcal" }
      ]
    },
    bloodPressure: {
      title: "Blood Pressure", icon: "❤️", value: "118/76", unit: "mmHg", color: "var(--ho-coral)", bgColor: "rgba(234, 67, 53, 0.1)",
      range: "Normal: 90/60 - 120/80 mmHg", rangeClass: "range-optimal",
      chartPath: "M 0,60 C 50,70 100,20 150,40 C 200,60 250,-10 300,30 C 350,70 380,50 400,60",
      details: [
        { label: "Systolic Average", val: "115 mmHg" },
        { label: "Diastolic Average", val: "75 mmHg" },
        { label: "Status", val: "Healthy" }
      ]
    },
    respRate: {
      title: "Respiratory Rate", icon: "🫁", value: "14.2", unit: "rpm", color: "var(--hc-blue)", bgColor: "rgba(66, 133, 244, 0.1)",
      range: "Normal: 12.0 - 20.0 rpm", rangeClass: "range-optimal",
      chartPath: "M 0,50 C 40,30 80,70 120,40 C 160,20 200,80 240,50 C 280,30 320,60 360,40 C 380,30 400,50 400,50",
      details: [
        { label: "Sleeping Average", val: "13.5 rpm" },
        { label: "Awake Average", val: "15.1 rpm" }
      ]
    },
    bodyTemp: {
      title: "Body Temperature", icon: "🌡️", value: "36.6", unit: "°C", color: "var(--hc-yellow)", bgColor: "rgba(251, 188, 5, 0.1)",
      range: "Normal: 36.1 - 37.2 °C", rangeClass: "range-optimal",
      chartPath: "M 0,50 L 80,45 L 160,55 L 240,48 L 320,52 L 400,50",
      details: [
        { label: "Wrist Temp Deviation", val: "-0.2 °C" },
        { label: "Measurement Context", val: "During Sleep" }
      ]
    },
    spo2: {
      title: "Blood Oxygen (SpO₂)", icon: "💧", value: "98", unit: "%", color: "var(--hc-blue)", bgColor: "rgba(66, 133, 244, 0.1)",
      range: "Normal: 95% - 100%", rangeClass: "range-optimal",
      chartPath: "M 0,20 C 100,25 200,15 300,20 C 350,22 400,18 400,20",
      details: [
        { label: "Daily Average", val: "97.5%" },
        { label: "Lowest Point", val: "95%" }
      ]
    },
    deepSleep: {
      title: "Deep Sleep Phase", icon: "🌙", value: "2h 15m", unit: "", color: "var(--hc-purple)", bgColor: "rgba(155, 89, 182, 0.1)",
      range: "Normal: 1.5 - 2.5 hours", rangeClass: "range-optimal",
      chartPath: "M 0,100 L 50,100 L 80,20 L 150,20 L 180,80 L 250,80 L 280,40 L 350,40 L 380,100 L 400,100",
      details: [
        { label: "Percentage of Total", val: "22% (Optimal)" },
        { label: "REM Sleep", val: "1h 45m" }
      ]
    },
    stress: {
      title: "Stress Index", icon: "🧠", value: "34", unit: "/100", color: "var(--ho-teal-600)", bgColor: "rgba(16, 148, 133, 0.1)",
      range: "Normal: 0 - 50 (Low Stress)", rangeClass: "range-optimal",
      chartPath: "M 0,80 C 40,60 80,100 120,50 C 160,10 200,40 240,80 C 280,110 320,70 360,90 C 380,100 400,80 400,80",
      details: [
        { label: "Peak Stress Time", val: "11:30 AM" },
        { label: "HRV Correlation", val: "High" }
      ]
    }
  };

  const modal = document.getElementById('metricModal');
  
  function openMetricModal(key) {
    const data = metricData[key];
    if(!data) return;

    // Populate Modal Header
    const iconEl = document.getElementById('modalIcon');
    iconEl.innerHTML = data.icon;
    iconEl.style.background = data.bgColor;
    iconEl.style.color = data.color;

    document.getElementById('modalTitle').innerText = data.title;
    document.getElementById('modalValue').innerText = data.value;
    document.getElementById('modalUnit').innerText = data.unit;

    // Populate Reference Range Badge
    const rangeBadge = document.getElementById('modalRangeBadge');
    document.getElementById('modalRangeText').innerText = data.range;
    rangeBadge.className = `ho-modal-range ${data.rangeClass}`;

    // Update Chart Path and Color
    const pathEl = document.getElementById('modalChartPath');
    pathEl.setAttribute('d', data.chartPath);
    pathEl.style.stroke = data.color;

    // Populate Details List
    const detailsContainer = document.getElementById('modalDetailsList');
    detailsContainer.innerHTML = ''; 
    data.details.forEach(detail => {
      detailsContainer.innerHTML += `
        <div class="ho-detail-row">
          <span class="ho-dr-label">${detail.label}</span>
          <span class="ho-dr-val">${detail.val}</span>
        </div>
      `;
    });

    // Show Modal
    modal.classList.add('active');
  }

  function closeMetricModal(e) {
    if (!e || e.target === modal) {
      modal.classList.remove('active');
    }
  }
</script>

</body>
</html>