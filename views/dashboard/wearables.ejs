            <svg class="ho-sparkline" viewBox="0 0 100 30" preserveAspectRatio="none">
              <path class="ho-spark-path" stroke="var(--ho-teal-600)" d="M 0,25 C 20,20 40,30 60,15 C 80,0 90,10 100,20" style="animation-delay: 0.4s;" />
