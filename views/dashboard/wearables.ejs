<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HealthOrbit — Wearable Telemetry</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet">
<!-- Universal Floating Island Sidebar CSS -->
<link rel="stylesheet" href="/css/sidebar.css">
<link rel="icon" href="/images/Logo.png">
<style>
/* 
==================================================================
  STRICTLY SCOPED CSS (PREFIXED WITH 'ho-') FOR WEARABLES
================================================================== 
*/
:root {
  --ho-bg-airy: #edf6f4;
  --ho-teal-900: #0b5e55;
  --ho-teal-700: #0d7a6e;
  --ho-teal-600: #109485;
  --ho-mint-400: #42b89d;
  --ho-coral: #e07a68;
  --ho-text-main: #0f1c1a;
  --ho-text-muted: #4e6b63;
  
  --ho-glass-clear: rgba(255, 255, 255, 0.45);
  --ho-glass-solid: rgba(255, 255, 255, 0.85);
  --ho-glass-border: rgba(255, 255, 255, 0.95);
  --ho-glass-border-subtle: rgba(255, 255, 255, 0.5);
  
  --ho-radius-xl: 32px;
  --ho-radius-lg: 20px;
  --ho-radius-md: 12px;
  
  --ho-shadow-glass: 0 20px 50px rgba(13, 122, 110, 0.08), inset 0 1px 1px rgba(255, 255, 255, 1);
  
  /* Health Connect Specific Accents */
  --hc-blue: #4285F4;
  --hc-green: #34A853;
  --hc-yellow: #FBBC05;
  --hc-red: #EA4335;
  --hc-purple: #9b59b6;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body { min-height: 100vh; font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; background-color: var(--ho-bg-airy); color: var(--ho-text-main); overflow: hidden; -webkit-font-smoothing: antialiased; display: flex; }

/* ---------- AMBIENT ORBS ---------- */
.ho-ambient-canvas { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
.ho-glow-orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.65; animation: hoFloatOrb 20s ease-in-out infinite alternate; }
.ho-orb-1 { width: 600px; height: 600px; background: #76d7c4; top: -150px; left: -100px; }
.ho-orb-2 { width: 700px; height: 700px; background: #a9dfbf; bottom: -200px; right: -150px; animation-delay: -5s; }
@keyframes hoFloatOrb { 0% { transform: translate(0, 0) scale(1); } 100% { transform: translate(60px, 70px) scale(1.15); } }

/* ---------- MAIN WORKSPACE LAYOUT ---------- */
.ho-app-layout { display: flex; width: 100vw; height: 100vh; position: relative; z-index: 10; }
.ho-main-content { 
  flex: 1; min-width: 0; display: flex; flex-direction: column; 
  height: 100vh; overflow-y: auto; scrollbar-width: none;
  margin-left: 0 !important; padding-left: 0 !important;
}
.ho-main-content::-webkit-scrollbar { display: none; }

/* TOP NAVBAR */
.ho-topbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 2.5rem 3rem 1.5rem; flex-shrink: 0; background: transparent;
  z-index: 20; position: sticky; top: 0;
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  mask-image: linear-gradient(to bottom, black 80%, transparent);
}
.ho-topbar-text h1 { font-family: 'Fraunces', serif; font-weight: 800; font-size: 2.2rem; color: var(--ho-teal-900); margin-bottom: 0.3rem; letter-spacing: -1px;}
.ho-topbar-text p { font-size: 0.95rem; color: var(--ho-text-muted); font-weight: 600; display: flex; align-items: center; gap: 0.5rem;}
.ho-pulse-dot { width: 8px; height: 8px; background: var(--hc-green); border-radius: 50%; box-shadow: 0 0 10px var(--hc-green); animation: hoPulse 2s infinite; }
@keyframes hoPulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.5); } }

.ho-btn-ghost { padding: 0.85rem 1.8rem; background: var(--ho-glass-solid); border: 1.5px solid var(--ho-glass-border); border-radius: 999px; color: var(--ho-teal-900); font-weight: 700; font-size: 0.95rem; cursor: pointer; text-decoration: none; transition: 0.2s; box-shadow: 0 4px 15px rgba(0,0,0,0.02); display: inline-block; }
.ho-btn-ghost:hover { background: #fff; box-shadow: 0 8px 25px rgba(13, 122, 110, 0.1); }

/* ---------- MOSAIC GRID ---------- */
.ho-mosaic-grid {
  display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-rows: minmax(140px, auto); gap: 1.5rem;
  padding: 0.5rem 3rem 4rem; flex: 1;
}

/* Base Panel */
.ho-panel {
  background: var(--ho-glass-clear);
  backdrop-filter: blur(40px) saturate(200%); -webkit-backdrop-filter: blur(40px) saturate(200%);
  border: 1px solid var(--ho-glass-border); border-radius: var(--ho-radius-xl);
  padding: 1.8rem; display: flex; flex-direction: column; box-shadow: var(--ho-shadow-glass);
  position: relative; overflow: hidden; transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  animation: hoSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
}
@keyframes hoSlideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

.ho-panel:not(.ho-dark-panel):hover { transform: translateY(-4px); box-shadow: 0 20px 40px rgba(13, 122, 110, 0.1); border-color: var(--ho-teal-600); background: rgba(255,255,255,0.7);}
.ho-panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem; z-index: 2;}
.ho-panel-head h3 { font-family: 'Fraunces', serif; font-size: 1.15rem; font-weight: 700; color: var(--ho-teal-900); display: flex; align-items: center; gap: 0.5rem;}

/* --- 1. HEALTH CONNECT HERO (Spans 8) --- */
.ho-hero { grid-column: span 8; background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(238, 246, 255, 0.9)); border: 1.5px solid var(--ho-glass-border); flex-direction: row; align-items: center; justify-content: space-between; padding: 2.5rem;}
.ho-hero-text { flex: 1; z-index: 2;}
.ho-hero-text h2 { font-family: 'Fraunces', serif; font-size: 2.2rem; font-weight: 600; line-height: 1.1; margin-bottom: 0.8rem; color: var(--ho-teal-900);}
.ho-hero-text p { font-size: 0.95rem; color: var(--ho-text-muted); line-height: 1.5; margin-bottom: 1.5rem; max-width: 90%;}

.ho-hc-metrics { display: flex; gap: 2rem; margin-top: 1rem; }
.ho-hc-stat { display: flex; flex-direction: column; gap: 0.2rem; }
.ho-hc-stat span { font-size: 0.75rem; text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; color: var(--ho-text-muted);}
.ho-hc-stat strong { font-family: 'JetBrains Mono', monospace; font-size: 1.8rem; font-weight: 800; color: var(--ho-teal-900);}
.ho-hc-stat strong small { font-size: 0.9rem; font-family: 'Plus Jakarta Sans', sans-serif; color: var(--ho-text-muted);}

/* Google Fit Style Rings */
.ho-ring-container { width: 160px; height: 160px; position: relative; display: flex; align-items: center; justify-content: center;}
.ho-svg-rings { transform: rotate(-90deg); width: 100%; height: 100%; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.1)); overflow: visible;}
.ho-ring-bg { fill: none; stroke: rgba(13, 122, 110, 0.1); stroke-width: 12; stroke-linecap: round;}
.ho-ring-fill { fill: none; stroke-linecap: round; stroke-width: 12; animation: hoDrawRing 2s ease-out forwards; }
@keyframes hoDrawRing { 0% { stroke-dasharray: 0, 1000; } }

/* --- 2. MULTI-DEVICE SYNC HUB (Spans 4) --- */
.ho-sync-hub { grid-column: span 4; display: flex; flex-direction: column; }
.ho-device-list { display: flex; flex-direction: column; gap: 0.8rem; flex: 1; overflow-y: auto;}
.ho-device-card { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.2rem; background: rgba(255,255,255,0.7); border: 1px solid var(--ho-glass-border-subtle); border-radius: 16px; transition: 0.2s;}
.ho-device-card:hover { background: #fff; border-color: var(--hc-blue); transform: translateX(4px); box-shadow: 0 4px 15px rgba(66, 133, 244, 0.1);}
.ho-device-left { display: flex; align-items: center; gap: 1rem; }
.ho-device-icon { width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; background: #fff; box-shadow: 0 4px 10px rgba(0,0,0,0.05);}
.ho-device-info strong { display: block; font-size: 0.95rem; color: var(--ho-teal-900); font-weight: 700; margin-bottom: 0.2rem;}
.ho-device-info span { font-size: 0.75rem; color: var(--ho-text-muted); font-weight: 600;}
.ho-sync-status { width: 10px; height: 10px; border-radius: 50%; background: var(--hc-green); box-shadow: 0 0 8px var(--hc-green);}

/* --- 3. HIGH-DENSITY DEEP VITALS MATRIX (Spans 8) --- */
.ho-vitals-matrix { grid-column: span 8; }
.ho-matrix-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
.ho-matrix-card { background: rgba(255,255,255,0.6); border: 1px solid var(--ho-glass-border-subtle); border-radius: 16px; padding: 1.2rem; display: flex; flex-direction: column; justify-content: space-between; transition: 0.2s; cursor: pointer;}
.ho-matrix-card:hover { background: #fff; border-color: var(--ho-teal-600); box-shadow: 0 6px 20px rgba(13, 122, 110, 0.06); transform: translateY(-2px);}

.ho-mc-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;}
.ho-mc-label { font-size: 0.75rem; font-weight: 800; color: var(--ho-text-muted); text-transform: uppercase; letter-spacing: 0.05em;}
.ho-mc-val { font-family: 'JetBrains Mono', monospace; font-size: 1.6rem; font-weight: 800; color: var(--ho-teal-900); display: flex; align-items: baseline; gap: 0.2rem; letter-spacing: -1px;}
.ho-mc-val small { font-size: 0.8rem; color: var(--ho-text-muted); font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 600; letter-spacing: 0;}

/* Mini Sparkline SVGs */
.ho-sparkline { width: 100%; height: 30px; margin-top: 0.8rem; overflow: visible;}
.ho-spark-path { fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1000; stroke-dashoffset: 1000; animation: hoDrawSpark 2s ease forwards;}
@keyframes hoDrawSpark { to { stroke-dashoffset: 0; } }

/* --- 4. RECENT SESSIONS LIST (Spans 4) --- */
.ho-workouts { grid-column: span 4; }
.ho-workout-feed { display: flex; flex-direction: column; gap: 0.8rem; flex: 1; overflow-y: auto;}
.ho-workout-item { display: flex; align-items: flex-start; justify-content: space-between; padding: 1rem; background: rgba(255,255,255,0.7); border: 1px solid var(--ho-glass-border-subtle); border-radius: 16px; transition: 0.2s;}
.ho-workout-item:hover { background: #fff; border-color: var(--ho-teal-600); transform: translateX(4px); box-shadow: 0 4px 15px rgba(13, 122, 110, 0.05);}
.ho-wo-left { display: flex; align-items: center; gap: 0.8rem; }
.ho-wo-icon { font-size: 1.4rem; width: 38px; height: 38px; background: #fff; border-radius: 10px; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,0.04);}
.ho-wo-details strong { display: block; font-size: 0.95rem; color: var(--ho-teal-900); font-weight: 700; margin-bottom: 0.2rem;}
.ho-wo-details span { display: block; font-size: 0.75rem; color: var(--ho-text-muted); font-weight: 600; margin-bottom: 0.2rem;}
.ho-wo-source { font-size: 0.65rem; color: var(--hc-blue); font-weight: 800; text-transform: uppercase;}
.ho-wo-metrics { text-align: right; }
.ho-wo-metrics strong { display: block; font-family: 'JetBrains Mono', monospace; font-size: 1rem; color: var(--ho-teal-900); font-weight: 700;}
.ho-wo-metrics span { font-size: 0.7rem; color: var(--ho-text-muted); font-weight: 600;}

/* MODAL OVERLAY */
.ho-modal-overlay {
  position: fixed; inset: 0;
  background: rgba(11, 94, 85, 0.4);
  backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  display: flex; align-items: center; justify-content: center;
  z-index: 2000; opacity: 0; visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}
.ho-modal-overlay.active { opacity: 1; visibility: visible; }

.ho-modal-panel {
  width: 100%; max-width: 500px;
  background: #fff;
  border-radius: var(--ho-radius-xl);
  padding: 2.5rem;
  box-shadow: 0 30px 60px rgba(0,0,0,0.15);
  transform: translateY(40px) scale(0.95);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex; flex-direction: column; gap: 1.5rem;
}
.ho-modal-overlay.active .ho-modal-panel { transform: translateY(0) scale(1); }

.ho-modal-header { display: flex; justify-content: space-between; align-items: flex-start; }
.ho-modal-title-group { display: flex; align-items: center; gap: 1rem; }
.ho-modal-icon { width: 50px; height: 50px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
.ho-modal-title { font-size: 1.4rem; font-family: 'Fraunces', serif; font-weight: 800; color: var(--ho-teal-900); }
.ho-modal-date { font-size: 0.85rem; color: var(--ho-text-muted); font-weight: 600; margin-top: 0.2rem; display: block;}
.ho-modal-close { background: rgba(13, 122, 110, 0.08); border: none; width: 36px; height: 36px; border-radius: 50%; font-size: 1.2rem; color: var(--ho-teal-900); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s;}
.ho-modal-close:hover { background: rgba(13, 122, 110, 0.15); transform: scale(1.05); }

.ho-modal-val-group { display: flex; flex-direction: column; gap: 0.5rem; }
.ho-modal-value-large { font-family: 'JetBrains Mono', monospace; font-size: 3.5rem; font-weight: 800; color: var(--ho-text-main); display: flex; align-items: baseline; gap: 0.5rem; line-height: 1;}
.ho-modal-value-large small { font-size: 1.2rem; font-weight: 600; color: var(--ho-text-muted); font-family: 'Plus Jakarta Sans', sans-serif;}

.ho-modal-range { 
  display: inline-flex; align-items: center; gap: 0.4rem;
  padding: 6px 12px; border-radius: 999px; font-size: 0.8rem; font-weight: 700; width: fit-content;
}
.range-optimal { background: rgba(46, 204, 113, 0.15); color: #27ae60; }

.ho-modal-chart-area { height: 140px; width: 100%; position: relative; border-bottom: 1px solid var(--ho-glass-border-subtle); padding-bottom: 1rem;}
.ho-mc-svg { width: 100%; height: 100%; overflow: visible; }
.ho-mc-path { fill: none; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 6px 8px rgba(0,0,0,0.15)); stroke-dasharray: 1000; stroke-dashoffset: 1000; }
.ho-modal-overlay.active .ho-mc-path { animation: hoDrawModalChart 1.5s ease-out forwards; animation-delay: 0.2s;}
@keyframes hoDrawModalChart { to { stroke-dashoffset: 0; } }

.ho-modal-details { display: flex; flex-direction: column; gap: 0.8rem; }
.ho-detail-row { display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: var(--ho-bg-airy); border-radius: 12px; }
.ho-dr-label { font-size: 0.9rem; font-weight: 700; color: var(--ho-text-muted); }
.ho-dr-val { font-family: 'JetBrains Mono', monospace; font-size: 1rem; font-weight: 800; color: var(--ho-teal-900); }

@media (max-width: 1400px) {
  .ho-hero, .ho-vitals-matrix { grid-column: span 8; }
  .ho-sync-hub, .ho-workouts { grid-column: span 4; }
  .ho-matrix-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 1024px) {
  .ho-mosaic-grid { grid-template-columns: repeat(6, 1fr); }
  .ho-hero, .ho-sync-hub, .ho-vitals-matrix, .ho-workouts { grid-column: span 6; }
  body .ho-main-content { margin-top: 5.5rem; padding: 0 !important; }
}
@media (max-width: 768px) {
  .ho-topbar { flex-direction: column; align-items: flex-start; padding: 1.5rem; gap: 1rem;}
  .ho-mosaic-grid { display: flex; flex-direction: column; padding: 1rem; gap: 1rem;}
  .ho-hero { flex-direction: column; text-align: left; align-items: flex-start; }
  .ho-ring-container { margin-top: 2rem; align-self: center; }
  .ho-hc-metrics { flex-direction: column; gap: 1rem; }
  .ho-matrix-grid { grid-template-columns: 1fr; }
  .ho-modal-panel { position: absolute; bottom: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; transform: translateY(100%); padding: 2rem 1.5rem; max-width: 100%;}
}
</style>
</head>
<body>

<div class="ho-ambient-canvas">
  <div class="ho-glow-orb ho-orb-1"></div>
  <div class="ho-glow-orb ho-orb-2"></div>
</div>

<div class="ho-app-layout">
  
  <!-- UNIVERSAL SIDEBAR IMPORT -->
  <%- include('../partials/sidebar') %>

  <!-- SCOPED MAIN CONTENT -->
  <main class="ho-main-content">
    
    <header class="ho-topbar">
      <div class="ho-topbar-text">
        <h1><b style="color: #e07a68;">Health Connect</b> Telemetry</h1>
        <p><span class="ho-pulse-dot"></span> Ingested live via HealthOrbit Android Companion App</p>
      </div>
      <div class="ho-topbar-actions">
        <a href="/timeline" class="ho-btn-ghost">View Full Timeline</a>
      </div>
    </header>

    <div class="ho-mosaic-grid">
      
      <!-- 1. HEALTH CONNECT HERO (Span 8) -->
      <div class="ho-panel ho-hero">
        <div class="ho-hero-text">
          <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--hc-blue); font-weight: 800; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            Health Connect Unified Pipeline
          </span>
          <h2>Telemetry Synchronized.</h2>
          <p>HealthOrbit is actively merging telemetry from Google Fit, Samsung Health, and connected smartwatches into your centralized health orbit.</p>
          
          <div class="ho-hc-metrics">
            <div class="ho-hc-stat" style="cursor: pointer;" onclick="openMetricModal('heart_rate')">
              <span>Heart Rate</span>
              <strong style="color: var(--hc-red);">
                <%= latestMetrics['heart_rate'] ? Math.round(latestMetrics['heart_rate'].numericValue || latestMetrics['heart_rate'].value) : '--' %> 
                <small>bpm</small>
              </strong>
            </div>
            <div class="ho-hc-stat" style="cursor: pointer;" onclick="openMetricModal('steps')">
              <span>Steps</span>
              <strong style="color: var(--hc-green);">
                <%= latestMetrics['steps'] ? Number(latestMetrics['steps'].numericValue || latestMetrics['steps'].value).toLocaleString() : '--' %> 
                <small>steps</small>
              </strong>
            </div>
            <div class="ho-hc-stat" style="cursor: pointer;" onclick="openMetricModal('calories')">
              <span>Active Energy</span>
              <strong style="color: var(--ho-coral);">
                <%= latestMetrics['calories'] ? Math.round(latestMetrics['calories'].numericValue || latestMetrics['calories'].value) : '--' %> 
                <small>kcal</small>
              </strong>
            </div>
          </div>
        </div>

        <div class="ho-ring-container">
          <svg class="ho-svg-rings" viewBox="0 0 160 160">
            <circle class="ho-ring-bg" cx="80" cy="80" r="65"></circle>
            <circle class="ho-ring-bg" cx="80" cy="80" r="48"></circle>
            <circle class="ho-ring-fill" cx="80" cy="80" r="65" stroke="var(--hc-green)" stroke-dasharray="408" style="stroke-dashoffset: 120;"></circle>
            <circle class="ho-ring-fill" cx="80" cy="80" r="48" stroke="var(--hc-blue)" stroke-dasharray="301" style="stroke-dashoffset: 90; animation-delay: 0.2s;"></circle>
          </svg>
        </div>
      </div>

      <!-- 2. DATA SOURCES HUB (Span 4) -->
      <div class="ho-panel ho-sync-hub">
        <div class="ho-panel-head">
          <h3><span>📡</span> Hardware Sources</h3>
        </div>
        
        <div class="ho-device-list">
          <div class="ho-device-card">
            <div class="ho-device-left">
              <div class="ho-device-icon">📱</div>
              <div class="ho-device-info">
                <strong>Android Health Connect</strong>
                <span>Status: Connected & Streaming</span>
              </div>
            </div>
            <div class="ho-sync-status status-active"></div>
          </div>

          <div class="ho-device-card">
            <div class="ho-device-left">
              <div class="ho-device-icon">🏃</div>
              <div class="ho-device-info">
                <strong>Google Fit Subsystem</strong>
                <span>Syncing: Steps, Calories, Distance</span>
              </div>
            </div>
            <div class="ho-sync-status status-active"></div>
          </div>

          <div class="ho-device-card">
            <div class="ho-device-left">
              <div class="ho-device-icon">⌚</div>
              <div class="ho-device-info">
                <strong>Smartwatch Telemetry</strong>
                <span>Syncing: Heart Rate, Blood Pressure</span>
              </div>
            </div>
            <div class="ho-sync-status status-active"></div>
          </div>
        </div>
      </div>

      <!-- 3. DEEP VITALS MATRIX (Span 8) -->
      <div class="ho-panel ho-vitals-matrix">
        <div class="ho-panel-head">
          <h3><span>🔬</span> Verified Biometric Matrix</h3>
        </div>
        
        <div class="ho-matrix-grid">
          
          <!-- Blood Pressure -->
          <div class="ho-matrix-card" onclick="openMetricModal('blood_pressure')">
            <div>
              <div class="ho-mc-top">
                <span class="ho-mc-label">Blood Pressure</span>
                <span style="color: var(--ho-coral);">❤️</span>
              </div>
              <div class="ho-mc-val">
                <% if (latestMetrics['blood_pressure_systolic'] && latestMetrics['blood_pressure_diastolic']) { %>
                  <%= Math.round(latestMetrics['blood_pressure_systolic'].numericValue || latestMetrics['blood_pressure_systolic'].value) %>/<%= Math.round(latestMetrics['blood_pressure_diastolic'].numericValue || latestMetrics['blood_pressure_diastolic'].value) %><small>mmHg</small>
                <% } else { %>
                  --<small>mmHg</small>
                <% } %>
              </div>
            </div>
            <svg class="ho-sparkline" viewBox="0 0 100 30" preserveAspectRatio="none">
              <path class="ho-spark-path" stroke="var(--ho-coral)" d="M 0,20 C 20,22 40,5 50,15 C 60,25 80,10 100,15" />
            </svg>
          </div>

          <!-- Heart Rate -->
          <div class="ho-matrix-card" onclick="openMetricModal('heart_rate')">
            <div>
              <div class="ho-mc-top">
                <span class="ho-mc-label">Heart Rate</span>
                <span style="color: var(--hc-red);">💓</span>
              </div>
              <div class="ho-mc-val">
                <%= latestMetrics['heart_rate'] ? Math.round(latestMetrics['heart_rate'].numericValue || latestMetrics['heart_rate'].value) : '--' %><small>bpm</small>
              </div>
            </div>
            <svg class="ho-sparkline" viewBox="0 0 100 30" preserveAspectRatio="none">
              <path class="ho-spark-path" stroke="var(--hc-red)" d="M 0,15 C 20,10 30,25 50,15 C 70,5 80,20 100,15" style="animation-delay: 0.1s;" />
            </svg>
          </div>

          <!-- Steps -->
          <div class="ho-matrix-card" onclick="openMetricModal('steps')">
            <div>
              <div class="ho-mc-top">
                <span class="ho-mc-label">Physical Steps</span>
                <span style="color: var(--hc-green);">👟</span>
              </div>
              <div class="ho-mc-val">
                <%= latestMetrics['steps'] ? Number(latestMetrics['steps'].numericValue || latestMetrics['steps'].value).toLocaleString() : '--' %><small>steps</small>
              </div>
            </div>
            <svg class="ho-sparkline" viewBox="0 0 100 30" preserveAspectRatio="none">
              <path class="ho-spark-path" stroke="var(--hc-green)" d="M 0,15 L 20,14 L 40,16 L 60,15 L 80,15 L 100,16" style="animation-delay: 0.2s;" />
            </svg>
          </div>

          <!-- Calories Burned -->
          <div class="ho-matrix-card" onclick="openMetricModal('calories')">
            <div>
              <div class="ho-mc-top">
                <span class="ho-mc-label">Active Calories</span>
                <span style="color: var(--ho-coral);">🔥</span>
              </div>
              <div class="ho-mc-val">
                <%= latestMetrics['calories'] ? Math.round(latestMetrics['calories'].numericValue || latestMetrics['calories'].value) : '--' %><small>kcal</small>
              </div>
            </div>
            <svg class="ho-sparkline" viewBox="0 0 100 30" preserveAspectRatio="none">
              <path class="ho-spark-path" stroke="var(--ho-coral)" d="M 0,10 C 30,12 60,8 100,10" style="animation-delay: 0.3s;" />
            </svg>
          </div>

          <!-- Distance Traveled -->
          <div class="ho-matrix-card" onclick="openMetricModal('distance')">
            <div>
              <div class="ho-mc-top">
                <span class="ho-mc-label">Distance</span>
                <span style="color: var(--hc-blue);">📍</span>
              </div>
              <div class="ho-mc-val">
                <%= latestMetrics['distance'] ? Number(latestMetrics['distance'].numericValue || latestMetrics['distance'].value).toFixed(1) : '--' %><small>km</small>
              </div>
            </div>
            <div style="margin-top: 1rem; width: 100%; height: 6px; background: rgba(66, 133, 244, 0.15); border-radius: 10px;">
              <div style="width: 80%; height: 100%; background: var(--hc-blue); border-radius: 10px;"></div>
            </div>
          </div>

          <!-- Ingestion Count -->
          <div class="ho-matrix-card">
            <div>
              <div class="ho-mc-top">
                <span class="ho-mc-label">Total Syncs</span>
                <span style="color: var(--ho-teal-600);">🔄</span>
              </div>
              <div class="ho-mc-val"><%= wearables ? wearables.length : 0 %><small>records</small></div>
            </div>
            <svg class="ho-sparkline" viewBox="0 0 100 30" preserveAspectRatio="none">
              <path class="ho-spark-path" stroke="var(--ho-teal-600)" d="M 0,25 C 20,20 40,30 60,15 C 80,0 90,10 100,20" style="animation-delay: 0.4s;" />
            </svg>
          </div>

        </div>
      </div>

      <!-- 4. RECENT SESSIONS LIST (Span 4) -->
      <div class="ho-panel ho-workouts">
        <div class="ho-panel-head">
          <h3><span>📋</span> Ingestion Stream</h3>
        </div>
        
        <div class="ho-workout-feed">
          <% if (wearables && wearables.length > 0) { %>
            <% wearables.slice(0, 5).forEach(item => { %>
              <div class="ho-workout-item">
                <div class="ho-wo-left">
                  <div class="ho-wo-icon">
                    <% if (item.metricKey.includes('heart')) { %>💓
                    <% } else if (item.metricKey.includes('step')) { %>👟
                    <% } else if (item.metricKey.includes('pressure')) { %>🩺
                    <% } else if (item.metricKey.includes('calorie')) { %>🔥
                    <% } else { %>📊<% } %>
                  </div>
                  <div class="ho-wo-details">
                    <strong><%= item.metricName %></strong>
                    <span><%= new Date(item.recordedAt).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
                    <div class="ho-wo-source">Health Connect • <%= item.provider %></div>
                  </div>
                </div>
                <div class="ho-wo-metrics">
                  <strong><%= item.value %> <%= item.unit %></strong>
                  <span>Verified</span>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div style="padding: 2rem; text-align: center; color: var(--ho-text-muted); font-size: 0.9rem;">
              No wearable records ingested yet. Open the Android companion app and tap <strong>Sync Health Records Now</strong>.
            </div>
          <% } %>
        </div>
      </div>

    </div>

    <%- include('../partials/footer') %>

  </main>
</div>

<!-- DYNAMIC METRIC MODAL -->
<div class="ho-modal-overlay" id="metricModal" onclick="closeMetricModal(event)">
  <div class="ho-modal-panel" onclick="event.stopPropagation()">
    
    <div class="ho-modal-header">
      <div class="ho-modal-title-group">
        <div class="ho-modal-icon" id="modalIcon">❤️</div>
        <div>
          <h3 class="ho-modal-title" id="modalTitle">Metric</h3>
          <span class="ho-modal-date">Synchronized Telemetry</span>
        </div>
      </div>
      <button class="ho-modal-close" onclick="closeMetricModal()">✕</button>
    </div>

    <div class="ho-modal-val-group">
      <div class="ho-modal-value-large">
        <span id="modalValue">0</span><small id="modalUnit">unit</small>
      </div>
      <div class="ho-modal-range range-optimal" id="modalRangeBadge">
        <span id="modalRangeText">Verified Observation</span>
      </div>
    </div>

    <div class="ho-modal-chart-area">
      <svg class="ho-mc-svg" viewBox="0 0 400 120" preserveAspectRatio="none">
        <path id="modalChartPath" class="ho-mc-path" stroke="var(--hc-red)" d="M 0,60 C 50,70 100,20 150,40 C 200,60 250,-10 300,30 C 350,70 380,50 400,60" />
      </svg>
    </div>

    <div class="ho-modal-details" id="modalDetailsList"></div>

  </div>
</div>

<script>
  const liveMetrics = <%- JSON.stringify(latestMetrics || {}) %>;

  const metricMeta = {
    heart_rate: {
      title: "Heart Rate", icon: "💓", unit: "bpm", color: "var(--hc-red)", bgColor: "rgba(234, 67, 53, 0.1)",
      range: "Baseline: 60 - 100 bpm",
      chartPath: "M 0,60 C 50,70 100,20 150,40 C 200,60 250,-10 300,30 C 350,70 380,50 400,60"
    },
    steps: {
      title: "Physical Steps", icon: "👟", unit: "steps", color: "var(--hc-green)", bgColor: "rgba(52, 168, 83, 0.1)",
      range: "Target: 10,000 steps/day",
      chartPath: "M 0,110 C 50,110 80,80 120,80 C 160,80 180,50 220,50 C 260,50 300,20 340,20 C 380,20 400,10 400,10"
    },
    calories: {
      title: "Active Energy Burned", icon: "🔥", unit: "kcal", color: "var(--ho-coral)", bgColor: "rgba(224, 122, 104, 0.1)",
      range: "Target: 500 kcal/day",
      chartPath: "M 0,120 L 50,110 L 100,90 L 150,95 L 200,70 L 250,50 L 300,40 L 350,20 L 400,10"
    },
    distance: {
      title: "Distance Covered", icon: "📍", unit: "km", color: "var(--hc-blue)", bgColor: "rgba(66, 133, 244, 0.1)",
      range: "Physical Mobility Telemetry",
      chartPath: "M 0,100 C 40,85 80,40 120,60 C 160,80 200,20 240,40 C 280,60 320,10 360,50 C 380,70 400,20 400,20"
    },
    blood_pressure: {
      title: "Blood Pressure", icon: "🩺", unit: "mmHg", color: "var(--hc-blue)", bgColor: "rgba(66, 133, 244, 0.1)",
      range: "Clinical Target: <120/80 mmHg",
      chartPath: "M 0,50 C 40,30 80,70 120,40 C 160,20 200,80 240,50 C 280,30 320,60 360,40 C 380,30 400,50 400,50"
    }
  };

  const modal = document.getElementById('metricModal');

  function openMetricModal(key) {
    const meta = metricMeta[key];
    if (!meta) return;

    let val = '--';
    let unit = meta.unit;

    if (key === 'blood_pressure') {
      const sys = liveMetrics['blood_pressure_systolic'];
      const dia = liveMetrics['blood_pressure_diastolic'];
      if (sys && dia) {
        val = `${Math.round(sys.numericValue || sys.value)}/${Math.round(dia.numericValue || dia.value)}`;
      }
    } else if (liveMetrics[key]) {
      val = liveMetrics[key].value;
      if (liveMetrics[key].unit) unit = liveMetrics[key].unit;
    }

    const iconEl = document.getElementById('modalIcon');
    iconEl.innerHTML = meta.icon;
    iconEl.style.background = meta.bgColor;
    iconEl.style.color = meta.color;

    document.getElementById('modalTitle').innerText = meta.title;
    document.getElementById('modalValue').innerText = val;
    document.getElementById('modalUnit').innerText = unit;

    document.getElementById('modalRangeText').innerText = meta.range;

    const pathEl = document.getElementById('modalChartPath');
    pathEl.setAttribute('d', meta.chartPath);
    pathEl.style.stroke = meta.color;

    const detailsContainer = document.getElementById('modalDetailsList');
    detailsContainer.innerHTML = `
      <div class="ho-detail-row">
        <span class="ho-dr-label">Ingestion Provider</span>
        <span class="ho-dr-val">Android Health Connect</span>
      </div>
      <div class="ho-detail-row">
        <span class="ho-dr-label">Deduplication Status</span>
        <span class="ho-dr-val">Verified Sparse Index</span>
      </div>
    `;

    modal.classList.add('active');
  }

  function closeMetricModal(e) {
    if (!e || e.target === modal) {
      modal.classList.remove('active');
    }
  }
</script>

</body>
</html>