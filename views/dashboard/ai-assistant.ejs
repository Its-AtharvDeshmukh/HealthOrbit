<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HealthOrbit — AI Assistant</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/sidebar.css">
<style>
:root {
  --void: #084039; --void-soft: #0d7a6e;
  --paper: #f2f8f6; --card: #ffffff;
  --ink: #0f1c1a; --ink-soft: #5e736f;
  --coral: #ef6f5b; --coral-soft: #fbe4de;
  --sage: #109485; --sage-soft: #dff1ec;
  --mist: #42b89d; --line: rgba(13, 122, 110, 0.15);
  --radius: 24px;
  --glass-bg: rgba(255, 255, 255, 0.75);
  --glass-border: rgba(255, 255, 255, 0.95);
  --shadow-glass: 0 10px 30px rgba(8, 64, 57, 0.05);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; background: var(--paper); color: var(--ink); overflow-x: hidden; height: 100vh;}
.mono { font-family: 'JetBrains Mono', monospace; }

/* Ambient Orbs */
.ambient { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
.orb { position: absolute; border-radius: 50%; filter: blur(90px); opacity: 0.35; animation: float 22s infinite alternate; }
.orb1 { width: 420px; height: 420px; background: #a3e4d7; top: -120px; left: -100px; }
.orb2 { width: 460px; height: 460px; background: #fcefc9; bottom: -140px; right: -100px; animation-delay: -6s; }
@keyframes float { 100% { transform: translate(40px, 40px) scale(1.1); } }

/* App Layout */
.shell { display: flex; width: 100vw; height: 100vh; position: relative; z-index: 1; }
.main { flex: 1; min-width: 0; display: flex; flex-direction: column; transition: 0.4s cubic-bezier(0.25, 1, 0.5, 1); height: 100vh;}

/* Topbar */
.topbar { display: flex; justify-content: space-between; align-items: center; padding: 2.5rem 3.5rem 1rem; background: transparent; z-index: 10; flex-shrink: 0;}
.topbar h1 { font-family: 'Fraunces', serif; font-weight: 600; font-size: 1.8rem; color: var(--void); display: flex; align-items: center; gap: 0.8rem;}
.topbar .sub { font-size: 0.85rem; color: var(--ink-soft); margin-top: 0.4rem; font-weight: 500; }
.actions { display: flex; gap: 0.8rem; align-items: center; }

/* AI Pulse Core */
.ai-core-mini { width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, var(--mist), var(--void-soft)); position: relative; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 15px rgba(197, 113, 23, 0.4);}
.ai-core-mini::before { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 1px dashed var(--void-soft); animation: spin 4s linear infinite; }
@keyframes spin { 100% { transform: rotate(360deg); } }

/* Bento Grid */
.bento-wrapper { padding: 1rem 3.5rem 2.5rem; flex: 1; display: flex; min-height: 0;}
.bento { display: grid; grid-template-columns: repeat(12, 1fr); gap: 1.5rem; flex: 1; min-height: 0;}

.card {
  background: var(--glass-bg); backdrop-filter: blur(25px) saturate(180%); -webkit-backdrop-filter: blur(25px) saturate(180%);
  border: 1px solid var(--glass-border); border-radius: var(--radius); padding: 1.5rem;
  overflow: hidden; position: relative; box-shadow: var(--shadow-glass); display: flex; flex-direction: column;
}

/* 1. CHAT INTERFACE (Spans 8 Cols) */
.c-chat { grid-column: span 8; padding: 0; background: rgba(255,255,255,0.6);}
.chat-window { flex: 1; overflow-y: auto; padding: 2rem; display: flex; flex-direction: column; gap: 1.5rem; scrollbar-width: thin;}
.chat-window::-webkit-scrollbar { width: 6px; }
.chat-window::-webkit-scrollbar-thumb { background: var(--line); border-radius: 10px; }

.msg-wrapper { display: flex; max-width: 80%; }
.msg-wrapper.ai { align-self: flex-start; }
.msg-wrapper.user { align-self: flex-end; flex-direction: row-reverse; }

.msg-avatar { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; flex-shrink: 0; margin: 0 1rem; box-shadow: 0 4px 10px rgba(0,0,0,0.05);}
.ai .msg-avatar { background: var(--void); color: #fff; }
.user .msg-avatar { background: var(--coral-soft); color: var(--coral); font-weight: 800; }

.msg-bubble { padding: 1.2rem 1.5rem; border-radius: 16px; font-size: 0.95rem; line-height: 1.6; }
.ai .msg-bubble { background: #fff; color: var(--void); border: 1px solid var(--line); border-top-left-radius: 4px; box-shadow: 0 4px 15px rgba(8, 64, 57, 0.03);}
.user .msg-bubble { background: linear-gradient(135deg, var(--void), var(--void-soft)); color: #fff; border-top-right-radius: 4px; box-shadow: 0 4px 15px rgba(8, 64, 57, 0.15);}

/* Chat Input Area */
.chat-input-container { padding: 1.5rem 2rem; background: #fff; border-top: 1px solid var(--line); border-bottom-left-radius: var(--radius); border-bottom-right-radius: var(--radius);}
.suggested-prompts { display: flex; gap: 0.6rem; margin-bottom: 1rem; overflow-x: auto; scrollbar-width: none; white-space: nowrap;}
.suggested-prompts::-webkit-scrollbar { display: none; }
.prompt-chip { background: var(--sage-soft); border: 1px solid rgba(13, 122, 110, 0.2); color: var(--void); padding: 0.4rem 1rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; cursor: pointer; transition: 0.2s; }
.prompt-chip:hover { background: var(--void-soft); color: #fff;}

.input-bar { display: flex; gap: 1rem; align-items: flex-end; background: var(--paper); border: 1px solid var(--line); border-radius: 16px; padding: 0.5rem; transition: 0.2s;}
.input-bar:focus-within { border-color: var(--void-soft); background: #fff; box-shadow: 0 0 0 4px rgba(13, 122, 110, 0.1);}
.chat-input { flex: 1; border: none; background: transparent; padding: 0.8rem; font-family: inherit; font-size: 0.95rem; color: var(--ink); resize: none; max-height: 120px; outline: none;}
.send-btn { width: 44px; height: 44px; border-radius: 12px; background: var(--coral); color: white; border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.2s; flex-shrink: 0; margin-bottom: 4px; margin-right: 4px;}
.send-btn:hover { background: #d95a46; transform: scale(1.05);}

/* 2. CONTEXT HUD (Spans 4 Cols) */
.c-context { grid-column: span 4; background: linear-gradient(135deg, rgba(255,255,255,0.8), rgba(223, 241, 236, 0.6));}
.context-header { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--mist); letter-spacing: 0.05em; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;}

.context-group { margin-bottom: 1.5rem; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 1.2rem; box-shadow: 0 4px 10px rgba(0,0,0,0.02);}
.context-group h4 { font-size: 0.85rem; color: var(--void); margin-bottom: 0.8rem; display: flex; align-items: center; gap: 0.5rem;}
.context-group h4 span { font-size: 1.1rem; }

.c-item { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 0; border-bottom: 1px dashed var(--line); font-size: 0.85rem;}
.c-item:last-child { border-bottom: none; padding-bottom: 0; }
.c-label { color: var(--ink-soft); font-weight: 600;}
.c-val { color: var(--void); font-family: 'JetBrains Mono', monospace; font-weight: 700;}

/* File Context */
.file-context { display: flex; align-items: center; gap: 0.8rem; background: var(--paper); padding: 0.8rem; border-radius: 10px; border: 1px solid var(--line);}
.file-icon { font-size: 1.5rem; }
.file-info strong { display: block; font-size: 0.85rem; color: var(--void); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 150px;}
.file-info span { font-size: 0.7rem; color: var(--ink-soft); }

@media (max-width: 1024px) {
  .bento { grid-template-columns: 1fr; }
  .c-chat { grid-row: 2; height: 600px; }
  .c-context { grid-row: 1; }
  .main { height: auto; }
  .shell { height: auto; }
}
@media (max-width: 768px) {
  .shell { flex-direction: column; }
  .topbar { padding: 1.2rem 1.5rem; flex-direction: column; align-items: flex-start; gap: 1rem; }
  .bento-wrapper { padding: 1.5rem; }
  .msg-wrapper { max-width: 95%; }
  .msg-avatar { display: none; }
}
</style>
</head>
<body>

<div class="ambient"><div class="orb orb1"></div><div class="orb orb2"></div></div>

<div class="shell">
  <!-- UNIVERSAL SIDEBAR IMPORT -->
  <%- include('../partials/sidebar') %>

  <main class="main">
    <header class="topbar">
      <div>
        <h1><div class="ai-core-mini"></div> HealthOrbit Medical Analyst</h1>
        <div class="sub">Your conversational interface to all normalized health data.</div>
      </div>
    </header>

    <div class="bento-wrapper">
      <div class="bento">

        <!-- 1. CHAT INTERFACE (Spans 8) -->
        <div class="card c-chat">
          <div class="chat-window">
            
            <!-- AI Welcome Message -->
            <div class="msg-wrapper ai">
              <div class="msg-avatar">✨</div>
              <div class="msg-bubble">
                Hello <strong><%= locals.userName ? userName.split(' ')[0] : 'there' %></strong>. I've synced your latest medical reports and Apple HealthKit telemetry. Your resting BPM is slightly elevated today, but your latest CBC parameters look stable. <br><br>How can I assist you with your health data today?
              </div>
            </div>

            <!-- User Message -->
            <div class="msg-wrapper user">
              <div class="msg-bubble">
                Can you explain why my Vitamin D was marked as "Deficient" in the CBC report I uploaded yesterday? What should I do?
              </div>
              <div class="msg-avatar">U</div>
            </div>

            <!-- AI Response -->
            <div class="msg-wrapper ai">
              <div class="msg-avatar">✨</div>
              <div class="msg-bubble">
                Certainly. Based on the <strong>Complete_Blood_Count.pdf</strong> you uploaded, your Vitamin D (25-OH) level is <strong>18 ng/mL</strong>. <br><br>
                The standard reference range for optimal health is typically between <strong>20 - 50 ng/mL</strong>, which is why the system flagged it as deficient.<br><br>
                I also see from your Timeline that you started taking <strong>Vitamin D3 (Cholecalciferol) 60,000 IU</strong> once a week. Continuing this protocol as prescribed by your doctor is the standard approach to elevating these levels.
              </div>
            </div>

          </div>

          <!-- Input Area -->
          <div class="chat-input-container">
            <div class="suggested-prompts">
              <span class="prompt-chip">Summarize my last 30 days of sleep</span>
              <span class="prompt-chip">Are my current meds causing fatigue?</span>
              <span class="prompt-chip">Explain my Hemoglobin trend</span>
            </div>
            <div class="input-bar">
              <textarea class="chat-input" rows="1" placeholder="Ask Gemini about your health data..."></textarea>
              <button class="send-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
              </button>
            </div>
          </div>
        </div>

        <!-- 2. CONTEXT HUD (Spans 4) -->
        <div class="card c-context">
          <div class="context-header">
            <span class="pulse-dot" style="width:6px; height:6px;"></span> Active Context Window
          </div>

          <div class="context-group">
            <h4><span>📄</span> Document Memory</h4>
            <div class="file-context">
              <div class="file-icon">📑</div>
              <div class="file-info">
                <strong>Complete_Blood_Count.pdf</strong>
                <span>Processed: Aug 18, 2026</span>
              </div>
            </div>
          </div>

          <div class="context-group">
            <h4><span>⌚</span> Live Telemetry (Apple HealthKit)</h4>
            <div class="c-item">
              <span class="c-label">Resting BPM</span>
              <span class="c-val" style="color: var(--coral);">82 <small style="font-size:0.6rem;">bpm</small></span>
            </div>
            <div class="c-item">
              <span class="c-label">Blood Oxygen</span>
              <span class="c-val">98 <small style="font-size:0.6rem;">%</small></span>
            </div>
            <div class="c-item">
              <span class="c-label">Sleep (Last Night)</span>
              <span class="c-val">6h 15m</span>
            </div>
          </div>

          <div class="context-group">
            <h4><span>💊</span> Active Protocols</h4>
            <div class="c-item">
              <span class="c-label">Levothyroxine</span>
              <span class="c-val">50mcg</span>
            </div>
            <div class="c-item">
              <span class="c-label">Vitamin D3</span>
              <span class="c-val">60k IU</span>
            </div>
          </div>

        </div>

      </div>
    </div>
  </main>
</div>

</body>
</html>