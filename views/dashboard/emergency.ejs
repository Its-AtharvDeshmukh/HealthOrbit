<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<link rel="icon" href="/images/Logo.png">
<title>HealthOrbit - Emergency Network</title>
<%- include('../partials/header', { title: 'HealthOrbit - Emergency', cssFile: 'global' }) %>
<style>
  /* EXACT ORIGINAL CSS PRESERVED + COMMUNITY SCROLLBAR */
  :root {
    --ho-bg-airy: #edf6f4; --ho-teal-900: #0b5e55; --ho-teal-700: #0d7a6e;
    --ho-teal-600: #109485; --ho-mint-400: #42b89d; --ho-coral: #e07a68;
    --ho-coral-soft: #fbe4de; --ho-danger: #e74c3c; --ho-danger-dark: #c0392b;
    --ho-danger-glow: rgba(231, 76, 60, 0.4); --ho-warning: #f39c12; --ho-blue: #3498db;
    --ho-glass-clear: rgba(255, 255, 255, 0.5); --ho-glass-solid: rgba(255, 255, 255, 0.88);
    --ho-glass-border: rgba(255, 255, 255, 0.95); --ho-glass-border-subtle: rgba(255, 255, 255, 0.5);
    --ho-radius-xl: 32px; --ho-radius-lg: 24px; --ho-radius-md: 16px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { min-height: 100vh; font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; background-color: var(--ho-bg-airy); color: var(--ho-text-main); overflow-x: hidden; -webkit-font-smoothing: antialiased; }
  .ho-app-layout { display: flex; width: 100vw; height: 100vh; position: relative; z-index: 10; }
  .ho-main-content { flex: 1; min-width: 0; display: flex; flex-direction: column; height: 100vh; overflow-y: auto; scrollbar-width: none; }
  .ho-main-content::-webkit-scrollbar { display: none; }
  
  .ho-topbar { display: flex; justify-content: space-between; align-items: center; padding: 2.5rem 3rem 1.2rem; flex-shrink: 0; background: transparent; z-index: 20; }
  .ho-topbar h1 { font-weight: 800; font-size: 1.8rem; color: var(--ho-teal-900); margin-bottom: 0.3rem; letter-spacing: -0.5px;}
  .ho-topbar p { font-size: 0.95rem; color: var(--ho-text-muted); font-weight: 500; }
  
  .ho-btn-danger-pill { background: linear-gradient(135deg, var(--ho-danger), var(--ho-danger-dark)); color: #fff; border: none; border-radius: 999px; padding: 0.8rem 1.6rem; font-weight: 800; font-size: 0.95rem; cursor: pointer; box-shadow: 0 8px 20px var(--ho-danger-glow); transition: 0.25s cubic-bezier(0.16, 1, 0.3, 1); display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; justify-content: center; }
  .ho-btn-danger-pill:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(231, 76, 60, 0.6); }
  .ho-btn-danger-pill:active { transform: scale(0.96); }

  .ho-mosaic-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 1.8rem; padding: 0.5rem 3rem 3rem; flex: 1 0 auto; }
  .ho-panel { background: var(--ho-glass-clear); backdrop-filter: blur(40px) saturate(200%); -webkit-backdrop-filter: blur(40px) saturate(200%); border: 1px solid var(--ho-glass-border); border-radius: var(--ho-radius-xl); padding: 2.2rem; display: flex; flex-direction: column; box-shadow: 0 20px 50px rgba(13, 122, 110, 0.08), inset 0 1px 1px rgba(255, 255, 255, 1); opacity: 0; animation: hoSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; transition: transform 0.3s ease, box-shadow 0.3s ease; }
  .ho-panel:hover { transform: translateY(-2px); box-shadow: 0 30px 60px rgba(13, 122, 110, 0.12); background: rgba(255,255,255,0.75);}
  @keyframes hoSlideUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
  .ho-delay-1 { animation-delay: 0.1s; } .ho-delay-2 { animation-delay: 0.2s; } .ho-delay-3 { animation-delay: 0.3s; } .ho-delay-4 { animation-delay: 0.4s; }

  .ho-panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.8rem; flex-shrink: 0; flex-wrap: wrap; gap: 1rem;}
  .ho-panel-header h2 { font-weight: 800; font-size: 1.35rem; color: var(--ho-teal-900); display: flex; align-items: center; gap: 0.6rem; margin: 0;}

  /* --- 1. ADVANCED SOS RADAR HERO --- */
  .ho-hero-sos { grid-column: span 12; background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(251, 228, 222, 0.8)); border: 1px solid rgba(231, 76, 60, 0.2); flex-direction: row; align-items: center; justify-content: space-between; padding: 3rem; overflow: hidden; position: relative; }
  .ho-sos-text-content { flex: 1; z-index: 5; max-width: 60%; }
  .ho-sos-text-content h2 { font-family: 'Fraunces', serif; font-size: 2.6rem; font-weight: 700; color: var(--ho-danger-dark); line-height: 1.1; margin-bottom: 0.8rem; letter-spacing: -0.5px;}
  .ho-sos-text-content p { font-size: 1.05rem; color: var(--ho-teal-900); line-height: 1.6; font-weight: 500; margin-bottom: 1.8rem; }
  
  .ho-hero-tag { display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(231, 76, 60, 0.1); color: var(--ho-danger); padding: 6px 14px; border-radius: 999px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem; }
  .ho-hero-tag .dot { width: 8px; height: 8px; background: var(--ho-danger); border-radius: 50%; box-shadow: 0 0 8px var(--ho-danger); animation: hoBlink 1.5s infinite; }
  @keyframes hoBlink { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  .ho-radar-zone { position: relative; width: 220px; height: 220px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; z-index: 5; }
  .ho-radar-ring { position: absolute; inset: 0; border-radius: 50%; border: 2px solid var(--ho-danger); animation: hoRadarPulse 2.5s infinite cubic-bezier(0.16, 1, 0.3, 1); }
  .ho-radar-ring:nth-child(2) { animation-delay: 0.8s; }
  .ho-radar-ring:nth-child(3) { animation-delay: 1.6s; }
  @keyframes hoRadarPulse { 0% { transform: scale(0.4); opacity: 1; stroke-width: 4px; } 100% { transform: scale(1.8); opacity: 0; stroke-width: 1px; } }

  .ho-giant-sos-btn { position: relative; width: 120px; height: 120px; border-radius: 50%; background: linear-gradient(135deg, #ff4b2b, #c0392b); color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 6px solid #fff; box-shadow: 0 15px 35px var(--ho-danger-glow); cursor: pointer; z-index: 10; transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
  .ho-giant-sos-btn:hover { transform: scale(1.08); box-shadow: 0 20px 45px rgba(231, 76, 60, 0.6); }
  .ho-giant-sos-btn:active { transform: scale(0.9); }
  .ho-giant-sos-btn span { font-family: 'JetBrains Mono', monospace; font-weight: 900; font-size: 2.2rem; letter-spacing: 2px;}

  /* --- 2. LIQUID BLOOD PROFILE --- */
  .ho-profile-panel { grid-column: span 4; display: flex; flex-direction: column; }
  .ho-blood-vial { width: 90px; height: 90px; margin: 0 auto 1.5rem; background: rgba(231, 76, 60, 0.1); border: 3px solid rgba(231, 76, 60, 0.3); border-radius: 30%; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; box-shadow: inset 0 0 20px rgba(231, 76, 60, 0.15), 0 10px 25px rgba(231, 76, 60, 0.1); transform: rotate(45deg); }
  .ho-blood-liquid { position: absolute; bottom: -10%; left: -50%; width: 200%; height: 100%; background: linear-gradient(180deg, var(--ho-danger-dark), var(--ho-danger)); border-radius: 40%; animation: hoLiquidWave 4s infinite linear; }
  @keyframes hoLiquidWave { 100% { transform: rotate(360deg); } }
  .ho-blood-type { position: relative; z-index: 5; color: #fff; font-family: 'JetBrains Mono', monospace; font-size: 2.4rem; font-weight: 900; transform: rotate(-45deg); text-shadow: 0 4px 10px rgba(0,0,0,0.3); }

  .ho-vial-info { text-align: center; margin-bottom: 2rem; }
  .ho-vial-info h4 { font-size: 1.2rem; color: var(--ho-teal-900); font-weight: 800; }
  .ho-vial-info p { font-size: 0.9rem; color: var(--ho-text-muted); font-weight: 600;}

  .ho-status-toggle { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 1.2rem; border-radius: 16px; border: 1px solid var(--ho-glass-border-subtle); margin-bottom: 0.8rem; transition: 0.2s; }
  .ho-status-toggle:hover { border-color: var(--ho-mint-400); transform: translateX(4px); }
  .ho-st-text strong { display: block; font-size: 0.95rem; color: var(--ho-teal-900); font-weight: 800;}
  .ho-st-text span { font-size: 0.8rem; color: var(--ho-text-muted); font-weight: 600;}

  .ho-toggle { position: relative; display: inline-block; width: 48px; height: 26px; flex-shrink: 0;}
  .ho-toggle input { opacity: 0; width: 0; height: 0; }
  .ho-toggle-slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(13, 122, 110, 0.15); transition: .4s; border-radius: 26px; }
  .ho-toggle-slider:before { position: absolute; content: ""; height: 20px; width: 20px; left: 3px; bottom: 3px; background-color: white; transition: .4s cubic-bezier(0.16, 1, 0.3, 1); border-radius: 50%; box-shadow: 0 2px 6px rgba(0,0,0,0.2); }
  .ho-toggle input:checked + .ho-toggle-slider { background-color: var(--ho-danger); }
  .ho-toggle input:checked + .ho-toggle-slider:before { transform: translateX(22px); }

  /* --- 3. LIVE COMMUNITY REQUESTS (SCROLL BAR IMPLEMENTED) --- */
  .ho-requests-panel { grid-column: span 8; display: flex; flex-direction: column; }
  .ho-live-indicator { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; font-weight: 700; color: var(--ho-mint-400); background: rgba(66, 184, 157, 0.1); padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(66, 184, 157, 0.2); }
  .ho-live-indicator .dot { width: 6px; height: 6px; background: var(--ho-mint-400); border-radius: 50%; animation: hoBlink 1.5s infinite; }

  .ho-req-list { 
    display: flex; flex-direction: column; gap: 1.2rem; 
    max-height: 420px; overflow-y: auto; flex: 1; padding-right: 0.6rem; 
    scrollbar-width: thin; scrollbar-color: rgba(13, 122, 110, 0.3) transparent;
  }
  .ho-req-list::-webkit-scrollbar { width: 6px; }
  .ho-req-list::-webkit-scrollbar-thumb { background: rgba(13, 122, 110, 0.25); border-radius: 999px; }
  .ho-req-list::-webkit-scrollbar-track { background: transparent; }
  
  .ho-req-card { background: #fff; border: 1px solid var(--ho-glass-border); border-radius: 20px; padding: 1.8rem; display: flex; flex-direction: column; gap: 1.2rem; box-shadow: 0 6px 20px rgba(0,0,0,0.03); transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
  .ho-req-card:hover { transform: translateY(-4px); box-shadow: 0 15px 35px rgba(13, 122, 110, 0.1); border-color: var(--ho-teal-600); }
  .ho-req-card.urgent { border-left: 5px solid var(--ho-danger); }
  
  .ho-req-header { display: flex; justify-content: space-between; align-items: flex-start; }
  .ho-req-title { display: flex; align-items: center; gap: 1rem; }
  .ho-req-icon { width: 48px; height: 48px; border-radius: 14px; background: var(--ho-coral-soft); color: var(--ho-danger); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; flex-shrink: 0; box-shadow: inset 0 0 10px rgba(255,255,255,0.5); }
  .ho-req-title-text strong { display: block; font-size: 1.2rem; color: var(--ho-teal-900); font-weight: 800; margin-bottom: 0.2rem;}
  .ho-req-title-text span { font-size: 0.85rem; color: var(--ho-text-muted); font-weight: 600;}
  
  .ho-req-meta { display: flex; gap: 0.8rem; font-size: 0.85rem; color: var(--ho-teal-900); font-weight: 700; flex-wrap: wrap;}
  .ho-req-meta div { display: flex; align-items: center; gap: 0.5rem; background: var(--ho-bg-airy); padding: 0.6rem 1rem; border-radius: 10px; border: 1px solid rgba(13, 122, 110, 0.05);}
  
  .ho-req-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem; padding-top: 1.2rem; border-top: 1px dashed var(--ho-glass-border-subtle); }
  .ho-btn-action-primary { background: var(--ho-teal-900); color: #fff; border: none; padding: 0.8rem 1.6rem; border-radius: 12px; font-weight: 800; font-size: 0.9rem; cursor: pointer; transition: 0.2s; box-shadow: 0 4px 15px rgba(11, 94, 85, 0.2); }
  .ho-btn-action-primary:hover { background: var(--ho-teal-700); transform: translateY(-2px); box-shadow: 0 8px 25px rgba(11, 94, 85, 0.3); }

  /* --- 4. TACTICAL DISPATCH MAP --- */
  .ho-map-panel { grid-column: span 12; padding: 0; flex-direction: row; overflow: hidden; background: #fff; }
  .ho-map-visual { flex: 1.5; position: relative; background: #cbd5e1; overflow: hidden; min-height: 400px; }
  .ho-map-grid-bg { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.2) 1px, transparent 1px); background-size: 40px 40px; opacity: 0.8; }
  .ho-map-user-pin { position: absolute; top: 50%; left: 40%; width: 20px; height: 20px; background: var(--ho-blue); border: 3px solid #fff; border-radius: 50%; transform: translate(-50%, -50%); box-shadow: 0 0 15px var(--ho-blue); z-index: 10; }
  .ho-map-user-pin::before { content: ''; position: absolute; inset: -20px; border: 2px solid var(--ho-blue); border-radius: 50%; animation: hoRadarPulse 2s infinite ease-out; }
  .ho-map-hos-pin { position: absolute; width: 44px; height: 44px; background: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; box-shadow: 0 6px 15px rgba(0,0,0,0.2); transform: translate(-50%, -50%); cursor: pointer; border: 2px solid var(--ho-teal-600); z-index: 5; transition: 0.2s; }
  .ho-map-hos-pin:hover { transform: translate(-50%, -50%) scale(1.15); z-index: 15; box-shadow: 0 10px 25px rgba(13, 122, 110, 0.4); }
  .ho-map-hos-pin::after { content: attr(data-name); position: absolute; bottom: -28px; background: rgba(0,0,0,0.8); color: #fff; font-size: 0.7rem; font-weight: 700; padding: 4px 8px; border-radius: 6px; white-space: nowrap; pointer-events: none; opacity: 0; transition: 0.2s; }
  .ho-map-hos-pin:hover::after { opacity: 1; bottom: -32px; }

  .ho-map-list { flex: 1; padding: 2.2rem; display: flex; flex-direction: column; gap: 1.2rem; background: #fff; z-index: 2; box-shadow: -10px 0 30px rgba(0,0,0,0.03); overflow-y: auto; max-height: 450px; }
  .ho-nearby-card { background: var(--ho-bg-airy); border: 1px solid var(--ho-glass-border-subtle); border-radius: 16px; padding: 1.2rem; display: flex; flex-direction: column; gap: 1rem; transition: 0.2s ease; cursor: pointer; position: relative; overflow: hidden; }
  .ho-nearby-card:hover { transform: translateX(-5px); border-color: var(--ho-teal-600); box-shadow: 0 10px 25px rgba(13, 122, 110, 0.1); background: #fff;}
  .ho-nearby-card::before { content:''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--ho-teal-600); transition: width 0.2s;}
  .ho-nearby-card:hover::before { width: 6px; }

  .ho-nc-top { display: flex; gap: 1rem; align-items: flex-start; }
  .ho-nc-info strong { display: block; font-size: 1.05rem; color: var(--ho-teal-900); font-weight: 800; margin-bottom: 0.2rem; line-height: 1.2;}
  .ho-nc-info span { display: block; font-size: 0.8rem; color: var(--ho-text-muted); font-weight: 600; margin-bottom: 0.2rem;}
  
  .ho-nc-actions { display: flex; gap: 0.8rem; margin-top: 0.5rem; }
  .ho-nc-btn { flex: 1; padding: 0.8rem 0; text-align: center; border-radius: 10px; font-weight: 800; font-size: 0.85rem; text-decoration: none; cursor: pointer; transition: 0.2s; border: none; display: inline-block; }
  .ho-nc-btn.call { background: var(--ho-danger); color: #fff; box-shadow: 0 4px 15px rgba(231,76,60,0.2); }
  .ho-nc-btn.call:hover { background: var(--ho-danger-dark); transform: scale(1.05); }
  .ho-nc-btn.nav { background: #fff; color: var(--ho-teal-900); border: 1px solid var(--ho-glass-border-subtle); }
  .ho-nc-btn.nav:hover { background: var(--ho-glass-border); transform: scale(1.05); }

  /* --- 5. 3D GLASS TILES FOR DIRECTORY & PROTOCOLS --- */
  .ho-directory-panel, .ho-protocol-panel { grid-column: span 6; }
  .ho-grid-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.2rem; }
  .ho-3d-tile { background: linear-gradient(145deg, #ffffff, rgba(255,255,255,0.7)); border: 1px solid var(--ho-glass-border); border-radius: 20px; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; text-decoration: none; color: inherit; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); cursor: pointer; box-shadow: 0 10px 30px rgba(0,0,0,0.03), inset 0 -4px 0 rgba(13, 122, 110, 0.05); }
  .ho-3d-tile:hover { transform: translateY(-6px); border-color: var(--ho-teal-600); box-shadow: 0 20px 40px rgba(13, 122, 110, 0.1), inset 0 -4px 0 var(--ho-teal-600); }
  .ho-3d-tile .tile-icon { font-size: 1.8rem; background: var(--ho-bg-airy); width: 54px; height: 54px; display: flex; align-items: center; justify-content: center; border-radius: 16px; box-shadow: inset 0 0 10px rgba(0,0,0,0.05); transition: 0.3s; }
  .ho-3d-tile:hover .tile-icon { transform: scale(1.1) rotate(5deg); background: var(--ho-coral-soft); color: var(--ho-danger); }
  .ho-tile-text strong { display: block; font-size: 1.05rem; color: var(--ho-teal-900); font-weight: 800; margin-bottom: 0.2rem;}
  .ho-tile-text span { font-size: 0.8rem; color: var(--ho-text-muted); font-weight: 600; line-height: 1.4;}

  /* --- MODALS & TOASTS --- */
  .ho-modal { position: fixed; inset: 0; background: rgba(11, 94, 85, 0.6); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); display: none; align-items: center; justify-content: center; z-index: 3000; padding: 1.2rem; opacity: 0; transition: opacity 0.3s ease; }
  .ho-modal.active { display: flex; opacity: 1; }
  .ho-modal-box { background: #ffffff; border: 1px solid var(--ho-glass-border); border-radius: 32px; padding: 3rem 2.5rem; width: 100%; max-width: 500px; text-align: center; box-shadow: 0 40px 80px rgba(0,0,0,0.25); transform: scale(0.95); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
  .ho-modal.active .ho-modal-box { transform: scale(1); }
  .ho-modal-box.critical-alert { border: 2px solid var(--ho-danger); background: linear-gradient(180deg, #fff, var(--ho-coral-soft)); box-shadow: 0 0 60px rgba(231, 76, 60, 0.3); }

  .ho-form-group { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; text-align: left; }
  .ho-form-group label { font-size: 0.85rem; font-weight: 800; color: var(--ho-teal-900); text-transform: uppercase; letter-spacing: 0.05em;}
  .ho-input { width: 100%; padding: 1rem 1.2rem; border: 1px solid #cbd5e1; border-radius: 16px; font-family: inherit; font-size: 1rem; color: var(--ho-text-main); font-weight: 500; outline: none; transition: 0.2s; background: #f8fcfb;}
  .ho-input:focus { border-color: var(--ho-teal-600); box-shadow: 0 0 0 4px rgba(13, 122, 110, 0.1); background: #fff;}
  
  .ho-sos-loader { width: 100%; height: 8px; background: rgba(231,76,60,0.2); border-radius: 999px; margin: 1.5rem 0; overflow: hidden; display: none; }
  .ho-sos-loader-fill { width: 0%; height: 100%; background: var(--ho-danger); animation: hoFillBar 2s linear forwards; }
  @keyframes hoFillBar { to { width: 100%; } }

  .ho-toast { position: fixed; bottom: 2.5rem; left: 50%; transform: translateX(-50%) translateY(30px); background: var(--ho-teal-900); color: #fff; padding: 1rem 2rem; border-radius: 999px; font-weight: 700; font-size: 0.95rem; box-shadow: 0 20px 40px rgba(0,0,0,0.25); z-index: 4000; opacity: 0; transition: all 0.4s cubic-bezier(0.16,1,0.3,1); pointer-events: none; border: 1px solid rgba(255,255,255,0.1); white-space: nowrap; }
  .ho-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

  @media (max-width: 1280px) {
    .ho-mosaic-grid { grid-template-columns: repeat(12, 1fr); }
    .ho-profile-panel, .ho-requests-panel, .ho-directory-panel, .ho-protocol-panel, .ho-map-panel { grid-column: span 12; }
    .ho-map-panel { flex-direction: column; }
    .ho-map-visual { min-height: 300px; }
    .ho-map-list { max-height: none; }
  }

  @media (max-width: 1024px) {
    body .ho-main-content { margin-top: 5.5rem; padding-left: 0 !important; }
  }

  @media (max-width: 768px) {
    body, html { height: auto !important; min-height: 100vh !important; overflow-x: hidden !important; background: var(--ho-bg-airy) !important; margin: 0 !important; padding: 0 !important; }
    .ho-app-layout { flex-direction: column !important; height: auto !important; min-height: 100vh !important; }
    .ho-main-content { padding-top: 5rem !important; margin-top: 0 !important; height: auto !important; min-height: 100vh !important; overflow: visible !important; margin-left: 0 !important;}
    .ho-topbar { flex-direction: column !important; align-items: flex-start !important; padding: 0 1.25rem 1.2rem !important; gap: 1rem !important; position: static !important; background: transparent !important; border: none !important; }
    .ho-topbar h1 { font-size: 1.6rem !important; }
    .ho-mosaic-grid { grid-template-columns: 1fr !important; padding: 0 1.25rem 2.5rem !important; gap: 1.5rem !important; display: flex !important; flex-direction: column !important; flex: 1 0 auto !important; }
    .ho-panel { height: auto !important; min-height: 0 !important; padding: 1.5rem !important; border-radius: 24px !important; flex: none !important; margin: 0 !important;}
    .ho-hero-sos { flex-direction: column-reverse !important; text-align: center !important; align-items: center !important; padding: 2rem 1.2rem !important; gap: 2.5rem !important;}
    .ho-sos-text-content { max-width: 100% !important; }
    .ho-sos-text-content h2 { font-size: 1.8rem !important; }
    .ho-radar-zone { width: 180px !important; height: 180px !important; margin: 0 auto; }
    .ho-giant-sos-btn { width: 100px !important; height: 100px !important; }
    .ho-giant-sos-btn span { font-size: 1.8rem !important; }
    .ho-req-header, .ho-req-meta, .ho-req-footer { flex-direction: column !important; align-items: stretch !important; gap: 1rem !important;}
    .ho-grid-links { grid-template-columns: 1fr !important; }
    .ho-map-panel { padding: 0 !important; overflow: hidden !important; }
    .ho-map-visual { min-height: 250px !important; width: 100% !important;}
    .ho-map-list { padding: 1.5rem 1.2rem !important; width: 100% !important;}
    .ho-nc-actions { flex-direction: column !important; gap: 0.8rem !important; }
    .ho-nc-btn { width: 100% !important; padding: 1rem !important;}
    .ho-modal { padding: 1rem !important; }
    .ho-modal-box { padding: 2.5rem 1.5rem !important; max-width: 95% !important; border-radius: 24px !important; max-height: 90vh !important; overflow-y: auto !important;}
    .ho-modal-box h3 { font-size: 1.5rem !important; }
    .ho-toast { width: 90% !important; text-align: center !important; font-size: 0.85rem !important; padding: 1rem !important; white-space: normal !important;}
  }
</style>
</head>
<body>

<% 
  // SAFELY MAP BACKEND VARIABLES (Prevents ReferenceError crashes)
  const u = locals.user || {};
  const alertStatus = locals.activeAlert || null;
  const reqs = locals.communityRequests || [];
  const privacy = u.privacySettings || {};
  const donor = u.donorProfile || {};
%>

<%- include('../partials/ambient') %>

<div class="ho-app-layout">
  <%- include('../partials/sidebar') %>

  <main class="ho-main-content">
    <header class="ho-topbar">
      <div>
        <h1>Emergency & Medical Network</h1>
        <p>Trigger SOS alerts, dispatch responders, and view critical medical requests.</p>
      </div>
      <div class="ho-topbar-actions">
        <button class="ho-btn-danger-pill" onclick="openModal('sosConfirmModal')">🚨 Trigger SOS Override</button>
      </div>
    </header>

    <% if (locals.successMsg) { %> <div class="ho-toast show" id="hoToast">✅ <%= locals.successMsg %></div> <% } %>
    <% if (locals.errorMsg) { %> <div class="ho-toast show" id="hoToast" style="background: var(--ho-danger);">⚠️ <%= locals.errorMsg %></div> <% } %>

    <div class="ho-mosaic-grid">
      
      <!-- 1. ADVANCED SOS RADAR HERO -->
      <section class="ho-panel ho-hero-sos ho-delay-1">
        <div class="ho-sos-text-content">
          <div class="ho-hero-tag"><div class="dot"></div> Critical Action Hub</div>
          <% if (alertStatus) { %>
            <h2 style="color: var(--ho-danger); font-size: 2rem;">🚨 SOS ACTIVE</h2>
            <p style="color: var(--ho-danger); font-weight: 700;">Your emergency alert and location have been securely saved in HealthOrbit.</p>
            <form action="/emergency/sos/resolve" method="POST" style="margin-bottom: 1.5rem;">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
              <button type="submit" class="ho-btn-danger-pill" style="background: var(--ho-danger); box-shadow: none;">Mark as Resolved</button>
            </form>
          <% } else { %>
            <h2>Are you in an emergency?</h2>
            <p>Instantly broadcast your live GPS coordinates, blood group, allergies, and condition to your designated family members and nearby emergency dispatchers.</p>
          <% } %>
          
          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="tel:108" class="ho-btn-danger-pill" style="background: #fff; color: var(--ho-danger); border: 2px solid var(--ho-danger); box-shadow: none;">🚑 Call Ambulance (108)</a>
            <% if (u.emergencyContactPhone) { %>
              <a href="tel:<%= u.emergencyContactPhone %>" class="ho-btn-danger-pill" style="background: #fff; color: var(--ho-teal-900); border: 2px solid var(--ho-glass-border-subtle); box-shadow: none;">📞 Call <%= u.emergencyContactName || 'Contact' %></a>
            <% } else { %>
              <a href="/profile" class="ho-btn-danger-pill" style="background: #fff; color: var(--ho-text-muted); border: 2px solid var(--ho-glass-border-subtle); box-shadow: none;">Add Emergency Contact</a>
            <% } %>
          </div>
          <div id="locationStatus" style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; font-weight: 700; color: var(--ho-text-muted); background: #fff; padding: 0.5rem 1rem; border-radius: 8px; display: inline-block; margin-top: 1.5rem; border: 1px solid var(--ho-glass-border-subtle);">Location not requested</div>
        </div>

        <div class="ho-radar-zone" onclick="openModal('sosConfirmModal')">
          <div class="ho-radar-ring"></div><div class="ho-radar-ring"></div><div class="ho-radar-ring"></div>
          <div class="ho-giant-sos-btn"><span>SOS</span></div>
        </div>
      </section>

      <!-- 2. LIQUID BLOOD PROFILE -->
      <section class="ho-panel ho-profile-panel ho-delay-2">
        <div class="ho-panel-header">
          <h2><span>❤️</span> Donor Identity</h2>
        </div>
        
        <div class="ho-blood-vial">
          <div class="ho-blood-liquid"></div>
          <div class="ho-blood-type"><%= u.bloodGroup ? u.bloodGroup.replace(/[^A-Za-z+-]/g, '') : '?' %></div>
        </div>

        <div class="ho-vial-info">
          <h4><%= u.bloodGroup || 'Not Set' %></h4>
          <p>Donor Status Configuration</p>
        </div>

        <form action="/emergency/donor-profile" method="POST">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
          <div style="display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 1rem 1.2rem; border-radius: 16px; border: 1px solid var(--ho-glass-border-subtle); margin-bottom: 0.8rem;">
            <strong style="font-size: 0.9rem; color: var(--ho-teal-900); font-weight: 800;">Available as Blood Donor</strong>
            <label class="ho-toggle"><input type="checkbox" name="bloodDonorEnabled" <%= donor.bloodDonorEnabled ? 'checked' : '' %>><span class="ho-toggle-slider"></span></label>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 1rem 1.2rem; border-radius: 16px; border: 1px solid var(--ho-glass-border-subtle); margin-bottom: 0.8rem;">
            <strong style="font-size: 0.9rem; color: var(--ho-teal-900); font-weight: 800;">Allow Contact Sharing</strong>
            <label class="ho-toggle"><input type="checkbox" name="contactSharingEnabled" <%= donor.contactSharingEnabled ? 'checked' : '' %>><span class="ho-toggle-slider"></span></label>
          </div>
          <div class="ho-form-group" style="margin-top: 1rem;">
            <label>Organ Donation Preference</label>
            <select name="organDonorPreference" class="ho-input">
              <option value="Not specified" <%= donor.organDonorPreference === 'Not specified' ? 'selected' : '' %>>Not specified</option>
              <option value="Yes" <%= donor.organDonorPreference === 'Yes' ? 'selected' : '' %>>Yes, willing to donate</option>
              <option value="No" <%= donor.organDonorPreference === 'No' ? 'selected' : '' %>>No</option>
            </select>
          </div>
          <button type="submit" class="ho-btn-danger-pill" style="width: 100%; margin-top: 1rem; background: var(--ho-teal-900); box-shadow: none;">Save Preferences</button>
        </form>
      </section>

      <!-- 3. LIVE COMMUNITY REQUESTS (WITH SCROLL BAR) -->
      <section class="ho-panel ho-requests-panel ho-delay-2">
        <div class="ho-panel-header">
          <h2><span>📢</span> Community Requests</h2>
          <div style="display: flex; gap: 1rem; align-items: center;">
            <div class="ho-live-indicator"><div class="dot"></div> Live Sync</div>
            <button class="ho-btn-danger-pill" style="padding: 0.6rem 1.2rem; font-size: 0.85rem;" onclick="openModal('broadcastModal')">+ Broadcast</button>
          </div>
        </div>

        <div class="ho-req-list">
          <% if (reqs && reqs.length > 0) { %>
            <% reqs.forEach(req => { %>
              <div class="ho-req-card <%= req.urgency.includes('High') || req.urgency.includes('Critical') ? 'urgent' : '' %>">
                <div class="ho-req-header">
                  <div class="ho-req-title">
                    <div class="ho-req-icon"><%= req.requestType.includes('Blood') ? '🩸' : (req.requestType.includes('Oxygen') ? '💨' : '💊') %></div>
                    <div class="ho-req-title-text">
                      <strong><%= req.title %></strong>
                      <span>Posted by <%= req.userId ? req.userId.fullName : 'Unknown User' %> • <%= new Date(req.createdAt).toLocaleDateString() %></span>
                    </div>
                  </div>
                  <span style="font-size: 0.75rem; font-weight: 800; color: var(--ho-danger); background: var(--ho-coral-soft); padding: 4px 10px; border-radius: 6px;"><%= req.urgency.split(' ')[0] %></span>
                </div>
                <div class="ho-req-meta">
                  <div>🏥 <%= req.hospitalName %></div>
                  <div>⏳ Expires: <%= new Date(req.expiresAt).toLocaleDateString() %></div>
                </div>
                <p style="font-size: 0.9rem; color: var(--ho-text-muted); font-weight: 600; line-height: 1.5; margin-top: 0.5rem;"><%= req.description %></p>
                <div class="ho-req-footer">
                  <span style="font-size: 0.85rem; color: var(--ho-text-muted); font-weight: 600;">Type: <%= req.requestType %> <%= req.bloodGroup ? `(${req.bloodGroup})` : '' %></span>
                  
                  <div style="display: flex; gap: 1rem; align-items: center;">
                    <% if (req.userId && req.userId.donorProfile && req.userId.donorProfile.contactSharingEnabled) { %>
                      <a href="tel:<%= req.userId.phone %>" class="ho-btn-danger-pill" style="background: #fff; color: var(--ho-teal-900); border: 1px solid var(--ho-glass-border-subtle); padding: 0.6rem 1.2rem; font-size: 0.85rem; box-shadow: none; text-decoration: none;">📞 Contact</a>
                    <% } else { %>
                      <span style="font-size: 0.75rem; color: var(--ho-text-muted); font-weight: 700;">Contact Hidden</span>
                    <% } %>

                    <% if (req.userId && req.userId._id && req.userId._id.toString() === u._id.toString()) { %>
                      <form action="/emergency/community/<%= req._id %>/delete" method="POST" style="margin: 0;">
                        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                        <button type="submit" style="background: none; border: none; color: var(--ho-danger); font-size: 0.8rem; font-weight: 800; cursor: pointer; text-decoration: underline;">Remove</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div style="text-align: center; padding: 4rem 2rem; background: rgba(255,255,255,0.4); border: 1.5px dashed var(--ho-glass-border-subtle); border-radius: 20px; color: var(--ho-text-muted);">
              <div style="font-size: 2.5rem; margin-bottom: 1rem;">📢</div>
              <strong style="display: block; font-size: 1.1rem; color: var(--ho-teal-900); margin-bottom: 0.5rem;">No Active Community Requests.</strong>
              <span>Broadcast a request if you have an urgent medical requirement.</span>
            </div>
          <% } %>
        </div>
      </section>

      <!-- 4. TACTICAL DISPATCH MAP -->
      <section class="ho-panel ho-map-panel ho-delay-3">
        <div class="ho-map-visual">
          <div class="ho-map-grid-bg"></div>
          <div class="ho-map-user-pin"></div>
          <div class="ho-map-hos-pin" data-name="City Care Super Specialty" style="top: 25%; left: 30%;" onclick="focusHospital(this)">🏥</div>
          <div class="ho-map-hos-pin" data-name="Wockhardt Hospital" style="top: 70%; left: 60%;" onclick="focusHospital(this)">🏥</div>
          <div class="ho-map-hos-pin" data-name="Dr. Mehta Clinic" style="top: 40%; left: 75%; border-color: #9b59b6;" onclick="focusHospital(this)">🩺</div>
        </div>

        <div class="ho-map-list">
          <div class="ho-panel-header" style="margin-bottom: 0.5rem;">
            <h2 style="font-size: 1.2rem;"><span>📍</span> Live Dispatch Directory</h2>
            <div class="ho-live-indicator" style="background: rgba(52, 152, 219, 0.1); color: var(--ho-blue); border-color: rgba(52, 152, 219, 0.2);"><div class="dot" style="background: var(--ho-blue);"></div> GPS Active</div>
          </div>

          <div class="ho-nearby-card" onclick="showToast('Focusing on City Care Hospital...')">
            <div class="ho-nc-top">
              <div class="ho-nc-info">
                <strong>City Care Super Specialty</strong>
                <span>1.2 km • Open 24/7 • Trauma Center</span>
              </div>
            </div>
            <div class="ho-nc-actions">
              <a href="tel:1234567890" class="ho-nc-btn call" onclick="event.stopPropagation();">📞 Call ER</a>
              <a href="https://www.google.com/maps/search/City+Care+Super+Specialty+hospital" target="_blank" class="ho-nc-btn nav" onclick="event.stopPropagation();">Navigate</a>
            </div>
          </div>

          <div class="ho-nearby-card" onclick="showToast('Focusing on Dr. Mehta Clinic...')">
            <div class="ho-nc-top">
              <div class="ho-nc-info">
                <strong>Dr. Mehta Clinic</strong>
                <span>2.5 km • General Physician</span>
              </div>
            </div>
            <div class="ho-nc-actions">
              <a href="tel:1234567891" class="ho-nc-btn call" style="background: var(--ho-teal-900); box-shadow: 0 4px 15px rgba(11,94,85,0.2);" onclick="event.stopPropagation();">📞 Call Clinic</a>
              <a href="https://www.google.com/maps/search/Dr.+Mehta+Clinic" target="_blank" class="ho-nc-btn nav" onclick="event.stopPropagation();">Navigate</a>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. 3D QUICK DIRECTORY (GOOGLE MAPS ENABLED) -->
      <section class="ho-panel ho-directory-panel ho-delay-4">
        <div class="ho-panel-header">
          <h2><span>🏥</span> Emergency Directory</h2>
        </div>
        <div class="ho-grid-links">
          <a href="https://www.google.com/maps/search/hospitals+near+me" target="_blank" class="ho-3d-tile" onclick="showToast('Opening Maps for Nearby Hospitals...')">
            <div class="tile-icon">🚑</div>
            <div class="ho-tile-text">
              <strong>Nearby Hospitals</strong>
              <span>Find ER & Trauma Centers</span>
            </div>
          </a>
          <a href="https://www.google.com/maps/search/24+hour+pharmacies+near+me" target="_blank" class="ho-3d-tile" onclick="showToast('Opening Maps for 24/7 Pharmacies...')">
            <div class="tile-icon">💊</div>
            <div class="ho-tile-text">
              <strong>24/7 Pharmacies</strong>
              <span>Locate open medical stores</span>
            </div>
          </a>
          <a href="https://www.google.com/maps/search/blood+banks+near+me" target="_blank" class="ho-3d-tile" onclick="showToast('Opening Maps for Blood Banks...')">
            <div class="tile-icon">🩸</div>
            <div class="ho-tile-text">
              <strong>Blood Banks</strong>
              <span>Find nearby blood banks</span>
            </div>
          </a>
          <a href="https://www.google.com/maps/search/clinics+doctors+near+me" target="_blank" class="ho-3d-tile" onclick="showToast('Opening Maps for Nearby Doctors...')">
            <div class="tile-icon">👩‍⚕️</div>
            <div class="ho-tile-text">
              <strong>On-Call Doctors</strong>
              <span>Find nearby clinics & doctors</span>
            </div>
          </a>
        </div>
      </section>

      <!-- 6. 3D FIRST AID PROTOCOLS -->
      <section class="ho-panel ho-protocol-panel ho-delay-4" style="background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(237, 246, 244, 0.9));">
        <div class="ho-panel-header">
          <h2><span>📘</span> First Aid Handbooks</h2>
        </div>
        <p style="font-size: 0.85rem; color: var(--ho-text-muted); font-weight: 600; margin-bottom: 1.5rem;">These basic guides do not replace professional medical training. Always call emergency services for severe situations.</p>
        
        <div class="ho-grid-links">
          <div class="ho-3d-tile" onclick="openFirstAid('cpr')">
            <div class="tile-icon" style="color: #e74c3c;">🫀</div>
            <div class="ho-tile-text"><strong>CPR Protocol</strong><span>Steps for Cardiac Arrest</span></div>
          </div>
          <div class="ho-3d-tile" onclick="openFirstAid('choking')">
            <div class="tile-icon" style="color: #3498db;">🗣️</div>
            <div class="ho-tile-text"><strong>Choking Guide</strong><span>Heimlich Maneuver steps</span></div>
          </div>
          <div class="ho-3d-tile" onclick="openFirstAid('burns')">
            <div class="tile-icon" style="color: #f39c12;">🔥</div>
            <div class="ho-tile-text"><strong>Severe Burns</strong><span>Immediate cooling protocol</span></div>
          </div>
          <div class="ho-3d-tile" onclick="openFirstAid('seizures')">
            <div class="tile-icon" style="color: #9b59b6;">🧠</div>
            <div class="ho-tile-text"><strong>Seizures</strong><span>How to protect the patient</span></div>
          </div>
        </div>
      </section>

    </div>
    <%- include('../partials/footer') %>
  </main>
</div>

<!-- ==========================================
     INTERACTIVE MODALS & TOASTS
========================================== -->

<!-- Premium Toast Notification -->
<div class="ho-toast" id="hoToast">Action completed successfully.</div>

<!-- Dramatic SOS Confirmation Modal -->
<div class="ho-modal" id="sosConfirmModal" onclick="closeModal('sosConfirmModal', event)">
  <div class="ho-modal-box critical-alert" onclick="event.stopPropagation()">
    <div style="font-size: 4rem; margin-bottom: 0.5rem; animation: hoPulse 1s infinite;">🚨</div>
    <h3 style="color: var(--ho-danger-dark); font-size: 2rem; margin-bottom: 0.8rem; font-weight: 900;">TRIGGER SOS?</h3>
    <p style="color: var(--ho-danger-dark); margin-bottom: 2rem; font-weight: 600; line-height: 1.5; font-size: 1.05rem;">This will securely save your live GPS location and emergency medical profile to your HealthOrbit account.</p>
    
    <div class="ho-sos-loader" id="sosLoader"><div class="ho-sos-loader-fill"></div></div>

    <div style="display: flex; gap: 1rem; flex-direction: column;" id="sosActionBtns">
      <button class="ho-btn-danger-pill" style="width: 100%; padding: 1.2rem; font-size: 1.1rem; border-radius: 16px; justify-content: center;" onclick="executeSOS()">YES, SAVE SOS ALERT</button>
      <button class="ho-btn-ghost" style="width: 100%; padding: 1rem; font-size: 1rem;" onclick="closeModal('sosConfirmModal')">Cancel</button>
    </div>
  </div>
</div>

<!-- Post Community Request Modal -->
<div class="ho-modal" id="broadcastModal" onclick="closeModal('broadcastModal', event)">
  <div class="ho-modal-box" style="text-align: left;" onclick="event.stopPropagation()">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
      <h3 style="color: var(--ho-teal-900); font-size: 1.6rem; font-weight: 800;">Post Medical Request</h3>
      <button style="background:none; border:none; font-size: 2.2rem; color: var(--ho-text-muted); cursor:pointer; line-height: 1;" onclick="closeModal('broadcastModal')">&times;</button>
    </div>
    
    <form action="/emergency/community/request" method="POST">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
      <div class="ho-form-group">
        <label>Requirement Type</label>
        <select name="requestType" class="ho-input" required onchange="document.getElementById('bgField').style.display = this.value === 'Blood Donation' ? 'flex' : 'none';">
          <option value="Blood Donation">Blood Donation</option>
          <option value="Oxygen / Respiratory Equipment">Oxygen / Respiratory Equipment</option>
          <option value="Emergency Medicine">Emergency Medicine</option>
          <option value="Other Urgent Need">Other Urgent Need</option>
        </select>
      </div>
      <div class="ho-form-group" id="bgField"><label>Blood Group Needed</label><input type="text" name="bloodGroup" class="ho-input" placeholder="e.g. O+"></div>
      <div class="ho-form-group"><label>Title</label><input type="text" name="title" class="ho-input" placeholder="e.g. Urgent O+ Blood Required" required></div>
      <div class="ho-form-group"><label>Hospital / Area Name</label><input type="text" name="hospitalName" class="ho-input" placeholder="e.g. City Care Hospital" required></div>
      <div class="ho-form-group"><label>Details</label><textarea name="description" class="ho-input" rows="3" required></textarea></div>
      <div class="ho-form-group">
        <label>Urgency Level</label>
        <select name="urgency" class="ho-input" style="color: var(--ho-danger); font-weight: 700;">
          <option value="High Priority (Within Hours)">High Priority (Within Hours)</option>
          <option value="Medium Priority (Within 24 Hours)">Medium Priority (Within 24 Hours)</option>
          <option value="Low Priority">Low Priority</option>
        </select>
      </div>
      <button type="submit" class="ho-btn-danger-pill" style="width: 100%; padding: 1.2rem; margin-top: 1rem; font-size: 1.1rem; border-radius: 16px; justify-content: center; background: var(--ho-teal-900); box-shadow: none;">Broadcast Request</button>
    </form>
  </div>
</div>

<!-- FIRST AID MODAL -->
<div class="ho-modal" id="firstAidModal" onclick="closeModal('firstAidModal', event)">
  <div class="ho-modal-box" onclick="event.stopPropagation()">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--ho-glass-border-subtle); padding-bottom: 1rem;">
      <h3 style="font-size:1.4rem; font-weight:800; color:var(--ho-danger);" id="faTitle">Guide</h3>
      <button onclick="closeModal('firstAidModal')" style="background:none; border:none; font-size:1.5rem; cursor:pointer;">&times;</button>
    </div>
    <div id="faContent" style="font-size: 0.95rem; color: var(--ho-text-muted); line-height: 1.6; font-weight: 500; text-align: left;"></div>
    <div style="margin-top: 2rem; background: rgba(231, 76, 60, 0.1); padding: 1.2rem; border-radius: 12px; color: var(--ho-danger); font-weight: 700; font-size: 0.85rem; text-align: center;">
      Always call 108 or your local emergency number immediately for severe or life-threatening situations.
    </div>
  </div>
</div>

<!-- UI Scripts -->
<script>
  function openModal(id) { document.getElementById(id).classList.add('active'); }
  function closeModal(id, e) {
    if (!e || e.target === document.getElementById(id) || e.target.classList.contains('ho-modal-close') || (e.target.tagName === 'BUTTON' && e.target.type === 'button' && e.target.textContent === 'Cancel')) {
      const modal = document.getElementById(id);
      modal.classList.remove('active');
      setTimeout(() => {
        modal.style.display = 'none';
        if(id === 'sosConfirmModal') {
          document.getElementById('sosLoader').style.display = 'none';
          document.getElementById('sosActionBtns').style.display = 'flex';
        }
      }, 300);
    }
  }

  function showToast(message) {
    const toast = document.getElementById('hoToast');
    toast.innerText = message;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 4000);
  }

  // REAL GEOLOCATION SOS LOGIC
  function executeSOS() {
    const statusEl = document.getElementById('locationStatus');
    const csrfToken = '<%= locals.csrfToken %>';
    
    document.getElementById('sosActionBtns').style.display = 'none';
    document.getElementById('sosLoader').style.display = 'block';
    
    if (statusEl) statusEl.textContent = 'Requesting location...';

    const sendSOS = (lat, lng, acc) => {
      fetch('/emergency/sos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ latitude: lat, longitude: lng, accuracy: acc, _csrf: csrfToken })
      })
      .then(res => res.json())
      .then(data => { window.location.href = '/emergency?success=Emergency+alert+saved+in+HealthOrbit'; })
      .catch(err => { window.location.href = '/emergency?error=Failed+to+save+alert'; });
    };

    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        (pos) => { sendSOS(pos.coords.latitude, pos.coords.longitude, pos.coords.accuracy); },
        (err) => { 
          if (statusEl) statusEl.textContent = 'Location denied. Saving alert without GPS...';
          sendSOS(null, null, null); 
        },
        { timeout: 10000, enableHighAccuracy: true }
      );
    } else {
      sendSOS(null, null, null);
    }
  }

  function focusHospital(element) {
    const hospitalName = element.getAttribute('data-name');
    showToast(`📍 Centering map on ${hospitalName}...`);
  }

  // STATIC FIRST AID CONTENT
  const faData = {
    cpr: { title: "CPR Protocol", content: "<p><strong>1. Check Responsiveness:</strong> Shake the person gently and shout. If no response, call emergency services (108).<br><br><strong>2. Check Breathing:</strong> Look for chest rise. If they are not breathing normally, begin CPR.<br><br><strong>3. Chest Compressions:</strong> Place the heel of one hand in the center of their chest, interlock your other hand on top. Push hard and fast (at least 2 inches deep, 100-120 compressions per minute).<br><br><strong>4. Use AED:</strong> If an Automated External Defibrillator is available, turn it on and follow the voice prompts immediately.</p>" },
    choking: { title: "Choking Guide", content: "<p><strong>For a Conscious Adult:</strong><br>1. Stand behind the person and wrap your arms around their waist.<br>2. Make a fist and place the thumb side just above their navel.<br>3. Grasp your fist with your other hand and give quick, upward thrusts (Heimlich maneuver) until the object is forced out.<br><br><strong>If Unconscious:</strong> Lower them to the floor, call emergency services, and begin CPR.</p>" },
    burns: { title: "Severe Burns", content: "<p><strong>1. Stop the Burning:</strong> Move the person away from the heat source safely.<br><br><strong>2. Cool the Burn:</strong> Run cool (not ice cold) water over the burn for at least 10-20 minutes. Do NOT apply ice, butter, or ointments.<br><br><strong>3. Protect the Area:</strong> Cover the burn loosely with a sterile, non-fluffy dressing or clean plastic wrap.<br><br><strong>4. Seek Urgent Care:</strong> Call emergency services for deep burns, burns larger than 3 inches, or burns on the face/hands.</p>" },
    seizures: { title: "Seizures", content: "<p><strong>1. Protect from Injury:</strong> Ease the person to the floor. Clear the area of hard or sharp objects.<br><br><strong>2. Cushion their Head:</strong> Place something soft and flat under their head.<br><br><strong>3. Do NOT Restrain:</strong> Do not hold them down or try to stop their movements. Do NOT put anything in their mouth.<br><br><strong>4. After the Seizure:</strong> Gently roll them onto one side (recovery position) to keep their airway clear. Time the seizure. Call 108 if it lasts longer than 5 minutes.</p>" }
  };

  function openFirstAid(type) {
    const data = faData[type];
    if (data) {
      document.getElementById('faTitle').textContent = data.title;
      document.getElementById('faContent').innerHTML = data.content;
      openModal('firstAidModal');
    }
  }
</script>
</body>
</html>