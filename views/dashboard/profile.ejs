          <div class="ho-perm-info"><strong>Public Emergency Card</strong><span>Allow first responders to view basic info (Planned)</span></div>
          <label class="ho-toggle"><input type="checkbox" name="emergencyCardEnabled" <%= emergCard ? 'checked' : '' %>><span class="ho-toggle-slider"></span></label>
        </div>
        <div class="ho-perm-row">
          <div class="ho-perm-info"><strong>AI Access: Basic Profile</strong><span>Allow AI to read age, gender, and conditions</span></div>
          <label class="ho-toggle"><input type="checkbox" name="profile" <%= aiPrefs.profile ? 'checked' : '' %>><span class="ho-toggle-slider"></span></label>
        </div>
        <div class="ho-perm-row">
          <div class="ho-perm-info"><strong>AI Access: Medical Reports</strong><span>Allow AI to read OCR extracted data</span></div>
          <label class="ho-toggle"><input type="checkbox" name="medicalReports" <%= aiPrefs.medicalReports ? 'checked' : '' %>><span class="ho-toggle-slider"></span></label>
        </div>
        <div class="ho-perm-row">
          <div class="ho-perm-info"><strong>AI Access: Health Measurements</strong><span>Allow AI to calculate trends from vitals</span></div>
          <label class="ho-toggle"><input type="checkbox" name="healthMeasurements" <%= aiPrefs.healthMeasurements ? 'checked' : '' %>><span class="ho-toggle-slider"></span></label>
        </div>
        <div class="ho-perm-row">
          <div class="ho-perm-info"><strong>AI Access: Medicines</strong><span>Allow AI to reference your medication list</span></div>
          <label class="ho-toggle"><input type="checkbox" name="medicines" <%= aiPrefs.medicines ? 'checked' : '' %>><span class="ho-toggle-slider"></span></label>
        </div>
        <div class="ho-perm-row">
          <div class="ho-perm-info"><strong>AI Access: Family Metadata</strong><span>Allow AI to view contacts in your family circle</span></div>
          <label class="ho-toggle"><input type="checkbox" name="familyMetadata" <%= aiPrefs.familyMetadata ? 'checked' : '' %>><span class="ho-toggle-slider"></span></label>
        </div>
      </div>
      <div style="display: flex; gap: 1rem;">
        <button type="button" class="ho-btn-ghost" style="flex: 1; justify-content:center;" onclick="closeModal('privacyModal')">Cancel</button>
        <button type="submit" class="ho-btn-primary" style="flex: 1; justify-content:center;">Save Privacy Rules</button>
      </div>
    </form>
  </div>
</div>

<!-- DELETE ACCOUNT CONFIRMATION MODAL -->
<div class="ho-modal" id="deleteAccountModal" onclick="closeModal('deleteAccountModal', event)">
  <div class="ho-modal-box ho-custom-scroll" style="max-width: 440px; text-align: center;" onclick="event.stopPropagation()">
    <div class="ho-modal-handle desktop-only" style="display:none;"></div>
    <div style="font-size: 2.8rem; margin-bottom: 0.75rem;">⚠️</div>
    <h3 style="font-size: 1.35rem; font-weight: 800; color: var(--ho-teal-900); margin-bottom: 0.4rem; font-family: 'Fraunces', serif;">Delete Account?</h3>
    <p style="font-size: 0.9rem; color: var(--ho-text-muted); line-height: 1.45; margin-bottom: 0.8rem; font-weight: 500;">Are you sure you want to delete your HealthOrbit account?</p>
    <p style="font-size: 0.78rem; color: var(--ho-danger); font-weight: 700; background: var(--ho-coral-soft); padding: 0.75rem; border-radius: 10px; margin-bottom: 1.5rem; line-height: 1.4;">Warning: This permanently deletes your reports, measurements, family access records, and account data. This cannot be undone.</p>
    <form method="POST" action="/account/delete">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div style="display: flex; gap: 1rem;">
        <button type="button" class="ho-btn-ghost" style="flex: 1; justify-content:center;" onclick="closeModal('deleteAccountModal')">Cancel</button>
        <button type="submit" class="ho-btn-danger" style="flex: 1; justify-content:center;">Delete Account</button>
      </div>
    </form>
  </div>
</div>

<div class="ho-toast" id="serverToast">Action completed</div>

<script>
  function openModal(id) {
    const modal = document.getElementById(id);
    modal.style.display = 'flex';
    setTimeout(() => modal.classList.add('active'), 10);
  }

  function closeModal(id, e) {
    if (!e || e.target === document.getElementById(id) || e.target.classList.contains('ho-modal-close') || (e.target.tagName === 'BUTTON' && e.target.type === 'button')) {
      const modal = document.getElementById(id);
      modal.classList.remove('active');
      setTimeout(() => modal.style.display = 'none', 300);
    }
  }

  function openManageAccess(memberId, name, relationship, permissions) {
    document.getElementById('maName').textContent = name;
    document.getElementById('maRelationship').textContent = 'Relationship: ' + relationship;
    document.getElementById('manageAccessForm').action = '/family/' + memberId + '/permissions';
    const keys = ['emergencyInfo','medicalReports','medicines','healthSummary','wearableData','insurance','symptoms','healthTimeline'];
    keys.forEach(function(k) {
      const el = document.getElementById('perm-' + k);
      if (el) el.checked = !!(permissions && permissions[k]);
    });
    openModal('manageAccessModal');
  }

  // SECURE FAMILY DETAIL FETCH & RENDER
  async function viewFamilyHealth(targetId, memberName) {
    document.getElementById('fhTitle').textContent = memberName + "'s Authorized Health Data";
    const bodyEl = document.getElementById('fhBody');
    bodyEl.innerHTML = '<p style="color: var(--ho-text-muted); text-align: center; padding: 2rem 0;">Retrieving authorized medical records...</p>';
    openModal('familyHealthModal');

    try {
      const res = await fetch('/family/member/' + targetId + '/health');
      if (!res.ok) {
        throw new Error('Access denied or record unavailable.');
      }
      const json = await res.json();
      const perms = json.permissions || {};
      const d = json.data || {};
      let html = '';

      if (perms.healthSummary && d.summary) {
        html += '<div style="background: rgba(13,122,110,0.05); padding: 1rem; border-radius: 12px; margin-bottom: 1rem; border:1px solid rgba(13,122,110,0.12);">' +
                '<strong style="color: var(--ho-teal-900); display: block; margin-bottom: 0.5rem; font-family:\'Fraunces\',serif;">Clinical Summary</strong>' +
                '<span style="font-size:0.85rem; color:var(--ho-text-main); display:block;">Blood Group: <b>' + (d.summary.bloodGroup || 'Not set') + '</b></span>' +
                '<span style="font-size:0.85rem; color:var(--ho-text-main); display:block;">Allergies: ' + (d.summary.allergies && d.summary.allergies.length ? d.summary.allergies.join(', ') : 'None') + '</span>' +
                '<span style="font-size:0.85rem; color:var(--ho-text-main); display:block;">Conditions: ' + (d.summary.medicalConditions && d.summary.medicalConditions.length ? d.summary.medicalConditions.join(', ') : 'None') + '</span>' +
                '</div>';
      }

      if (perms.emergencyInfo && d.emergency && d.emergency.emergencyContact) {
        const ec = d.emergency.emergencyContact;
        html += '<div style="background: rgba(251, 228, 222, 0.5); padding: 1rem; border-radius: 12px; margin-bottom: 1rem; border:1px solid rgba(224,122,104,0.25);">' +
                '<strong style="color: var(--ho-danger); display: block; margin-bottom: 0.3rem;">Emergency Contact</strong>' +
                '<span style="font-size:0.85rem; color:var(--ho-text-main);">' + (ec.name || 'Contact') + ' (' + (ec.relationship || 'Relative') + ') &mdash; ' + (ec.phone || '') + '</span>' +
                '</div>';
      }

      if (perms.medicines && d.medicines) {
        html += '<div style="margin-bottom: 1rem;"><strong style="color: var(--ho-teal-900); display: block; margin-bottom: 0.5rem;">Current Medicines (' + d.medicines.length + ')</strong>';
        if (d.medicines.length === 0) {
          html += '<p style="font-size:0.85rem; color:var(--ho-text-muted);">No active prescriptions.</p>';
        } else {
          d.medicines.forEach(function(m) {
            html += '<div style="background:#fff; border:1px solid rgba(13,122,110,0.15); border-radius:10px; padding:0.65rem 0.8rem; margin-bottom:0.4rem; font-size:0.85rem;">' +
                    '<b>' + m.name + '</b> &mdash; ' + (m.dosage || '') + ' (' + (Array.isArray(m.times) ? m.times.join(', ') : m.times || '') + ')</div>';
          });
        }
        html += '</div>';
      }

      if (perms.medicalReports && d.medicalReports) {
        html += '<div style="margin-bottom: 1rem;"><strong style="color: var(--ho-teal-900); display: block; margin-bottom: 0.5rem;">Medical Reports (' + d.medicalReports.length + ')</strong>';
        if (d.medicalReports.length === 0) {
          html += '<p style="font-size:0.85rem; color:var(--ho-text-muted);">No reports uploaded.</p>';
        } else {
          d.medicalReports.forEach(function(r) {
            html += '<div style="background:#fff; border:1px solid rgba(13,122,110,0.15); border-radius:10px; padding:0.65rem 0.8rem; margin-bottom:0.4rem; font-size:0.85rem;">' +
                    '📄 <b>' + r.originalFileName + '</b> &mdash; ' + new Date(r.createdAt).toLocaleDateString() + '</div>';
          });
        }
        html += '</div>';
      }

      if (html === '') {
        html = '<p style="text-align: center; color: var(--ho-text-muted); padding: 1.5rem 0;">No permissions granted by this family member to view their records.</p>';
      }

      bodyEl.innerHTML = html;
    } catch (err) {
      bodyEl.innerHTML = '<p style="text-align: center; color: var(--ho-danger); padding: 1.5rem 0;">' + err.message + '</p>';
    }
  }

  (function() {
    const toast = document.getElementById('serverToast');
    if (toast) {
      setTimeout(() => {
        toast.classList.add('show');
      }, 100);
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 400); 
      }, 4000);
    }
  })();
</script>
</body>
</html>