<!-- PRIVACY & AI MODAL -->
<div class="ho-modal" id="privacyModal" onclick="closeModal('privacyModal', event)">
  <div class="ho-modal-box ho-custom-scroll" onclick="event.stopPropagation()">
    <div class="ho-modal-handle desktop-only" style="display:none;"></div>
    <div class="ho-modal-head">
      <h3>Privacy &amp; AI Settings</h3>
      <button type="button" class="ho-modal-close" onclick="closeModal('privacyModal')">&times;</button>
    </div>
    <p style="font-size: 0.82rem; font-weight: 500; color: var(--ho-text-muted); margin-bottom: 1.25rem;">Choose what data HealthOrbit AI is allowed to process when answering your questions.</p>
    <form method="POST" action="/profile/privacy">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div style="display: flex; flex-direction: column; gap: 0.2rem; margin-bottom: 1.5rem;" class="ho-custom-scroll">
