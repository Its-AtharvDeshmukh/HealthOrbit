  <div class="ho-glow-orb ho-orb-1"></div>
  <div class="ho-glow-orb ho-orb-2"></div>
  <div class="ho-glow-orb ho-orb-3"></div>
</div>

<div class="ho-app-layout">
  <%- include('../partials/sidebar') %>

  <main class="ho-main-content ho-custom-scroll" id="mainScroll">

    <!-- ===== TOPBAR ===== -->
    <header class="ho-topbar">
      <div class="ho-topbar-text">
        <div class="ho-eyebrow-pill">
          <span class="ho-pulse-dot"></span>
          Prescription Adherence &amp; Symptom Chronology
        </div>
        <h1>Medicines &amp; <b>Symptoms</b></h1>
      </div>

      <div class="ho-topbar-actions">
        <button type="button" class="ho-btn-ghost" onclick="openAddSymptomModal()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          + Log Symptom
        </button>
        <button type="button" class="ho-btn-ghost ho-btn-solid" onclick="openAddMedicineModal()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          + Add Medicine
        </button>
      </div>
    </header>

    <div class="ho-mosaic-grid">

      <!-- ===== 1. ADHERENCE & CLINICAL CHRONOLOGY HERO (SPAN 8) ===== -->
      <section class="ho-panel ho-hero">
        <div class="ho-hero-text">
          <div class="ho-hero-eyebrow">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.5 20.5l10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"/><line x1="8.5" y1="8.5" x2="15.5" y2="15.5"/></svg>
            Parallel Regimen &amp; Symptom Tracker
          </div>

          <h2>Prescriptions &amp; <em>Observations.</em></h2>

          <p>
            Manage your active prescriptions, log scheduled doses in real time, and record symptom episodes along a unified longitudinal timeline. Tap any card to inspect or edit.
          </p>

          <!-- Pharmacokinetic Scan Strip -->
          <div class="ho-scan-strip" aria-hidden="true">
            <svg viewBox="0 0 300 40" preserveAspectRatio="none">
              <path class="base" d="M0 20 H45 L52 20 L58 7 L66 33 L74 20 H125 L132 20 L138 9 L146 31 L154 20 H205 L212 20 L218 8 L226 32 L234 20 H300"/>
              <path class="live" pathLength="300" d="M0 20 H45 L52 20 L58 7 L66 33 L74 20 H125 L132 20 L138 9 L146 31 L154 20 H205 L212 20 L218 8 L226 32 L234 20 H300"/>
            </svg>
            <div class="ho-scan-badge">
              <%= adherencePct !== null ? (adherencePct + '% Adherence Today') : (activeMedsCount + ' Active Rx') %>
            </div>
          </div>

          <!-- 4 Interactive KPI Stat Tiles -->
          <div class="ho-hc-metrics">
            <button type="button" class="ho-hc-stat" onclick="document.getElementById('prescriptionsSection').scrollIntoView({behavior:'smooth'})">
              <span class="lbl">Active Rx</span>
              <strong><span class="js-count"><%= activeMedsCount %></span><small>meds</small></strong>
            </button>

            <button type="button" class="ho-hc-stat" onclick="document.getElementById('scheduleSection').scrollIntoView({behavior:'smooth'})">
              <span class="lbl">Doses Taken</span>
              <strong style="color: var(--ho-teal-600);">
                <span><%= takenDosesToday %>/<%= totalDosesToday %></span><small>today</small>
              </strong>
            </button>

            <button type="button" class="ho-hc-stat" onclick="document.getElementById('scheduleSection').scrollIntoView({behavior:'smooth'})">
              <span class="lbl">Pending Doses</span>
              <strong style="color: <%= pendingDosesToday > 0 ? 'var(--ho-amber)' : 'var(--ho-teal-600)' %>;">
                <span class="js-count"><%= pendingDosesToday %></span><small>left</small>
              </strong>
            </button>

            <button type="button" class="ho-hc-stat" onclick="document.getElementById('symptomsSection').scrollIntoView({behavior:'smooth'})">
              <span class="lbl">Symptoms</span>
              <strong style="color: var(--ho-coral);">
                <span class="js-count"><%= normalizedSymptoms.length %></span><small>logged</small>
              </strong>
            </button>
          </div>
        </div>

        <!-- 3-Ring Adherence & Regimen Gauge -->
        <div class="ho-ring-wrap">
          <div class="ho-ring-container">
            <svg class="ho-svg-rings" viewBox="0 0 160 160" aria-label="Dose Adherence, Active Prescriptions, and Symptom Logs Gauge">
              <circle class="ho-ring-orbit" cx="80" cy="80" r="75"></circle>
              <circle class="ho-ring-bg" cx="80" cy="80" r="64"></circle>
              <circle class="ho-ring-bg" cx="80" cy="80" r="48"></circle>
              <circle class="ho-ring-bg" cx="80" cy="80" r="32"></circle>
              <circle class="ho-ring-fill" id="ringAdherence" cx="80" cy="80" r="64" stroke="var(--ho-mint-400)" stroke-dasharray="402.1" stroke-dashoffset="402.1"></circle>
              <circle class="ho-ring-fill" id="ringPrescriptions" cx="80" cy="80" r="48" stroke="var(--ho-blue)" stroke-dasharray="301.6" stroke-dashoffset="301.6"></circle>
              <circle class="ho-ring-fill" id="ringSymptoms" cx="80" cy="80" r="32" stroke="var(--ho-coral)" stroke-dasharray="201.1" stroke-dashoffset="201.1"></circle>
            </svg>
            <div class="ho-ring-center">
              <strong><%= adherencePct !== null ? (adherencePct + '%') : activeMedsCount %></strong>
              <span><%= adherencePct !== null ? 'Adherence' : 'Active Rx' %></span>
            </div>
          </div>
          <div class="ho-ring-legend">
            <span><i style="background: var(--ho-mint-400)"></i>Taken <b><%= takenDosesToday %></b></span>
            <span><i style="background: var(--ho-blue)"></i>Rx <b><%= activeMedsCount %></b></span>
            <span><i style="background: var(--ho-coral)"></i>Symptoms <b><%= normalizedSymptoms.length %></b></span>
          </div>
        </div>
      </section>

      <!-- ===== 2. QUICK SYMPTOM LOG MATRIX (SPAN 4) ===== -->
      <section class="ho-panel ho-symptom-quick">
        <div>
          <div class="ho-panel-head" style="margin-bottom: 0.65rem;">
            <h3>
              <span class="ic-box" style="background:rgba(224,122,104,0.14); color:var(--ho-coral);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              </span>
              1-Tap Symptom Log
            </h3>
            <button type="button" class="ho-tag warn" style="border:none; cursor:pointer;" onclick="openAddSymptomModal()">+ Custom</button>
          </div>

          <p class="ho-sq-desc">Select severity and tap any symptom below to log it to your health timeline immediately:</p>

          <!-- Severity Selector for Quick Log -->
          <div class="ho-sev-selector" role="radiogroup" aria-label="Quick Log Severity">
            <button type="button" class="ho-sev-pill active" data-qsev="Mild">Mild</button>
            <button type="button" class="ho-sev-pill" data-qsev="Moderate">Moderate</button>
            <button type="button" class="ho-sev-pill" data-qsev="Severe">Severe</button>
          </div>

          <div class="ho-sq-grid">
            <button type="button" class="ho-sq-btn" onclick="quickLogSymptom('Headache', this)">
              <span class="ho-sq-icon">🤕</span>
              <span class="ho-sq-label">Headache</span>
            </button>
            <button type="button" class="ho-sq-btn" onclick="quickLogSymptom('Fever', this)">
              <span class="ho-sq-icon">🤒</span>
              <span class="ho-sq-label">Fever</span>
            </button>
            <button type="button" class="ho-sq-btn" onclick="quickLogSymptom('Cough', this)">
              <span class="ho-sq-icon">🤧</span>
              <span class="ho-sq-label">Cough</span>
            </button>
            <button type="button" class="ho-sq-btn" onclick="quickLogSymptom('Fatigue', this)">
              <span class="ho-sq-icon">😴</span>
              <span class="ho-sq-label">Fatigue</span>
            </button>
            <button type="button" class="ho-sq-btn" onclick="quickLogSymptom('Nausea', this)">
              <span class="ho-sq-icon">🤢</span>
              <span class="ho-sq-label">Nausea</span>
            </button>
            <button type="button" class="ho-sq-btn" onclick="quickLogSymptom('Dizziness', this)">
              <span class="ho-sq-icon">💫</span>
              <span class="ho-sq-label">Dizziness</span>
            </button>
          </div>
        </div>
      </section>

      <!-- ===== 3. ACTIVE PRESCRIPTIONS VAULT (SPAN 8) ===== -->
      <section class="ho-panel ho-med-panel" id="prescriptionsSection">
        <div class="ho-panel-head">
          <h3>
            <span class="ic-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M10.5 20.5l10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"/><line x1="8.5" y1="8.5" x2="15.5" y2="15.5"/></svg></span>
            Active Prescriptions Vault
          </h3>
          <div style="display:flex; gap:0.45rem; align-items:center;">
            <span class="ho-tag"><%= activeMedsCount %> Ongoing</span>
            <button type="button" class="ho-tag good" style="border:none; cursor:pointer;" onclick="openAddMedicineModal()">+ Add Rx</button>
          </div>
        </div>

        <div class="ho-filter-strip">
          <div class="ho-search-box">
            <svg class="ho-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="medSearchInput" class="ho-search-input" placeholder="Search prescriptions by name, dosage, or instructions..." aria-label="Search prescriptions">
          </div>
          <div class="ho-filter-tabs" role="tablist">
            <button type="button" class="ho-ftab active" data-med-filter="all">All (<%= normalizedMeds.length %>)</button>
            <button type="button" class="ho-ftab" data-med-filter="scheduled">Daily (<%= scheduledMedsCount %>)</button>
            <button type="button" class="ho-ftab" data-med-filter="prn">PRN / As Needed (<%= prnMedsCount %>)</button>
          </div>
        </div>

        <div class="ho-med-grid ho-custom-scroll" id="medGrid">
          <% if (normalizedMeds.length > 0) { %>
            <% normalizedMeds.forEach((med) => { %>
              <div
                class="ho-med-card <%= med.isPrn ? 'prn' : '' %>"
                data-med-search="<%= (med.name + ' ' + med.dosage + ' ' + med.instructions).toLowerCase() %>"
                data-med-type="<%= med.isPrn ? 'prn' : 'scheduled' %>"
                onclick="openInspectorModal('medicine', <%= med.idx %>)">

                <div class="ho-mc-top">
                  <div style="display:flex; gap:0.8rem; align-items:center; min-width:0;">
                    <div style="width:40px; height:40px; border-radius:12px; background:<%= med.isPrn ? 'rgba(59,130,246,0.1)' : 'rgba(13,122,110,0.1)' %>; color:<%= med.isPrn ? 'var(--ho-blue)' : 'var(--ho-teal-700)' %>; display:grid; place-items:center; flex-shrink:0; font-size:1.15rem;">
                      💊
                    </div>
                    <div style="min-width:0;">
                      <strong class="ho-mc-title" style="display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= med.name %></strong>
                      <span style="font-family:'JetBrains Mono',monospace; font-size:0.75rem; color:var(--ho-text-muted); font-weight:700;"><%= med.dosage %></span>
                    </div>
                  </div>

                  <div class="ho-card-actions" onclick="event.stopPropagation();">
                    <button type="button" class="ho-btn-icon" title="Edit / Reschedule Prescription" onclick="openEditMedicineModal(<%= med.idx %>)">
                      <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    </button>
                    <form action="/medicines/delete/<%= med.id %>" method="POST" style="margin:0;" onsubmit="return confirm('Delete this prescription?');">
                      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                      <button type="submit" class="ho-btn-delete" title="Delete Prescription" aria-label="Delete">
                        <svg viewBox="0 0 24 24"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      </button>
                    </form>
                  </div>
                </div>

                <div style="font-size:0.77rem; color:var(--ho-text-muted); font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                  <%= med.instructions %>
                </div>

                <div class="ho-mc-bot">
                  <span style="font-size:0.7rem; text-transform:uppercase; font-weight:800;"><%= med.frequency %></span>
                  <span class="ho-mc-badge" style="<%= med.isPrn ? 'background:rgba(59,130,246,0.1); color:var(--ho-blue); border-color:rgba(59,130,246,0.2);' : '' %>">
                    ⏰ <%= med.timesDisplay %>
                  </span>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div style="grid-column: 1 / -1; text-align:center; padding:2.2rem 1rem; color:var(--ho-text-muted); font-size:0.88rem; font-weight:600; background:rgba(255,255,255,0.5); border:1.5px dashed rgba(13,122,110,0.22); border-radius:18px;">
              No active prescriptions in your vault yet. Click <strong>+ Add Medicine</strong> to schedule your medications.
            </div>
          <% } %>
        </div>
      </section>

      <!-- ===== 4. AI CLINICAL PHARMACY & SYMPTOM COMPANION (SPAN 4) ===== -->
      <section class="ho-panel ho-ai-banner-card">
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; gap:0.75rem; margin-bottom:1rem; z-index:2; position:relative;">
            <div style="display:flex; align-items:center; gap:0.65rem;">
              <div class="ho-ai-mini-orb" aria-hidden="true">
                <span class="r1"></span><span class="r2"></span><span class="core"></span>
              </div>
              <span style="font-size:0.7rem; font-weight:800; text-transform:uppercase; letter-spacing:0.07em; color:var(--ho-mint-200);">HealthOrbit AI Companion</span>
            </div>
            <span class="ho-tag" style="background:rgba(255,255,255,0.14); color:#ffffff;">Non-Diagnostic</span>
          </div>

          <h3 style="font-family:'Fraunces',serif; font-size:1.3rem; font-weight:700; color:#ffffff; margin-bottom:0.55rem; position:relative; z-index:2;">
            Medication &amp; Symptom Questions
          </h3>
          <p style="font-size:0.86rem; line-height:1.58; color:rgba(233,251,246,0.88); font-weight:500; position:relative; z-index:2;">
            Prepare questions for your doctor about your active prescriptions (<%= activeMedsCount %>) or recent symptom entries (<%= normalizedSymptoms.length %>), or review general timing instructions.
          </p>
        </div>

        <div style="margin-top:1.15rem; padding-top:0.95rem; border-top:1px solid rgba(255,255,255,0.14); display:flex; flex-direction:column; gap:0.55rem; position:relative; z-index:2;">
          <button type="button" class="ho-btn-ghost" style="width:100%; justify-content:center; background:#ffffff; color:var(--ho-teal-950); border:none;" onclick="askAiAboutRegimen()">
            ✨ Ask AI About My Regimen &amp; Symptoms
          </button>
        </div>
      </section>

      <!-- ===== 5. TODAY'S SCHEDULE TIMELINE (SPAN 8) ===== -->
      <section class="ho-panel ho-schedule-panel" id="scheduleSection">
        <div class="ho-panel-head">
          <h3>
            <span class="ic-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
            Today's Dose Schedule Timeline
          </h3>
          <div style="display:flex; gap:0.4rem; align-items:center;">
            <div class="ho-filter-tabs" role="tablist">
              <button type="button" class="ho-ftab active" data-sched-filter="all">All (<%= totalDosesToday %>)</button>
              <button type="button" class="ho-ftab" data-sched-filter="upcoming">Pending (<%= pendingDosesToday %>)</button>
              <button type="button" class="ho-ftab" data-sched-filter="completed">Taken (<%= takenDosesToday %>)</button>
            </div>
          </div>
        </div>

        <div class="ho-timeline ho-custom-scroll" id="scheduleTimeline">
          <% if (normalizedSchedule.length > 0) { %>
            <% normalizedSchedule.forEach((item) => { %>
              <div
                class="ho-tl-item <%= item.isTaken ? 'completed' : 'upcoming' %>"
                data-sched-state="<%= item.isTaken ? 'completed' : 'upcoming' %>">
                <div class="ho-tl-dot"></div>
                <span class="ho-tl-time">⏰ <%= item.time %> &bull; <%= item.name %></span>

                <div class="ho-tl-card" onclick="openInspectorModal('schedule', <%= item.idx %>)">
                  <div class="ho-tl-info">
                    <strong><%= item.name %> <% if (item.dosage) { %>(<%= item.dosage %>)<% } %></strong>
                    <span><%= item.instructions %></span>
                  </div>

                  <div onclick="event.stopPropagation();" style="display:flex; align-items:center; gap:0.5rem;">
                    <% if (item.isTaken) { %>
                      <span class="ho-tag good" style="padding:0.4rem 0.85rem;">✔ Taken</span>
                    <% } else if (item.medId) { %>
                      <form action="/medicines/log/<%= item.medId %>" method="POST" style="margin:0;">
                        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                        <input type="hidden" name="time" value="<%= item.time %>">
                        <input type="hidden" name="status" value="taken">
                        <button type="submit" class="ho-btn-action">Mark as Taken</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div style="text-align:center; padding:2rem 1rem; color:var(--ho-text-muted); font-size:0.86rem; font-weight:600;">
              No timed doses scheduled for today. Add a daily prescription with a scheduled time to populate your timeline.
            </div>
          <% } %>
        </div>
      </section>

      <!-- ===== 6. RECENT SYMPTOMS JOURNAL (SPAN 4) ===== -->
      <section class="ho-panel ho-history-panel" id="symptomsSection">
        <div class="ho-panel-head">
          <h3>
            <span class="ic-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span>
            Recent Symptoms
          </h3>
          <span class="ho-tag <%= severeSymptomsCount > 0 ? 'warn' : '' %>"><%= normalizedSymptoms.length %> Logged</span>
        </div>

        <div class="ho-filter-strip" style="margin-bottom:0.75rem;">
          <div class="ho-search-box" style="min-width:100%;">
            <svg class="ho-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="symSearchInput" class="ho-search-input" placeholder="Filter logged symptoms..." aria-label="Filter symptoms">
          </div>
        </div>

        <div class="ho-symptom-list ho-custom-scroll" id="symptomList">
          <% if (normalizedSymptoms.length > 0) { %>
            <% normalizedSymptoms.forEach((symp) => { %>
              <div
                class="ho-sym-card"
                data-sym-search="<%= (symp.symptom + ' ' + symp.severity + ' ' + symp.notes).toLowerCase() %>"
                onclick="openInspectorModal('symptom', <%= symp.idx %>)">
                <div class="ho-sym-left">
                  <div class="ho-sym-icon">🩺</div>
                  <div class="ho-sym-text">
                    <strong><%= symp.symptom %></strong>
                    <span><%= symp.dateStr %><% if (symp.timeStr) { %> &bull; <%= symp.timeStr %><% } %></span>
                    <% if (symp.notes) { %>
                      <span style="font-style:italic; color:var(--ho-text-subtle); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:170px;"><%= symp.notes %></span>
                    <% } %>
                  </div>
                </div>

                <div style="display:flex; align-items:center; gap:0.4rem;" onclick="event.stopPropagation();">
                  <span class="ho-sym-severity <%= symp.severityKey %>"><%= symp.severity %></span>
                  <button type="button" class="ho-btn-icon" title="Edit / Re-log Symptom" onclick="openEditSymptomModal(<%= symp.idx %>)">
                    <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                  </button>
                  <form action="/symptoms/delete/<%= symp.id %>" method="POST" style="margin:0;" onsubmit="return confirm('Delete this symptom log?');">
                    <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                    <button type="submit" class="ho-btn-delete" title="Delete Log" aria-label="Delete">
                      <svg viewBox="0 0 24 24"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    </button>
                  </form>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div style="text-align:center; padding:2rem 1rem; color:var(--ho-text-muted); font-size:0.85rem; font-weight:600;">
              No symptoms logged recently. Use the 1-Tap Symptom Log above or click <strong>+ Log Symptom</strong>.
            </div>
          <% } %>
        </div>
      </section>

    </div>

    <%- include('../partials/footer') %>
  </main>
</div>

<!-- ==========================================================================
     1. INTERACTIVE ITEM INSPECTOR POP-UP MODAL (MEDICINE / SCHEDULE / SYMPTOM)
========================================================================== -->
<div class="ho-modal-overlay" id="inspectorModal" onclick="closeModal('inspectorModal', event)" role="dialog" aria-modal="true" aria-labelledby="insTitle">
  <div class="ho-modal-panel ho-custom-scroll" id="inspectorModalPanel" onclick="event.stopPropagation()">
    <div class="ho-modal-handle"></div>
    <div class="ho-modal-header">
      <div>
        <span class="ho-tag" id="insBadge">Record</span>
        <h3 class="ho-modal-title" id="insTitle" style="margin-top:0.35rem;">Details</h3>
      </div>
      <button type="button" class="ho-modal-close" onclick="closeModal('inspectorModal')" aria-label="Close">✕</button>
    </div>

    <div id="insBody" style="display:flex; flex-direction:column; gap:0.65rem;"></div>

    <div style="display:flex; gap:0.6rem; flex-wrap:wrap; align-items:center; padding-top:0.35rem;">
      <button type="button" class="ho-btn-ghost" id="insEditBtn" style="display:none;">✎ Edit / Update</button>
      <form id="insLogDoseForm" method="POST" style="margin:0; display:none;">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
        <input type="hidden" name="time" id="insDoseTime" value="Now">
        <input type="hidden" name="status" value="taken">
        <button type="submit" class="ho-btn-ghost" style="border-color:var(--ho-teal-600); color:var(--ho-teal-900);">✔ Log Dose Taken</button>
      </form>
      <button type="button" class="ho-btn-ghost ho-btn-solid" id="insAskAiBtn" style="flex:1; justify-content:center;">
        ✨ Ask AI Assistant
      </button>
    </div>
  </div>
</div>

<!-- ==========================================================================
     2. ADD / EDIT PRESCRIPTION MODAL
========================================================================== -->
<div class="ho-modal-overlay" id="medicineModal" onclick="closeModal('medicineModal', event)" role="dialog" aria-modal="true">
  <div class="ho-modal-panel ho-custom-scroll" id="medicineModalPanel" onclick="event.stopPropagation()">
    <div class="ho-modal-handle"></div>
    <div class="ho-modal-header">
      <div>
        <span class="ho-tag" id="medModalBadge">Prescription Vault</span>
        <h3 class="ho-modal-title" id="medModalTitle" style="margin-top:0.3rem;">Add New Prescription</h3>
      </div>
      <button type="button" class="ho-modal-close" onclick="closeModal('medicineModal')">✕</button>
    </div>

    <form action="/medicines/add" method="POST" id="medicineForm">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
      <input type="hidden" id="editReplaceMedId" value="">

      <div class="ho-form-group">
        <label>Medicine Name</label>
        <input type="text" name="name" id="medNameInput" class="ho-input" placeholder="e.g. Paracetamol, Metformin, Vitamin D3" required>
      </div>

      <div class="ho-form-group">
        <label>Dosage Strength</label>
        <input type="text" name="dosage" id="medDosageInput" class="ho-input" placeholder="e.g. 500 mg" required>
        <div class="ho-preset-chips">
          <button type="button" class="ho-preset-chip" onclick="setInputVal('medDosageInput','250 mg')">250 mg</button>
          <button type="button" class="ho-preset-chip" onclick="setInputVal('medDosageInput','500 mg')">500 mg</button>
          <button type="button" class="ho-preset-chip" onclick="setInputVal('medDosageInput','650 mg')">650 mg</button>
          <button type="button" class="ho-preset-chip" onclick="setInputVal('medDosageInput','10 mg')">10 mg</button>
          <button type="button" class="ho-preset-chip" onclick="setInputVal('medDosageInput','1 Tablet')">1 Tablet</button>
          <button type="button" class="ho-preset-chip" onclick="setInputVal('medDosageInput','5 ml')">5 ml</button>
        </div>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
        <div class="ho-form-group">
          <label>Frequency</label>
          <select name="frequency" id="medFreqInput" class="ho-input">
            <option value="Daily">Daily</option>
            <option value="Twice Daily">Twice Daily</option>
            <option value="As Needed (PRN)">As Needed (PRN)</option>
            <option value="Weekly">Weekly</option>
          </select>
        </div>
        <div class="ho-form-group">
          <label>Scheduled Time</label>
          <input type="time" name="times" id="medTimeInput" class="ho-input" value="08:00">
        </div>
      </div>

      <div class="ho-form-group">
        <label>Clinical Instructions</label>
        <input type="text" name="duration" id="medInstInput" class="ho-input" placeholder="e.g. After meals with warm water">
        <div class="ho-preset-chips">
          <button type="button" class="ho-preset-chip" onclick="setInputVal('medInstInput','After meals')">After meals</button>
          <button type="button" class="ho-preset-chip" onclick="setInputVal('medInstInput','Before breakfast (Empty stomach)')">Empty stomach</button>
          <button type="button" class="ho-preset-chip" onclick="setInputVal('medInstInput','Before sleep')">Before sleep</button>
          <button type="button" class="ho-preset-chip" onclick="setInputVal('medInstInput','With plenty of water')">With water</button>
        </div>
      </div>

      <label id="replaceOldMedWrap" style="display:none; align-items:center; gap:0.5rem; font-size:0.78rem; font-weight:700; color:var(--ho-teal-900); margin-bottom:0.85rem; cursor:pointer;">
        <input type="checkbox" id="replaceOldMedCheck" checked>
        Replace previous version of this prescription automatically
      </label>

      <button type="submit" class="ho-btn-ghost ho-btn-solid" id="medSubmitBtn" style="width:100%; justify-content:center; padding:0.95rem;">
        Save Prescription
      </button>
    </form>
  </div>
</div>

<!-- ==========================================================================
     3. JOURNAL / EDIT SYMPTOM MODAL
========================================================================== -->
<div class="ho-modal-overlay" id="symptomModal" onclick="closeModal('symptomModal', event)" role="dialog" aria-modal="true">
  <div class="ho-modal-panel ho-custom-scroll" id="symptomModalPanel" onclick="event.stopPropagation()">
    <div class="ho-modal-handle"></div>
    <div class="ho-modal-header">
      <div>
        <span class="ho-tag warn" id="symModalBadge">Symptom Journal</span>
        <h3 class="ho-modal-title" id="symModalTitle" style="margin-top:0.3rem;">Journal Symptom</h3>
      </div>
      <button type="button" class="ho-modal-close" onclick="closeModal('symptomModal')">✕</button>
    </div>

    <form action="/symptoms/add" method="POST" id="symptomForm">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
      <input type="hidden" id="editReplaceSymId" value="">

      <div class="ho-form-group">
        <label>Symptom Name</label>
        <input type="text" name="symptomType" id="symTypeInput" class="ho-input" placeholder="e.g. Migraine, Joint Stiffness, Acid Reflux" required>
        <div class="ho-preset-chips">
          <button type="button" class="ho-preset-chip" onclick="setInputVal('symTypeInput','Headache')">Headache</button>
          <button type="button" class="ho-preset-chip" onclick="setInputVal('symTypeInput','Fever')">Fever</button>
          <button type="button" class="ho-preset-chip" onclick="setInputVal('symTypeInput','Cough')">Cough</button>
          <button type="button" class="ho-preset-chip" onclick="setInputVal('symTypeInput','Fatigue')">Fatigue</button>
          <button type="button" class="ho-preset-chip" onclick="setInputVal('symTypeInput','Stomach Ache')">Stomach Ache</button>
        </div>
      </div>

      <div class="ho-form-group">
        <label>Severity Level</label>
        <select name="severity" id="symSevInput" class="ho-input">
          <option value="Mild">Mild — Noticeable but does not limit activity</option>
          <option value="Moderate">Moderate — Interferes with comfort</option>
          <option value="Severe">Severe — High discomfort</option>
        </select>
      </div>

      <div class="ho-form-group">
        <label>Clinical Notes &amp; Context</label>
        <textarea name="notes" id="symNotesInput" class="ho-input" rows="3" placeholder="When did it start? What makes it better or worse?" style="resize:vertical; line-height:1.45;"></textarea>
      </div>

      <label id="replaceOldSymWrap" style="display:none; align-items:center; gap:0.5rem; font-size:0.78rem; font-weight:700; color:var(--ho-teal-900); margin-bottom:0.85rem; cursor:pointer;">
        <input type="checkbox" id="replaceOldSymCheck" checked>
        Replace previous entry when saving updated symptom
      </label>

      <button type="submit" class="ho-btn-ghost ho-btn-solid" id="symSubmitBtn" style="width:100%; justify-content:center; padding:0.95rem;">
        Save to Health Timeline
      </button>
    </form>
  </div>
</div>

<div class="ho-toast" id="hoToast">Action completed</div>

<script>
  const medsData = <%- JSON.stringify(normalizedMeds || []).replace(/</g, '\\u003c') %>;
  const scheduleData = <%- JSON.stringify(normalizedSchedule || []).replace(/</g, '\\u003c') %>;
  const symptomsData = <%- JSON.stringify(normalizedSymptoms || []).replace(/</g, '\\u003c') %>;
  const csrfTokenStr = <%- JSON.stringify(locals.csrfToken || '').replace(/</g, '\\u003c') %>;

  const $ = (s, r) => (r || document).querySelector(s);
  const $$ = (s, r) => Array.from((r || document).querySelectorAll(s));

  function showToast(msg) {
    const t = $('#hoToast');
    if (!t) return;
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(t._h);
    t._h = setTimeout(() => t.classList.remove('show'), 2300);
  }

  window.setInputVal = function (id, val) {
    const el = document.getElementById(id);
    if (el) { el.value = val; el.focus(); }
  };

  /* ---- 1. Count-Up Numbers & 3-Ring Gauge Animation ---- */
  function countUp(el) {
    const raw = el.textContent.trim();
    const target = parseFloat(raw.replace(/,/g, ''));
    if (isNaN(target)) return;
    const dur = 1000, start = performance.now();
    function tick(now) {
      const p = Math.min(1, (now - start) / dur), e = 1 - Math.pow(1 - p, 4);
      el.textContent = Math.round(target * e).toLocaleString();
      if (p < 1) requestAnimationFrame(tick); else el.textContent = raw;
    }
    requestAnimationFrame(tick);
  }
  $$('.js-count').forEach(countUp);

  (function animateRings() {
    const pAdh = <%= adherencePct !== null ? (adherencePct / 100).toFixed(2) : (activeMedsCount > 0 ? 0.75 : 0) %>;
    const pRx  = <%= activeMedsCount > 0 ? Math.min(1, activeMedsCount / 6).toFixed(2) : 0 %>;
    const pSym = <%= normalizedSymptoms.length > 0 ? Math.min(1, normalizedSymptoms.length / 8).toFixed(2) : 0 %>;

    setTimeout(() => {
      const rA = $('#ringAdherence'), rP = $('#ringPrescriptions'), rS = $('#ringSymptoms');
      if (rA) rA.style.strokeDashoffset = (402.1 * (1 - pAdh)).toFixed(1);
      if (rP) rP.style.strokeDashoffset = (301.6 * (1 - pRx)).toFixed(1);
      if (rS) rS.style.strokeDashoffset = (201.1 * (1 - pSym)).toFixed(1);
    }, 280);
  })();

  /* ---- 2. Search & Filter Tabs (Prescriptions, Schedule, Symptoms) ---- */
  let medFilter = 'all', medQuery = '';
  function filterMeds() {
    $$('#medGrid .ho-med-card').forEach(card => {
      const okType = medFilter === 'all' || card.dataset.medType === medFilter;
      const okSearch = !medQuery || (card.dataset.medSearch || '').includes(medQuery);
      card.style.display = (okType && okSearch) ? '' : 'none';
    });
  }
  $('#medSearchInput')?.addEventListener('input', e => {
    medQuery = e.target.value.trim().toLowerCase();
    filterMeds();
  });
  $$('[data-med-filter]').forEach(btn => {
    btn.addEventListener('click', () => {
      $$('[data-med-filter]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      medFilter = btn.dataset.medFilter || 'all';
      filterMeds();
    });
  });

  $$('[data-sched-filter]').forEach(btn => {
    btn.addEventListener('click', () => {
      $$('[data-sched-filter]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const f = btn.dataset.schedFilter || 'all';
      $$('#scheduleTimeline .ho-tl-item').forEach(item => {
        item.style.display = (f === 'all' || item.dataset.schedState === f) ? '' : 'none';
      });
    });
  });

  $('#symSearchInput')?.addEventListener('input', e => {
    const q = e.target.value.trim().toLowerCase();
    $$('#symptomList .ho-sym-card').forEach(card => {
      card.style.display = (!q || (card.dataset.symSearch || '').includes(q)) ? '' : 'none';
    });
  });

  /* ---- 3. Quick Log Symptom with Selected Severity ---- */
  let quickSeverity = 'Mild';
  $$('.ho-sev-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      $$('.ho-sev-pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      quickSeverity = pill.dataset.qsev || 'Mild';
    });
  });

  window.quickLogSymptom = async function (name, btnEl) {
    if (btnEl) btnEl.classList.add('logging');
    try {
      const res = await fetch('/symptoms/quick', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'CSRF-Token': csrfTokenStr
        },
        body: JSON.stringify({ symptomName: name, severity: quickSeverity })
      });
      if (res.ok) {
        showToast(`✔ ${name} (${quickSeverity}) logged to health timeline.`);
        setTimeout(() => window.location.reload(), 750);
      } else {
        openAddSymptomModal(name, quickSeverity);
      }
    } catch (err) {
      openAddSymptomModal(name, quickSeverity);
    } finally {
      if (btnEl) btnEl.classList.remove('logging');
    }
  };

  /* ---- 4. Modal Open / Close & Edit / Update Workflows ---- */
  window.openModal = function (id) {
    const m = document.getElementById(id);
    if (m) m.classList.add('active');
  };
  window.closeModal = function (id, e) {
    const m = document.getElementById(id);
    if (!m) return;
    if (!e || e.target === m) m.classList.remove('active');
  };

  window.openAddMedicineModal = function () {
    $('#medModalBadge').textContent = 'New Prescription';
    $('#medModalTitle').textContent = 'Add New Prescription';
    $('#medSubmitBtn').textContent = 'Save Prescription';
    $('#editReplaceMedId').value = '';
    $('#replaceOldMedWrap').style.display = 'none';
    $('#medicineForm').reset();
    openModal('medicineModal');
  };

  window.openEditMedicineModal = function (idx) {
    const m = medsData[idx];
    if (!m) return;
    closeModal('inspectorModal');
    $('#medModalBadge').textContent = 'Update Prescription';
    $('#medModalTitle').textContent = 'Edit ' + m.name;
    $('#medSubmitBtn').textContent = 'Save Updated Prescription';
    $('#medNameInput').value = m.name;
    $('#medDosageInput').value = m.dosage !== '--' ? m.dosage : '';
    $('#medFreqInput').value = m.isPrn ? 'As Needed (PRN)' : 'Daily';
    $('#medTimeInput').value = (m.times && m.times[0] && /^\d{2}:\d{2}$/.test(m.times[0])) ? m.times[0] : '08:00';
    $('#medInstInput').value = m.instructions !== 'Follow clinician dosage instructions.' ? m.instructions : '';
    $('#editReplaceMedId').value = m.id;
    $('#replaceOldMedWrap').style.display = 'flex';
    openModal('medicineModal');
  };

  /* If editing a medicine and "Replace previous" is checked, delete the old record before submitting */
  $('#medicineForm')?.addEventListener('submit', async function (e) {
    const oldId = $('#editReplaceMedId').value;
    const shouldReplace = $('#replaceOldMedCheck')?.checked;
    if (oldId && shouldReplace) {
      e.preventDefault();
      try {
        await fetch('/medicines/delete/' + encodeURIComponent(oldId), {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: '_csrf=' + encodeURIComponent(csrfTokenStr)
        });
      } catch (_) {}
      $('#editReplaceMedId').value = '';
      this.submit();
    }
  });

  window.openAddSymptomModal = function (prefillName, prefillSev) {
    $('#symModalBadge').textContent = 'Symptom Journal';
    $('#symModalTitle').textContent = 'Journal Symptom';
    $('#symSubmitBtn').textContent = 'Save to Health Timeline';
    $('#editReplaceSymId').value = '';
    $('#replaceOldSymWrap').style.display = 'none';
    $('#symptomForm').reset();
    if (prefillName) $('#symTypeInput').value = prefillName;
    if (prefillSev) $('#symSevInput').value = prefillSev;
    openModal('symptomModal');
  };

  window.openEditSymptomModal = function (idx) {
    const s = symptomsData[idx];
    if (!s) return;
    closeModal('inspectorModal');
    $('#symModalBadge').textContent = 'Update Symptom Entry';
    $('#symModalTitle').textContent = 'Edit ' + s.symptom;
    $('#symSubmitBtn').textContent = 'Save Updated Entry';
    $('#symTypeInput').value = s.symptom;
    $('#symSevInput').value = ['Mild', 'Moderate', 'Severe'].includes(s.severity) ? s.severity : 'Mild';
    $('#symNotesInput').value = s.notes || '';
    $('#editReplaceSymId').value = s.id;
    $('#replaceOldSymWrap').style.display = 'flex';
    openModal('symptomModal');
  };

  $('#symptomForm')?.addEventListener('submit', async function (e) {
    const oldSymId = $('#editReplaceSymId').value;
    const shouldReplace = $('#replaceOldSymCheck')?.checked;
    if (oldSymId && shouldReplace) {
      e.preventDefault();
      try {
        await fetch('/symptoms/delete/' + encodeURIComponent(oldSymId), {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: '_csrf=' + encodeURIComponent(csrfTokenStr)
        });
      } catch (_) {}
      $('#editReplaceSymId').value = '';
      this.submit();
    }
  });

  /* ---- 5. Interactive Inspector Modal (Medicine / Schedule / Symptom) ---- */
  let currentAiPrompt = 'Can you review my active prescriptions and logged symptoms?';

  window.openInspectorModal = function (type, idx) {
    const badge = $('#insBadge');
    const title = $('#insTitle');
    const body = $('#insBody');
    const editBtn = $('#insEditBtn');
    const doseForm = $('#insLogDoseForm');

    editBtn.style.display = 'none';
    doseForm.style.display = 'none';

    if (type === 'medicine' && medsData[idx]) {
      const m = medsData[idx];
      badge.className = 'ho-tag ' + (m.isPrn ? 'blue' : 'good');
      badge.textContent = m.frequency;
      title.textContent = m.name;
      body.innerHTML = `
        <div class="ho-detail-row"><span class="ho-dr-label">Dosage Strength</span><span class="ho-dr-val">${m.dosage}</span></div>
        <div class="ho-detail-row"><span class="ho-dr-label">Scheduled Times</span><span class="ho-dr-val">${m.timesDisplay}</span></div>
        <div class="ho-detail-row"><span class="ho-dr-label">Instructions</span><span class="ho-dr-val">${m.instructions}</span></div>
      `;
      editBtn.style.display = 'inline-flex';
      editBtn.onclick = () => openEditMedicineModal(idx);
      doseForm.style.display = 'block';
      doseForm.action = '/medicines/log/' + m.id;
      $('#insDoseTime').value = (m.times && m.times[0]) ? m.times[0] : new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      currentAiPrompt = `I am prescribed ${m.name} (${m.dosage}, ${m.frequency}, instructions: ${m.instructions}). What general information or questions should I discuss with my doctor about this medication?`;
    } else if (type === 'schedule' && scheduleData[idx]) {
      const sc = scheduleData[idx];
      badge.className = 'ho-tag ' + (sc.isTaken ? 'good' : 'warn');
      badge.textContent = sc.status;
      title.textContent = `${sc.name} (${sc.time})`;
      body.innerHTML = `
        <div class="ho-detail-row"><span class="ho-dr-label">Scheduled Time</span><span class="ho-dr-val">${sc.time}</span></div>
        <div class="ho-detail-row"><span class="ho-dr-label">Dosage</span><span class="ho-dr-val">${sc.dosage || '--'}</span></div>
        <div class="ho-detail-row"><span class="ho-dr-label">Instructions</span><span class="ho-dr-val">${sc.instructions}</span></div>
      `;
      if (!sc.isTaken && sc.medId) {
        doseForm.style.display = 'block';
        doseForm.action = '/medicines/log/' + sc.medId;
        $('#insDoseTime').value = sc.time;
      }
      currentAiPrompt = `Can you help me organize questions for my doctor regarding my ${sc.name} (${sc.dosage}) scheduled at ${sc.time}?`;
    } else if (type === 'symptom' && symptomsData[idx]) {
      const s = symptomsData[idx];
      badge.className = 'ho-tag warn';
      badge.textContent = s.severity + ' Severity';
      title.textContent = s.symptom;
      body.innerHTML = `
        <div class="ho-detail-row"><span class="ho-dr-label">Recorded On</span><span class="ho-dr-val">${s.dateStr} ${s.timeStr}</span></div>
        <div class="ho-detail-row"><span class="ho-dr-label">Severity</span><span class="ho-dr-val">${s.severity}</span></div>
        ${s.notes ? `<div class="ho-detail-row"><span class="ho-dr-label">Clinical Notes</span><span class="ho-dr-val">${s.notes}</span></div>` : ''}
      `;
      editBtn.style.display = 'inline-flex';
      editBtn.onclick = () => openEditSymptomModal(idx);
      currentAiPrompt = `I logged a ${s.severity} ${s.symptom} on ${s.dateStr}${s.notes ? ' (' + s.notes + ')' : ''}. What non-diagnostic context and doctor questions can you share?`;
    }

    openModal('inspectorModal');
  };

  /* Handoff to Floating AI Widget (#hoAiWidget) */
  function triggerAiWidget(promptText) {
    const widgetRoot = document.getElementById('hoAiWidget');
    const aiInput = document.getElementById('hoAiInput');
    const aiSend = document.getElementById('hoAiSendBtn');
    if (widgetRoot && aiInput) {
      widgetRoot.classList.add('open');
      aiInput.value = promptText;
      if (aiSend) aiSend.disabled = false;
      aiInput.focus();
    } else {
      window.location.href = '/ai-assistant';
    }
  }

  $('#insAskAiBtn')?.addEventListener('click', () => { closeModal('inspectorModal'); triggerAiWidget(currentAiPrompt); });    window.askAiAboutRegimen = function () { triggerAiWidget('Can you summarize my active prescriptions and recent symptom logs so I can discuss them at my next doctor visit?'); };    document.addEventListener('keydown', e => { if (e.key === 'Escape') { $$('.ho-modal-overlay.active').forEach(m => m.classList.remove('active'));
    }
  });

  /* ---- 6. Scroll Progress & Cursor Spotlight ---- */
  const mainScroll = $('#mainScroll');
  if (mainScroll) {
    mainScroll.addEventListener('scroll', () => {
      const max = mainScroll.scrollHeight - mainScroll.clientHeight;
      $('#scrollProgress').style.width = (max > 0 ? (mainScroll.scrollTop / max) * 100 : 0) + '\%'; }, { passive: true }); }    $$('.ho-panel').forEach(p => {
    p.addEventListener('pointermove', e => {
      const r = p.getBoundingClientRect();
      p.style.setProperty('--mx', (e.clientX - r.left) + 'px');
      p.style.setProperty('--my', (e.clientY - r.top) + 'px');
    });
  });
</script>
</body>
</html>