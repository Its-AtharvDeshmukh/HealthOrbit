<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0b5e55">
  <%- include('../partials/header', { title: 'HealthOrbit — Medicines & Symptoms Studio' }) %>
  <link rel="icon" href="/images/Logo.png">
<%
  /* ==========================================================================
     SERVER-SIDE VIEW MODEL (100% REAL BACKEND VARIABLES ONLY)
     Defensively normalizes Medicine, Schedule, and SymptomEntry documents
     so every calculation is 100% honest and never throws undefined errors.
  ========================================================================== */
  const rawMeds = (typeof medicines !== 'undefined' && Array.isArray(medicines)) ? medicines : [];
  const rawSchedule = (typeof scheduleToday !== 'undefined' && Array.isArray(scheduleToday)) ? scheduleToday : [];
  const rawSymptoms = (typeof symptoms !== 'undefined' && Array.isArray(symptoms)) ? symptoms : [];

  const normalizedMeds = rawMeds.map((m, idx) => {
    const freqStr = String(m.frequency || 'Daily').trim();
    const isPrn = /need|prn|sos/i.test(freqStr);
    const timesArr = Array.isArray(m.times)
      ? m.times.filter(Boolean)
      : (m.times ? String(m.times).split(',').map(s => s.trim()).filter(Boolean) : []);

    return {
      idx,
      id: m._id ? String(m._id) : `med_${idx}`,
      name: m.name || m.medicineName || 'Prescription',
      dosage: m.dosage || m.dose || '--',
      frequency: freqStr,
      isPrn,
      times: timesArr,
      timesDisplay: timesArr.length > 0 ? timesArr.join(', ') : (isPrn ? 'As Needed (PRN)' : 'Flexible'),
      instructions: m.instructions || m.duration || m.notes || 'Follow clinician dosage instructions.',
      active: m.active !== false
    };
  });

  const normalizedSchedule = rawSchedule.map((item, idx) => {
    const medObj = (item && item.medicine && typeof item.medicine === 'object') ? item.medicine : {};
    const statusStr = String(item.status || 'Pending').trim();
    const isTaken = /taken|completed|done/i.test(statusStr);
    const isSkipped = /skip|missed/i.test(statusStr);
    const medId = medObj._id ? String(medObj._id) : (item.medicineId ? String(item.medicineId) : '');

    return {
      idx,
      medId,
      name: medObj.name || item.medicineName || 'Scheduled Dose',
      dosage: medObj.dosage || item.dosage || '',
      instructions: medObj.instructions || medObj.duration || 'Scheduled dose',
      time: item.time || 'Scheduled',
      status: isTaken ? 'Taken' : (isSkipped ? 'Skipped' : 'Upcoming'),
      isTaken,
      isSkipped
    };
  });

  const normalizedSymptoms = rawSymptoms.map((s, idx) => {
    const sevStr = String(s.severity || 'Mild').trim();
    const sevKey = sevStr.toLowerCase();
    const dRaw = s.recordedAt || s.loggedAt || s.createdAt || null;
    const dObj = dRaw ? new Date(dRaw) : null;
    const validD = dObj && !isNaN(dObj.getTime()) ? dObj : null;

    return {
      idx,
      id: s._id ? String(s._id) : `sym_${idx}`,
      symptom: s.symptom || s.symptomType || s.name || 'Logged Symptom',
      severity: sevStr,
      severityKey: (sevKey === 'severe' || sevKey === 'high') ? 'severe' : (sevKey === 'moderate' ? 'moderate' : 'mild'),
      notes: s.notes || s.description || '',
      dateStr: validD ? validD.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : 'Recent',
      timeStr: validD ? validD.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : ''
    };
  });

  const activeMedsCount = normalizedMeds.filter(m => m.active).length;
  const prnMedsCount = normalizedMeds.filter(m => m.isPrn).length;
  const scheduledMedsCount = Math.max(0, normalizedMeds.length - prnMedsCount);

  const totalDosesToday = normalizedSchedule.length;
  const takenDosesToday = normalizedSchedule.filter(s => s.isTaken).length;
  const pendingDosesToday = Math.max(0, totalDosesToday - takenDosesToday);
  const adherencePct = totalDosesToday > 0 ? Math.round((takenDosesToday / totalDosesToday) * 100) : null;

  const severeSymptomsCount = normalizedSymptoms.filter(s => s.severityKey === 'severe').length;
%>

  <style>
    /* ==================================================================
       HEALTHORBIT — MEDICINES & SYMPTOMS STUDIO
       Liquid Glass Bento Mosaic + Web-Only Floating Motion + Mobile Sheets
    ================================================================== */
    :root {
      --ho-bg-airy: #edf6f4;
      --ho-teal-950: #06302b;
      --ho-teal-900: #0b5e55;
      --ho-teal-800: #0c6b61;
      --ho-teal-700: #0d7a6e;
      --ho-teal-600: #109485;
      --ho-mint-400: #42b89d;
      --ho-mint-200: #9be8d3;
      --ho-mint-soft: #dff1ec;
      --ho-coral: #e07a68;
      --ho-coral-soft: #fbe4de;
      --ho-amber: #f59e0b;
      --ho-amber-soft: #fef3c7;
      --ho-blue: #3b82f6;
      --ho-blue-soft: #dbeafe;
      --ho-danger: #d94b4b;
      --ho-green: #27ae60;
      --ho-text-main: #0f1c1a;
      --ho-text-muted: #4e6b63;
      --ho-text-subtle: #78948d;

      --ho-glass-clear: rgba(255, 255, 255, 0.58);
      --ho-glass-solid: rgba(255, 255, 255, 0.9);
      --ho-glass-border: rgba(255, 255, 255, 0.95);
      --ho-glass-border-subtle: rgba(13, 122, 110, 0.14);

      --ho-radius-xl: 28px;
      --ho-radius-lg: 20px;
      --ho-radius-md: 14px;
      --ho-shadow-glass: 0 20px 50px rgba(13, 122, 110, 0.08), inset 0 1px 1px rgba(255, 255, 255, 1);
      --ho-shadow-elevated: 0 26px 56px rgba(13, 122, 110, 0.16);
      --ho-ease: cubic-bezier(0.16, 1, 0.3, 1);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { -webkit-tap-highlight-color: transparent; }

    body {
      min-height: 100vh;
      min-height: 100dvh;
      font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
      background-color: var(--ho-bg-airy);
      color: var(--ho-text-main);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      display: flex;
    }

    /* ---------- Custom Visible Scrollbars (.ho-custom-scroll) ---------- */
    .ho-custom-scroll {
      scrollbar-width: thin;
      scrollbar-color: rgba(13, 122, 110, 0.34) rgba(13, 122, 110, 0.05);
    }
    .ho-custom-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
    .ho-custom-scroll::-webkit-scrollbar-track { background: rgba(13, 122, 110, 0.05); border-radius: 999px; }
    .ho-custom-scroll::-webkit-scrollbar-thumb { background: rgba(13, 122, 110, 0.34); border-radius: 999px; }
    .ho-custom-scroll::-webkit-scrollbar-thumb:hover { background: var(--ho-teal-600); }

    /* ---------- Ambient Glow Orbs (Web-Only Floating Motion) ---------- */
    .ho-ambient-canvas { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
    .ho-glow-orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.6; }
    .ho-orb-1 { width: 580px; height: 580px; background: #76d7c4; top: -120px; left: -100px; }
    .ho-orb-2 { width: 620px; height: 620px; background: #fadbd8; bottom: -160px; right: -100px; }
    .ho-orb-3 { width: 400px; height: 400px; background: #85c1e9; top: 36%; left: 42%; opacity: 0.28; }

    @media (min-width: 1025px) {
      .ho-glow-orb { animation: hoFloatOrb 22s ease-in-out infinite alternate; }
      .ho-orb-2 { animation-delay: -6s; }
      .ho-orb-3 { animation-delay: -11s; }
      @keyframes hoFloatOrb {
        0% { transform: translate(0, 0) scale(1) rotate(0deg); }
        50% { transform: translate(45px, 60px) scale(1.08) rotate(4deg); }
        100% { transform: translate(-30px, 40px) scale(0.96) rotate(-3deg); }
      }
    }

    /* ---------- App Layout Shell ---------- */
    .ho-app-layout { display: flex; width: 100vw; height: 100vh; height: 100dvh; position: relative; z-index: 10; }
    .ho-main-content {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      height: 100vh;
      height: 100dvh;
      overflow-y: auto;
      overflow-x: hidden;
      scroll-behavior: smooth;
    }

    .ho-scroll-progress {
      position: fixed; top: 0; left: 0; height: 3px; width: 0; z-index: 3000;
      background: linear-gradient(90deg, var(--ho-mint-400), var(--ho-coral));
      border-radius: 0 3px 3px 0;
      transition: width 0.1s linear;
    }

    /* ---------- Sticky Topbar ---------- */
    .ho-topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
      padding: 2rem 3rem 1.2rem;
      flex-shrink: 0;
      background: transparent;
      z-index: 20;
      position: sticky;
      top: 0;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      mask-image: linear-gradient(to bottom, black 82%, transparent);
      -webkit-mask-image: linear-gradient(to bottom, black 82%, transparent);
    }
    @media (min-width: 1025px) {
      .ho-topbar { animation: hoDrop 0.65s var(--ho-ease) both; }
      @keyframes hoDrop { from { opacity: 0; transform: translateY(-16px); } to { opacity: 1; transform: none; } }
    }

    .ho-eyebrow-pill {
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.11em;
      text-transform: uppercase;
      color: var(--ho-teal-700);
      margin-bottom: 0.35rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .ho-pulse-dot {
      width: 8px; height: 8px;
      background: var(--ho-mint-400);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--ho-mint-400);
      animation: hoPulse 2s infinite;
      flex-shrink: 0;
    }
    @keyframes hoPulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.5); } }

    .ho-topbar-text h1 {
      font-family: 'Fraunces', serif;
      font-weight: 800;
      font-size: 2.2rem;
      color: var(--ho-teal-900);
      letter-spacing: -0.9px;
      line-height: 1.1;
    }
    .ho-topbar-text h1 b { color: var(--ho-coral); font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; }

    .ho-topbar-actions { display: flex; gap: 0.65rem; align-items: center; flex-wrap: wrap; }
    .ho-btn-ghost {
      padding: 0.78rem 1.35rem;
      background: var(--ho-glass-solid);
      border: 1.5px solid var(--ho-glass-border);
      border-radius: 999px;
      color: var(--ho-teal-900);
      font-weight: 700;
      font-size: 0.86rem;
      cursor: pointer;
      text-decoration: none;
      transition: 0.25s var(--ho-ease);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: inherit;
      white-space: nowrap;
    }
    .ho-btn-ghost svg { width: 16px; height: 16px; flex-shrink: 0; }
    .ho-btn-ghost:hover { background: #ffffff; box-shadow: 0 8px 25px rgba(13, 122, 110, 0.12); transform: translateY(-2px); border-color: var(--ho-teal-600); }
    .ho-btn-ghost:active { transform: scale(0.96); }
    .ho-btn-solid {
      background: linear-gradient(135deg, var(--ho-teal-600), var(--ho-teal-900));
      color: #ffffff;
      border-color: transparent;
      box-shadow: 0 10px 22px rgba(11, 94, 85, 0.25);
    }
    .ho-btn-solid:hover { background: linear-gradient(135deg, var(--ho-teal-600), var(--ho-teal-900)); color: #ffffff; box-shadow: 0 14px 28px rgba(11, 94, 85, 0.34); }

    /* ---------- 12-COLUMN BENTO MOSAIC GRID ---------- */
    .ho-mosaic-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 1.5rem;
      padding: 0.5rem 3rem 3rem;
      max-width: 1600px;
      width: 100%;
      margin: 0 auto;
      flex: 1 0 auto;
    }

    /* Base Liquid Glass Panel */
    .ho-panel {
      --mx: 50%;
      --my: 50%;
      background: var(--ho-glass-clear);
      backdrop-filter: blur(40px) saturate(200%);
      -webkit-backdrop-filter: blur(40px) saturate(200%);
      border: 1px solid var(--ho-glass-border);
      border-radius: var(--ho-radius-xl);
      padding: 1.8rem;
      display: flex;
      flex-direction: column;
      box-shadow: var(--ho-shadow-glass);
      position: relative;
      overflow: hidden;
      min-width: 0;
    }
    @media (min-width: 1025px) {
      .ho-panel {
        transition: 0.4s var(--ho-ease);
        animation: hoSlideUp 0.7s var(--ho-ease) both;
      }
      .ho-mosaic-grid > .ho-panel:nth-child(1) { animation-delay: 0.05s; }
      .ho-mosaic-grid > .ho-panel:nth-child(2) { animation-delay: 0.11s; }
      .ho-mosaic-grid > .ho-panel:nth-child(3) { animation-delay: 0.17s; }
      .ho-mosaic-grid > .ho-panel:nth-child(4) { animation-delay: 0.23s; }
      .ho-mosaic-grid > .ho-panel:nth-child(5) { animation-delay: 0.29s; }
      .ho-mosaic-grid > .ho-panel:nth-child(6) { animation-delay: 0.35s; }
      @keyframes hoSlideUp { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }

      .ho-panel::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease;
        background: radial-gradient(380px circle at var(--mx) var(--my), rgba(66, 184, 157, 0.16), transparent 60%);
      }
      .ho-panel:hover::after { opacity: 1; }
      .ho-panel:hover { transform: translateY(-4px); box-shadow: var(--ho-shadow-elevated); border-color: rgba(16, 148, 133, 0.4); background: rgba(255, 255, 255, 0.72); }
    }

    .ho-panel-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.15rem;
      z-index: 2;
      gap: 0.8rem;
      flex-wrap: wrap;
    }
    .ho-panel-head h3 {
      font-family: 'Fraunces', serif;
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--ho-teal-900);
      display: flex;
      align-items: center;
      gap: 0.55rem;
    }
    .ho-panel-head h3 .ic-box {
      width: 30px; height: 30px;
      border-radius: 10px;
      background: rgba(13, 122, 110, 0.1);
      color: var(--ho-teal-700);
      display: inline-flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .ho-panel-head h3 .ic-box svg { width: 16px; height: 16px; }

    .ho-tag {
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.28rem 0.75rem;
      border-radius: 999px;
      background: rgba(13, 122, 110, 0.09);
      color: var(--ho-teal-700);
      white-space: nowrap;
    }
    .ho-tag.warn { background: var(--ho-coral-soft); color: #c0392b; }
    .ho-tag.good { background: var(--ho-mint-soft); color: var(--ho-teal-900); }
    .ho-tag.blue { background: var(--ho-blue-soft); color: #1d4ed8; }

    /* ==================================================================
       1. ADHERENCE & CLINICAL CHRONOLOGY HERO (SPAN 8)
    ================================================================== */
    .ho-hero {
      grid-column: span 8;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.75rem;
      padding: 2.1rem 2.3rem;
      background:
        radial-gradient(90% 120% at 100% 0%, rgba(66, 184, 157, 0.18), transparent 60%),
        radial-gradient(80% 100% at 0% 100%, rgba(224, 122, 104, 0.14), transparent 60%),
        linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(236, 248, 245, 0.92));
      border: 1.5px solid var(--ho-glass-border);
    }
    .ho-hero-text { flex: 1; z-index: 2; min-width: 0; }
    .ho-hero-eyebrow {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--ho-teal-700);
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }
    .ho-hero-text h2 {
      font-family: 'Fraunces', serif;
      font-size: clamp(1.7rem, 2.3vw, 2.15rem);
      font-weight: 700;
      line-height: 1.12;
      margin-bottom: 0.55rem;
      color: var(--ho-teal-950);
    }
    .ho-hero-text h2 em {
      font-style: normal;
      background: linear-gradient(100deg, var(--ho-teal-600), var(--ho-coral));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .ho-hero-text > p {
      font-size: 0.89rem;
      color: var(--ho-text-muted);
      line-height: 1.55;
      margin-bottom: 1rem;
      font-weight: 500;
    }

    /* Animated Pharmacokinetic Wave Strip */
    .ho-scan-strip {
      position: relative;
      width: 100%;
      max-width: 460px;
      height: 40px;
      margin-bottom: 1.1rem;
      border-radius: 12px;
      overflow: hidden;
      background: rgba(13, 122, 110, 0.05);
      border: 1px solid rgba(13, 122, 110, 0.1);
      display: flex;
      align-items: center;
    }
    .ho-scan-strip svg { width: 100%; height: 100%; display: block; }
    .ho-scan-strip .base { fill: none; stroke: rgba(13, 122, 110, 0.14); stroke-width: 1.5; }
    .ho-scan-strip .live {
      fill: none;
      stroke: var(--ho-teal-600);
      stroke-width: 2.2;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-dasharray: 70 230;
      filter: drop-shadow(0 0 4px rgba(16, 148, 133, 0.55));
    }
    @media (min-width: 1025px) {
      .ho-scan-strip .live { animation: hoScanWave 2.8s linear infinite; }
      @keyframes hoScanWave { from { stroke-dashoffset: 300; } to { stroke-dashoffset: 0; } }
    }
    .ho-scan-badge {
      position: absolute;
      top: 50%;
      right: 0.65rem;
      transform: translateY(-50%);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      font-weight: 800;
      color: var(--ho-teal-800);
      background: rgba(255, 255, 255, 0.88);
      padding: 0.18rem 0.6rem;
      border-radius: 999px;
      border: 1px solid rgba(13, 122, 110, 0.12);
    }

    /* 4 Interactive KPI Stat Tiles */
    .ho-hc-metrics { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .ho-hc-stat {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      padding: 0.75rem 1rem;
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid var(--ho-glass-border-subtle);
      border-radius: 16px;
      cursor: pointer;
      transition: 0.25s var(--ho-ease);
      min-width: 112px;
      text-align: left;
      font-family: inherit;
    }
    .ho-hc-stat:hover { background: #ffffff; transform: translateY(-3px); box-shadow: 0 10px 22px rgba(13, 122, 110, 0.1); border-color: var(--ho-teal-600); }
    .ho-hc-stat:active { transform: scale(0.97); }
    .ho-hc-stat span.lbl { font-size: 0.65rem; text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; color: var(--ho-text-muted); }
    .ho-hc-stat strong { font-family: 'JetBrains Mono', monospace; font-size: 1.45rem; font-weight: 800; color: var(--ho-teal-900); letter-spacing: -0.8px; }
    .ho-hc-stat strong small { font-size: 0.72rem; font-family: 'Plus Jakarta Sans', sans-serif; color: var(--ho-text-muted); font-weight: 600; margin-left: 2px; }

    /* 3-Ring Adherence & Regimen Gauge */
    .ho-ring-wrap { display: flex; flex-direction: column; align-items: center; gap: 0.85rem; flex-shrink: 0; z-index: 2; }
    .ho-ring-container { width: 184px; height: 184px; position: relative; display: flex; align-items: center; justify-content: center; }
    .ho-svg-rings { transform: rotate(-90deg); width: 100%; height: 100%; filter: drop-shadow(0 6px 14px rgba(11, 94, 85, 0.12)); overflow: visible; }
    .ho-ring-orbit { fill: none; stroke: rgba(13, 122, 110, 0.22); stroke-width: 1.5; stroke-dasharray: 3 6; transform-origin: 80px 80px; }
    @media (min-width: 1025px) {
      .ho-ring-orbit { animation: hoSpin 28s linear infinite; }
      @keyframes hoSpin { to { transform: rotate(360deg); } }
    }
    .ho-ring-bg { fill: none; stroke: rgba(13, 122, 110, 0.1); stroke-width: 11; }
    .ho-ring-fill { fill: none; stroke-linecap: round; stroke-width: 11; transition: stroke-dashoffset 1.6s var(--ho-ease); }
    .ho-ring-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
    .ho-ring-center strong { font-family: 'JetBrains Mono', monospace; font-size: 1.6rem; font-weight: 800; color: var(--ho-teal-900); line-height: 1; }
    .ho-ring-center span { font-size: 0.58rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ho-text-muted); margin-top: 0.25rem; }
    .ho-ring-legend { display: flex; gap: 0.7rem; flex-wrap: wrap; justify-content: center; }
    .ho-ring-legend span { display: flex; align-items: center; gap: 0.35rem; font-size: 0.68rem; font-weight: 700; color: var(--ho-text-muted); }
    .ho-ring-legend i { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }

    /* ==================================================================
       2. QUICK SYMPTOM LOG MATRIX (SPAN 4)
    ================================================================== */
    .ho-symptom-quick {
      grid-column: span 4;
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.88), rgba(251, 228, 222, 0.48));
      justify-content: space-between;
    }
    .ho-sq-desc { font-size: 0.82rem; color: var(--ho-text-muted); margin-bottom: 0.75rem; font-weight: 600; line-height: 1.45; z-index: 2; }

    /* Severity Selector Bar for Quick Log */
    .ho-sev-selector {
      display: flex;
      background: rgba(13, 122, 110, 0.07);
      padding: 3px;
      border-radius: 12px;
      gap: 4px;
      margin-bottom: 0.9rem;
      z-index: 2;
    }
    .ho-sev-pill {
      flex: 1;
      border: none;
      background: transparent;
      padding: 0.38rem 0.5rem;
      border-radius: 9px;
      font-family: inherit;
